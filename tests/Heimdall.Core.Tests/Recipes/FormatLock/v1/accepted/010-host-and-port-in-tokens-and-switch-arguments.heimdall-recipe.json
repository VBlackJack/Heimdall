{
  "schemaVersion": 1,
  "id": "lock.sample",
  "version": "1.0.0",
  "author": "Lock",
  "name": "Sample",
  "description": "A sample of the version 1 format.",
  "program": "ping.exe",
  "arguments": ["{Host}", ["-p", "{Port}"], "--at={Host}:{Port}", "{in:up}"],
  "inputs": [
    { "name": "up", "type": "bool", "label": "Label up", "whenTrue": ["--host={Host}", "--port={Port}"], "whenFalse": ["--peer={Host}:{Port}"] }
  ]
}
