{
  "schemaVersion": 1,
  "id": "lock.sample",
  "version": "1.0.0",
  "author": "Lock",
  "name": "Sample",
  "description": "A sample of the version 1 format.",
  "program": "ping.exe",
  "arguments": ["{in:flag}"],
  "inputs": [
    { "name": "level", "type": "int", "label": "Label level", "required": true },
    { "name": "tag", "type": "string", "label": "Label tag", "default": "t" },
    { "name": "flag", "type": "bool", "label": "Label flag", "whenTrue": ["--level", "{in:level}"], "whenFalse": ["--tag", "{in:tag}"] }
  ]
}
