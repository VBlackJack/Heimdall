{
  "schemaVersion": 1,
  "id": "lock.sample",
  "version": "1.0.0",
  "author": "Lock",
  "name": "Sample",
  "description": "A sample of the version 1 format.",
  "program": "ping.exe",
  "arguments": ["{in:on}", "{in:off}"],
  "inputs": [
    { "name": "on", "type": "bool", "label": "Label on", "default": true, "whenTrue": ["--on"] },
    { "name": "off", "type": "bool", "label": "Label off", "default": false, "whenTrue": ["--off"] }
  ]
}
