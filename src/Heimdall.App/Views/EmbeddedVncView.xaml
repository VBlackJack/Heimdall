<UserControl x:Class="Heimdall.App.Views.EmbeddedVncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Heimdall.App.Localization"
             xmlns:behaviors="clr-namespace:Heimdall.App.Behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="540"
             d:DesignWidth="900"
             Background="{DynamicResource BackgroundBrush}"
             Focusable="True">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header strip -->
        <Border x:Name="SessionHeaderBar"
                Grid.Row="0"
                Padding="{StaticResource SessionHeaderPadding}"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                SizeChanged="OnHeaderSizeChanged">
            <Grid x:Name="HeaderLayout">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Who and how it is going. The status takes the room the title and the endpoint
                     leave and is trimmed to it: the controls used to take all of a narrow pane. -->
                <Grid Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SessionTitleText"
                               Grid.Column="0"
                               FontSize="{StaticResource FontSizeBody}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="{StaticResource SessionHeaderTitleMaxWidth}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="EndpointTextBlock"
                               Grid.Column="1"
                               Margin="8,0,0,0"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="{StaticResource SessionHeaderEndpointMaxWidth}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2"
                               Text=" - " Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="{StaticResource FontSizeCaption}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusTextBlock"
                               Grid.Column="3"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.LiveSetting="Polite"
                               behaviors:LiveRegionBehavior.AnnounceOnTargetUpdated="True"/>
                </Grid>

                <!-- Display controls. They belong in the header, outside the remote screen: drawn
                     over the page they took the top right corner of the remote desktop, where
                     the remote windows keep their minimize, maximize and close buttons. Declared
                     in screen order, left to right, so Tab follows the eye. In a pane too narrow
                     for both, the header moves them under the title (OnHeaderSizeChanged). -->
                <StackPanel x:Name="HeaderControls"
                            Grid.Row="0"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="SplitButton"
                            Content="&#xE8A9;"
                            FontFamily="{StaticResource FontFamilyIcons}"
                            Click="OnSplitClick"
                            Style="{DynamicResource GhostButtonStyle}"
                            Padding="6,2" FontSize="{StaticResource FontSizeBody}" Margin="4,0"/>

                    <ComboBox x:Name="QualitySelector"
                              Margin="8,0,0,0"
                              FontSize="{StaticResource FontSizeCaption}"
                              VerticalAlignment="Center"
                              SelectedIndex="2"
                              ToolTip="{loc:Translate TooltipVncQuality}"
                              AutomationProperties.Name="{loc:Translate A11yVncQuality}">
                        <ComboBoxItem Content="{loc:Translate VncQualityBest}" Tag="best"/>
                        <ComboBoxItem Content="{loc:Translate VncQualityBalanced}" Tag="balanced"/>
                        <ComboBoxItem Content="{loc:Translate VncQualityPerformance}" Tag="performance"/>
                        <ComboBoxItem Content="{loc:Translate VncQualityLowBandwidth}" Tag="low-bandwidth"/>
                    </ComboBox>

                    <ComboBox x:Name="ScalingSelector"
                              Margin="8,0,0,0"
                              FontSize="{StaticResource FontSizeCaption}"
                              VerticalAlignment="Center"
                              SelectedIndex="1"
                              ToolTip="{loc:Translate TooltipVncScaling}"
                              AutomationProperties.Name="{loc:Translate A11yVncScaling}">
                        <ComboBoxItem Content="{loc:Translate VncScalingRemote}" Tag="remote"/>
                        <ComboBoxItem Content="{loc:Translate VncScalingScale}" Tag="scale"/>
                        <ComboBoxItem Content="{loc:Translate VncScalingNone}" Tag="none"/>
                    </ComboBox>

                    <Button x:Name="ClipboardButton"
                            Click="OnClipboardClick"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            MinHeight="{StaticResource SessionHeaderMinTarget}"
                            Padding="8,2"
                            FontSize="{StaticResource FontSizeCaption}"
                            Margin="8,0,0,0"
                            Content="{loc:Translate VncClipboardSync}"
                            ToolTip="{loc:Translate TooltipVncClipboard}"
                            AutomationProperties.Name="{loc:Translate A11yVncClipboard}"/>

                    <Button x:Name="ReconnectButton"
                            Click="OnReconnectClick"
                            Style="{DynamicResource PrimaryButtonStyle}"
                            MinHeight="{StaticResource SessionHeaderMinTarget}"
                            Padding="8,2"
                            FontSize="{StaticResource FontSizeCaption}"
                            Margin="8,0,0,0"
                            Visibility="Collapsed"/>

                    <Button x:Name="DisconnectButton"
                            Click="OnDisconnectClick"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            MinHeight="{StaticResource SessionHeaderMinTarget}"
                            Padding="8,2"
                            FontSize="{StaticResource FontSizeCaption}"
                            Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Connection progress indicator -->
        <ProgressBar x:Name="VncLoadingBar"
                     Grid.Row="1"
                     VerticalAlignment="Top"
                     Panel.ZIndex="1"
                     Height="2"
                     IsIndeterminate="True"
                     Foreground="{DynamicResource AccentTextBrush}"
                     Background="Transparent"
                     BorderThickness="0"
                     IsHitTestVisible="False"/>

        <!-- VNC surface -->
        <Grid Grid.Row="1" ClipToBounds="True">
            <wv2:WebView2 x:Name="VncWebView"
                          Focusable="True" />

            <!-- Reconnect overlay (shown on unexpected disconnect) -->
            <Border x:Name="ReconnectOverlay"
                    Style="{StaticResource FadeInPanelStyle}"
                    Visibility="Collapsed"
                    Background="{DynamicResource OverlayBackground}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <StackPanel MaxWidth="400">
                        <TextBlock x:Name="ReconnectMessageText"
                                   AutomationProperties.LiveSetting="Assertive"
                                   behaviors:LiveRegionBehavior.AnnounceOnTargetUpdated="True"
                                   FontSize="{StaticResource FontSizeSubtitle}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <WrapPanel Orientation="Horizontal"
                               HorizontalAlignment="Center"
                               MaxWidth="720"
                               Margin="0,16,0,0">
                        <!-- A shared session cannot store its password: the user types it here,
                             and only when the server asked for it. -->
                        <Button x:Name="OverlayEnterPasswordButton"
                                Click="OnOverlayEnterPasswordClick"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                Visibility="Collapsed"
                                Padding="16,6"
                                FontSize="{StaticResource FontSizeBodyLarge}"
                                Margin="0,0,8,0"
                                AutomationProperties.AutomationId="Vnc.OverlayEnterPassword"/>
                        <Button x:Name="OverlayReconnectButton"
                                Click="OnOverlayReconnectClick"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                Padding="16,6"
                                FontSize="{StaticResource FontSizeBodyLarge}"
                                Margin="0,0,8,0"/>
                        <!-- This overlay is the only one over a VNC pane (the pane's own stays
                             away), so it carries the pane's way to the profile. -->
                        <Button x:Name="OverlayEditProfileButton"
                                Click="OnOverlayEditProfileClick"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Visibility="Collapsed"
                                Padding="16,6"
                                FontSize="{StaticResource FontSizeBodyLarge}"
                                Margin="8,0,0,0"
                                Content="{loc:Translate BtnEditProfileOverlay}"
                                ToolTip="{loc:Translate TooltipEditProfileOverlay}"
                                AutomationProperties.Name="{loc:Translate A11yEditProfileOverlay}"/>
                        <Button x:Name="OverlayCloseButton"
                                Click="OnOverlayCloseClick"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Padding="16,6"
                                FontSize="{StaticResource FontSizeBodyLarge}"
                                Margin="8,0,0,0"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border x:Name="FallbackPanel"
                    Visibility="Collapsed"
                    Background="{DynamicResource BackgroundBrush}"
                    Padding="28">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            MaxWidth="420">
                    <TextBlock x:Name="FallbackTitleText"
                               FontSize="{StaticResource FontSizeDisplay}"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock x:Name="FallbackMessageText"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
