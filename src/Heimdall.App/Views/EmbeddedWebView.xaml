<!-- A web console (iLO, iDRAC, switch, NAS) in a session tab. Labels are set from the
     localizer in InitializeSessionAsync, as the VNC view does. -->
<UserControl x:Class="Heimdall.App.Views.EmbeddedWebView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header strip -->
        <Border Grid.Row="0"
                Padding="{StaticResource SessionHeaderPadding}"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <Button x:Name="SplitButton"
                        DockPanel.Dock="Right"
                        Content="&#xE8A9;"
                        FontFamily="{StaticResource FontFamilyIcons}"
                        Click="OnSplitClick"
                        Style="{DynamicResource GhostButtonStyle}"
                        Padding="6,2" FontSize="{StaticResource FontSizeBody}" Margin="4,0"/>

                <!-- Opens the page with the profile's external program, or the default browser:
                     the way out when the embedded engine does not render a console well. -->
                <Button x:Name="OpenExternallyButton"
                        DockPanel.Dock="Right"
                        Content="&#xE8A7;"
                        FontFamily="{StaticResource FontFamilyIcons}"
                        Click="OnOpenExternallyClick"
                        Style="{DynamicResource GhostButtonStyle}"
                        Padding="6,2" FontSize="{StaticResource FontSizeBody}" Margin="4,0"/>

                <Button x:Name="ReloadButton"
                        DockPanel.Dock="Left"
                        Content="&#xE72C;"
                        FontFamily="{StaticResource FontFamilyIcons}"
                        Click="OnReloadClick"
                        Style="{DynamicResource GhostButtonStyle}"
                        Padding="6,2" FontSize="{StaticResource FontSizeBody}" Margin="0,0,4,0"/>

                <Button x:Name="BackButton"
                        DockPanel.Dock="Left"
                        Content="&#xE72B;"
                        FontFamily="{StaticResource FontFamilyIcons}"
                        Click="OnBackClick"
                        IsEnabled="False"
                        Style="{DynamicResource GhostButtonStyle}"
                        Padding="6,2" FontSize="{StaticResource FontSizeBody}" Margin="0,0,4,0"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="SessionTitleText"
                               FontSize="{StaticResource FontSizeBody}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="{StaticResource SessionHeaderTitleMaxWidth}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="AddressTextBlock"
                               Margin="8,0,0,0"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="{StaticResource SessionHeaderTitleMaxWidth}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text=" - " Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="{StaticResource FontSizeCaption}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusTextBlock"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ProgressBar x:Name="LoadingBar"
                     Grid.Row="1"
                     VerticalAlignment="Top"
                     Panel.ZIndex="1"
                     Height="2"
                     IsIndeterminate="True"
                     Foreground="{DynamicResource AccentBrush}"
                     Background="Transparent"
                     BorderThickness="0"
                     IsHitTestVisible="False"/>

        <Grid Grid.Row="1" ClipToBounds="True">
            <wv2:WebView2 x:Name="ConsoleWebView"
                          Focusable="True"/>

            <Border x:Name="FallbackPanel"
                    Visibility="Collapsed"
                    Background="{DynamicResource BackgroundBrush}"
                    Padding="28">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            MaxWidth="420">
                    <TextBlock x:Name="FallbackTitleText"
                               FontSize="{StaticResource FontSizeDisplay}"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="FallbackMessageText"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Button x:Name="FallbackRetryButton"
                                Click="OnReloadClick"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                Padding="16,6"/>
                        <Button x:Name="FallbackOpenExternallyButton"
                                Click="OnOpenExternallyClick"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Padding="16,6"
                                Margin="8,0,0,0"/>
                    </StackPanel>
                    <!-- The engine reports a console too old for it (an iLO2 speaking TLS 1.0) as a
                         plain connection failure, so the way out is offered on every failure. -->
                    <TextBlock x:Name="FallbackOldConsoleHint"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
