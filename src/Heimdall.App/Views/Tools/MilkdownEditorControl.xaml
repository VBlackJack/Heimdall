<UserControl x:Class="Heimdall.App.Views.Tools.MilkdownEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Grid>
        <!-- The name belongs to the web view, which is what takes the focus; the host sets it once on
             this control and it is forwarded here, so the page stays free of the note title. -->
        <wv2:WebView2 x:Name="EditorWebView"
                      Focusable="True"
                      AutomationProperties.Name="{Binding Path=(AutomationProperties.Name), RelativeSource={RelativeSource AncestorType=UserControl}}"/>

        <Border x:Name="LoadingPanel"
                Background="{DynamicResource SurfaceBrush}">
            <TextBlock Text="..."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="{StaticResource FontSizeBody}"/>
        </Border>
    </Grid>
</UserControl>
