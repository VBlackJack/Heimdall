<UserControl x:Class="Heimdall.App.Views.Tools.SshServerAuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Heimdall.App.Localization"
             Background="{DynamicResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="{StaticResource ToolHeaderPadding}"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderStrongBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <Button x:Name="BtnHelp" DockPanel.Dock="Right" Content="?"
                        Click="OnHelpClick"
                        Style="{DynamicResource ToolHelpButtonStyle}"
                        Padding="{StaticResource PaddingButtonHelp}" FontSize="{StaticResource FontSizeBody}" FontWeight="Bold"
                        Margin="{StaticResource MarginInlineControl}"/>
                <TextBlock x:Name="HeaderTitle"
                           FontSize="{StaticResource FontSizeSubtitle}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Help panel -->
        <Border x:Name="HelpPanel" Grid.Row="1" Style="{StaticResource ToolHelpPanelStyle}">
            <DockPanel>
                <Button x:Name="BtnCloseHelp" DockPanel.Dock="Right" Content="&#xE711;"
                        FontFamily="{StaticResource FontFamilyIcons}" FontSize="{StaticResource FontSizeBody}"
                        Click="OnCloseHelpClick"
                        Style="{DynamicResource ToolCloseHelpButtonStyle}"
                        VerticalAlignment="Top"/>
                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TxtHelpContent" TextWrapping="Wrap"
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               LineHeight="20"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Progress bar -->
        <ProgressBar x:Name="AuditProgress" Grid.Row="2"
                     Height="4"
                     IsIndeterminate="True"
                     Visibility="Collapsed"/>

        <!-- Main content -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="{StaticResource SpacingLg}">
            <StackPanel MaxWidth="{StaticResource ToolContentMaxWidth}">
                <!-- Input row -->
                <TextBlock x:Name="LblHost"
                           FontSize="{StaticResource FontSizeBody}" Margin="{StaticResource MarginLabelBottom}"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <DockPanel Margin="{StaticResource MarginStackItem}">
                    <Button x:Name="BtnAuditFleet" DockPanel.Dock="Right"
                            Click="OnAuditFleetClick"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Padding="{StaticResource PaddingButtonPrimary}" Margin="{StaticResource MarginInlineControl}"
                            VerticalAlignment="Center"/>
                    <Button x:Name="BtnAudit" DockPanel.Dock="Right"
                            Click="OnAuditClick"
                            Style="{DynamicResource PrimaryButtonStyle}"
                            Padding="{StaticResource PaddingButtonPrimary}" Margin="{StaticResource MarginInlineControl}"
                            VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtPort" DockPanel.Dock="Right"
                             Text="{Binding Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Width="76"
                             Style="{StaticResource WatermarkTextBoxStyle}"
                             FontSize="{StaticResource FontSizeBodyLarge}" FontFamily="{StaticResource FontFamilyMonospace}"
                             Padding="{StaticResource PaddingInput}" Margin="{StaticResource MarginInlineControl}"
                             Background="{DynamicResource CardBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Right" Text=":"
                               FontSize="{StaticResource FontSizeBodyLarge}" Margin="{StaticResource MarginInlineStart}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtHost"
                             Text="{Binding Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource WatermarkTextBoxStyle}"
                             FontSize="{StaticResource FontSizeBodyLarge}" FontFamily="{StaticResource FontFamilyMonospace}"
                             Padding="{StaticResource PaddingInput}"
                             Background="{DynamicResource CardBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             VerticalAlignment="Center"/>
                </DockPanel>

                <!-- Gateway routing -->
                <DockPanel Margin="{StaticResource MarginStackItem}">
                    <TextBlock x:Name="LblRouteVia"
                               FontSize="{StaticResource FontSizeBody}" Margin="{StaticResource MarginInlineSm}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbRouteVia" MinWidth="240"
                              Background="{DynamicResource CardBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              VerticalAlignment="Center"/>
                </DockPanel>

                <!-- Error / Status message -->
                <TextBlock x:Name="TxtError" Visibility="Collapsed"
                           FontSize="{StaticResource FontSizeBody}" Margin="{StaticResource MarginSectionBottom}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource ErrorTextBrush}"/>

                <!-- Empty state -->
                <Border x:Name="EmptyStatePanel" Style="{StaticResource ToolEmptyStateStyle}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE72E;" Style="{StaticResource ToolEmptyStateIconStyle}" Focusable="False"/>
                        <TextBlock x:Name="TxtEmptyState" Style="{StaticResource ToolEmptyStateTextStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Batch Fleet Results -->
                <Border x:Name="FleetResultsPanel" Visibility="Collapsed"
                        Padding="{StaticResource SpacingMd}"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource CornerRadiusSm}"
                        Margin="{StaticResource MarginSectionBottom}">
                    <StackPanel>
                        <DockPanel Margin="{StaticResource MarginLabelBottom}">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="BtnExportFleetHtml" Click="OnExportFleetHtmlClick"
                                        Style="{DynamicResource SecondaryButtonStyle}"
                                        Padding="{StaticResource PaddingButtonCopy}" Margin="0,0,8,0"/>
                                <Button x:Name="BtnExportFleetCsv" Click="OnExportFleetCsvClick"
                                        Style="{DynamicResource SecondaryButtonStyle}"
                                        Padding="{StaticResource PaddingButtonCopy}"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="LblFleetTitle" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="TxtFleetSummary" FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <DataGrid x:Name="FleetResultsGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  MaxHeight="240"
                                  SelectionChanged="OnFleetRowSelectionChanged"
                                  Style="{DynamicResource ThemedDataGridStyle}"
                                  ColumnHeaderStyle="{DynamicResource ThemedDataGridColumnHeaderStyle}"
                                  CellStyle="{DynamicResource ThemedDataGridCellStyle}">
                            <DataGrid.RowStyle>
                                <Style TargetType="{x:Type DataGridRow}"
                                       BasedOn="{StaticResource ThemedDataGridRowStyle}">
                                    <Setter Property="AutomationProperties.Name">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource AccessibleRowNameConverter}">
                                                <Binding Source="{x:Static loc:LocalizationSource.Instance}" Path="[A11ySshFleetAuditRow]"/>
                                                <Binding Path="DisplayName"/>
                                                <Binding Path="Endpoint"/>
                                                <Binding Path="Grade"/>
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="ColFleetName" Binding="{Binding DisplayName}" Width="140"/>
                                <DataGridTextColumn x:Name="ColFleetEndpoint" Binding="{Binding Endpoint}" Width="150"/>
                                <DataGridTextColumn x:Name="ColFleetGateway" Binding="{Binding Gateway}" Width="100"/>
                                <DataGridTextColumn x:Name="ColFleetGrade" Binding="{Binding Grade}" Width="60"/>
                                <DataGridTextColumn x:Name="ColFleetDrift" Binding="{Binding Drift}" Width="80"/>
                                <DataGridTextColumn x:Name="ColFleetAnssi" Binding="{Binding Anssi}" Width="68"/>
                                <DataGridTextColumn x:Name="ColFleetPq" Binding="{Binding PostQuantum}" Width="60"/>
                                <DataGridTextColumn x:Name="ColFleetStrictKex" Binding="{Binding StrictKex}" Width="74"/>
                                <DataGridTextColumn x:Name="ColFleetStatus" Binding="{Binding Status}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Results -->
                <StackPanel x:Name="ResultsPanel" Visibility="Collapsed">
                    <!-- Summary header card -->
                    <Border Padding="{StaticResource SpacingMd}"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource CornerRadiusSm}"
                            Margin="{StaticResource MarginSectionBottom}">
                        <DockPanel>
                            <Border x:Name="GradeBadge" DockPanel.Dock="Left"
                                    CornerRadius="{StaticResource CornerRadiusSm}"
                                    Padding="20,10" Margin="0,0,16,0" VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="LblGradeCaption" FontSize="{StaticResource FontSizeCaption}"
                                               Foreground="{DynamicResource TextOnAccentBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtGrade" FontSize="{StaticResource FontSizeHeadline}" FontWeight="Bold"
                                               Foreground="{DynamicResource TextOnAccentBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtBanner"
                                           FontFamily="{StaticResource FontFamilyMonospace}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextWrapping="Wrap"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <Border x:Name="BadgeAnssi" CornerRadius="{StaticResource CornerRadiusSm}" Padding="8,3" Margin="0,0,8,4">
                                        <TextBlock x:Name="TxtBadgeAnssi" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextOnAccentBrush}"/>
                                    </Border>
                                    <Border x:Name="BadgePq" CornerRadius="{StaticResource CornerRadiusSm}" Padding="8,3" Margin="0,0,8,4">
                                        <TextBlock x:Name="TxtBadgePq" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextOnAccentBrush}"/>
                                    </Border>
                                    <Border x:Name="BadgeStrictKex" CornerRadius="{StaticResource CornerRadiusSm}" Padding="8,3" Margin="0,0,8,4">
                                        <TextBlock x:Name="TxtBadgeStrictKex" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextOnAccentBrush}"/>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Action buttons -->
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource MarginSectionBottom}">
                        <Button x:Name="BtnCopy" Click="OnCopyClick"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Padding="{StaticResource PaddingButtonCopy}" Margin="0,0,8,0"/>
                        <Button x:Name="BtnExportHtml" Click="OnExportHtmlClick"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Padding="{StaticResource PaddingButtonCopy}" Margin="0,0,8,0"/>
                        <Button x:Name="BtnExportCsv" Click="OnExportCsvClick"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Padding="{StaticResource PaddingButtonCopy}" Margin="0,0,8,0"/>
                        <Button x:Name="BtnCopyDropIn" Click="OnCopyDropInClick"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Padding="{StaticResource PaddingButtonCopy}"/>
                    </StackPanel>

                    <!-- Findings -->
                    <Border Padding="{StaticResource SpacingMd}"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource CornerRadiusSm}"
                            Margin="{StaticResource MarginSectionBottom}">
                        <StackPanel>
                            <TextBlock x:Name="LblFindings" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="{StaticResource MarginLabelBottom}"/>
                            <ItemsControl x:Name="FindingsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" Foreground="{Binding Brush}" Margin="0,0,8,0" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Message}" Foreground="{Binding Brush}" TextWrapping="Wrap" FontSize="{StaticResource FontSizeBody}"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Algorithms table -->
                    <Border Padding="{StaticResource SpacingMd}"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource CornerRadiusSm}"
                            Margin="{StaticResource MarginSectionBottom}">
                        <StackPanel>
                            <TextBlock x:Name="LblAlgorithms" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="{StaticResource MarginLabelBottom}"/>
                            <ItemsControl x:Name="AlgorithmsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Category}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontFamily="{StaticResource FontFamilyMonospace}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Note}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Rating}" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{Binding Brush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Recommended sshd_config -->
                    <Border Padding="{StaticResource SpacingMd}"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource CornerRadiusSm}">
                        <StackPanel>
                            <TextBlock x:Name="LblRecommendation" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="{StaticResource MarginLabelBottom}"/>
                            <TextBox x:Name="TxtRecommendation"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     FontFamily="{StaticResource FontFamilyMonospace}"
                                     FontSize="{StaticResource FontSizeCaption}"
                                     Background="{DynamicResource CardBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     Padding="{StaticResource PaddingInput}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
