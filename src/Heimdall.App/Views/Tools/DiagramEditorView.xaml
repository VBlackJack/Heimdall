<UserControl x:Class="Heimdall.App.Views.Tools.DiagramEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900"
             Background="{DynamicResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--
            Header. File actions live behind one menu button rather than as
            fifteen buttons in a row: the row already scrolled horizontally in
            French, and the tool gained templates, a scan merge and printing.
        -->
        <Border Grid.Row="0" Padding="{StaticResource ToolHeaderPadding}" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button x:Name="BtnHelp" DockPanel.Dock="Right" Content="?" Click="OnHelpClick"
                        Style="{DynamicResource ToolHelpButtonStyle}"
                        Padding="{StaticResource PaddingButtonHelp}" FontSize="{StaticResource FontSizeBody}" FontWeight="Bold"
                        Margin="{StaticResource MarginInlineControl}"
                        TabIndex="11"/>
                <!-- Current document name, with a modified marker when the editor holds unsaved work -->
                <TextBlock x:Name="TxtDocumentName" DockPanel.Dock="Right" Text=""
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Margin="{StaticResource MarginInlineControl}"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="HeaderTitle" Text="" FontSize="{StaticResource FontSizeSubtitle}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Button x:Name="BtnFile" Content="" Click="OnFileMenuClick"
                                Style="{DynamicResource SecondaryButtonStyle}" Padding="{StaticResource PaddingButtonToolbar}" Margin="{StaticResource MarginToolbarGroup}" FontSize="{StaticResource FontSizeCaption}"
                                TabIndex="0"/>
                        <Button x:Name="BtnSave" Content="" Click="OnSaveClick"
                                Style="{DynamicResource PrimaryButtonStyle}" Padding="{StaticResource PaddingButtonToolbar}" Margin="{StaticResource MarginInlineXs}" FontSize="{StaticResource FontSizeCaption}"
                                TabIndex="1"/>
                        <Button x:Name="BtnInsertLine" Content="" Click="OnInsertLineClick"
                                Style="{DynamicResource SecondaryButtonStyle}" Padding="{StaticResource PaddingButtonToolbar}" Margin="{StaticResource MarginToolbarGroup}" FontSize="{StaticResource FontSizeCaption}"
                                TabIndex="2"/>
                        <Button x:Name="BtnFormat" Content="" Click="OnFormatClick"
                                Style="{DynamicResource SecondaryButtonStyle}" Padding="{StaticResource PaddingButtonToolbar}" Margin="{StaticResource MarginInlineXs}" FontSize="{StaticResource FontSizeCaption}"
                                TabIndex="3"/>
                        <Button x:Name="BtnUndo" Content="" Click="OnUndoClick"
                                Style="{DynamicResource SecondaryButtonStyle}" Padding="{StaticResource PaddingButtonToolbar}" Margin="{StaticResource MarginToolbarGroup}" FontSize="{StaticResource FontSizeCaption}"
                                TabIndex="4"/>
                        <Button x:Name="BtnRedo" Content="" Click="OnRedoClick"
                                Style="{DynamicResource SecondaryButtonStyle}" Padding="{StaticResource PaddingButtonToolbar}" Margin="{StaticResource MarginInlineXs}" FontSize="{StaticResource FontSizeCaption}"
                                TabIndex="5"/>
                        <Button x:Name="BtnZoomOut" Content="" Click="OnZoomOutClick"
                                Style="{DynamicResource SecondaryButtonStyle}" Padding="{StaticResource PaddingButtonToolbar}" Margin="{StaticResource MarginInlineXs}" FontSize="{StaticResource FontSizeCaption}"
                                TabIndex="6"/>
                        <Button x:Name="BtnActualSize" Content="" Click="OnActualSizeClick"
                                Style="{DynamicResource SecondaryButtonStyle}" Padding="{StaticResource PaddingButtonToolbar}" Margin="{StaticResource MarginInlineXs}" FontSize="{StaticResource FontSizeCaption}"
                                TabIndex="7"/>
                        <Button x:Name="BtnZoomIn" Content="" Click="OnZoomInClick"
                                Style="{DynamicResource SecondaryButtonStyle}" Padding="{StaticResource PaddingButtonToolbar}" Margin="{StaticResource MarginInlineXs}" FontSize="{StaticResource FontSizeCaption}"
                                TabIndex="8"/>
                        <Button x:Name="BtnDuplicate" Content="" Click="OnDuplicateClick"
                                Style="{DynamicResource SecondaryButtonStyle}" Padding="{StaticResource PaddingButtonToolbar}" Margin="{StaticResource MarginInlineXs}" FontSize="{StaticResource FontSizeCaption}"
                                TabIndex="9"/>
                        <Button x:Name="BtnDelete" Content="" Click="OnDeleteClick"
                                Style="{DynamicResource SecondaryButtonStyle}" Padding="{StaticResource PaddingButtonToolbar}" FontSize="{StaticResource FontSizeCaption}"
                                TabIndex="10"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Help panel -->
        <Border x:Name="HelpPanel" Grid.Row="1" Style="{StaticResource ToolHelpPanelStyle}">
            <DockPanel>
                <Button x:Name="BtnCloseHelp" DockPanel.Dock="Right" Content="&#xE711;"
                        FontFamily="{StaticResource FontFamilyIcons}" FontSize="{StaticResource FontSizeBody}"
                        Click="OnCloseHelpClick"
                        Style="{DynamicResource ToolCloseHelpButtonStyle}"
                        VerticalAlignment="Top"
                        TabIndex="12"/>
                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TxtHelpContent" Text="" TextWrapping="Wrap"
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               LineHeight="20"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Inline status and error surface for open, save, merge and export -->
        <TextBlock x:Name="TxtError" Grid.Row="2" Text=""
                   Style="{StaticResource ToolInlineErrorTextStyle}"
                   Visibility="Collapsed"/>

        <!-- WebView2 hosting draw.io via iframe -->
        <wv2:WebView2 Grid.Row="3" x:Name="DiagramWebView" Focusable="True"/>

        <!-- Fallback if WebView2 unavailable -->
        <Border Grid.Row="3" x:Name="FallbackPanel" Visibility="Collapsed"
                Background="{DynamicResource BackgroundBrush}" Padding="{StaticResource PaddingEmptyStatePanel}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                <TextBlock x:Name="FallbackTitle" FontSize="{StaticResource FontSizeDisplay}" FontWeight="SemiBold"
                           TextAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock x:Name="FallbackMessage" FontSize="{StaticResource FontSizeBody}" Margin="{StaticResource MarginSectionTop}"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
