<UserControl x:Class="Heimdall.App.Views.Tools.PasswordGeneratorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             Background="{DynamicResource BackgroundBrush}"
             KeyDown="OnKeyDown">
    <UserControl.Resources>
        <!--
            The readouts sit in a second column while the panel is wide enough for two, and drop
            back under the generator when it is not. A tool can be opened into a split pane a
            third of the screen wide, and a column that narrow would cut the phonetic reading to
            one word a line. The width that decides is the panel's own, not the window's.

            Nothing is hidden either way. That is the difference between a second column and a
            second tab: a reading of the password, the syllables it was built from and the batch
            it came in are all about the password on screen, and a setting or a reading that is
            in effect but out of sight is how a generator ends up lying to the person using it.
        -->
        <Style x:Key="PasswordDetailPaneStyle" TargetType="StackPanel">
            <Setter Property="Grid.Row" Value="0"/>
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="MinWidth" Value="280"/>
            <Setter Property="MaxWidth" Value="380"/>
            <Setter Property="Margin" Value="24,0,0,0"/>
            <Style.Triggers>
                <DataTrigger Value="True"
                             Binding="{Binding ActualWidth,
                                               RelativeSource={RelativeSource AncestorType=Grid},
                                               Converter={StaticResource NarrowPaneConverter}}">
                    <Setter Property="Grid.Row" Value="1"/>
                    <Setter Property="Grid.Column" Value="0"/>
                    <Setter Property="MaxWidth" Value="{x:Static sys:Double.PositiveInfinity}"/>
                    <Setter Property="Margin" Value="0,16,0,0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PlacementCursorStyle" TargetType="Thumb">
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="CursorBody" CornerRadius="{StaticResource CornerRadiusSm}"
                                Background="{DynamicResource AccentBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CursorBody" Property="BorderBrush"
                                        Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter TargetName="CursorBody" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="{StaticResource ToolHeaderPadding}"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <Button x:Name="BtnHelp" DockPanel.Dock="Right" Content="?"
                        TabIndex="9"
                        Click="OnHelpClick"
                        Style="{DynamicResource ToolHelpButtonStyle}"
                        Padding="{StaticResource PaddingButtonHelp}" FontSize="{StaticResource FontSizeBody}" FontWeight="Bold"
                        Margin="{StaticResource MarginInlineControl}"/>
                <TextBlock x:Name="HeaderTitle" FontSize="{StaticResource FontSizeSubtitle}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Help panel -->
        <Border x:Name="HelpPanel" Grid.Row="1" Style="{StaticResource ToolHelpPanelStyle}">
            <DockPanel>
                <Button x:Name="BtnCloseHelp" DockPanel.Dock="Right" Content="&#xE711;"
                        FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource FontSizeBody}"
                        Click="OnCloseHelpClick"
                        Style="{DynamicResource ToolCloseHelpButtonStyle}"
                        VerticalAlignment="Top"/>
                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TxtHelpContent" Text="" TextWrapping="Wrap"
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               LineHeight="20"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid x:Name="GeneratorBody" Margin="{StaticResource ContentAreaMargin}">
        <Grid.ColumnDefinitions>
            <!-- The generator's own minimum is the widest row it has to lay out, which is the
                 minimum strength and the count on one line. Without it the readouts, being an
                 Auto column, would be served first and leave the sliders as stubs -->
            <ColumnDefinition Width="*" MinWidth="560"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><!-- Row 0: Mode selector -->
                <RowDefinition Height="Auto"/><!-- Row 1: Password output -->
                <RowDefinition Height="Auto"/><!-- Row 2: Strength, crack time and notices -->
                <RowDefinition Height="Auto"/><!-- Row 3: Mode-specific options -->
                <RowDefinition Height="Auto"/><!-- Row 4: Case block pattern -->
                <RowDefinition Height="Auto"/><!-- Row 5: Minimum strength and how many -->
                <RowDefinition Height="Auto"/><!-- Row 6: Presets -->
                <RowDefinition Height="Auto"/><!-- Row 7: Advanced options -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ROW 0: Mode selector ComboBox -->
            <StackPanel Grid.Row="0" Margin="{StaticResource MarginSectionBottom}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ModeLabel"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" Margin="{StaticResource MarginInlineSm}"/>
                    <ComboBox x:Name="CmbMode" Width="160"
                              TabIndex="0"
                              SelectedIndex="{Binding SelectedModeIndex, Mode=TwoWay}"
                              Background="{DynamicResource CardBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
                <TextBlock x:Name="ModeDescription"
                           FontSize="{StaticResource FontSizeCaption}" Margin="0,2,0,8"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>

            <!-- ROW 1: Password output with overlaid regenerate/copy buttons -->
            <StackPanel Grid.Row="1" Margin="{StaticResource MarginLabelBottom}">
                <Border Padding="{StaticResource SpacingSm}"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource CornerRadiusSm}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PasswordOutput" Grid.Column="0"
                                 TabIndex="1"
                                 IsReadOnly="True" Focusable="True"
                                 Text="{Binding GeneratedPassword, Mode=OneWay}"
                                 TextWrapping="Wrap"
                                 FontFamily="Consolas" FontSize="{StaticResource FontSizeLarge}"
                                 Background="Transparent"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderThickness="0"
                                 VerticalAlignment="Center"
                                 AutomationProperties.LiveSetting="Polite"
                                 GotFocus="OnPasswordOutputGotFocus"/>
                        <StackPanel Grid.Column="1" Orientation="Vertical"
                                    VerticalAlignment="Center" Margin="{StaticResource MarginInlineControl}">
                            <Button x:Name="BtnRegenerate" Command="{Binding GenerateCoreCommand}"
                                    TabIndex="2"
                                    Style="{DynamicResource PrimaryButtonStyle}"
                                    Padding="{StaticResource PaddingButtonCopy}" Margin="{StaticResource MarginLabelBottom}" FontSize="{StaticResource FontSizeCaption}"/>
                            <Button x:Name="BtnCopy" Click="OnCopyClick"
                                    TabIndex="3"
                                    Style="{DynamicResource SecondaryButtonStyle}"
                                    Padding="{StaticResource PaddingButtonCopy}" FontSize="{StaticResource FontSizeCaption}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock x:Name="KeyboardHintText"
                           FontSize="{StaticResource FontSizeSmallCaption}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Right" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- ROW 2: Strength indicator + Phonetic -->
            <StackPanel Grid.Row="2" Margin="{StaticResource MarginSectionSeparator}">
                <Border x:Name="StrengthBarBorder" Height="10" CornerRadius="{StaticResource CornerRadiusSm}" Background="{DynamicResource CardBrush}"
                        Visibility="{Binding ShowStrength, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="StrengthBarFillColumn" Width="0*"/>
                            <ColumnDefinition x:Name="StrengthBarEmptyColumn" Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="{StaticResource CornerRadiusSm}" x:Name="StrengthBar"
                                Background="{DynamicResource ErrorBrush}"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="StrengthLabel"
                           Text="{Binding StrengthText}"
                           Visibility="{Binding ShowStrength, Converter={StaticResource BoolToVisibilityConverter}}"
                           FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Margin="0,4,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           AutomationProperties.LiveSetting="Polite"/>
                <DockPanel Margin="0,2,0,0">
                    <TextBlock x:Name="CrackTimeText"
                               Text="{Binding CrackTimeText}"
                               FontSize="{StaticResource FontSizeCaption}" DockPanel.Dock="Right"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock x:Name="StrengthIssues"
                               Text="{Binding IssuesText}"
                               FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                               Foreground="{DynamicResource WarningTextBrush}"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"/>
                </DockPanel>

                <!-- The attack the crack time is worked out against, on its own line so that a figure
                     nobody can read without it is never shown without it -->
                <TextBlock x:Name="CrackTimeAssumptionText"
                           Text="{Binding CrackTimeAssumptionText}"
                           HorizontalAlignment="Right" TextAlignment="Right"
                           FontSize="{StaticResource FontSizeSmallCaption}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Opacity="0.85"/>

                <!-- What the minimum strength did, when it did anything -->
                <TextBlock x:Name="FloorNoticeText" Margin="0,2,0,0"
                           Text="{Binding FloorNoticeText}"
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Visibility="{Binding ShowFloorNotice, Converter={StaticResource BoolToVisibilityConverter}}"
                           AutomationProperties.LiveSetting="Polite"/>

            </StackPanel>

            <!-- ROW 3: Mode-specific core options -->
            <Grid Grid.Row="3" Margin="{StaticResource MarginSectionBottom}">

                <!-- RANDOM mode panel -->
                <StackPanel x:Name="PanelRandom"
                            Visibility="{Binding IsRandomMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <!-- Quick length buttons -->
                    <WrapPanel x:Name="QuickLengthPanel" Orientation="Horizontal" Margin="{StaticResource MarginStackItem}">
                        <TextBlock x:Name="QuickLengthLabel" FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="{StaticResource MarginInlineSm}"/>
                        <Button x:Name="BtnLen8" Content="8" Click="OnQuickLength" Tag="8"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Padding="{StaticResource PaddingButtonPreset}" Margin="{StaticResource MarginInlineXs}" FontSize="{StaticResource FontSizeCaption}" MinWidth="32"/>
                        <Button x:Name="BtnLen12" Content="12" Click="OnQuickLength" Tag="12"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Padding="{StaticResource PaddingButtonPreset}" Margin="{StaticResource MarginInlineXs}" FontSize="{StaticResource FontSizeCaption}" MinWidth="32"/>
                        <Button x:Name="BtnLen16" Content="16" Click="OnQuickLength" Tag="16"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Padding="{StaticResource PaddingButtonPreset}" Margin="{StaticResource MarginInlineXs}" FontSize="{StaticResource FontSizeCaption}" MinWidth="32"/>
                        <Button x:Name="BtnLen24" Content="24" Click="OnQuickLength" Tag="24"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Padding="{StaticResource PaddingButtonPreset}" Margin="{StaticResource MarginInlineXs}" FontSize="{StaticResource FontSizeCaption}" MinWidth="32"/>
                        <Button x:Name="BtnLen32" Content="32" Click="OnQuickLength" Tag="32"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Padding="{StaticResource PaddingButtonPreset}" Margin="{StaticResource MarginInlineXs}" FontSize="{StaticResource FontSizeCaption}" MinWidth="32"/>
                        <Button x:Name="BtnLen64" Content="64" Click="OnQuickLength" Tag="64"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Padding="{StaticResource PaddingButtonPreset}" Margin="{StaticResource MarginInlineXs}" FontSize="{StaticResource FontSizeCaption}" MinWidth="32"/>
                    </WrapPanel>
                    <!-- Length slider -->
                    <DockPanel Margin="{StaticResource MarginSectionBottom}">
                        <TextBlock x:Name="LengthLabel"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" MinWidth="90"/>
                        <TextBlock x:Name="LengthValueText"
                                   Text="{Binding Length}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontWeight="SemiBold" FontSize="{StaticResource FontSizeSubtitle}"
                                   VerticalAlignment="Center" Width="40"
                                   TextAlignment="Center" DockPanel.Dock="Right"/>
                        <Slider x:Name="LengthSlider"
                                TabIndex="4"
                                Minimum="4" Maximum="128"
                                Value="{Binding Length, Mode=TwoWay}"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                VerticalAlignment="Center"/>
                    </DockPanel>
                    <!-- 2-column checkbox grid -->
                    <Grid Margin="{StaticResource MarginLabelBottom}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <CheckBox x:Name="ChkUppercase" IsChecked="{Binding IncludeUppercase, Mode=TwoWay}"
                                  TabIndex="5"
                                  Grid.Row="0" Grid.Column="0" Margin="0,0,16,8"
                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <CheckBox x:Name="ChkLowercase" IsChecked="{Binding IncludeLowercase, Mode=TwoWay}"
                                  TabIndex="6"
                                  Grid.Row="0" Grid.Column="1" Margin="0,0,16,8"
                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <CheckBox x:Name="ChkDigits" IsChecked="{Binding IncludeDigits, Mode=TwoWay}"
                                  TabIndex="7"
                                  Grid.Row="1" Grid.Column="0" Margin="0,0,16,8"
                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <CheckBox x:Name="ChkSymbols" IsChecked="{Binding IncludeSymbols, Mode=TwoWay}"
                                  TabIndex="8"
                                  Grid.Row="1" Grid.Column="1" Margin="0,0,16,8"
                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Grid>
                </StackPanel>

                <!-- SYLLABLE mode panel -->
                <StackPanel x:Name="PanelSyllable"
                            Visibility="{Binding IsSyllableMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <!-- Base length slider -->
                    <DockPanel Margin="{StaticResource MarginStackItem}">
                        <TextBlock x:Name="SylLengthLabel"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" MinWidth="110"/>
                        <TextBlock x:Name="SylTotalLengthText"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="{StaticResource FontSizeCaption}" VerticalAlignment="Center"
                                   Margin="{StaticResource MarginInlineControl}" DockPanel.Dock="Right"/>
                        <TextBlock x:Name="SylLengthValueText"
                                   Text="{Binding SyllableLength}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontWeight="SemiBold" FontSize="{StaticResource FontSizeSubtitle}"
                                   VerticalAlignment="Center" Width="40"
                                   TextAlignment="Center" DockPanel.Dock="Right"/>
                        <Slider x:Name="SylLengthSlider"
                                Minimum="8" Maximum="32"
                                Value="{Binding SyllableLength, Mode=TwoWay}"
                                IsSnapToTickEnabled="True" TickFrequency="2"
                                VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="SylStepNote"
                               FontSize="{StaticResource FontSizeSmallCaption}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="80,0,0,4"/>
                    <!-- Separator + Case on same row -->
                    <Grid Margin="{StaticResource MarginSectionBottom}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SylSeparatorLabel" Grid.Column="0"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="{StaticResource MarginInlineSm}"/>
                        <TextBox x:Name="TxtSylSeparator" Grid.Column="1" Width="60" MaxLength="4"
                                 Text="{Binding SyllableSeparator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas" FontSize="{StaticResource FontSizeBodyLarge}"
                                 Padding="{StaticResource PaddingInput}"
                                 Background="{DynamicResource CardBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"/>
                        <TextBlock x:Name="SylCaseLabel" Grid.Column="3"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="{StaticResource MarginInlineSm}"/>
                        <ComboBox x:Name="CmbSylCase" Grid.Column="4" Width="140"
                                  SelectedIndex="{Binding SyllableCaseIndex, Mode=TwoWay}"
                                  Background="{DynamicResource CardBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Grid>
                    <!-- CVC checkbox -->
                    <CheckBox x:Name="ChkSylCvc" IsChecked="{Binding SyllableCvc, Mode=TwoWay}" Margin="{StaticResource MarginLabelBottom}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Checked="OnSylCvcChanged" Unchecked="OnSylCvcChanged"/>
                    <TextBlock x:Name="SylCvcHint"
                               FontSize="{StaticResource FontSizeSmallCaption}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="20,0,0,8"/>
                    <!-- Digits + Specials sliders side by side -->
                    <Grid Margin="{StaticResource MarginSectionBottom}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0">
                            <TextBlock x:Name="SylDigitsLabel"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" MinWidth="95"/>
                            <TextBlock x:Name="SylDigitsValueText"
                                       Text="{Binding SyllableDigits}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontWeight="SemiBold" FontSize="{StaticResource FontSizeSubtitle}"
                                       VerticalAlignment="Center" Width="30"
                                       TextAlignment="Center" DockPanel.Dock="Right"/>
                            <Slider x:Name="SylDigitsSlider"
                                    Minimum="0" Maximum="6"
                                    Value="{Binding SyllableDigits, Mode=TwoWay}"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    VerticalAlignment="Center"/>
                        </DockPanel>
                        <DockPanel Grid.Column="2">
                            <TextBlock x:Name="SylSpecialsLabel"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" MinWidth="120"/>
                            <TextBlock x:Name="SylSpecialsValueText"
                                       Text="{Binding SyllableSpecials}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontWeight="SemiBold" FontSize="{StaticResource FontSizeSubtitle}"
                                       VerticalAlignment="Center" Width="30"
                                       TextAlignment="Center" DockPanel.Dock="Right"/>
                            <Slider x:Name="SylSpecialsSlider"
                                    Minimum="0" Maximum="6"
                                    Value="{Binding SyllableSpecials, Mode=TwoWay}"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    VerticalAlignment="Center"/>
                        </DockPanel>
                    </Grid>
                    <!-- Inline placement (visible when digits+specials > 0) -->
                    <StackPanel x:Name="SylPlacementPanel" Orientation="Horizontal" Margin="{StaticResource MarginStackItem}"
                                Visibility="{Binding ShowSyllablePlacement, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock x:Name="SylPlacementLabel"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="{StaticResource MarginInlineSm}"/>
                        <ComboBox x:Name="CmbSylPlacement" Width="140"
                                  SelectedIndex="{Binding SyllablePlacementIndex, Mode=TwoWay}"
                                  Background="{DynamicResource CardBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- PASSPHRASE mode panel -->
                <StackPanel x:Name="PanelPassphrase"
                            Visibility="{Binding IsPassphraseMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <!-- Word count slider -->
                    <DockPanel Margin="{StaticResource MarginSectionBottom}">
                        <TextBlock x:Name="PpWordCountLabel"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" MinWidth="130"/>
                        <TextBlock x:Name="PpWordCountValueText"
                                   Text="{Binding PassphraseWordCount}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontWeight="SemiBold" FontSize="{StaticResource FontSizeSubtitle}"
                                   VerticalAlignment="Center" Width="40"
                                   TextAlignment="Center" DockPanel.Dock="Right"/>
                        <Slider x:Name="PpWordCountSlider"
                                Minimum="2" Maximum="8"
                                Value="{Binding PassphraseWordCount, Mode=TwoWay}"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                VerticalAlignment="Center"/>
                    </DockPanel>
                    <!-- Separator + Language on same row -->
                    <Grid Margin="{StaticResource MarginSectionBottom}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PpSeparatorLabel" Grid.Column="0"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="{StaticResource MarginInlineSm}"/>
                        <TextBox x:Name="TxtPpSeparator" Grid.Column="1" Width="60" MaxLength="4"
                                 Text="{Binding PassphraseSeparator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas" FontSize="{StaticResource FontSizeBodyLarge}"
                                 Padding="{StaticResource PaddingInput}"
                                 Background="{DynamicResource CardBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"/>
                        <TextBlock x:Name="PpLanguageLabel" Grid.Column="3"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="{StaticResource MarginInlineSm}"/>
                        <ComboBox x:Name="CmbPpLanguage" Grid.Column="4" Width="140"
                                  SelectedIndex="{Binding PassphraseLanguageIndex, Mode=TwoWay}"
                                  Background="{DynamicResource CardBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <!-- What this language is worth a word, where the language is chosen -->
                        <TextBlock x:Name="PpWordListSummary" Grid.Column="5"
                                   Text="{Binding WordListSummaryText}"
                                   FontSize="{StaticResource FontSizeSmallCaption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                    <!-- Case -->
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource MarginSectionBottom}">
                        <TextBlock x:Name="PpCaseLabel"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="{StaticResource MarginInlineSm}"/>
                        <ComboBox x:Name="CmbPpCase" Width="140"
                                  SelectedIndex="{Binding PassphraseCaseIndex, Mode=TwoWay}"
                                  Background="{DynamicResource CardBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <!-- Digits + Specials sliders side by side -->
                    <Grid Margin="{StaticResource MarginSectionBottom}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0">
                            <TextBlock x:Name="PpDigitsLabel"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" MinWidth="95"/>
                            <TextBlock x:Name="PpDigitsValueText"
                                       Text="{Binding PassphraseDigits}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontWeight="SemiBold" FontSize="{StaticResource FontSizeSubtitle}"
                                       VerticalAlignment="Center" Width="30"
                                       TextAlignment="Center" DockPanel.Dock="Right"/>
                            <Slider x:Name="PpDigitsSlider"
                                    Minimum="0" Maximum="6"
                                    Value="{Binding PassphraseDigits, Mode=TwoWay}"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    VerticalAlignment="Center"/>
                        </DockPanel>
                        <DockPanel Grid.Column="2">
                            <TextBlock x:Name="PpSpecialsLabel"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" MinWidth="120"/>
                            <TextBlock x:Name="PpSpecialsValueText"
                                       Text="{Binding PassphraseSpecials}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontWeight="SemiBold" FontSize="{StaticResource FontSizeSubtitle}"
                                       VerticalAlignment="Center" Width="30"
                                       TextAlignment="Center" DockPanel.Dock="Right"/>
                            <Slider x:Name="PpSpecialsSlider"
                                    Minimum="0" Maximum="6"
                                    Value="{Binding PassphraseSpecials, Mode=TwoWay}"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    VerticalAlignment="Center"/>
                        </DockPanel>
                    </Grid>
                    <!-- Inline placement (visible when digit or special checked) -->
                    <StackPanel x:Name="PpPlacementPanel" Orientation="Horizontal" Margin="{StaticResource MarginStackItem}"
                                Visibility="{Binding ShowPassphrasePlacement, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock x:Name="PpPlacementLabel"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="{StaticResource MarginInlineSm}"/>
                        <ComboBox x:Name="CmbPpPlacement" Width="140"
                                  SelectedIndex="{Binding PassphrasePlacementIndex, Mode=TwoWay}"
                                  Background="{DynamicResource CardBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- LEET mode panel -->
                <StackPanel x:Name="PanelLeet"
                            Visibility="{Binding IsLeetMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <!-- Where the word comes from -->
                    <CheckBox x:Name="ChkLeetRandomWord" IsChecked="{Binding LeetRandomWord, Mode=TwoWay}"
                              Margin="{StaticResource MarginLabelBottom}"
                              Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Grid Margin="{StaticResource MarginSectionBottom}"
                          Visibility="{Binding ShowLeetBaseWord, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LeetWordLabel" Grid.Column="0"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="{StaticResource MarginInlineSm}"/>
                        <TextBox x:Name="TxtLeetWord" Grid.Column="1" MaxLength="32"
                                 Text="{Binding LeetBaseWord, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas" FontSize="{StaticResource FontSizeBodyLarge}"
                                 Padding="{StaticResource PaddingInput}"
                                 Background="{DynamicResource CardBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"/>
                    </Grid>
                    <!-- Language of the drawn word -->
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource MarginSectionBottom}"
                                Visibility="{Binding LeetRandomWord, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock x:Name="LeetLanguageLabel"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="{StaticResource MarginInlineSm}"/>
                        <ComboBox x:Name="CmbLeetLanguage" Width="140"
                                  SelectedIndex="{Binding PassphraseLanguageIndex, Mode=TwoWay}"
                                  Background="{DynamicResource CardBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="LeetWordListSummary"
                                   Text="{Binding WordListSummaryText}"
                                   FontSize="{StaticResource FontSizeSmallCaption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <!-- Substitution depth -->
                    <CheckBox x:Name="ChkLeetFullSubstitution" IsChecked="{Binding LeetFullSubstitution, Mode=TwoWay}"
                              Margin="{StaticResource MarginLabelBottom}"
                              Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <!-- Case -->
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource MarginSectionBottom}">
                        <TextBlock x:Name="LeetCaseLabel"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="{StaticResource MarginInlineSm}"/>
                        <ComboBox x:Name="CmbLeetCase" Width="140"
                                  SelectedIndex="{Binding LeetCaseIndex, Mode=TwoWay}"
                                  Background="{DynamicResource CardBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <!-- Digits + Specials sliders side by side -->
                    <Grid Margin="{StaticResource MarginSectionBottom}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0">
                            <TextBlock x:Name="LeetDigitsLabel"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" MinWidth="95"/>
                            <TextBlock x:Name="LeetDigitsValueText"
                                       Text="{Binding LeetDigits}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontWeight="SemiBold" FontSize="{StaticResource FontSizeSubtitle}"
                                       VerticalAlignment="Center" Width="30"
                                       TextAlignment="Center" DockPanel.Dock="Right"/>
                            <Slider x:Name="LeetDigitsSlider"
                                    Minimum="0" Maximum="6"
                                    Value="{Binding LeetDigits, Mode=TwoWay}"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    VerticalAlignment="Center"/>
                        </DockPanel>
                        <DockPanel Grid.Column="2">
                            <TextBlock x:Name="LeetSpecialsLabel"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" MinWidth="120"/>
                            <TextBlock x:Name="LeetSpecialsValueText"
                                       Text="{Binding LeetSpecials}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontWeight="SemiBold" FontSize="{StaticResource FontSizeSubtitle}"
                                       VerticalAlignment="Center" Width="30"
                                       TextAlignment="Center" DockPanel.Dock="Right"/>
                            <Slider x:Name="LeetSpecialsSlider"
                                    Minimum="0" Maximum="6"
                                    Value="{Binding LeetSpecials, Mode=TwoWay}"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    VerticalAlignment="Center"/>
                        </DockPanel>
                    </Grid>
                    <!-- Inline placement (visible when digits or specials > 0) -->
                    <StackPanel x:Name="LeetPlacementPanel" Orientation="Horizontal" Margin="{StaticResource MarginStackItem}"
                                Visibility="{Binding ShowLeetPlacement, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock x:Name="LeetPlacementLabel"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="{StaticResource MarginInlineSm}"/>
                        <ComboBox x:Name="CmbLeetPlacement" Width="140"
                                  SelectedIndex="{Binding LeetPlacementIndex, Mode=TwoWay}"
                                  Background="{DynamicResource CardBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <!-- The word the generator drew, so the operator can read it back -->
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource MarginStackItem}"
                                Visibility="{Binding ShowLeetWordSource, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock x:Name="LeetWordSourceLabel"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="{StaticResource MarginInlineSm}"/>
                        <TextBlock x:Name="LeetWordSourceText" Text="{Binding LeetWordSource}"
                                   FontFamily="Consolas" FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ROW 4: Case block pattern and placement bar, each shown by its own mode -->
            <StackPanel Grid.Row="4">
            <StackPanel x:Name="PanelCaseBlocks" Margin="{StaticResource MarginSectionBottom}"
                        Visibility="{Binding ShowCaseBlocks, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel Margin="{StaticResource MarginLabelBottom}">
                    <TextBlock x:Name="CaseBlocksHint" DockPanel.Dock="Right"
                               FontSize="{StaticResource FontSizeSmallCaption}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="CaseBlocksLabel"
                               FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </DockPanel>
                <WrapPanel x:Name="CaseBlocksPanel" Orientation="Horizontal"
                           Margin="{StaticResource MarginStackItem}"/>
                <WrapPanel Orientation="Horizontal" Margin="{StaticResource MarginStackItem}">
                    <Button x:Name="BtnCaseBlockRemove" Style="{DynamicResource SecondaryButtonStyle}" Click="OnCaseBlockRemove" Content="-"
                            Padding="{StaticResource PaddingButtonPreset}" Margin="0,0,6,4" MinWidth="32"
                            FontSize="{StaticResource FontSizeCaption}"/>
                    <Button x:Name="BtnCaseBlockAdd" Style="{DynamicResource SecondaryButtonStyle}" Click="OnCaseBlockAdd" Content="+"
                            Padding="{StaticResource PaddingButtonPreset}" Margin="0,0,12,4" MinWidth="32"
                            FontSize="{StaticResource FontSizeCaption}"/>
                    <Button x:Name="BtnCaseBlocksRandom" Style="{DynamicResource SecondaryButtonStyle}" Click="OnCaseBlocksRandom"
                            Padding="{StaticResource PaddingButtonPreset}" Margin="0,0,12,4"
                            FontSize="{StaticResource FontSizeCaption}"/>
                    <Button x:Name="BtnCaseBlocksAllUpper" Style="{DynamicResource SecondaryButtonStyle}" Click="OnCaseBlocksAllUpper" Content="UUU"
                            Padding="{StaticResource PaddingButtonPreset}" Margin="0,0,6,4"
                            FontFamily="Consolas" FontSize="{StaticResource FontSizeCaption}"/>
                    <Button x:Name="BtnCaseBlocksAllLower" Style="{DynamicResource SecondaryButtonStyle}" Click="OnCaseBlocksAllLower" Content="lll"
                            Padding="{StaticResource PaddingButtonPreset}" Margin="0,0,6,4"
                            FontFamily="Consolas" FontSize="{StaticResource FontSizeCaption}"/>
                    <Button x:Name="BtnCaseBlocksAllTitle" Style="{DynamicResource SecondaryButtonStyle}" Click="OnCaseBlocksAllTitle" Content="TTT"
                            Padding="{StaticResource PaddingButtonPreset}" Margin="0,0,12,4"
                            FontFamily="Consolas" FontSize="{StaticResource FontSizeCaption}"/>
                    <CheckBox x:Name="ChkCaseBlocksAutoSync" IsChecked="{Binding CaseBlocksAutoSync, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="0,0,0,4"
                              Visibility="{Binding ShowCaseBlocksAutoSync, Converter={StaticResource BoolToVisibilityConverter}}"
                              Foreground="{DynamicResource TextPrimaryBrush}"/>
                </WrapPanel>
            </StackPanel>

                <!-- Placement bar, shown when a mode places its extras by position -->
                <!-- The two rows read the same 0-100 scale, so their tracks have to start at
                     the same place and be the same length. Two grids cannot agree on an Auto
                     column by themselves; a shared size scope is what makes them, in any
                     language, without anyone choosing a number in pixels -->
                <StackPanel x:Name="PanelPlacementBar" Margin="{StaticResource MarginSectionBottom}"
                            Grid.IsSharedSizeScope="True"
                            Visibility="{Binding ShowPlacementBar, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DockPanel Margin="{StaticResource MarginLabelBottom}">
                        <TextBlock x:Name="PlacementBarHint" DockPanel.Dock="Right"
                                   FontSize="{StaticResource FontSizeSmallCaption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="PlacementBarLabel"
                                   FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <Grid x:Name="PlacementDigitsRow" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="PlacementLabel"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PlacementDigitsLabel" Grid.Column="0"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Height="30" CornerRadius="{StaticResource CornerRadiusSm}"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Canvas x:Name="PlacementDigitsTrack" ClipToBounds="True"
                                    Background="Transparent"/>
                        </Border>
                    </Grid>
                    <Grid x:Name="PlacementSpecialsRow" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="PlacementLabel"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PlacementSpecialsLabel" Grid.Column="0"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Height="30" CornerRadius="{StaticResource CornerRadiusSm}"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Canvas x:Name="PlacementSpecialsTrack" ClipToBounds="True"
                                    Background="Transparent"/>
                        </Border>
                    </Grid>
                    <Button x:Name="BtnPlacementDistribute" Style="{DynamicResource SecondaryButtonStyle}" Click="OnPlacementDistribute"
                            HorizontalAlignment="Left"
                            Padding="{StaticResource PaddingButtonPreset}" Margin="0,4,0,0"
                            FontSize="{StaticResource FontSizeCaption}"/>
                </StackPanel>
            </StackPanel>

            <!-- ROW 5: what is asked of the generator - the floor, and how many passwords -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock x:Name="EntropyFloorLabel"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="{StaticResource MarginInlineSm}"/>
                <ComboBox x:Name="CmbEntropyFloor" MinWidth="120"
                          SelectedIndex="{Binding EntropyFloorIndex, Mode=TwoWay}"
                          Background="{DynamicResource CardBrush}"
                          Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock x:Name="BatchCountLabel"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="24,0,8,0"/>
                <TextBlock x:Name="BatchCountValueText"
                           Text="{Binding BatchCount}"
                           Foreground="{DynamicResource AccentBrush}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" MinWidth="24" TextAlignment="Center"/>
                <Slider x:Name="BatchCountSlider" Width="160"
                        Minimum="1" Maximum="20"
                        Value="{Binding BatchCount, Mode=TwoWay}"
                        IsSnapToTickEnabled="True" TickFrequency="1"
                        VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>

            <!-- ROW 6: Presets filtered by mode -->
            <StackPanel x:Name="PanelPresets" Grid.Row="6" Margin="{StaticResource MarginSectionBottom}">
                <TextBlock x:Name="PresetsLabel"
                           FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="{StaticResource MarginLabelBottom}"/>
                <!-- Random presets -->
                <WrapPanel x:Name="PresetsRandom" Orientation="Horizontal"
                           Visibility="{Binding IsRandomMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button x:Name="BtnPresetPin4" Click="OnPresetPin4"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Padding="{StaticResource PaddingButtonPreset}" Margin="0,0,6,4" FontSize="{StaticResource FontSizeCaption}"/>
                    <Button x:Name="BtnPresetPin6" Click="OnPresetPin6"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Padding="{StaticResource PaddingButtonPreset}" Margin="0,0,6,4" FontSize="{StaticResource FontSizeCaption}"/>
                    <Button x:Name="BtnPresetWifi" Click="OnPresetWifi"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Padding="{StaticResource PaddingButtonPreset}" Margin="0,0,6,4" FontSize="{StaticResource FontSizeCaption}"/>
                    <Button x:Name="BtnPresetApiKey" Click="OnPresetApiKey"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Padding="{StaticResource PaddingButtonPreset}" Margin="0,0,6,4" FontSize="{StaticResource FontSizeCaption}"/>
                    <Button x:Name="BtnPresetMysql" Click="OnPresetMysql"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Padding="{StaticResource PaddingButtonPreset}" Margin="0,0,6,4" FontSize="{StaticResource FontSizeCaption}"/>
                    <Button x:Name="BtnPresetSsh" Click="OnPresetSsh"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Padding="{StaticResource PaddingButtonPreset}" Margin="0,0,6,4" FontSize="{StaticResource FontSizeCaption}"/>
                </WrapPanel>
                <!-- Passphrase presets -->
                <WrapPanel x:Name="PresetsPassphrase" Orientation="Horizontal"
                           Visibility="{Binding IsPassphraseMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button x:Name="BtnPresetPassphrase4" Click="OnPresetPassphrase4"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Padding="{StaticResource PaddingButtonPreset}" Margin="0,0,6,4" FontSize="{StaticResource FontSizeCaption}"/>
                    <Button x:Name="BtnPresetPassphrase6" Click="OnPresetPassphrase6"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Padding="{StaticResource PaddingButtonPreset}" Margin="0,0,6,4" FontSize="{StaticResource FontSizeCaption}"/>
                </WrapPanel>
                <!-- Syllable presets -->
                <WrapPanel x:Name="PresetsSyllable" Orientation="Horizontal"
                           Visibility="{Binding IsSyllableMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button x:Name="BtnPresetSylEasy" Click="OnPresetSylEasy"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Padding="{StaticResource PaddingButtonPreset}" Margin="0,0,6,4" FontSize="{StaticResource FontSizeCaption}"/>
                    <Button x:Name="BtnPresetSylBalanced" Click="OnPresetSylBalanced"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Padding="{StaticResource PaddingButtonPreset}" Margin="0,0,6,4" FontSize="{StaticResource FontSizeCaption}"/>
                    <Button x:Name="BtnPresetSylStrong" Click="OnPresetSylStrong"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Padding="{StaticResource PaddingButtonPreset}" Margin="0,0,6,4" FontSize="{StaticResource FontSizeCaption}"/>
                </WrapPanel>
                <!-- Save preset button -->
                <Button x:Name="BtnSavePreset" Click="OnSavePresetClick"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Padding="{StaticResource PaddingButtonPreset}" Margin="0,4,0,0" FontSize="{StaticResource FontSizeCaption}"
                        HorizontalAlignment="Left"/>
                <!-- Saved (custom) presets -->
                <WrapPanel x:Name="PanelCustomPresets" Orientation="Horizontal" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- ROW 6: Advanced Expander -->
            <Expander x:Name="AdvancedExpander" Grid.Row="7" IsExpanded="False" Margin="{StaticResource MarginStackItem}"
                      Foreground="{DynamicResource TextPrimaryBrush}">
                <StackPanel Margin="{StaticResource MarginSubsectionTop}">
                    <!-- Exclude ambiguous -->
                    <CheckBox x:Name="ChkExcludeAmbiguous" IsChecked="{Binding ExcludeAmbiguous, Mode=TwoWay}" Margin="0,0,16,8"
                              Visibility="{Binding ShowExcludeAmbiguous, Converter={StaticResource BoolToVisibilityConverter}}"
                              Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <!-- CLI-safe -->
                    <CheckBox x:Name="ChkCliSafe" IsChecked="{Binding CliSafe, Mode=TwoWay}" Margin="0,0,16,8"
                              Visibility="{Binding HasActiveSpecials, Converter={StaticResource BoolToVisibilityConverter}}"
                              Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <CheckBox x:Name="ChkLayoutSafe" IsChecked="{Binding LayoutSafe, Mode=TwoWay}" Margin="0,0,16,8"
                              Visibility="{Binding ShowLayoutSafe, Converter={StaticResource BoolToVisibilityConverter}}"
                              Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <!-- Custom specials (visible when Symbols checked) -->
                    <DockPanel x:Name="PanelCustomSpecials" Margin="{StaticResource MarginStackItem}"
                               Visibility="{Binding HasActiveSpecials, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock x:Name="CustomSpecialsLabel"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" MinWidth="180"/>
                        <TextBox x:Name="TxtCustomSpecials" MaxLength="64"
                                 Text="{Binding CustomSpecials, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas" FontSize="{StaticResource FontSizeBodyLarge}"
                                 Padding="{StaticResource PaddingInput}"
                                 Background="{DynamicResource CardBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"/>
                    </DockPanel>
                    <TextBlock x:Name="CustomSpecialsNoticeText" Margin="120,2,0,6"
                               Text="{Binding CustomSpecialsNotice}"
                               FontSize="{StaticResource FontSizeSmallCaption}"
                               Foreground="{DynamicResource WarningTextBrush}"
                               TextWrapping="Wrap"
                               Visibility="{Binding ShowCustomSpecialsNotice, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <!-- Clipboard auto-clear -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                        <CheckBox x:Name="ChkClipboardAutoClear" IsChecked="{Binding ClipboardAutoClear, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <ComboBox x:Name="CmbClipboardDelay" Width="90" Margin="8,0,0,0"
                                  SelectedIndex="{Binding ClipboardClearIndex, Mode=TwoWay}"
                                  Visibility="{Binding ClipboardAutoClear, Converter={StaticResource BoolToVisibilityConverter}}"
                                  Background="{DynamicResource CardBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Expander>

        </Grid>

        <!-- What can be said about the password that was produced: how it is built,
             how it is read aloud, the others in the batch and the ones before it.
             Beside the generator when the panel is wide enough to hold both, under
             it when it is not, which is why none of it is behind a tab: a reading of
             the password has to sit where the password is -->
        <StackPanel x:Name="PasswordDetailPane"
                    Style="{StaticResource PasswordDetailPaneStyle}">
            <!-- Syllable structure (visible in Syllable mode) -->
            <StackPanel x:Name="PanelSylStructure" Margin="0,6,0,0"
                        Visibility="{Binding ShowSyllableStructure, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock x:Name="SylStructureLabel"
                           FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock x:Name="SylStructureText"
                           Text="{Binding SyllableStructureText}"
                           FontFamily="Consolas" FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Phonetic pronunciation (always visible when password <= 32 chars) -->
            <StackPanel x:Name="PanelPhonetic" Margin="0,6,0,0"
                        Visibility="{Binding ShowPhonetic, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel>
                    <Button x:Name="BtnCopyPhonetic" DockPanel.Dock="Right" Click="OnCopyPhoneticClick"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Padding="{StaticResource PaddingButtonHelp}" FontSize="{StaticResource FontSizeCaption}" Margin="{StaticResource MarginInlineControl}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PhoneticLabel"
                               FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock x:Name="PhoneticText"
                           Text="{Binding PhoneticText}"
                           FontSize="{StaticResource FontSizeCaption}" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
            <!-- The batch, shown when one click produced more than one password -->
            <StackPanel x:Name="PanelBatch" Margin="{StaticResource MarginSectionBottom}"
                        Visibility="{Binding ShowBatch, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel Margin="{StaticResource MarginLabelBottom}">
                    <Button x:Name="BtnBatchExport" DockPanel.Dock="Right" Click="OnBatchExport"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Padding="{StaticResource PaddingButtonPreset}" Margin="6,0,0,0"
                            FontSize="{StaticResource FontSizeCaption}"/>
                    <Button x:Name="BtnBatchCopyAll" DockPanel.Dock="Right" Click="OnBatchCopyAll"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Padding="{StaticResource PaddingButtonPreset}" Margin="6,0,0,0"
                            FontSize="{StaticResource FontSizeCaption}"/>
                    <CheckBox x:Name="ChkBatchMask" DockPanel.Dock="Right"
                              IsChecked="{Binding MaskBatch, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="6,0,0,0"
                              Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="BatchLabel"
                               FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </DockPanel>
                <ItemsControl x:Name="BatchList" ItemsSource="{Binding BatchRows}"
                              MaxHeight="220">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,2">
                                <Button DockPanel.Dock="Right" Content="&#xE8C8;"
                                        Click="OnBatchCopyRow"
                                        Tag="{Binding}"
                                        Style="{DynamicResource SecondaryButtonStyle}"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="{StaticResource FontSizeCaption}"
                                        Padding="6,2" Margin="6,0,0,0"/>
                                <TextBlock Text="{Binding}"
                                           FontFamily="Consolas"
                                           FontSize="{StaticResource FontSizeBody}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ROW 7: Password history -->
            <Border Grid.Row="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                    Padding="0,8,0,0" Margin="0,4,0,0">
                <StackPanel>
                    <DockPanel Margin="{StaticResource MarginLabelBottom}">
                        <TextBlock x:Name="HistoryLabel" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="BtnClearHistory" DockPanel.Dock="Right"
                                Click="OnClearHistoryClick"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Padding="{StaticResource PaddingButtonHelp}" FontSize="{StaticResource FontSizeCaption}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <TextBlock x:Name="HistoryEmptyText"
                               Visibility="{Binding IsHistoryEmpty, Converter={StaticResource BoolToVisibilityConverter}}"
                               FontSize="{StaticResource FontSizeCaption}" FontStyle="Italic"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,4,0,0"/>
                    <ItemsControl x:Name="HistoryList"
                                  ItemsSource="{Binding PasswordHistory}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,1">
                                    <Button DockPanel.Dock="Right" Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource FontSizeCaption}"
                                            Click="OnHistoryCopyClick" Tag="{Binding}"
                                            Style="{DynamicResource SecondaryButtonStyle}"
                                            Padding="{StaticResource PaddingButtonHelp}" Margin="{StaticResource MarginInlineStart}"
                                            Loaded="OnHistoryCopyButtonLoaded"/>
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="{StaticResource FontSizeCaption}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
    </ScrollViewer>
    </Grid>
</UserControl>
