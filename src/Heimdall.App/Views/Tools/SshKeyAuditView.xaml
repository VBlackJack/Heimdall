<UserControl x:Class="Heimdall.App.Views.Tools.SshKeyAuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Heimdall.App.Converters"
             Background="{DynamicResource BackgroundBrush}">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="{StaticResource ToolHeaderPadding}"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderStrongBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <Button x:Name="BtnHelp" DockPanel.Dock="Right" Content="?"
                        Click="OnHelpClick"
                        Style="{DynamicResource ToolHelpButtonStyle}"
                        Padding="{StaticResource PaddingButtonHelp}" FontSize="{StaticResource FontSizeBody}" FontWeight="Bold"
                        Margin="{StaticResource MarginInlineControl}"/>
                <TextBlock x:Name="HeaderTitle"
                           FontSize="{StaticResource FontSizeSubtitle}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Help panel -->
        <Border x:Name="HelpPanel" Grid.Row="1" Style="{StaticResource ToolHelpPanelStyle}">
            <DockPanel>
                <Button x:Name="BtnCloseHelp" DockPanel.Dock="Right" Content="&#xE711;"
                        FontFamily="{StaticResource FontFamilyIcons}" FontSize="{StaticResource FontSizeBody}"
                        Click="OnCloseHelpClick"
                        Style="{DynamicResource ToolCloseHelpButtonStyle}"
                        VerticalAlignment="Top"/>
                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TxtHelpContent" Text="" TextWrapping="Wrap"
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               LineHeight="20"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="{StaticResource SpacingLg}">
            <Grid MaxWidth="{StaticResource ToolContentMaxWidth}"
                  HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Input section -->
                <Border Grid.Row="0" Padding="{StaticResource SpacingMd}"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource CornerRadiusSm}"
                        Margin="{StaticResource MarginSectionBottom}">
                    <StackPanel>
                        <DockPanel Margin="{StaticResource MarginStackItem}">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button x:Name="BtnBrowse"
                                        Click="OnBrowseClick"
                                        Style="{DynamicResource SecondaryButtonStyle}"
                                        Padding="{StaticResource PaddingButtonCopy}" Margin="{StaticResource MarginInlineControl}"/>
                                <Button x:Name="BtnLoadFromAgent"
                                        Click="OnLoadFromAgentClick"
                                        Style="{DynamicResource SecondaryButtonStyle}"
                                        Padding="{StaticResource PaddingButtonCopy}" Margin="{StaticResource MarginInlineControl}"/>
                                <Button x:Name="BtnRemoveFromAgent"
                                        Click="OnRemoveFromAgentClick"
                                        Style="{DynamicResource SecondaryButtonStyle}"
                                        Padding="{StaticResource PaddingButtonCopy}" Margin="{StaticResource MarginInlineControl}"/>
                                <Button x:Name="BtnClearAgent"
                                        Click="OnClearAgentClick"
                                        Style="{DynamicResource SecondaryButtonStyle}"
                                        Padding="{StaticResource PaddingButtonCopy}" Margin="{StaticResource MarginInlineControl}"/>
                                <Button x:Name="BtnDeployKey"
                                        Click="OnDeployKeyClick"
                                        Style="{DynamicResource SecondaryButtonStyle}"
                                        Padding="{StaticResource PaddingButtonCopy}" Margin="{StaticResource MarginInlineControl}"
                                        Visibility="Collapsed"/>
                            </StackPanel>
                            <TextBlock x:Name="InputLabel"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       Margin="{StaticResource MarginLabelBottom}"/>
                        </DockPanel>
                        <TextBox x:Name="KeyInput"
                                 AcceptsReturn="True"
                                 Text="{Binding KeyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="{StaticResource FontFamilyMonospace}"
                                 FontSize="{StaticResource FontSizeBody}"
                                 MinHeight="120" MaxHeight="240"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 Background="{DynamicResource CardBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 Padding="{StaticResource PaddingInput}"
                                 TextChanged="OnKeyInputTextChanged"/>
                        <!-- File load error (oversized, unreadable or access refused) -->
                        <TextBlock x:Name="FileError"
                                   Text="{Binding FileErrorMessage, Mode=OneWay}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{DynamicResource ErrorTextBrush}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding ShowFileError, Converter={StaticResource BoolToVisibilityConverter}}"
                                   Margin="{StaticResource MarginLabelBottom}"/>
                    </StackPanel>
                </Border>

                <!-- Empty state -->
                <TextBlock x:Name="EmptyState" Grid.Row="1"
                           Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibilityConverter}}"
                           Style="{StaticResource ToolEmptyStateTextStyle}"
                           HorizontalAlignment="Center"
                          />

                <!-- Parse error -->
                <TextBlock x:Name="ParseError" Grid.Row="1"
                           FontSize="{StaticResource FontSizeBody}"
                           Foreground="{DynamicResource ErrorTextBrush}"
                           TextWrapping="Wrap"
                           Visibility="{Binding ShowParseError, Converter={StaticResource BoolToVisibilityConverter}}"
                           Margin="{StaticResource MarginSubsectionTop}"/>

                <!-- Key type badge -->
                <StackPanel x:Name="BadgePanel" Grid.Row="2"
                            Orientation="Horizontal"
                            Visibility="{Binding ShowResults, Converter={StaticResource BoolToVisibilityConverter}}"
                            Margin="{StaticResource MarginSectionBottom}">
                    <Border x:Name="AlgorithmBadge"
                            CornerRadius="{StaticResource CornerRadiusSm}"
                            Padding="12,4"
                            Margin="{StaticResource MarginInlineSm}">
                        <TextBlock x:Name="AlgorithmBadgeText"
                                   FontSize="{StaticResource FontSizeBody}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextOnAccentBrush}"/>
                    </Border>
                    <Border x:Name="RatingBadge"
                            CornerRadius="{StaticResource CornerRadiusSm}"
                            Padding="12,4">
                        <TextBlock x:Name="RatingBadgeText"
                                   FontSize="{StaticResource FontSizeBody}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextOnAccentBrush}"/>
                    </Border>
                </StackPanel>

                <!-- Key details grid -->
                <Border x:Name="DetailsPanel" Grid.Row="3"
                        Padding="{StaticResource SpacingMd}"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource CornerRadiusSm}"
                        Visibility="{Binding ShowResults, Converter={StaticResource BoolToVisibilityConverter}}"
                        Margin="{StaticResource MarginSectionBottom}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Algorithm -->
                        <TextBlock x:Name="DetailAlgorithmLabel" Grid.Row="0" Grid.Column="0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                   Margin="{StaticResource MarginDetailRow}"/>
                        <TextBlock x:Name="DetailAlgorithmValue" Grid.Row="0" Grid.Column="1"
                                   Text="{Binding Algorithm}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource MarginDetailRow}"/>

                        <!-- Key Size -->
                        <TextBlock x:Name="DetailKeySizeLabel" Grid.Row="1" Grid.Column="0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                   Margin="{StaticResource MarginDetailRow}"/>
                        <TextBlock x:Name="DetailKeySizeValue" Grid.Row="1" Grid.Column="1"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource MarginDetailRow}"/>

                        <!-- Fingerprint -->
                        <TextBlock x:Name="DetailFingerprintLabel" Grid.Row="2" Grid.Column="0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                   Margin="{StaticResource MarginDetailRow}"/>
                        <Grid Grid.Row="2" Grid.Column="1" Margin="{StaticResource MarginDetailRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="DetailFingerprintValue"
                                     IsReadOnly="True"
                                     Text="{Binding Fingerprint, Mode=OneWay}"
                                     FontFamily="{StaticResource FontFamilyMonospace}" FontSize="{StaticResource FontSizeBody}"
                                     Background="Transparent"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderThickness="0"
                                     VerticalAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="BtnCopyFingerprint"
                                    Click="OnCopyFingerprintClick"
                                    Style="{DynamicResource SecondaryButtonStyle}"
                                    Padding="{StaticResource PaddingButtonCopy}" Margin="{StaticResource MarginInlineControl}"
                                    VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Format -->
                        <TextBlock x:Name="DetailFormatLabel" Grid.Row="3" Grid.Column="0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                   Margin="{StaticResource MarginDetailRow}"/>
                        <TextBlock x:Name="DetailFormatValue" Grid.Row="3" Grid.Column="1"
                                   Text="{Binding Format}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource MarginDetailRow}"/>

                        <!-- Type (public/private) -->
                        <TextBlock x:Name="DetailTypeLabel" Grid.Row="4" Grid.Column="0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                   Margin="{StaticResource MarginDetailRow}"/>
                        <TextBlock x:Name="DetailTypeValue" Grid.Row="4" Grid.Column="1"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource MarginDetailRow}"/>

                        <!-- Encrypted -->
                        <TextBlock x:Name="DetailEncryptedLabel" Grid.Row="5" Grid.Column="0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DetailEncryptedValue" Grid.Row="5" Grid.Column="1"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Security assessment / Findings -->
                <Border x:Name="FindingsPanel" Grid.Row="4"
                        Padding="{StaticResource SpacingMd}"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource CornerRadiusSm}"
                        Visibility="{Binding ShowResults, Converter={StaticResource BoolToVisibilityConverter}}"
                        Margin="{StaticResource MarginSectionBottom}">
                    <StackPanel>
                        <TextBlock x:Name="FindingsTitle"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontWeight="SemiBold" Margin="{StaticResource MarginStackItem}"/>
                        <ItemsControl x:Name="FindingsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="{StaticResource MarginLabelBottom}">
                                        <TextBlock Text="{Binding Icon}"
                                                   Foreground="{Binding IconBrush}"
                                                   FontWeight="Bold"
                                                   Width="20" VerticalAlignment="Top"/>
                                        <TextBlock Text="{Binding Text}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Live SSH Agent Inspector -->
                <Border x:Name="AgentInspectorPanel" Grid.Row="5"
                        Padding="{StaticResource SpacingMd}"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource CornerRadiusSm}"
                        Margin="{StaticResource MarginSectionBottom}">
                    <StackPanel>
                        <DockPanel Margin="{StaticResource MarginStackItem}">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="BtnLoadKeyFileToAgent"
                                        Click="OnLoadKeyFileToAgentClick"
                                        Style="{DynamicResource SecondaryButtonStyle}"
                                        Padding="{StaticResource PaddingButtonCopy}" Margin="{StaticResource MarginInlineControl}"/>
                                <Button x:Name="BtnRefreshAgentInspector"
                                        Click="OnRefreshAgentInspectorClick"
                                        Style="{DynamicResource SecondaryButtonStyle}"
                                        Padding="{StaticResource PaddingButtonCopy}" Margin="{StaticResource MarginInlineControl}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="AgentInspectorTitle"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="AgentInspectorSummary"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock x:Name="AgentInspectorEmptyText"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                        <ItemsControl x:Name="AgentKeysList" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource CornerRadiusSm}"
                                            Padding="8,6"
                                            Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding AgentName}"
                                                               FontSize="{StaticResource FontSizeCaption}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentTextBrush}"
                                                               Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding KeyType}"
                                                               FontFamily="{StaticResource FontFamilyMonospace}"
                                                               FontSize="{StaticResource FontSizeCaption}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding Comment}"
                                                               FontSize="{StaticResource FontSizeCaption}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Fingerprint}"
                                                           FontFamily="{StaticResource FontFamilyMonospace}"
                                                           FontSize="{StaticResource FontSizeCaption}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding MatchedProfilesText}"
                                                           FontSize="{StaticResource FontSizeCaption}"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           Margin="0,2,0,0"
                                                           Visibility="{Binding HasMatchedProfiles, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <Button Content="{Binding AuditLabel}"
                                                        Tag="{Binding}"
                                                        Click="OnAgentRowAuditClick"
                                                        Style="{DynamicResource SecondaryButtonStyle}"
                                                        Padding="6,2"
                                                        FontSize="{StaticResource FontSizeCaption}"
                                                        Margin="0,0,4,0"/>
                                                <Button Content="{Binding DeployLabel}"
                                                        Tag="{Binding}"
                                                        Click="OnAgentRowDeployClick"
                                                        Style="{DynamicResource SecondaryButtonStyle}"
                                                        Padding="6,2"
                                                        FontSize="{StaticResource FontSizeCaption}"
                                                        Margin="0,0,4,0"/>
                                                <Button Content="{Binding RemoveLabel}"
                                                        Tag="{Binding}"
                                                        Click="OnAgentRowRemoveClick"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Padding="6,2"
                                                        FontSize="{StaticResource FontSizeCaption}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
