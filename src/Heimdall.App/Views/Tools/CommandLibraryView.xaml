<UserControl x:Class="Heimdall.App.Views.Tools.CommandLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:Heimdall.App.Behaviors"
             xmlns:converters="clr-namespace:Heimdall.App.Converters"
             xmlns:loc="clr-namespace:Heimdall.App.Localization"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:vm="clr-namespace:Heimdall.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:CommandLibraryViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource BackgroundBrush}">
    <!-- Scoped to this view, so they only fire while the tool has focus. Every key here
         was checked against what the window already takes: Ctrl+B/E/F/N/O/S/T/W/Tab are
         registered globally, and the window's preview handler only claims Apps, Shift+F10,
         F11 and Escape-while-fullscreen. Return and Ctrl+Return match the convention the
         other tools already use for a primary and a consequential action. Shift+Return types
         the command at the prompt without running it; the window claims no Shift+Return. -->
    <UserControl.InputBindings>
        <KeyBinding Key="Return" Command="{Binding CopyCommand}"/>
        <KeyBinding Key="Return" Modifiers="Control" Command="{Binding SendCommand}"/>
        <KeyBinding Key="Return" Modifiers="Shift" Command="{Binding InsertCommand}"/>
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding DuplicateSelectedCommand}"/>
    </UserControl.InputBindings>
    <!-- The action list and the three bottom panels (generator, history, runbooks) share the
         body. A panel sits in an auto row, which is served before the list's star row, so a cap
         alone let the generator take everything in a short window: at 1024x768 the list was gone
         and the Copy / Send bar was clipped below the tool. Each panel's height is therefore
         what the body has left once the list has kept two rows, and never more than its cap. -->
    <UserControl.Resources>
        <converters:RemainingHeightConverter x:Key="RemainingHeightConverter"/>
        <sys:Double x:Key="CmdLibActionListMinHeight">128</sys:Double>
        <!-- Square icon buttons of the header and the rows. -->
        <sys:Double x:Key="CmdLibIconButtonSize">28</sys:Double>
        <Thickness x:Key="CmdLibBlockMarginTop">0,6,0,0</Thickness>
        <Thickness x:Key="CmdLibChipMargin">0,2,8,2</Thickness>
        <Thickness x:Key="CmdLibCaptionMarginTop">0,2,0,0</Thickness>
        <Thickness x:Key="CmdLibRowMargin">0,2,0,2</Thickness>
        <Thickness x:Key="CmdLibPanelHeaderMargin">12,8,12,4</Thickness>
        <sys:Double x:Key="CmdLibGeneratorMaxHeight">450</sys:Double>
        <sys:Double x:Key="CmdLibHistoryMaxHeight">300</sys:Double>
        <sys:Double x:Key="CmdLibRunbooksMaxHeight">420</sys:Double>
        <sys:Double x:Key="CmdLibBottomPanelMinHeight">96</sys:Double>
        <sys:Double x:Key="CmdLibBottomPanelGripHeight">8</sys:Double>
        <sys:Double x:Key="CmdLibBottomPanelGripBarWidth">40</sys:Double>
        <sys:Double x:Key="CmdLibBottomPanelGripBarHeight">3</sys:Double>
        <!-- Wide enough for the longest shipped badge (EJECUTAR in Spanish) so titles start in one
             column whatever the risk; a longer translation grows the badge rather than clipping. -->
        <sys:Double x:Key="CmdLibRiskBadgeMinWidth">64</sys:Double>
        <sys:Double x:Key="CmdLibParameterLabelWidth">130</sys:Double>
        <sys:Double x:Key="CmdLibRunbookVariableLabelWidth">150</sys:Double>
        <sys:Double x:Key="CmdLibRunbookStepNumberWidth">24</sys:Double>
        <sys:Double x:Key="CmdLibHelpMaxHeight">200</sys:Double>
        <sys:Double x:Key="CmdLibHelpLineHeight">20</sys:Double>
        <sys:Double x:Key="CmdLibBroadcastListMaxHeight">140</sys:Double>
        <!-- A ghost button that shows when it is on: the History and Runbooks panels and the
             favorites filter. They stay plain buttons whose Tag carries the view model's state,
             as the tab strip's broadcast marker does, rather than ToggleButtons: a ToggleButton
             beside a Command can be flipped through UIA without the view model following. -->
        <Style x:Key="CmdLibOnOffButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}">
                    <DataTrigger.Value>
                        <sys:Boolean>True</sys:Boolean>
                    </DataTrigger.Value>
                    <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ ROW 0 - HEADER ═══════════ -->
        <Border Grid.Row="0"
                Padding="{StaticResource ToolHeaderPadding}"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderStrongBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        x:Name="BtnHelp"
                        Content="?"
                        Command="{Binding ToggleHelpCommand}"
                        ToolTip="{loc:Translate ToolHelpTooltip}"
                        AutomationProperties.Name="{loc:Translate ToolHelpTooltip}"
                        Style="{DynamicResource ToolHelpButtonStyle}"
                        Padding="{StaticResource PaddingButtonHelp}"
                        FontSize="{StaticResource FontSizeBody}"
                        FontWeight="Bold"
                        Margin="{StaticResource MarginInlineControl}"
                        TabIndex="27"/>
                <Button DockPanel.Dock="Right"
                        x:Name="BtnHistory"
                        Content="&#xE81C;" FontFamily="{StaticResource FontFamilyIcons}"
                        Command="{Binding ToggleHistoryCommand}"
                        Tag="{Binding IsHistoryVisible}"
                        ToolTip="{loc:Translate ToolCmdLibBtnHistory}"
                        Style="{StaticResource CmdLibOnOffButtonStyle}"
                        FontSize="{StaticResource FontSizeBodyLarge}" MinWidth="{StaticResource CmdLibIconButtonSize}" Height="{StaticResource CmdLibIconButtonSize}"
                        Padding="{StaticResource SpacingXs}"
                        Margin="{StaticResource MarginInlineControl}"
                        TabIndex="26">
                    <AutomationProperties.Name>
                        <MultiBinding Converter="{StaticResource AccessibleStateNameConverter}">
                            <Binding Source="{x:Static loc:LocalizationSource.Instance}" Path="[ToolCmdLibBtnHistory]"/>
                            <Binding Path="IsHistoryVisible"/>
                            <Binding Source="{x:Static loc:LocalizationSource.Instance}" Path="[ToolCmdLibToggleOnFormat]"/>
                        </MultiBinding>
                    </AutomationProperties.Name>
                </Button>
                <Button DockPanel.Dock="Right"
                        x:Name="BtnRunbooks"
                        Content="&#xE9D5;" FontFamily="{StaticResource FontFamilyIcons}"
                        Command="{Binding ToggleRunbooksCommand}"
                        Tag="{Binding IsRunbooksVisible}"
                        ToolTip="{loc:Translate ToolCmdLibBtnRunbooks}"
                        Style="{StaticResource CmdLibOnOffButtonStyle}"
                        FontSize="{StaticResource FontSizeBodyLarge}" MinWidth="{StaticResource CmdLibIconButtonSize}" Height="{StaticResource CmdLibIconButtonSize}"
                        Padding="{StaticResource SpacingXs}"
                        Margin="{StaticResource MarginInlineControl}"
                        TabIndex="25">
                    <AutomationProperties.Name>
                        <MultiBinding Converter="{StaticResource AccessibleStateNameConverter}">
                            <Binding Source="{x:Static loc:LocalizationSource.Instance}" Path="[ToolCmdLibBtnRunbooks]"/>
                            <Binding Path="IsRunbooksVisible"/>
                            <Binding Source="{x:Static loc:LocalizationSource.Instance}" Path="[ToolCmdLibToggleOnFormat]"/>
                        </MultiBinding>
                    </AutomationProperties.Name>
                </Button>
                <Button DockPanel.Dock="Right"
                        x:Name="BtnSync"
                        Content="&#xE895;" FontFamily="{StaticResource FontFamilyIcons}"
                        Command="{Binding SyncCommand}"
                        ToolTip="{loc:Translate ToolCmdLibBtnSync}"
                        AutomationProperties.Name="{loc:Translate ToolCmdLibBtnSync}"
                        IsEnabled="{Binding IsSyncing, Converter={StaticResource InvertBoolConverter}}"
                        Style="{DynamicResource GhostButtonStyle}"
                        FontSize="{StaticResource FontSizeBodyLarge}" MinWidth="{StaticResource CmdLibIconButtonSize}" Height="{StaticResource CmdLibIconButtonSize}"
                        Padding="{StaticResource SpacingXs}"
                        Margin="{StaticResource MarginInlineControl}"
                        TabIndex="24"/>
                <Button DockPanel.Dock="Right"
                        x:Name="BtnCancelSync"
                        Content="&#xE711;" FontFamily="{StaticResource FontFamilyIcons}"
                        Command="{Binding CancelSyncCommand}"
                        ToolTip="{loc:Translate ToolCmdLibBtnCancelSync}"
                        AutomationProperties.Name="{loc:Translate ToolCmdLibBtnCancelSync}"
                        Visibility="{Binding IsSyncing, Converter={StaticResource BoolToVisibilityConverter}}"
                        Style="{DynamicResource GhostButtonStyle}"
                        FontSize="{StaticResource FontSizeBodyLarge}" MinWidth="{StaticResource CmdLibIconButtonSize}" Height="{StaticResource CmdLibIconButtonSize}"
                        Padding="{StaticResource SpacingXs}"
                        Margin="{StaticResource MarginInlineControl}"
                        TabIndex="23"/>
                <Button DockPanel.Dock="Right"
                        x:Name="BtnImport"
                        Content="&#xE8B5;" FontFamily="{StaticResource FontFamilyIcons}"
                        Command="{Binding ImportCommand}"
                        ToolTip="{loc:Translate ToolCmdLibBtnImport}"
                        AutomationProperties.Name="{loc:Translate ToolCmdLibBtnImport}"
                        Style="{DynamicResource GhostButtonStyle}"
                        FontSize="{StaticResource FontSizeBodyLarge}" MinWidth="{StaticResource CmdLibIconButtonSize}" Height="{StaticResource CmdLibIconButtonSize}"
                        Padding="{StaticResource SpacingXs}"
                        Margin="{StaticResource MarginInlineControl}"
                        TabIndex="22"/>
                <Button DockPanel.Dock="Right"
                        x:Name="BtnExport"
                        Content="&#xEDE1;" FontFamily="{StaticResource FontFamilyIcons}"
                        Command="{Binding ExportCommand}"
                        ToolTip="{loc:Translate ToolCmdLibBtnExport}"
                        AutomationProperties.Name="{loc:Translate ToolCmdLibBtnExport}"
                        Style="{DynamicResource GhostButtonStyle}"
                        FontSize="{StaticResource FontSizeBodyLarge}" MinWidth="{StaticResource CmdLibIconButtonSize}" Height="{StaticResource CmdLibIconButtonSize}"
                        Padding="{StaticResource SpacingXs}"
                        Margin="{StaticResource MarginInlineControl}"
                        TabIndex="21"/>
                <Button DockPanel.Dock="Right"
                        x:Name="BtnAdd"
                        Content="&#xE710;" FontFamily="{StaticResource FontFamilyIcons}"
                        Command="{Binding AddActionCommand}"
                        ToolTip="{loc:Translate ToolCmdLibBtnAdd}"
                        AutomationProperties.Name="{loc:Translate ToolCmdLibBtnAdd}"
                        Style="{DynamicResource GhostButtonStyle}"
                        FontSize="{StaticResource FontSizeBodyLarge}" MinWidth="{StaticResource CmdLibIconButtonSize}" Height="{StaticResource CmdLibIconButtonSize}"
                        Padding="{StaticResource SpacingXs}"
                        Margin="{StaticResource MarginInlineControl}"
                        TabIndex="20"/>
                <TextBlock Text="{loc:Translate ToolCmdLibTitle}"
                           FontSize="{StaticResource FontSizeSubtitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding SyncStatusMessage}"
                           Visibility="{Binding IsSyncing, Converter={StaticResource BoolToVisibilityConverter}}"
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="{StaticResource MarginInlineControl}"/>
                <TextBlock Text="{Binding SyncKeptLocalSummary}"
                           ToolTip="{Binding SyncKeptLocalTitles}"
                           Visibility="{Binding SyncKeptLocalSummary, Converter={StaticResource NullToVisibilityConverter}}"
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="{StaticResource MarginInlineControl}"/>
            </DockPanel>
        </Border>

        <!-- ═══════════ ROW 1 - HELP PANEL ═══════════ -->
        <Border Grid.Row="1"
                Style="{StaticResource ToolHelpPanelStyle}"
                Visibility="{Binding IsHelpVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="&#xE711;" FontFamily="{StaticResource FontFamilyIcons}"
                        FontSize="{StaticResource FontSizeBody}"
                        Command="{Binding ToggleHelpCommand}"
                        AutomationProperties.Name="{loc:Translate BtnClose}"
                        Style="{DynamicResource ToolCloseHelpButtonStyle}"
                        VerticalAlignment="Top"
                        TabIndex="28"/>
                <ScrollViewer MaxHeight="{StaticResource CmdLibHelpMaxHeight}" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding HelpContentText}" TextWrapping="Wrap"
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               LineHeight="{StaticResource CmdLibHelpLineHeight}"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ═══════════ ROW 2 - FILTERS ═══════════ -->
        <Border Grid.Row="2"
                Padding="{StaticResource ToolHeaderPadding}"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderStrongBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Search bar - always full width -->
                <Grid Grid.Row="0">
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource WatermarkTextBoxStyle}"
                             Tag="{loc:Translate ToolCmdLibSearchPlaceholder}"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{loc:Translate ToolCmdLibSearchPlaceholder}"
                             FontSize="{StaticResource FontSizeBodyLarge}"
                             Padding="8,6,28,6"
                             Background="{DynamicResource CardBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             TabIndex="0"/>
                    <Button Content="&#xE711;" FontFamily="{StaticResource FontFamilyIcons}"
                            FontSize="{StaticResource FontSizeSmallCaption}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="{StaticResource MarginInlineXs}" Padding="{StaticResource SpacingXs}"
                            Style="{DynamicResource GhostButtonStyle}" MinHeight="0"
                            Command="{Binding ClearSearchCommand}"
                            AutomationProperties.Name="{loc:Translate A11yClearSearch}"
                            Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>

                <!-- Filter controls - wrappable -->
                <WrapPanel Grid.Row="1" Margin="{StaticResource CmdLibBlockMarginTop}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ResultCountText}"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="{StaticResource CmdLibChipMargin}"
                               MinWidth="65"/>
                    <Button Content="&#x2605;"
                            TabIndex="1"
                            x:Name="BtnFavoritesFilter"
                            Command="{Binding ToggleFavoritesFilterCommand}"
                            Tag="{Binding FavoritesFilterActive}"
                            ToolTip="{loc:Translate ToolCmdLibFilterFavorites}"
                            Style="{StaticResource CmdLibOnOffButtonStyle}"
                            FontSize="{StaticResource FontSizeBodyLarge}" MinWidth="{StaticResource CmdLibIconButtonSize}" Height="{StaticResource CmdLibIconButtonSize}" Padding="{StaticResource SpacingXs}"
                            Margin="{StaticResource CmdLibChipMargin}"
                            Foreground="{Binding FavoritesFilterBrushKey, Converter={StaticResource ResourceKeyToBrushConverter}}">
                        <AutomationProperties.Name>
                            <MultiBinding Converter="{StaticResource AccessibleStateNameConverter}">
                                <Binding Source="{x:Static loc:LocalizationSource.Instance}" Path="[ToolCmdLibFilterFavorites]"/>
                                <Binding Path="FavoritesFilterActive"/>
                                <Binding Source="{x:Static loc:LocalizationSource.Instance}" Path="[ToolCmdLibToggleOnFormat]"/>
                            </MultiBinding>
                        </AutomationProperties.Name>
                    </Button>
                    <ComboBox MinWidth="180" Margin="{StaticResource CmdLibChipMargin}"
                              x:Name="CmbCategoryFilter"
                              FontSize="{StaticResource FontSizeBody}"
                              ItemsSource="{Binding CategoryFilterItems}"
                              SelectedIndex="{Binding CategoryFilterIndex, Mode=TwoWay}"
                              ToolTip="{loc:Translate ToolCmdLibDialogLblCategory}"
                              AutomationProperties.Name="{loc:Translate ToolCmdLibDialogLblCategory}"
                              TabIndex="2"/>
                    <ComboBox MinWidth="150" Margin="{StaticResource CmdLibChipMargin}"
                              x:Name="CmbTagFilter"
                              FontSize="{StaticResource FontSizeBody}"
                              ItemsSource="{Binding TagFilterItems}"
                              SelectedIndex="{Binding TagFilterIndex, Mode=TwoWay}"
                              ToolTip="{loc:Translate ToolCmdLibDialogLblTags}"
                              AutomationProperties.Name="{loc:Translate ToolCmdLibDialogLblTags}"
                              TabIndex="3"/>
                    <ComboBox MinWidth="130" Margin="{StaticResource CmdLibChipMargin}"
                              x:Name="CmbPlatformFilter"
                              FontSize="{StaticResource FontSizeBody}"
                              ItemsSource="{Binding PlatformFilterItems}"
                              SelectedIndex="{Binding PlatformFilterIndex, Mode=TwoWay}"
                              ToolTip="{loc:Translate ToolCmdLibDialogLblPlatform}"
                              AutomationProperties.Name="{loc:Translate ToolCmdLibDialogLblPlatform}"
                              TabIndex="4"/>
                    <ComboBox MinWidth="120" Margin="{StaticResource CmdLibRowMargin}"
                              x:Name="CmbRiskFilter"
                              FontSize="{StaticResource FontSizeBody}"
                              ItemsSource="{Binding RiskFilterItems}"
                              SelectedIndex="{Binding RiskFilterIndex, Mode=TwoWay}"
                              ToolTip="{loc:Translate ToolCmdLibDialogLblRisk}"
                              AutomationProperties.Name="{loc:Translate ToolCmdLibDialogLblRisk}"
                              TabIndex="5"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Loading indicator -->
        <!-- Shown for a Git sync too: it reloads the whole library and takes longer than
             any of the local operations, and the status text beside the title is easy to
             miss while the list sits there looking idle. IsLibraryIdle already means
             "neither busy nor syncing". -->
        <ProgressBar Grid.Row="3"
                     Style="{StaticResource ToolLoadingBarStyle}"
                     Visibility="{Binding IsOperationRunning, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- ═══════════ ROW 4 - BODY: BOTTOM PANELS + ACTION LIST ═══════════ -->
        <!-- A DockPanel, not a Grid: it measures a docked panel against the height that is
             really left, where a Grid measures an auto row against infinity. In a Grid the
             generator asked for its full cap, the body overflowed its row, and its own
             ActualHeight then fed the cap back, so nothing ever gave way. The list is the
             last child and takes what the open panel leaves. -->
        <DockPanel x:Name="BodyPanel" Grid.Row="4">
        <!-- ═══════════ GENERATOR PANEL ═══════════ -->
        <Border x:Name="GeneratorPanel" DockPanel.Dock="Bottom"
                Visibility="{Binding IsGeneratorVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Border.MaxHeight>
                <MultiBinding Converter="{StaticResource RemainingHeightConverter}">
                    <Binding Path="ActualHeight" ElementName="BodyPanel"/>
                    <Binding Source="{StaticResource CmdLibActionListMinHeight}"/>
                    <Binding Source="{StaticResource CmdLibGeneratorMaxHeight}"/>
                    <Binding Path="Height" RelativeSource="{RelativeSource Self}"/>
                </MultiBinding>
            </Border.MaxHeight>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,12,12,8">
                        <DockPanel Margin="{StaticResource MarginStackItem}">
                            <StackPanel DockPanel.Dock="Right"
                                        Orientation="Horizontal"
                                        Visibility="{Binding HasMultipleTemplates, Converter={StaticResource BoolToVisibilityConverter}}">
                                <RadioButton Content="{loc:Translate ToolCmdLibPlatformWindows}"
                                             GroupName="TemplatePlatform"
                                             IsChecked="{Binding UseWindowsTemplate, Mode=TwoWay}"
                                             AutomationProperties.Name="{loc:Translate ToolCmdLibPlatformWindows}"
                                             FontSize="{StaticResource FontSizeCaption}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             VerticalAlignment="Center" Margin="{StaticResource MarginInlineSm}"/>
                                <RadioButton Content="{loc:Translate ToolCmdLibPlatformLinux}"
                                             GroupName="TemplatePlatform"
                                             IsChecked="{Binding UseLinuxTemplate, Mode=TwoWay}"
                                             AutomationProperties.Name="{loc:Translate ToolCmdLibPlatformLinux}"
                                             FontSize="{StaticResource FontSizeCaption}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ActiveTemplateName}"
                                       FontSize="{StaticResource FontSizeBody}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding Parameters}"
                                      Margin="{StaticResource MarginLabelBottom}">
                            <ItemsControl.ItemContainerStyle>
                                <!-- The name goes on the container: set in the template it is inert, and the
                                     row announced its class name to a screen reader. -->
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding DisplayLabel}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="{StaticResource MarginLabelBottom}"
                                               ToolTip="{Binding DisplayTooltip}">
                                        <TextBlock DockPanel.Dock="Left"
                                                   Text="{Binding DisplayLabel}" Width="{StaticResource CmdLibParameterLabelWidth}"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <!-- A parameter offering a fixed set gets a list to
                                             pick from; everything else keeps its box. Both
                                             are declared and one is collapsed, rather than
                                             swapped by a template selector, because the two
                                             bind to the same Value and the panel is small. -->
                                        <ComboBox ItemsSource="{Binding AllowedValues}"
                                                  Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="False"
                                                  SelectedItem="{Binding Value, Mode=TwoWay}"
                                                  Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibilityConverter}}"
                                                  ToolTip="{Binding DisplayTooltip}"
                                                  AutomationProperties.Name="{Binding DisplayLabel}"
                                                  FontSize="{StaticResource FontSizeBody}"/>
                                        <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding IsFreeText, Converter={StaticResource BoolToVisibilityConverter}}"
                                                 ToolTip="{Binding DisplayTooltip}"
                                                 AutomationProperties.Name="{Binding DisplayLabel}"
                                                 FontSize="{StaticResource FontSizeBody}"
                                                 FontFamily="{StaticResource FontFamilyMonospace}"
                                                 Padding="{StaticResource PaddingInput}"
                                                 Background="{DynamicResource CardBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderBrush="{DynamicResource BorderBrush}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Validation errors (shown when parameters are invalid) -->
                        <TextBlock Text="{Binding ValidationError}"
                                   Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVisibilityConverter}}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{DynamicResource ErrorTextBrush}"
                                   TextWrapping="Wrap" Margin="{StaticResource MarginLabelBottom}"/>

                        <TextBox Text="{Binding GeneratedCommand, Mode=OneWay}"
                                 IsReadOnly="True" TextWrapping="NoWrap"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="{StaticResource FontFamilyMonospace}"
                                 FontSize="{StaticResource FontSizeBody}"
                                 Padding="{StaticResource PaddingInput}"
                                 Background="{DynamicResource CardBrush}"
                                 Foreground="{DynamicResource AccentTextBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 Margin="{StaticResource MarginStackItem}"/>

                        <!-- Notes / Examples / Links (collapsed when empty) -->
                        <StackPanel Visibility="{Binding HasDetailContent, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Margin="{StaticResource MarginLabelBottom}">
                            <TextBlock Text="{Binding SelectedActionNotes}"
                                       Visibility="{Binding HasSelectedNotes, Converter={StaticResource BoolToVisibilityConverter}}"
                                       TextWrapping="Wrap"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="{StaticResource MarginLabelBottom}"/>
                            <!-- Here rather than on the list row: that row already carries a
                                 favourite toggle, a risk badge, a platform label, a title and
                                 a description, and tags would crowd out the title. -->
                            <TextBlock Text="{Binding SelectedActionTags}"
                                       Visibility="{Binding HasSelectedTags, Converter={StaticResource BoolToVisibilityConverter}}"
                                       TextWrapping="Wrap"
                                       FontSize="{StaticResource FontSizeSmallCaption}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="{StaticResource MarginLabelBottom}"/>
                            <ItemsControl ItemsSource="{Binding SelectedActionExamples}">
                                <ItemsControl.ItemContainerStyle>
                                    <!-- The name goes on the container: set in the template it is inert, and the
                                         row announced its class name to a screen reader. -->
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Command}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Card row. The apply action lives on a flat Button (in the
                                             visual tree, so it inherits the per-item DataContext) instead
                                             of a Border MouseBinding, which only resolved CommandParameter
                                             for the first realized container. Copy is a sibling Button so
                                             clicking it never triggers the row apply. -->
                                        <Border Padding="6,3" Margin="{StaticResource CmdLibCaptionMarginTop}"
                                                Background="{DynamicResource BackgroundBrush}"
                                                CornerRadius="{StaticResource CornerRadiusSm}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0"
                                                        Command="{Binding DataContext.ApplyExampleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Command}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="0"
                                                        Cursor="Hand"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch"
                                                        ToolTip="{loc:Translate ToolCmdLibApplyExample}"
                                                        AutomationProperties.Name="{loc:Translate ToolCmdLibApplyExample}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}">
                                                                <ContentPresenter HorizontalAlignment="Stretch"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Command}"
                                                                   FontFamily="{StaticResource FontFamilyMonospace}"
                                                                   FontSize="{StaticResource FontSizeCaption}"
                                                                   Foreground="{DynamicResource AccentTextBrush}"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Description}"
                                                                   FontSize="{StaticResource FontSizeSmallCaption}"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Column="1"
                                                        Content="&#xE8C8;" FontFamily="{StaticResource FontFamilyIcons}"
                                                        Command="{Binding DataContext.CopyExampleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Command}"
                                                        Style="{DynamicResource GhostButtonStyle}"
                                                        ToolTip="{loc:Translate ToolCmdLibBtnCopyExample}"
                                                        AutomationProperties.Name="{loc:Translate ToolCmdLibBtnCopyExample}"
                                                        FontSize="{StaticResource IconSizeSmall}" Width="{StaticResource TargetMinSize}" Height="{StaticResource TargetMinSize}"
                                                        Padding="{StaticResource SpacingXxs}" VerticalAlignment="Top"
                                                        Focusable="False"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding SelectedActionLinks}" Margin="0,4,0,0">
                                <ItemsControl.ItemContainerStyle>
                                    <!-- The name goes on the container: set in the template it is inert, and the
                                         row announced its class name to a screen reader. -->
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="{StaticResource FontSizeCaption}">
                                            <Hyperlink NavigateUri="{Binding Url}"
                                                       RequestNavigate="OnLinkNavigate"
                                                       Foreground="{DynamicResource AccentTextBrush}">
                                                <Run Text="{Binding Title, Mode=OneWay}"/>
                                            </Hyperlink>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Action buttons - always visible below scroll area -->
                <DockPanel Grid.Row="1" Margin="12,0,12,12">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button Command="{Binding EditSelectedCommand}"
                                x:Name="BtnEdit"
                                Content="&#xE70F;" FontFamily="{StaticResource FontFamilyIcons}"
                                Visibility="{Binding CanEditSelected, Converter={StaticResource BoolToVisibilityConverter}}"
                                ToolTip="{loc:Translate ToolCmdLibBtnEdit}"
                                AutomationProperties.Name="{loc:Translate ToolCmdLibBtnEdit}"
                                Style="{DynamicResource GhostButtonStyle}"
                                FontSize="{StaticResource FontSizeBodyLarge}" MinWidth="{StaticResource CmdLibIconButtonSize}" Height="{StaticResource CmdLibIconButtonSize}"
                                Padding="{StaticResource SpacingXs}"
                                Margin="{StaticResource MarginInlineXs}" TabIndex="7"/>
                        <!-- Unlike Edit and Delete this has no visibility gate: copying a
                             shipped action into your own library is the only way to get a
                             variant of one, since they cannot be edited. -->
                        <Button Command="{Binding DuplicateSelectedCommand}"
                                x:Name="BtnDuplicate"
                                Content="&#xF413;" FontFamily="{StaticResource FontFamilyIcons}"
                                ToolTip="{loc:Translate ToolCmdLibDuplicate}"
                                AutomationProperties.Name="{loc:Translate ToolCmdLibDuplicate}"
                                Style="{DynamicResource GhostButtonStyle}"
                                FontSize="{StaticResource FontSizeBodyLarge}" MinWidth="{StaticResource CmdLibIconButtonSize}" Height="{StaticResource CmdLibIconButtonSize}"
                                Padding="{StaticResource SpacingXs}"
                                Margin="{StaticResource MarginInlineXs}" TabIndex="8"/>
                        <Button Command="{Binding DeleteSelectedCommand}"
                                x:Name="BtnDelete"
                                Content="&#xE74D;" FontFamily="{StaticResource FontFamilyIcons}"
                                Visibility="{Binding CanEditSelected, Converter={StaticResource BoolToVisibilityConverter}}"
                                ToolTip="{loc:Translate ToolCmdLibBtnDelete}"
                                AutomationProperties.Name="{loc:Translate ToolCmdLibBtnDelete}"
                                Style="{DynamicResource GhostButtonStyle}"
                                FontSize="{StaticResource FontSizeBodyLarge}" MinWidth="{StaticResource CmdLibIconButtonSize}" Height="{StaticResource CmdLibIconButtonSize}"
                                Padding="{StaticResource SpacingXs}"
                                TabIndex="9"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="BtnCopy"
                                Command="{Binding CopyCommand}"
                                IsEnabled="{Binding IsCommandValid}"
                                ToolTip="{Binding CopyTooltip}"
                                ToolTipService.ShowOnDisabled="True"
                                Content="{loc:Translate ToolCmdLibBtnCopy}"
                                AutomationProperties.Name="{loc:Translate ToolCmdLibBtnCopy}"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Padding="{StaticResource PaddingButtonCopy}"
                                FontSize="{StaticResource FontSizeBody}"
                                Margin="{StaticResource MarginInlineSm}" TabIndex="10"/>
                        <!-- Insert sits between Copy and Send: it reaches the terminal like Send and
                             runs nothing, like Copy. Enabled under Send's condition. -->
                        <Button x:Name="BtnInsert"
                                Command="{Binding InsertCommand}"
                                IsEnabled="{Binding IsSendEnabled}"
                                Visibility="{Binding IsInsertVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                ToolTip="{loc:Translate ToolCmdLibBtnInsertTooltip}"
                                ToolTipService.ShowOnDisabled="True"
                                Content="{loc:Translate ToolCmdLibBtnInsert}"
                                AutomationProperties.Name="{loc:Translate ToolCmdLibBtnInsert}"
                                AutomationProperties.HelpText="{loc:Translate ToolCmdLibBtnInsertTooltip}"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Padding="{StaticResource PaddingButtonCopy}"
                                FontSize="{StaticResource FontSizeBody}"
                                Margin="{StaticResource MarginInlineSm}" TabIndex="11"/>
                        <Button x:Name="BtnSend"
                                Command="{Binding SendCommand}"
                                IsEnabled="{Binding IsSendEnabled}"
                                Visibility="{Binding IsSendVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                ToolTip="{Binding SendTooltip}"
                                ToolTipService.ShowOnDisabled="True"
                                Content="{loc:Translate ToolCmdLibBtnSend}"
                                AutomationProperties.Name="{loc:Translate ToolCmdLibBtnSend}"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                Padding="{StaticResource PaddingButtonPrimary}"
                                FontSize="{StaticResource FontSizeBody}"
                                TabIndex="12"/>
                        <!-- IsChecked is the only mutator, and it is two-way on purpose. With a
                             one-way IsChecked beside a Command, anything that drives the control
                             through the UIA Toggle pattern - an automation client, a screen reader -
                             flips the button's own state without ever running the Command, and the
                             button then reads "on" over a closed panel. Measured on the running app
                             on 2026-09-19. -->
                        <ToggleButton x:Name="BtnBroadcastToggle"
                                      IsChecked="{Binding IsBroadcastPanelOpen, Mode=TwoWay}"
                                      Visibility="{Binding CanOfferBroadcast, Converter={StaticResource BoolToVisibilityConverter}}"
                                      Content="&#xE8A7;" FontFamily="{StaticResource FontFamilyIcons}"
                                      ToolTip="{loc:Translate ToolCmdLibBroadcastToggleTooltip}"
                                      AutomationProperties.Name="{loc:Translate ToolCmdLibBroadcastToggleTooltip}"
                                      Style="{DynamicResource ToolbarToggleButtonStyle}"
                                      FontSize="{StaticResource FontSizeBodyLarge}" MinWidth="{StaticResource CmdLibIconButtonSize}" Height="{StaticResource CmdLibIconButtonSize}"
                                      Padding="{StaticResource SpacingXs}"
                                      Margin="{StaticResource MarginInlineSm}" TabIndex="13"/>
                    </StackPanel>
                    <!-- Inline hint shown only for non-injectable sessions (RDP/VNC/etc.):
                         command is ready but there is no terminal sink to Send into,
                         so guide the user to Copy and paste manually. -->
                    <TextBlock x:Name="CopyHintText"
                               Text="{loc:Translate ToolCmdLibCopyHintNoTerminal}"
                               AutomationProperties.Name="{loc:Translate ToolCmdLibCopyHintNoTerminal}"
                               Visibility="{Binding ShowCopyHint, Converter={StaticResource BoolToVisibilityConverter}}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="{StaticResource FontSizeCaption}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="{StaticResource MarginInlineSm}"/>
                </DockPanel>

                <!-- Broadcast panel: the open terminals this command can be sent to at once.
                     Shown only when there is more than one, because with a single terminal the
                     Send button already is the whole feature. -->
                <Border Grid.Row="2"
                        Visibility="{Binding IsBroadcastPanelOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="{StaticResource SpacingMd}">
                    <StackPanel>
                        <DockPanel Margin="{StaticResource MarginDetailRow}">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="{loc:Translate ToolCmdLibBroadcastHeader}"
                                       FontWeight="SemiBold"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button Command="{Binding SelectAllBroadcastTargetsCommand}"
                                        Content="{loc:Translate ToolCmdLibBroadcastSelectAll}"
                                        AutomationProperties.Name="{loc:Translate ToolCmdLibBroadcastSelectAll}"
                                        Style="{DynamicResource GhostButtonStyle}"
                                        FontSize="{StaticResource FontSizeCaption}"
                                        Padding="6,2"
                                        Margin="{StaticResource MarginInlineXs}"/>
                                <Button Command="{Binding ClearBroadcastSelectionCommand}"
                                        Content="{loc:Translate ToolCmdLibBroadcastSelectNone}"
                                        AutomationProperties.Name="{loc:Translate ToolCmdLibBroadcastSelectNone}"
                                        Style="{DynamicResource GhostButtonStyle}"
                                        FontSize="{StaticResource FontSizeCaption}"
                                        Padding="6,2"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- The panel is offered whenever the library sits in a session, so it can
                             legitimately open with nothing open to send to. Saying so is cheaper
                             than a toggle that hides itself and cannot be found. -->
                        <TextBlock Text="{loc:Translate ToolCmdLibBroadcastNoTerminals}"
                                   AutomationProperties.Name="{loc:Translate ToolCmdLibBroadcastNoTerminals}"
                                   Visibility="{Binding HasNoBroadcastTargets, Converter={StaticResource BoolToVisibilityConverter}}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   TextWrapping="Wrap" Margin="{StaticResource CmdLibRowMargin}"/>

                        <ScrollViewer MaxHeight="{StaticResource CmdLibBroadcastListMaxHeight}" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding BroadcastTargets}"
                                          AutomationProperties.Name="{loc:Translate ToolCmdLibBroadcastHeader}">
                                <ItemsControl.ItemContainerStyle>
                                    <!-- The name goes on the container: set in the template it is inert, and the
                                         row announced its class name to a screen reader. -->
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Content="{Binding AccessibleName}"
                                                  AutomationProperties.Name="{Binding AccessibleName}"
                                                  FontSize="{StaticResource FontSizeCaption}"
                                                  Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <DockPanel Margin="{StaticResource MarginSubsectionTop}">
                            <Button DockPanel.Dock="Right"
                                    x:Name="BtnBroadcast"
                                    Command="{Binding BroadcastCommand}"
                                    Content="{Binding BroadcastButtonText}"
                                    AutomationProperties.Name="{Binding BroadcastButtonText}"
                                    Style="{DynamicResource PrimaryButtonStyle}"
                                    Padding="{StaticResource PaddingButtonPrimary}"
                                    FontSize="{StaticResource FontSizeBody}"
                                    HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding BroadcastStatus, NotifyOnTargetUpdated=True}"
                                       Visibility="{Binding HasBroadcastStatus, Converter={StaticResource BoolToVisibilityConverter}}"
                                       AutomationProperties.LiveSetting="Polite"
                                       behaviors:LiveRegionBehavior.AnnounceOnTargetUpdated="True"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="{StaticResource MarginInlineSm}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════ HISTORY PANEL ═══════════ -->
        <Border x:Name="HistoryPanel" DockPanel.Dock="Bottom"
                Visibility="{Binding IsHistoryVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Border.MaxHeight>
                <MultiBinding Converter="{StaticResource RemainingHeightConverter}">
                    <Binding Path="ActualHeight" ElementName="BodyPanel"/>
                    <Binding Source="{StaticResource CmdLibActionListMinHeight}"/>
                    <Binding Source="{StaticResource CmdLibHistoryMaxHeight}"/>
                    <Binding Path="Height" RelativeSource="{RelativeSource Self}"/>
                </MultiBinding>
            </Border.MaxHeight>
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="{StaticResource CmdLibPanelHeaderMargin}">
                    <Button DockPanel.Dock="Right"
                            Content="&#xE74D;" FontFamily="{StaticResource FontFamilyIcons}"
                            Command="{Binding ClearHistoryCommand}"
                            ToolTip="{loc:Translate ToolCmdLibHistoryClear}"
                            AutomationProperties.Name="{loc:Translate ToolCmdLibHistoryClear}"
                            Style="{DynamicResource GhostButtonStyle}"
                            FontSize="{StaticResource FontSizeBodyLarge}" MinWidth="{StaticResource CmdLibIconButtonSize}" Height="{StaticResource CmdLibIconButtonSize}"
                            Padding="{StaticResource SpacingXs}"/>
                    <!-- Only offered when the library was opened for a host: without one there is
                         nothing to compare a row against. -->
                    <CheckBox DockPanel.Dock="Right"
                              Content="{loc:Translate ToolCmdLibHistoryThisHostOnly}"
                              AutomationProperties.Name="{loc:Translate ToolCmdLibHistoryThisHostOnly}"
                              IsChecked="{Binding HistoryThisHostOnly, Mode=TwoWay}"
                              Visibility="{Binding HasTargetHost, Converter={StaticResource BoolToVisibilityConverter}}"
                              VerticalAlignment="Center"
                              Margin="{StaticResource MarginInlineControl}"/>
                    <TextBlock Text="{loc:Translate ToolCmdLibHistoryTitle}"
                               FontSize="{StaticResource FontSizeBody}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Translate ToolCmdLibCopied}"
                               Visibility="{Binding IsHistoryCopyFeedbackVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource SuccessTextBrush}"
                               VerticalAlignment="Center"
                               Margin="{StaticResource MarginInlineControl}"/>
                </DockPanel>
                <!-- Docked before the list so the list stays the panel's last child and fills
                     it. As the last child this text took the fill even while collapsed, and the
                     list was docked left at the width of its content: timestamp, Copy and Replay
                     ended around the middle of the panel. -->
                <TextBlock DockPanel.Dock="Bottom"
                           Text="{loc:Translate ToolCmdLibHistoryEmpty}"
                           Visibility="{Binding IsHistoryEmpty, Converter={StaticResource BoolToVisibilityConverter}}"
                           Style="{StaticResource ToolEmptyStateTextStyle}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,8"/>
                <ListView ItemsSource="{Binding HistoryEntries}"
                          Background="Transparent" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <!-- Title, host, sent or copied, and time, as the action rows do it:
                                 the row's TextBlocks give its container no name of their own. -->
                            <Setter Property="behaviors:ItemContainerAccessibilityBehavior.IsEnabled" Value="True"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="12,4"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="Bd"
                                                Padding="{TemplateBinding Padding}"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="0,0,0,1">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftDoubleClick"
                                                              Command="{Binding DataContext.CopyHistoryEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding GeneratedCommand}"/>
                                            </Border.InputBindings>
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource SurfaceBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource CardBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <!-- Replay sits before Copy, so the two read left to right in
                                     increasing commitment: put it back in the generator, or
                                     just take the text. -->
                                <Button DockPanel.Dock="Right"
                                        Content="&#xE72C;" FontFamily="{StaticResource FontFamilyIcons}"
                                        Command="{Binding DataContext.ReplayHistoryEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding CanReplay, Converter={StaticResource BoolToVisibilityConverter}}"
                                        ToolTip="{loc:Translate ToolCmdLibHistoryReplay}"
                                        AutomationProperties.Name="{loc:Translate ToolCmdLibHistoryReplay}"
                                        Style="{DynamicResource GhostButtonStyle}"
                                        FontSize="{StaticResource IconSizeSmall}" Width="{StaticResource TargetMinSize}" Height="{StaticResource TargetMinSize}"
                                        Padding="{StaticResource SpacingXxs}" VerticalAlignment="Center"
                                        Margin="{StaticResource MarginInlineStart}" Focusable="False"/>
                                <Button DockPanel.Dock="Right"
                                        Content="&#xE8C8;" FontFamily="{StaticResource FontFamilyIcons}"
                                        Command="{Binding DataContext.CopyHistoryEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding GeneratedCommand}"
                                        Visibility="{Binding IsReadable, Converter={StaticResource BoolToVisibilityConverter}}"
                                        ToolTip="{loc:Translate ToolCmdLibBtnCopy}"
                                        AutomationProperties.Name="{loc:Translate ToolCmdLibBtnCopy}"
                                        Style="{DynamicResource GhostButtonStyle}"
                                        FontSize="{StaticResource IconSizeSmall}" Width="{StaticResource TargetMinSize}" Height="{StaticResource TargetMinSize}"
                                        Padding="{StaticResource SpacingXxs}" VerticalAlignment="Center"
                                        Margin="{StaticResource MarginInlineStart}" Focusable="False"/>
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding Timestamp}"
                                           FontSize="{StaticResource FontSizeSmallCaption}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="{StaticResource MarginInlineControl}"/>
                                <!-- Sent or copied: where the text went, never how it ended.
                                     A terminal has no return channel, so there is no exit code. -->
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{loc:Translate ToolCmdLibHistorySent}"
                                           Visibility="{Binding IsExecuted, Converter={StaticResource BoolToVisibilityConverter}}"
                                           FontSize="{StaticResource FontSizeSmallCaption}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentTextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="{StaticResource MarginInlineControl}"/>
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{loc:Translate ToolCmdLibHistoryCopied}"
                                           Visibility="{Binding IsCopied, Converter={StaticResource BoolToVisibilityConverter}}"
                                           FontSize="{StaticResource FontSizeSmallCaption}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="{StaticResource MarginInlineControl}"/>
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding TargetHost}"
                                                   Visibility="{Binding HasTargetHost, Converter={StaticResource BoolToVisibilityConverter}}"
                                                   FontSize="{StaticResource FontSizeSmallCaption}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="{StaticResource MarginInlineControl}"/>
                                        <TextBlock Text="{Binding ActionTitle}"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  Visibility="{Binding IsReadable, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding GeneratedCommand}"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   FontFamily="{StaticResource FontFamilyMonospace}"
                                                   Foreground="{DynamicResource AccentTextBrush}"
                                                   TextWrapping="NoWrap"/>
                                    </ScrollViewer>
                                    <!-- A sealed row whose key is gone. The title and the
                                         timestamp above still say what ran and when, which is
                                         why they are kept in clear. -->
                                    <TextBlock Text="{loc:Translate ToolCmdLibHistoryLocked}"
                                               Visibility="{Binding IsUnreadable, Converter={StaticResource BoolToVisibilityConverter}}"
                                               FontSize="{StaticResource FontSizeCaption}"
                                               FontStyle="Italic"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="NoWrap"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </DockPanel>
        </Border>

        <!-- ═══════════ RUNBOOKS PANEL ═══════════ -->
        <Border DockPanel.Dock="Bottom"
                x:Name="RunbooksPanel"
                Visibility="{Binding IsRunbooksVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Border.MaxHeight>
                <MultiBinding Converter="{StaticResource RemainingHeightConverter}">
                    <Binding Path="ActualHeight" ElementName="BodyPanel"/>
                    <Binding Source="{StaticResource CmdLibActionListMinHeight}"/>
                    <Binding Source="{StaticResource CmdLibRunbooksMaxHeight}"/>
                    <Binding Path="Height" RelativeSource="{RelativeSource Self}"/>
                </MultiBinding>
            </Border.MaxHeight>
            <Grid>
                <!-- The list of runbooks -->
                <DockPanel x:Name="RunbookListPanel"
                           Visibility="{Binding IsRunbookListVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DockPanel DockPanel.Dock="Top" Margin="{StaticResource CmdLibPanelHeaderMargin}">
                        <Button DockPanel.Dock="Right"
                                Content="&#xE768;" FontFamily="{StaticResource FontFamilyIcons}"
                                Command="{Binding RunRunbookCommand}"
                                ToolTip="{loc:Translate ToolCmdLibRunbookRun}"
                                AutomationProperties.Name="{loc:Translate ToolCmdLibRunbookRun}"
                                Style="{DynamicResource GhostButtonStyle}"
                                FontSize="{StaticResource FontSizeBodyLarge}" MinWidth="{StaticResource CmdLibIconButtonSize}" Height="{StaticResource CmdLibIconButtonSize}" Padding="{StaticResource SpacingXs}"/>
                        <Button DockPanel.Dock="Right"
                                Content="&#xE74D;" FontFamily="{StaticResource FontFamilyIcons}"
                                Command="{Binding DeleteRunbookCommand}"
                                ToolTip="{loc:Translate ToolCmdLibRunbookDelete}"
                                AutomationProperties.Name="{loc:Translate ToolCmdLibRunbookDelete}"
                                Style="{DynamicResource GhostButtonStyle}"
                                FontSize="{StaticResource FontSizeBodyLarge}" MinWidth="{StaticResource CmdLibIconButtonSize}" Height="{StaticResource CmdLibIconButtonSize}" Padding="{StaticResource SpacingXs}"/>
                        <Button DockPanel.Dock="Right"
                                Content="&#xF413;" FontFamily="{StaticResource FontFamilyIcons}"
                                Command="{Binding DuplicateRunbookCommand}"
                                ToolTip="{loc:Translate ToolCmdLibRunbookDuplicate}"
                                AutomationProperties.Name="{loc:Translate ToolCmdLibRunbookDuplicate}"
                                Style="{DynamicResource GhostButtonStyle}"
                                FontSize="{StaticResource FontSizeBodyLarge}" MinWidth="{StaticResource CmdLibIconButtonSize}" Height="{StaticResource CmdLibIconButtonSize}" Padding="{StaticResource SpacingXs}"/>
                        <Button DockPanel.Dock="Right"
                                Content="&#xE70F;" FontFamily="{StaticResource FontFamilyIcons}"
                                Command="{Binding EditRunbookCommand}"
                                ToolTip="{loc:Translate ToolCmdLibRunbookEdit}"
                                AutomationProperties.Name="{loc:Translate ToolCmdLibRunbookEdit}"
                                Style="{DynamicResource GhostButtonStyle}"
                                FontSize="{StaticResource FontSizeBodyLarge}" MinWidth="{StaticResource CmdLibIconButtonSize}" Height="{StaticResource CmdLibIconButtonSize}" Padding="{StaticResource SpacingXs}"/>
                        <Button DockPanel.Dock="Right"
                                Content="&#xE710;" FontFamily="{StaticResource FontFamilyIcons}"
                                Command="{Binding NewRunbookCommand}"
                                ToolTip="{loc:Translate ToolCmdLibRunbookNew}"
                                AutomationProperties.Name="{loc:Translate ToolCmdLibRunbookNew}"
                                Style="{DynamicResource GhostButtonStyle}"
                                FontSize="{StaticResource FontSizeBodyLarge}" MinWidth="{StaticResource CmdLibIconButtonSize}" Height="{StaticResource CmdLibIconButtonSize}" Padding="{StaticResource SpacingXs}"/>
                        <TextBlock Text="{loc:Translate ToolCmdLibRunbooksTitle}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom"
                               Text="{loc:Translate ToolCmdLibRunbooksEmpty}"
                               Visibility="{Binding IsRunbooksEmpty, Converter={StaticResource BoolToVisibilityConverter}}"
                               Style="{StaticResource ToolEmptyStateTextStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,8"/>
                    <ListView ItemsSource="{Binding Runbooks}"
                              SelectedItem="{Binding SelectedRunbook, Mode=TwoWay}"
                              AutomationProperties.Name="{loc:Translate ToolCmdLibRunbooksTitle}"
                              Background="Transparent" BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="behaviors:ItemContainerAccessibilityBehavior.IsEnabled" Value="True"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="12,4"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding LastRunText}"
                                               FontSize="{StaticResource FontSizeSmallCaption}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="{StaticResource MarginInlineControl}"/>
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding StepCountText}"
                                               FontSize="{StaticResource FontSizeSmallCaption}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="{StaticResource MarginInlineControl}"/>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="{StaticResource FontSizeBody}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>

                <!-- A run: the variables, the steps with their status, the current command, and
                     Send / Insert / Copy / Skip / Stop. Nothing advances by itself: a terminal
                     returns no exit code, so the operator reads the output and decides. -->
                <DockPanel x:Name="RunbookRunPanel"
                           DataContext="{Binding ActiveRun}"
                           Visibility="{Binding DataContext.IsRunbookRunVisible, ElementName=RunbooksPanel, Converter={StaticResource BoolToVisibilityConverter}}"
                           Margin="12,8,12,8">
                    <!-- The status takes every pixel the Stop button leaves: the mode line sat beside
                         it in the same row and left the "Running: ..." text about 65 px. The mode
                         goes under the status, and both trim only as a last resort. -->
                    <Grid x:Name="RunbookRunHeader" DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="{Binding Title}"
                                   ToolTip="{Binding Title}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="{Binding ExecutionModeText}"
                                   ToolTip="{loc:Translate ToolCmdLibRunbookModeTooltip}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="1"
                                Content="{loc:Translate ToolCmdLibRunbookStop}"
                                Command="{Binding StopCommand}"
                                ToolTip="{loc:Translate ToolCmdLibRunbookStopTooltip}"
                                AutomationProperties.Name="{loc:Translate ToolCmdLibRunbookStop}"
                                VerticalAlignment="Center"
                                Margin="{StaticResource MarginInlineControl}"
                                Style="{DynamicResource SecondaryButtonStyle}"/>
                    </Grid>

                    <StackPanel DockPanel.Dock="Top"
                                Visibility="{Binding HasVariables, Converter={StaticResource BoolToVisibilityConverter}}"
                                Margin="{StaticResource CmdLibBlockMarginTop}">
                        <TextBlock Text="{loc:Translate ToolCmdLibRunbookRunVariables}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <ItemsControl ItemsSource="{Binding Variables}">
                            <ItemsControl.ItemContainerStyle>
                                <!-- The name goes on the container: set in the template it is inert, and the
                                     row announced its class name to a screen reader. -->
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Reference}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="{StaticResource CmdLibRowMargin}">
                                        <TextBlock DockPanel.Dock="Left"
                                                   Text="{Binding Reference}" Width="{StaticResource CmdLibRunbookVariableLabelWidth}"
                                                   FontFamily="{StaticResource FontFamilyMonospace}"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="{Binding Reference}"
                                                 FontFamily="{StaticResource FontFamilyMonospace}"
                                                 Padding="{StaticResource PaddingInput}"
                                                 Background="{DynamicResource CardBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderBrush="{DynamicResource BorderBrush}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- The current step: its command, why it cannot go, and the five gestures. -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="{StaticResource CmdLibBlockMarginTop}">
                        <TextBlock Text="{loc:Translate ToolCmdLibRunbookRunCommand}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox Text="{Binding CurrentCommand, Mode=OneWay}"
                                 IsReadOnly="True"
                                 AutomationProperties.Name="{loc:Translate ToolCmdLibRunbookRunCommand}"
                                 FontFamily="{StaticResource FontFamilyMonospace}"
                                 TextWrapping="Wrap"
                                 Padding="{StaticResource PaddingInput}"
                                 Background="{DynamicResource CardBrush}"
                                 Foreground="{DynamicResource AccentTextBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"/>
                        <TextBlock Text="{Binding CurrentValidationError}"
                                   Visibility="{Binding HasCurrentValidationError, Converter={StaticResource BoolToVisibilityConverter}}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{DynamicResource ErrorTextBrush}"
                                   TextWrapping="Wrap" Margin="{StaticResource CmdLibCaptionMarginTop}"/>
                        <TextBlock Text="{loc:Translate ToolCmdLibRunbookNoTerminal}"
                                   Visibility="{Binding ShowNoTerminalHint, Converter={StaticResource BoolToVisibilityConverter}}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="{StaticResource CmdLibCaptionMarginTop}"/>
                        <TextBlock Text="{loc:Translate ToolCmdLibRunbookFinished}"
                                   Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibilityConverter}}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{DynamicResource SuccessTextBrush}"
                                   TextWrapping="Wrap" Margin="{StaticResource CmdLibCaptionMarginTop}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource CmdLibBlockMarginTop}">
                            <Button Content="{loc:Translate ToolCmdLibRunbookSkip}"
                                    Command="{Binding SkipCommand}"
                                    AutomationProperties.Name="{loc:Translate ToolCmdLibRunbookSkip}"
                                    Style="{DynamicResource SecondaryButtonStyle}"
                                    Margin="{StaticResource MarginInlineSm}"/>
                            <Button x:Name="BtnRunCopy"
                                    Content="{loc:Translate ToolCmdLibBtnCopy}"
                                    Command="{Binding CopyCommand}"
                                    AutomationProperties.Name="{loc:Translate ToolCmdLibBtnCopy}"
                                    Style="{DynamicResource SecondaryButtonStyle}"
                                    Margin="{StaticResource MarginInlineSm}"/>
                            <Button Content="{loc:Translate ToolCmdLibBtnInsert}"
                                    Command="{Binding InsertCommand}"
                                    ToolTip="{loc:Translate ToolCmdLibBtnInsertTooltip}"
                                    AutomationProperties.Name="{loc:Translate ToolCmdLibBtnInsert}"
                                    Style="{DynamicResource SecondaryButtonStyle}"
                                    Margin="{StaticResource MarginInlineSm}"/>
                            <Button x:Name="BtnRunSend"
                                    Content="{loc:Translate ToolCmdLibBtnSend}"
                                    Command="{Binding SendCommand}"
                                    AutomationProperties.Name="{loc:Translate ToolCmdLibBtnSend}"
                                    Style="{DynamicResource PrimaryButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>

                    <ListView ItemsSource="{Binding Steps}"
                              AutomationProperties.Name="{loc:Translate ToolCmdLibRunbookSectionSteps}"
                              Background="Transparent" BorderThickness="0"
                              Margin="{StaticResource CmdLibBlockMarginTop}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="behaviors:ItemContainerAccessibilityBehavior.IsEnabled" Value="True"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="4,2"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding StatusText}"
                                               FontSize="{StaticResource FontSizeSmallCaption}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="{StaticResource MarginInlineControl}"/>
                                    <TextBlock DockPanel.Dock="Left"
                                               Text="{Binding Number}"
                                               Width="{StaticResource CmdLibRunbookStepNumberWidth}"
                                               FontSize="{StaticResource FontSizeCaption}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ValidationError}"
                                                   Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVisibilityConverter}}"
                                                   FontSize="{StaticResource FontSizeSmallCaption}"
                                                   Foreground="{DynamicResource ErrorTextBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </Grid>
        </Border>

        <!-- ═══════════ ACTION LIST ═══════════ -->
        <Grid>
            <ListView
                      x:Name="ActionList"
                      Background="Transparent" BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ItemsSource="{Binding ActionsView}"
                      SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                      AutomationProperties.Name="{loc:Translate ToolCmdLibTitle}"
                      TabIndex="6">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <!-- The row's text lives in TextBlocks inside a DockPanel, none of which
                             contributes to the container's automation name, so without this the
                             row announces the bound entry's class name. -->
                        <Setter Property="behaviors:ItemContainerAccessibilityBehavior.IsEnabled" Value="True"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="{StaticResource ToolFooterPadding}"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="Bd"
                                            Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="0,0,0,1">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource SurfaceBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource CardBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border Padding="12,8,12,4"
                                        Background="{DynamicResource BackgroundBrush}">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="{StaticResource FontSizeBodyLarge}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentTextBrush}"/>
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <!-- Favorite toggle -->
                            <!-- 24x24 kept intentionally: dense list-row context, favorite toggling rides a larger row hit area. -->
                            <Button DockPanel.Dock="Right"
                                    Content="{Binding FavoriteIcon}"
                                    Command="{Binding DataContext.ToggleFavoriteByIdCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Source.Id}"
                                    ToolTip="{Binding FavoriteTooltip}"
                                    AutomationProperties.Name="{Binding FavoriteTooltip}"
                                    Style="{DynamicResource GhostButtonStyle}"
                                    FontSize="{StaticResource FontSizeBodyLarge}" Width="{StaticResource TargetMinSize}" Height="{StaticResource TargetMinSize}"
                                    VerticalAlignment="Center" Margin="{StaticResource MarginInlineStart}"
                                    Foreground="{DynamicResource WarningTextBrush}"/>
                            <!-- Risk badge -->
                            <Border DockPanel.Dock="Left"
                                    MinWidth="{StaticResource CmdLibRiskBadgeMinWidth}"
                                    CornerRadius="{StaticResource CornerRadiusSm}" Padding="4,1"
                                    VerticalAlignment="Center" Margin="{StaticResource MarginLabelInline}"
                                    ToolTip="{Binding RiskLabel}">
                                <Border.Background>
                                    <MultiBinding Converter="{StaticResource ResourceKeyToBrushConverter}">
                                        <Binding Path="RiskBrushKey"/>
                                        <Binding Path="DataContext.ThemeRevision" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    </MultiBinding>
                                </Border.Background>
                                <TextBlock Text="{Binding RiskBadge}"
                                           HorizontalAlignment="Center"
                                           FontSize="{StaticResource FontSizeSmallCaption}"
                                           FontWeight="Bold" Foreground="{DynamicResource BadgeTextBrush}"/>
                            </Border>
                            <!-- Platform badge -->
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding PlatformLabel}"
                                       FontSize="{StaticResource FontSizeSmallCaption}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="{StaticResource MarginInlineControl}"/>
                            <!-- Title + description -->
                            <StackPanel>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Description}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <!-- The command itself, for the template a click would open on under
                                     the current platform filter. Not part of the row's spoken name,
                                     which stays title then badges. -->
                                <TextBlock Text="{Binding CommandPreview}"
                                           FontFamily="{StaticResource FontFamilyMonospace}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- No results -->
            <TextBlock
                       Text="{loc:Translate ToolCmdLibNoResults}"
                       Visibility="{Binding IsNoResultsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                       Style="{StaticResource ToolEmptyStateTextStyle}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- Empty state -->
            <Border
                    Style="{StaticResource ToolEmptyStateStyle}"
                    Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource FontFamilyIcons}"
                               Style="{StaticResource ToolEmptyStateIconStyle}"
                               Focusable="False"/>
                    <TextBlock Text="{Binding EmptyStateMessage}"
                               Style="{StaticResource ToolEmptyStateTextStyle}"/>
                </StackPanel>
            </Border>

            <!-- The grip that resizes whichever bottom panel is open. It lies over the bottom
                 edge of the list rather than in a row of its own, so it costs the list none of
                 its reserve, and it sits exactly on the top edge of the open panel. A Thumb
                 rather than a GridSplitter, which needs a Grid: the body is a DockPanel on
                 purpose (see its comment above). The drag, the arrow keys and the double-click
                 reset live in the code-behind. -->
            <Thumb x:Name="BottomPanelGrip"
                   VerticalAlignment="Bottom"
                   Height="{StaticResource CmdLibBottomPanelGripHeight}"
                   Cursor="SizeNS"
                   Focusable="True"
                   IsTabStop="True"
                   Visibility="{Binding IsBottomPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                   ToolTip="{loc:Translate ToolCmdLibBottomPanelGripTooltip}"
                   AutomationProperties.Name="{loc:Translate A11yGridSplitter}"
                   AutomationProperties.HelpText="{loc:Translate ToolCmdLibBottomPanelGripTooltip}"
                   DragDelta="OnBottomPanelGripDragDelta"
                   DragCompleted="OnBottomPanelGripDragCompleted"
                   MouseDoubleClick="OnBottomPanelGripDoubleClick"
                   KeyDown="OnBottomPanelGripKeyDown">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="GripBackground" Background="Transparent">
                            <Border x:Name="GripBar"
                                    Width="{StaticResource CmdLibBottomPanelGripBarWidth}"
                                    Height="{StaticResource CmdLibBottomPanelGripBarHeight}"
                                    CornerRadius="{StaticResource CornerRadiusSm}"
                                    Background="{DynamicResource BorderStrongBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GripBar" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="GripBar" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="GripBar" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
        </DockPanel>
    </Grid>
</UserControl>
