<Window x:Class="Heimdall.App.Views.Dialogs.AsciinemaPlayerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:Heimdall.App.Behaviors"
        xmlns:loc="clr-namespace:Heimdall.App.Localization"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{loc:Translate CastPlayerDialogTitle}"
        Width="920"
        Height="620"
        MinWidth="680"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        ResizeMode="CanResizeWithGrip"
        behaviors:WorkingAreaMinimumBehavior.IsEnabled="True"
        behaviors:DialogChromeBehavior.HideCaptionButtons="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/DialogCommonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="{StaticResource SpacingMd}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnOpen"
                        Content="{loc:Translate CastPlayerBtnOpen}"
                        Click="OnOpenClick"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Margin="0,0,8,0"
                        AutomationProperties.Name="{loc:Translate CastPlayerBtnOpen}"/>
                <Button x:Name="BtnClose"
                        Content="{loc:Translate BtnClose}"
                        IsCancel="True"
                        Click="OnCloseClick"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        AutomationProperties.Name="{loc:Translate BtnClose}"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TxtTitle"
                           Text="{loc:Translate CastPlayerDialogTitle}"
                           FontSize="{StaticResource FontSizeTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="TxtMeta"
                           Text="{loc:Translate CastPlayerEmptyHint}"
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DockPanel>

        <!-- Embedded xterm.js WebView2 surface -->
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerRadiusSm}"
                ClipToBounds="True">
            <wv2:WebView2 x:Name="PlayerWebView" Focusable="False"/>
        </Border>

        <!-- Transport controls -->
        <Border Grid.Row="2" Style="{StaticResource DialogSectionCardStyle}" Margin="0,10,0,0" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnPlayPause"
                        Grid.Column="0"
                        Content="{loc:Translate CastPlayerBtnPlay}"
                        Click="OnPlayPauseClick"
                        IsEnabled="False"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        MinWidth="84"
                        Margin="0,0,6,0"
                        AutomationProperties.Name="{loc:Translate CastPlayerBtnPlay}"/>

                <Button x:Name="BtnRestart"
                        Grid.Column="1"
                        Content="{loc:Translate CastPlayerBtnRestart}"
                        Click="OnRestartClick"
                        IsEnabled="False"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Margin="0,0,12,0"
                        AutomationProperties.Name="{loc:Translate CastPlayerBtnRestart}"/>

                <Slider x:Name="TimelineSlider"
                        Grid.Column="2"
                        Minimum="0"
                        Maximum="1"
                        Value="0"
                        IsEnabled="False"
                        VerticalAlignment="Center"
                        ValueChanged="OnTimelineSliderValueChanged"
                        AutomationProperties.Name="{loc:Translate CastPlayerTimelineA11y}"/>

                <TextBlock x:Name="TxtClock"
                           Grid.Column="3"
                           Text="00:00 / 00:00"
                           FontFamily="{StaticResource FontFamilyMonospace}"
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           Margin="12,0,12,0"/>

                <ComboBox x:Name="CmbSpeed"
                          Grid.Column="4"
                          MinWidth="72"
                          SelectedIndex="1"
                          SelectionChanged="OnSpeedSelectionChanged"
                          Margin="0,0,10,0"
                          AutomationProperties.Name="{loc:Translate CastPlayerSpeedLabel}">
                    <ComboBoxItem Content="0.5x" Tag="0.5"/>
                    <ComboBoxItem Content="1x" Tag="1.0"/>
                    <ComboBoxItem Content="2x" Tag="2.0"/>
                    <ComboBoxItem Content="4x" Tag="4.0"/>
                </ComboBox>

                <CheckBox x:Name="ChkIdleCap"
                          Grid.Column="5"
                          Content="{loc:Translate CastPlayerIdleCapLabel}"
                          IsChecked="True"
                          Checked="OnIdleCapChanged"
                          Unchecked="OnIdleCapChanged"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="{loc:Translate CastPlayerIdleCapLabel}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
