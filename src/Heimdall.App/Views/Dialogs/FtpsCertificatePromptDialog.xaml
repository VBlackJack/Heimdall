<Window x:Class="Heimdall.App.Views.Dialogs.FtpsCertificatePromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:Heimdall.App.Behaviors"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:loc="clr-namespace:Heimdall.App.Localization"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Heimdall.App.ViewModels.Dialogs"
        d:DataContext="{d:DesignInstance Type=vm:FtpsCertificatePromptDialogViewModel, IsDesignTimeCreatable=False}"
        mc:Ignorable="d"
        Title="{Binding HeaderText}"
        Width="760"
        SizeToContent="Height"
        MaxHeight="820"
        MinWidth="660"
        behaviors:WorkingAreaMinimumBehavior.IsEnabled="True"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/DialogCommonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

            <Style x:Key="FingerprintBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="AcceptsReturn" Value="True"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="FontFamily" Value="{StaticResource FontFamilyMonospace}"/>
                <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="MinHeight" Value="62"/>
            </Style>

            <Style x:Key="WarningCardStyle" TargetType="Border" BasedOn="{StaticResource DialogSectionCardStyle}">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMismatch}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="WarningTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DialogSectionDescriptionStyle}">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMismatch}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="HeaderIconStyle" TargetType="Path">
                <Setter Property="Width" Value="26"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="Data" Value="{DynamicResource Geo.Status.Error}"/>
                <Setter Property="Stretch" Value="Uniform"/>
                <Setter Property="Fill" Value="{DynamicResource WarningBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMismatch}" Value="True">
                        <Setter Property="Fill" Value="{DynamicResource ErrorBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="HeaderTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMismatch}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="AcceptButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMismatch}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="RejectButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding RejectIsDefault}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="{StaticResource SpacingLg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Path Style="{StaticResource HeaderIconStyle}"
                      Margin="0,0,12,0"
                      VerticalAlignment="Top"/>
                <StackPanel>
                    <TextBlock Text="{Binding HeaderText}"
                               Style="{StaticResource HeaderTitleStyle}"/>
                    <TextBlock Text="{Binding EndpointText}"
                               Margin="0,6,0,0"
                               FontSize="{StaticResource FontSizeBodyLarge}"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1"
                Style="{StaticResource DialogSectionCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Style="{StaticResource DialogLabelStyle}"
                           Text="{loc:Translate FtpsCertificateSubjectLabel}"/>
                <TextBlock Grid.Row="1"
                           Margin="0,0,0,10"
                           TextWrapping="Wrap"
                           FontSize="{StaticResource FontSizeBodyLarge}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="{Binding Subject}"/>

                <TextBlock Grid.Row="2"
                           Style="{StaticResource DialogLabelStyle}"
                           Text="{loc:Translate FtpsCertificateIssuerLabel}"/>
                <TextBlock Grid.Row="3"
                           Margin="0,0,0,10"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="{Binding Issuer}"/>

                <TextBlock Grid.Row="4"
                           Style="{StaticResource DialogLabelStyle}"
                           Text="{loc:Translate FtpsCertificateValidityLabel}"/>
                <TextBlock Grid.Row="5"
                           Margin="0,0,0,10"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="{Binding ValidityText}"/>

                <TextBlock Grid.Row="6"
                           Style="{StaticResource DialogLabelStyle}"
                           Text="{loc:Translate FtpsCertificateValidationIssueLabel}"/>
                <TextBlock Grid.Row="7"
                           Margin="0,0,0,12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource ErrorTextBrush}"
                           Text="{Binding ValidationErrors}"/>

                <Grid Grid.Row="8"
                      Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Style="{StaticResource DialogLabelStyle}"
                               Text="{loc:Translate FtpsCertificatePresentedFingerprintLabel}"/>
                    <Button x:Name="CopyFingerprintButton"
                            Grid.Column="1"
                            Content="{loc:Translate FtpsCertificateCopyFingerprintButton}"
                            Command="{Binding CopyFingerprintCommand}"
                            Style="{DynamicResource GhostButtonStyle}"
                            Padding="6,2"
                            MinHeight="0"
                            FontSize="{StaticResource FontSizeCaption}"
                            ToolTip="{loc:Translate FtpsCertificateCopyFingerprintTooltip}"
                            AutomationProperties.Name="{loc:Translate FtpsCertificateCopyFingerprintButton}"/>
                </Grid>
                <TextBox x:Name="PresentedFingerprintBox"
                         Grid.Row="9"
                         Style="{StaticResource FingerprintBoxStyle}"
                         Text="{Binding PresentedFingerprint, Mode=OneWay}"/>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource WarningCardStyle}">
            <TextBlock Text="{Binding WarningText}"
                       Style="{StaticResource WarningTextStyle}"/>
        </Border>

        <WrapPanel Grid.Row="3"
                   Orientation="Horizontal"
                   HorizontalAlignment="Right"
                   Margin="0,16,0,0">
            <Button x:Name="RejectButton"
                    Margin="0,0,8,0"
                    MinWidth="104"
                    IsCancel="True"
                    IsDefault="{Binding RejectIsDefault}"
                    Content="{Binding RejectButtonText}"
                    Command="{Binding RejectCommand}"
                    Style="{StaticResource RejectButtonStyle}"
                    AutomationProperties.Name="{Binding RejectButtonText}"/>
            <Button x:Name="TrustOnceButton"
                    Margin="0,0,8,0"
                    MinWidth="212"
                    MaxWidth="260"
                    IsDefault="{Binding TrustOnceIsDefault}"
                    Command="{Binding TrustOnceCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    AutomationProperties.Name="{Binding TrustOnceButtonText}">
                <TextBlock Text="{Binding TrustOnceButtonText}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </Button>
            <Button x:Name="AcceptButton"
                    MinWidth="240"
                    MaxWidth="320"
                    IsDefault="{Binding AcceptIsDefault}"
                    Command="{Binding AcceptCommand}"
                    Style="{StaticResource AcceptButtonStyle}"
                    AutomationProperties.Name="{Binding AcceptButtonText}">
                <TextBlock Text="{Binding AcceptButtonText}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </Button>
        </WrapPanel>
    </Grid>
</Window>
