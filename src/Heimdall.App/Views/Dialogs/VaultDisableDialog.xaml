<Window x:Class="Heimdall.App.Views.Dialogs.VaultDisableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Heimdall.App.Converters"
        xmlns:loc="clr-namespace:Heimdall.App.Localization"
        xmlns:vm="clr-namespace:Heimdall.App.ViewModels.Dialogs"
        d:DataContext="{d:DesignInstance Type=vm:VaultDisableDialogViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{loc:Translate VaultDisableTitle}"
        Width="420" SizeToContent="Height" MaxHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        ResizeMode="CanResizeWithGrip"
        MinWidth="360" MinHeight="280"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow">

    <Window.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InvertBoolConverter x:Key="InvertBoolConverter"/>
    </Window.Resources>

    <Grid Margin="{StaticResource SpacingXl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Translate VaultDisablePrompt}"
                   FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,12"/>

        <!-- Warning: credentials revert to OS-level (DPAPI) protection -->
        <Border Grid.Row="1" Background="{DynamicResource CardBrush}"
                CornerRadius="{StaticResource CornerRadiusSm}" Padding="12,8" Margin="0,0,0,14">
            <TextBlock Text="{loc:Translate VaultDisableWarning}"
                       Foreground="{DynamicResource WarningTextBrush}"
                       FontSize="{StaticResource FontSizeBody}" TextWrapping="Wrap"/>
        </Border>

        <TextBlock Grid.Row="2" Text="{loc:Translate VaultFieldMasterPassword}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="{StaticResource FontSizeCaption}" Margin="0,0,0,4"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="3" TabIndex="0"
                     AutomationProperties.Name="{loc:Translate VaultFieldMasterPassword}"
                     IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}, FallbackValue=True}"
                     FontSize="{StaticResource FontSizeBody}"
                     Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8,6"
                     CaretBrush="{DynamicResource TextPrimaryBrush}"
                     KeyDown="OnPasswordKeyDown"/>

        <StackPanel Grid.Row="4" Margin="0,8,0,0">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource ErrorTextBrush}"
                       FontSize="{StaticResource FontSizeBody}" TextWrapping="Wrap"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
            <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,4,0,0">
                <TextBlock Text="{Binding BusyMessage}" Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="{StaticResource FontSizeBody}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <ProgressBar IsIndeterminate="True" Height="4"
                             Background="{DynamicResource CardBrush}" Foreground="{DynamicResource AccentBrush}"
                             BorderThickness="0"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelBtn" Content="{loc:Translate BtnCancel}"
                    AutomationProperties.Name="{loc:Translate BtnCancel}"
                    IsCancel="True" TabIndex="2" MinWidth="80" Margin="0,0,8,0"
                    Style="{DynamicResource SecondaryButtonStyle}" Click="OnCancelClick"/>
            <Button x:Name="DisableBtn" Content="{loc:Translate VaultDisableConfirmBtn}"
                    AutomationProperties.Name="{loc:Translate VaultDisableConfirmBtn}"
                    IsDefault="True" TabIndex="1" MinWidth="80"
                    IsEnabled="{Binding CanSubmit, FallbackValue=True}"
                    Style="{DynamicResource PrimaryButtonStyle}" Click="OnDisableClick"/>
        </StackPanel>
    </Grid>
</Window>
