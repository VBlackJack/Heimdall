<Window x:Class="Heimdall.App.Views.Dialogs.SharedSessionImportReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:Heimdall.App.Behaviors"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:Heimdall.App.Localization"
        mc:Ignorable="d"
        Title="{Binding DialogTitle}"
        Width="860"
        Height="600"
        MinWidth="640"
        behaviors:WorkingAreaMinimumBehavior.IsEnabled="True"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/DialogCommonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Read-only: the report never changes a session. Close is both the Enter and the Escape
         button, so either key, and the title bar, simply close it. -->
    <Grid Margin="{StaticResource SpacingLg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="ReportTitle"
                       Text="{Binding DialogTitle}"
                       FontSize="{StaticResource FontSizeBodyLarge}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding TotalText}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- The count of every check, zeros included, so a clean check is visibly clean. -->
        <ItemsControl Grid.Row="1"
                      Margin="0,12,0,0"
                      Focusable="False"
                      ItemsSource="{Binding Summary}"
                      AutomationProperties.Name="{loc:Translate SharedReportSummaryA11y}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerRadiusMd}"
                            Padding="8,4"
                            Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding Count}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <TextBlock Text="{Binding EmptyText}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontStyle="Italic"
                       Visibility="{Binding HasEntries, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding HasEntries, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding Groups}"
                              Focusable="False"
                              Grid.IsSharedSizeScope="True"
                              AutomationProperties.LabeledBy="{Binding ElementName=ReportTitle}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="{Binding Header}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ReportFolder"/>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ReportSession"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Folder}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,16,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Session}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,16,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Explanation}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,16,0,0" LastChildFill="True">
            <TextBlock Text="{Binding StatusText, NotifyOnTargetUpdated=True}"
                       DockPanel.Dock="Left"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="{StaticResource SharedReportStatusMaxWidth}"
                       AutomationProperties.LiveSetting="Polite"
                       behaviors:LiveRegionBehavior.AnnounceOnTargetUpdated="True"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:Translate SharedReportCopy}"
                        Command="{Binding CopyCommand}"
                        IsEnabled="{Binding HasEntries}"
                        MinWidth="110"
                        Margin="0,0,8,0"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        AutomationProperties.Name="{loc:Translate SharedReportCopy}"/>
                <Button Content="{loc:Translate SharedReportExportCsv}"
                        Command="{Binding ExportCsvCommand}"
                        IsEnabled="{Binding HasEntries}"
                        MinWidth="110"
                        Margin="0,0,8,0"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        AutomationProperties.Name="{loc:Translate SharedReportExportCsv}"/>
                <Button Content="{Binding CloseLabel}"
                        IsDefault="True"
                        IsCancel="True"
                        MinWidth="110"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        AutomationProperties.Name="{Binding CloseLabel}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
