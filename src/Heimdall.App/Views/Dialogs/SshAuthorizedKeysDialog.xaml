<Window x:Class="Heimdall.App.Views.Dialogs.SshAuthorizedKeysDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:Heimdall.App.Behaviors"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:loc="clr-namespace:Heimdall.App.Localization"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Heimdall.App.ViewModels.Dialogs"
        d:DataContext="{d:DesignInstance Type=vm:SshAuthorizedKeysDialogViewModel, IsDesignTimeCreatable=False}"
        mc:Ignorable="d"
        Title="{loc:Translate SshAuthKeysDialogTitle}"
        Width="760"
        Height="560"
        MinWidth="640"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        ResizeMode="CanResizeWithGrip"
        behaviors:DialogChromeBehavior.HideCaptionButtons="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/DialogCommonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="{StaticResource SpacingLg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{loc:Translate SshAuthKeysBtnRefresh}"
                        Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding CanInteract}"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Margin="0,0,8,0"
                        AutomationProperties.Name="{loc:Translate SshAuthKeysBtnRefresh}"/>
                <Button Content="{loc:Translate SshAuthKeysBtnRemove}"
                        Command="{Binding RemoveSelectedCommand}"
                        IsEnabled="{Binding CanRemoveSelected}"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Foreground="{DynamicResource ErrorTextBrush}"
                        AutomationProperties.Name="{loc:Translate SshAuthKeysBtnRemove}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{loc:Translate SshAuthKeysDialogTitle}"
                           FontSize="{StaticResource FontSizeTitle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding TargetSummary}"
                           Margin="0,2,0,0"
                           FontSize="{StaticResource FontSizeBody}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DockPanel>

        <ProgressBar Grid.Row="1"
                     Height="4"
                     IsIndeterminate="True"
                     Margin="0,0,0,8"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Entries}"
                  SelectedItem="{Binding SelectedEntry}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Style="{DynamicResource ThemedDataGridStyle}"
                  ColumnHeaderStyle="{DynamicResource ThemedDataGridColumnHeaderStyle}"
                  CellStyle="{DynamicResource ThemedDataGridCellStyle}"
                  AutomationProperties.Name="{loc:Translate SshAuthKeysDialogTitle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding LineNumber}" Width="42"/>
                <DataGridTextColumn Header="{loc:Translate SshAuthKeysColType}" Binding="{Binding KeyType}" Width="140"/>
                <DataGridTextColumn Header="{loc:Translate SshAuthKeysColFingerprint}" Binding="{Binding Fingerprint}" Width="210"/>
                <DataGridTextColumn Header="{loc:Translate SshAuthKeysColOptions}" Binding="{Binding Options}" Width="140"/>
                <DataGridTextColumn Header="{loc:Translate SshAuthKeysColComment}" Binding="{Binding Comment}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Style="{StaticResource DialogSectionCardStyle}" Margin="0,12,0,0">
            <Grid IsEnabled="{Binding CanInteract}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{loc:Translate SshAuthKeysAddKeyLabel}"
                           Style="{StaticResource DialogLabelStyle}"
                           VerticalAlignment="Center" Margin="0,0,10,8"/>
                <TextBox Grid.Row="0" Grid.Column="1"
                         Text="{Binding NewPublicKeyLine, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource DialogFormTextBoxStyle}"
                         FontFamily="{StaticResource FontFamilyMonospace}"
                         Margin="0,0,6,8"
                         AutomationProperties.Name="{loc:Translate SshAuthKeysAddKeyLabel}"/>
                <Button Grid.Row="0" Grid.Column="2"
                        Content="{loc:Translate BtnBrowse}"
                        Click="OnBrowsePublicKeyClick"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Margin="0,0,0,8" Padding="10,4"
                        AutomationProperties.Name="{loc:Translate BtnBrowse}"/>

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="{loc:Translate SshAuthKeysOptionsLabel}"
                           Style="{StaticResource DialogLabelStyle}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Row="1" Grid.Column="1"
                         Text="{Binding NewKeyOptions, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource DialogFormTextBoxStyle}"
                         FontFamily="{StaticResource FontFamilyMonospace}"
                         Margin="0,0,6,0"
                         AutomationProperties.Name="{loc:Translate SshAuthKeysOptionsLabel}"/>
                <Button Grid.Row="1" Grid.Column="2"
                        Content="{loc:Translate SshAuthKeysBtnAdd}"
                        Command="{Binding AddKeyCommand}"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        Padding="12,4"
                        AutomationProperties.Name="{loc:Translate SshAuthKeysBtnAdd}"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="4"
                   Text="{Binding StatusMessage}"
                   FontSize="{StaticResource FontSizeCaption}"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{loc:Translate BtnClose}"
                    IsCancel="True"
                    Click="OnCloseClick"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    MinWidth="96"
                    AutomationProperties.Name="{loc:Translate BtnClose}"/>
        </StackPanel>
    </Grid>
</Window>
