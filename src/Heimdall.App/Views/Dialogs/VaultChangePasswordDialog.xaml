<Window x:Class="Heimdall.App.Views.Dialogs.VaultChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Heimdall.App.Converters"
        xmlns:loc="clr-namespace:Heimdall.App.Localization"
        xmlns:vm="clr-namespace:Heimdall.App.ViewModels.Dialogs"
        d:DataContext="{d:DesignInstance Type=vm:VaultChangePasswordDialogViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{loc:Translate VaultChangeTitle}"
        Width="420" SizeToContent="Height" MaxHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        ResizeMode="CanResizeWithGrip"
        MinWidth="360" MinHeight="320"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow">

    <Window.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InvertBoolConverter x:Key="InvertBoolConverter"/>
    </Window.Resources>

    <Grid Margin="{StaticResource SpacingXl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Translate VaultChangePrompt}"
                   FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,14"/>

        <TextBlock Grid.Row="1" Text="{loc:Translate VaultFieldCurrentPassword}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="{StaticResource FontSizeCaption}" Margin="0,0,0,4"/>
        <PasswordBox x:Name="CurrentPasswordBox" Grid.Row="2" TabIndex="0"
                     AutomationProperties.Name="{loc:Translate VaultFieldCurrentPassword}"
                     IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}, FallbackValue=True}"
                     FontSize="{StaticResource FontSizeBody}"
                     Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8,6"
                     CaretBrush="{DynamicResource TextPrimaryBrush}"/>

        <TextBlock Grid.Row="3" Text="{loc:Translate VaultFieldNewPassword}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="{StaticResource FontSizeCaption}" Margin="0,10,0,4"/>
        <PasswordBox x:Name="NewPasswordBox" Grid.Row="4" TabIndex="1"
                     AutomationProperties.Name="{loc:Translate VaultFieldNewPassword}"
                     IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}, FallbackValue=True}"
                     FontSize="{StaticResource FontSizeBody}"
                     Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8,6"
                     CaretBrush="{DynamicResource TextPrimaryBrush}"
                     PasswordChanged="OnPasswordChanged"/>

        <TextBlock Grid.Row="5" Text="{loc:Translate VaultFieldConfirmPassword}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="{StaticResource FontSizeCaption}" Margin="0,10,0,4"/>
        <PasswordBox x:Name="ConfirmPasswordBox" Grid.Row="6" TabIndex="2"
                     AutomationProperties.Name="{loc:Translate VaultFieldConfirmPassword}"
                     IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}, FallbackValue=True}"
                     FontSize="{StaticResource FontSizeBody}"
                     Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8,6"
                     CaretBrush="{DynamicResource TextPrimaryBrush}"
                     KeyDown="OnConfirmKeyDown"
                     PasswordChanged="OnPasswordChanged"/>

        <TextBlock Grid.Row="7" Text="{Binding PolicyMessage}"
                   FontSize="{StaticResource FontSizeCaption}" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>

        <StackPanel Grid.Row="8" Margin="0,8,0,0">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource ErrorTextBrush}"
                       FontSize="{StaticResource FontSizeBody}" TextWrapping="Wrap"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
            <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,4,0,0">
                <TextBlock Text="{Binding BusyMessage}" Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="{StaticResource FontSizeBody}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <ProgressBar IsIndeterminate="True" Height="4"
                             Background="{DynamicResource CardBrush}" Foreground="{DynamicResource AccentBrush}"
                             BorderThickness="0"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelBtn" Content="{loc:Translate BtnCancel}"
                    AutomationProperties.Name="{loc:Translate BtnCancel}"
                    IsCancel="True" TabIndex="4" MinWidth="80" Margin="0,0,8,0"
                    Style="{DynamicResource SecondaryButtonStyle}" Click="OnCancelClick"/>
            <Button x:Name="ChangeBtn" Content="{loc:Translate VaultChangeConfirmBtn}"
                    AutomationProperties.Name="{loc:Translate VaultChangeConfirmBtn}"
                    IsDefault="True" TabIndex="3" MinWidth="80"
                    IsEnabled="{Binding CanSubmit, FallbackValue=False}"
                    Style="{DynamicResource PrimaryButtonStyle}" Click="OnChangeClick"/>
        </StackPanel>
    </Grid>
</Window>
