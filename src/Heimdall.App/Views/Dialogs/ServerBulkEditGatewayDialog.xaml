<Window x:Class="Heimdall.App.Views.Dialogs.ServerBulkEditGatewayDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Heimdall.App.Localization"
        xmlns:vm="clr-namespace:Heimdall.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance Type=vm:ServerBulkEditGatewayViewModel}"
        mc:Ignorable="d"
        Title="{loc:Translate DialogTitleBulkEditGateway}"
        Width="520"
        SizeToContent="Height"
        MinWidth="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Loaded="OnLoaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/DialogCommonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="{StaticResource SpacingLg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource DialogSectionCardStyle}">
            <StackPanel>
                <TextBlock Text="{Binding Header}"
                           Style="{StaticResource DialogSectionTitleStyle}"/>

                <TextBlock Text="{loc:Translate BulkEditGatewayChoiceLabel}"
                           Style="{StaticResource DialogLabelStyle}"/>

                <RadioButton x:Name="UseGatewayRadioButton"
                             GroupName="GatewayChoice"
                             Content="{loc:Translate BulkEditGatewayUseGatewayChoice}"
                             AutomationProperties.Name="{loc:Translate BulkEditGatewayUseGatewayChoice}"
                             IsChecked="{Binding IsGatewayChoiceSelected, Mode=TwoWay}"
                             Margin="0,6,0,0"
                             TabIndex="0"/>

                <StackPanel Margin="24,8,0,10"
                            IsEnabled="{Binding IsGatewayPickerEnabled}">
                    <TextBlock Text="{loc:Translate BulkEditGatewayPickerLabel}"
                               Style="{StaticResource DialogLabelStyle}"/>
                    <ComboBox x:Name="GatewayComboBox"
                              ItemsSource="{Binding AvailableGateways}"
                              SelectedItem="{Binding SelectedGateway}"
                              DisplayMemberPath="DisplayText"
                              Style="{StaticResource DialogFormComboBoxStyle}"
                              AutomationProperties.Name="{loc:Translate BulkEditGatewayPickerLabel}"
                              TabIndex="1"/>
                </StackPanel>

                <RadioButton GroupName="GatewayChoice"
                             Content="{loc:Translate BulkEditGatewayDirectChoice}"
                             AutomationProperties.Name="{loc:Translate BulkEditGatewayDirectChoice}"
                             IsChecked="{Binding IsDirectChoiceSelected, Mode=TwoWay}"
                             Margin="0,4,0,0"
                             TabIndex="2"/>

                <RadioButton GroupName="GatewayChoice"
                             Content="{loc:Translate BulkEditGatewayInheritChoice}"
                             AutomationProperties.Name="{loc:Translate BulkEditGatewayInheritChoice}"
                             IsChecked="{Binding IsInheritChoiceSelected, Mode=TwoWay}"
                             Margin="0,10,0,0"
                             TabIndex="3"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="{loc:Translate BtnCancel}"
                    AutomationProperties.Name="{loc:Translate BtnCancel}"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}"
                    MinWidth="88"
                    Margin="0,0,8,0"
                    TabIndex="4"/>
            <Button Content="{loc:Translate BtnApply}"
                    AutomationProperties.Name="{loc:Translate BtnApply}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True"
                    MinWidth="96"
                    IsEnabled="{Binding IsApplyEnabled}"
                    Click="OnApplyClick"
                    TabIndex="5"/>
        </StackPanel>
    </Grid>
</Window>
