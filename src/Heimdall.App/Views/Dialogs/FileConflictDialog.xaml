<Window x:Class="Heimdall.App.Views.Dialogs.FileConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:behaviors="clr-namespace:Heimdall.App.Behaviors"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Heimdall.App.ViewModels.Dialogs"
        d:DataContext="{d:DesignInstance Type=vm:FileConflictDialogViewModel}"
        mc:Ignorable="d"
        Title="{Binding DialogTitle}"
        AutomationProperties.HelpText="{Binding DialogHint}"
        Width="760"
        Height="560"
        MinWidth="620"
        behaviors:WorkingAreaMinimumBehavior.IsEnabled="True"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/DialogCommonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Row and footer sizes named once. The window's own size stays literal: the working-area
                 clamp reads the declared minimum from the root attributes, like every dialog. -->
            <GridLength x:Key="ConflictActionColumnWidth">150</GridLength>
            <sys:Double x:Key="ConflictFooterButtonMinWidth">120</sys:Double>
            <sys:Double x:Key="ConflictApplyButtonMinWidth">150</sys:Double>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="{StaticResource SpacingLg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding DialogTitle}"
                       FontSize="{StaticResource FontSizeBodyLarge}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Margin="0,6,0,0"
                       Text="{Binding DialogHint}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"/>
            <TextBlock Margin="0,6,0,0"
                       Text="{Binding SummaryText}"
                       Foreground="{DynamicResource TextDisabledBrush}"
                       FontSize="{StaticResource FontSizeCaption}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,12,0,0" Orientation="Horizontal">
            <TextBlock x:Name="ApplyToAllLabel"
                       Text="{Binding ApplyToAllText}"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <Button Content="{Binding ApplyAllSkipText}"
                    Command="{Binding ApplyAllSkipCommand}"
                    AutomationProperties.LabeledBy="{Binding ElementName=ApplyToAllLabel}"
                    Style="{DynamicResource GhostButtonStyle}"
                    Margin="0,0,6,0"/>
            <Button Content="{Binding ApplyAllReplaceText}"
                    Command="{Binding ApplyAllReplaceCommand}"
                    AutomationProperties.LabeledBy="{Binding ElementName=ApplyToAllLabel}"
                    Style="{DynamicResource GhostButtonStyle}"
                    Margin="0,0,6,0"/>
            <Button Content="{Binding ApplyAllAutoRenameText}"
                    Command="{Binding ApplyAllAutoRenameCommand}"
                    AutomationProperties.LabeledBy="{Binding ElementName=ApplyToAllLabel}"
                    Style="{DynamicResource GhostButtonStyle}"
                    Margin="0,0,6,0"/>
            <Button x:Name="ReplaceIfNewerButton"
                    Content="{Binding ApplyAllReplaceIfNewerText}"
                    Command="{Binding ApplyAllReplaceIfNewerCommand}"
                    AutomationProperties.LabeledBy="{Binding ElementName=ApplyToAllLabel}"
                    Style="{DynamicResource GhostButtonStyle}"
                    Visibility="{Binding HasComparison, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>

        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Padding="12"
                CornerRadius="6"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="{StaticResource ConflictActionColumnWidth}"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Margin="4,0,8,8"
                           Text="{Binding TargetColumnHeader}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontWeight="SemiBold"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Margin="4,0,0,8"
                           Text="{Binding ActionColumnHeader}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontWeight="SemiBold"/>

                <!-- The rows are virtualized: a batch of thousands of collisions used to build a combo box
                     per row up front, which made the dialog slow to open. -->
                <ItemsControl Grid.Row="1" Grid.ColumnSpan="2"
                              ItemsSource="{Binding Rows}"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              AutomationProperties.Name="{Binding DialogTitle}"
                              AutomationProperties.HelpText="{Binding SummaryText}">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FileConflictRowViewModel}">
                            <Border Padding="0,6"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="{StaticResource ConflictActionColumnWidth}"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Margin="4,2,8,0"
                                                   Text="{Binding TargetPath}"
                                                   ToolTip="{Binding TargetPath}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Visibility="{Binding HasComparison, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Margin="4,4,8,0"
                                                       Text="{Binding IncomingSummary}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="{StaticResource FontSizeCaption}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Margin="4,2,8,0"
                                                       Text="{Binding ExistingSummary}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="{StaticResource FontSizeCaption}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Margin="4,2,8,0"
                                                       Text="{Binding ComparisonNote}"
                                                       Foreground="{DynamicResource InfoBrush}"
                                                       FontSize="{StaticResource FontSizeCaption}"/>
                                        </StackPanel>
                                        <TextBlock Margin="4,4,8,0"
                                                   Text="{Binding DetailText}"
                                                   Foreground="{DynamicResource WarningTextBrush}"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              Margin="4,0,0,0"
                                              VerticalAlignment="Top"
                                              ItemsSource="{Binding ConflictOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding Resolution}"
                                              AutomationProperties.Name="{Binding TargetPath}"
                                              AutomationProperties.HelpText="{Binding DetailText}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="{Binding CancelText}"
                        Command="{Binding CancelCommand}"
                        MinWidth="{StaticResource ConflictFooterButtonMinWidth}"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Style="{DynamicResource SecondaryButtonStyle}"/>
                <Button x:Name="ApplyButton"
                        Content="{Binding ApplyText}"
                        Command="{Binding ApplyCommand}"
                        MinWidth="{StaticResource ConflictApplyButtonMinWidth}"
                        IsDefault="True"
                        Style="{DynamicResource PrimaryButtonStyle}"/>
            </StackPanel>
            <!-- Cancel leaves the whole batch undone; the row choices do not say so. -->
            <TextBlock x:Name="CancelHint"
                       Text="{Binding CancelHintText}"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextDisabledBrush}"
                       FontSize="{StaticResource FontSizeCaption}"/>
        </DockPanel>
    </Grid>
</Window>
