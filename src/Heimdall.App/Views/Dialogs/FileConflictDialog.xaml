<Window x:Class="Heimdall.App.Views.Dialogs.FileConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Heimdall.App.ViewModels.Dialogs"
        d:DataContext="{d:DesignInstance Type=vm:FileConflictDialogViewModel}"
        mc:Ignorable="d"
        Title="{Binding DialogTitle}"
        AutomationProperties.HelpText="{Binding DialogHint}"
        Width="760"
        Height="520"
        MinWidth="620"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/DialogCommonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="{StaticResource SpacingLg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding DialogTitle}"
                       FontSize="{StaticResource FontSizeBodyLarge}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Margin="0,6,0,0"
                       Text="{Binding DialogHint}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"/>
            <TextBlock Margin="0,6,0,0"
                       Text="{Binding SummaryText}"
                       Foreground="{DynamicResource TextDisabledBrush}"
                       FontSize="{StaticResource FontSizeCaption}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,12,0,0" Orientation="Horizontal">
            <TextBlock x:Name="ApplyToAllLabel"
                       Text="{Binding ApplyToAllText}"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <Button Content="{Binding ApplyAllSkipText}"
                    Command="{Binding ApplyAllSkipCommand}"
                    AutomationProperties.LabeledBy="{Binding ElementName=ApplyToAllLabel}"
                    Style="{DynamicResource GhostButtonStyle}"
                    Margin="0,0,6,0"/>
            <Button Content="{Binding ApplyAllReplaceText}"
                    Command="{Binding ApplyAllReplaceCommand}"
                    AutomationProperties.LabeledBy="{Binding ElementName=ApplyToAllLabel}"
                    Style="{DynamicResource GhostButtonStyle}"
                    Margin="0,0,6,0"/>
            <Button Content="{Binding ApplyAllAutoRenameText}"
                    Command="{Binding ApplyAllAutoRenameCommand}"
                    AutomationProperties.LabeledBy="{Binding ElementName=ApplyToAllLabel}"
                    Style="{DynamicResource GhostButtonStyle}"/>
        </StackPanel>

        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Padding="12"
                CornerRadius="6"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Margin="4,0,8,8"
                           Text="{Binding TargetColumnHeader}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontWeight="SemiBold"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Margin="4,0,0,8"
                           Text="{Binding ActionColumnHeader}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontWeight="SemiBold"/>

                <ScrollViewer Grid.Row="1" Grid.ColumnSpan="2"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Rows}"
                                  AutomationProperties.Name="{Binding DialogTitle}"
                                  AutomationProperties.HelpText="{Binding SummaryText}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FileConflictRowViewModel}">
                                <Border Padding="0,6"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="150"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Margin="4,2,8,0"
                                                   Text="{Binding TargetPath}"
                                                   ToolTip="{Binding TargetPath}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <ComboBox Grid.Column="1"
                                                  Margin="4,0,0,0"
                                                  ItemsSource="{Binding DataContext.ConflictOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding Resolution}"
                                                  AutomationProperties.Name="{Binding TargetPath}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="{Binding CancelText}"
                    Command="{Binding CancelCommand}"
                    MinWidth="120"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Style="{DynamicResource SecondaryButtonStyle}"/>
            <Button x:Name="ApplyButton"
                    Content="{Binding ApplyText}"
                    Command="{Binding ApplyCommand}"
                    MinWidth="150"
                    IsDefault="True"
                    Style="{DynamicResource PrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
