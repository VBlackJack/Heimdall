<Window x:Class="Heimdall.App.Views.Dialogs.VaultUnlockDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Heimdall.App.Converters"
        xmlns:loc="clr-namespace:Heimdall.App.Localization"
        xmlns:vm="clr-namespace:Heimdall.App.ViewModels.Dialogs"
        d:DataContext="{d:DesignInstance Type=vm:VaultUnlockDialogViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{loc:Translate VaultUnlockTitle}"
        Width="400" SizeToContent="Height" MaxHeight="440"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        ResizeMode="CanResizeWithGrip"
        MinWidth="340"
        MinHeight="260"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow">

    <Window.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="{StaticResource SpacingXl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Prompt -->
        <TextBlock Grid.Row="0"
                   Text="{loc:Translate VaultUnlockPrompt}"
                   FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="0,0,0,16"/>

        <!-- Master password input (disabled when locked out or busy) -->
        <PasswordBox x:Name="PasswordBox"
                     Grid.Row="1"
                     TabIndex="0"
                     AutomationProperties.Name="{loc:Translate VaultUnlockPrompt}"
                     IsEnabled="{Binding CanSubmit, FallbackValue=True}"
                     FontSize="{StaticResource FontSizeBody}"
                     Background="{DynamicResource CardBrush}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource BorderBrush}"
                     BorderThickness="1"
                     Padding="8,6"
                     CaretBrush="{DynamicResource TextPrimaryBrush}"
                     KeyDown="OnPasswordKeyDown"/>

        <!-- Error message (visible when non-empty) -->
        <TextBlock Grid.Row="2"
                   Text="{Binding ErrorMessage}"
                   Foreground="{DynamicResource ErrorTextBrush}"
                   FontSize="{StaticResource FontSizeBody}"
                   HorizontalAlignment="Center"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>

        <!-- Busy indicator (unlock / migration resume) -->
        <StackPanel Grid.Row="3"
                    Margin="0,12,0,0"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding BusyMessage}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="{StaticResource FontSizeBody}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,6"
                       TextWrapping="Wrap"
                       TextAlignment="Center"/>
            <ProgressBar IsIndeterminate="True"
                         Height="4"
                         Background="{DynamicResource CardBrush}"
                         Foreground="{DynamicResource AccentBrush}"
                         BorderThickness="0"/>
        </StackPanel>

        <!-- Lockout message (visible when locked out) -->
        <Border Grid.Row="4"
                Background="{DynamicResource CardBrush}"
                CornerRadius="{StaticResource CornerRadiusSm}"
                Padding="12,8"
                Margin="0,12,0,0"
                Visibility="{Binding IsLockedOut, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding LockoutMessage}"
                       Foreground="{DynamicResource WarningTextBrush}"
                       FontSize="{StaticResource FontSizeBody}"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="UnlockWithHelloBtn"
                    AutomationProperties.Name="{loc:Translate VaultHelloUnlockButton}"
                    ToolTip="{loc:Translate VaultHelloUnlockButton}"
                    Command="{Binding UnlockWithHelloCommand}"
                    Visibility="{Binding ShowHelloUnlock, Converter={StaticResource BoolToVisibilityConverter}}"
                    IsEnabled="{Binding CanUnlockWithHello}"
                    TabIndex="3"
                    MinWidth="80"
                    Height="35"
                    Margin="0,0,8,0"
                    Style="{DynamicResource SecondaryButtonStyle}">
                <Viewbox Width="20" Height="20" Stretch="Uniform">
                    <Canvas Width="20" Height="20">
                        <Path Data="{StaticResource Geo.Security.Fingerprint}"
                              Stroke="{DynamicResource TextPrimaryBrush}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"/>
                    </Canvas>
                </Viewbox>
            </Button>
            <Button x:Name="CancelBtn"
                    Content="{loc:Translate BtnCancel}"
                    AutomationProperties.Name="{loc:Translate BtnCancel}"
                    IsCancel="True"
                    TabIndex="2"
                    MinWidth="80"
                    Margin="0,0,8,0"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    Click="OnCancelClick"/>
            <Button x:Name="UnlockBtn"
                    Content="{loc:Translate BtnUnlock}"
                    AutomationProperties.Name="{loc:Translate BtnUnlock}"
                    IsDefault="True"
                    TabIndex="1"
                    MinWidth="80"
                    Click="OnUnlockClick"
                    IsEnabled="{Binding CanSubmit, FallbackValue=True}"
                    Style="{DynamicResource PrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
