<Window x:Class="Heimdall.App.Views.Dialogs.MacroEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Heimdall.App.Converters"
        xmlns:loc="clr-namespace:Heimdall.App.Localization"
        xmlns:vm="clr-namespace:Heimdall.App.ViewModels.Dialogs"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MacroEditorDialogViewModel}"
        Title="{Binding DialogTitle}"
        Width="980"
        Height="760"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/DialogCommonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="{StaticResource SpacingLg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{loc:Translate MacroEditorNameLabel}"
                           Style="{StaticResource DialogLabelStyle}"/>
                <TextBox x:Name="MacroNameTextBox"
                         Text="{Binding MacroName, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{loc:Translate MacroEditorNameLabel}"
                         Style="{StaticResource DialogFormTextBoxStyle}"
                         MaxLength="200"/>
                <TextBlock Text="{Binding NameError}"
                           Style="{StaticResource FieldValidationErrorStyle}"
                           Visibility="{Binding NameError, Converter={StaticResource NullToVisibilityConverter}}"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="{loc:Translate MacroEditorAddExpectStep}"
                    Command="{Binding AddExpectStepCommand}"
                    AutomationProperties.Name="{loc:Translate MacroEditorAddExpectStep}"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    Margin="16,20,8,0"
                    MinWidth="128"
                    VerticalAlignment="Top"/>

            <Button Grid.Column="2"
                    Content="{loc:Translate MacroEditorAddSendStep}"
                    Command="{Binding AddSendStepCommand}"
                    AutomationProperties.Name="{loc:Translate MacroEditorAddSendStep}"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    Margin="0,20,0,0"
                    MinWidth="120"
                    VerticalAlignment="Top"/>
        </Grid>

        <TextBlock Grid.Row="1"
                   Text="{Binding ValidationError}"
                   Style="{StaticResource FieldValidationErrorStyle}"
                   Margin="0,8,0,0"
                   Visibility="{Binding ValidationError, Converter={StaticResource NullToVisibilityConverter}}"/>

        <ScrollViewer Grid.Row="2"
                      Margin="0,14,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:MacroEntryEditorViewModel}">
                        <Border Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="92"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{loc:Translate MacroEditorInputLabel}"
                                               Style="{StaticResource DialogLabelStyle}"/>
                                    <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="{loc:Translate MacroEditorInputLabel}"
                                             Style="{StaticResource DialogFormTextBoxStyle}"
                                             FontFamily="Consolas"
                                             TextWrapping="NoWrap"
                                             HorizontalScrollBarVisibility="Auto"/>
                                    <TextBlock Text="{Binding InputValidationMessage}"
                                               Style="{StaticResource FieldValidationErrorStyle}"
                                               Visibility="{Binding InputValidationMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="{loc:Translate MacroEditorDelayLabel}"
                                               Style="{StaticResource DialogLabelStyle}"/>
                                    <TextBox Text="{Binding DelayMs, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="{loc:Translate MacroEditorDelayLabel}"
                                             Style="{StaticResource DialogFormTextBoxStyle}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Bottom">
                                    <Button Content="&#xE74A;"
                                            FontFamily="Segoe MDL2 Assets"
                                            Width="30"
                                            Height="30"
                                            Margin="0,0,4,0"
                                            Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{loc:Translate MacroEditorMoveUp}"
                                            ToolTip="{loc:Translate MacroEditorMoveUp}"
                                            Style="{DynamicResource ToolbarGhostButtonStyle}"/>
                                    <Button Content="&#xE74B;"
                                            FontFamily="Segoe MDL2 Assets"
                                            Width="30"
                                            Height="30"
                                            Margin="0,0,4,0"
                                            Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{loc:Translate MacroEditorMoveDown}"
                                            ToolTip="{loc:Translate MacroEditorMoveDown}"
                                            Style="{DynamicResource ToolbarGhostButtonStyle}"/>
                                    <Button Content="&#xE711;"
                                            FontFamily="Segoe MDL2 Assets"
                                            Width="30"
                                            Height="30"
                                            Command="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{loc:Translate MacroEditorDeleteEntry}"
                                            ToolTip="{loc:Translate MacroEditorDeleteEntry}"
                                            Style="{DynamicResource ToolbarGhostButtonStyle}"/>
                                </StackPanel>

                                <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="136"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="{loc:Translate MacroEditorExpectPattern}"
                                                   Style="{StaticResource DialogLabelStyle}"/>
                                        <TextBox Text="{Binding ExpectPattern, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="{loc:Translate MacroEditorExpectPattern}"
                                                 Style="{StaticResource DialogFormTextBoxStyle}"
                                                 FontFamily="Consolas"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="{loc:Translate MacroEditorExpectRegex}"
                                                   Style="{StaticResource DialogLabelStyle}"/>
                                        <CheckBox IsChecked="{Binding ExpectIsRegex}"
                                                  IsEnabled="{Binding HasExpectPattern}"
                                                  Content="{loc:Translate MacroEditorExpectRegexShort}"
                                                  AutomationProperties.Name="{loc:Translate MacroEditorExpectRegex}"
                                                  Style="{StaticResource DialogFormCheckBoxStyle}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,6,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                        <TextBlock Text="{loc:Translate MacroEditorExpectTimeout}"
                                                   Style="{StaticResource DialogLabelStyle}"/>
                                        <TextBox Text="{Binding ExpectTimeoutMs, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding HasExpectPattern}"
                                                 AutomationProperties.Name="{loc:Translate MacroEditorExpectTimeout}"
                                                 Style="{StaticResource DialogFormTextBoxStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="{loc:Translate MacroEditorExpectOnTimeout}"
                                                   Style="{StaticResource DialogLabelStyle}"/>
                                        <ComboBox ItemsSource="{Binding DataContext.TimeoutActionOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedValue="{Binding ExpectOnTimeout}"
                                                  SelectedValuePath="Action"
                                                  DisplayMemberPath="Label"
                                                  IsEnabled="{Binding HasExpectPattern}"
                                                  AutomationProperties.Name="{loc:Translate MacroEditorExpectOnTimeout}"
                                                  Style="{StaticResource DialogFormComboBoxStyle}"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding RegexValidationMessage}"
                                               Style="{StaticResource FieldValidationErrorStyle}"
                                               Visibility="{Binding RegexValidationMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding DataContext.TimeoutRangeText, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Style="{StaticResource DialogHintTextStyle}"
                                               Visibility="{Binding HasExpectPattern, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="{loc:Translate MacroEditorDeleteMacro}"
                    Click="OnDeleteMacroClick"
                    AutomationProperties.Name="{loc:Translate MacroEditorDeleteMacro}"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    MinWidth="112"/>

            <Button Grid.Column="2"
                    Content="{loc:Translate BtnCancel}"
                    IsCancel="True"
                    AutomationProperties.Name="{loc:Translate BtnCancel}"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    MinWidth="90"
                    Margin="0,0,8,0"/>

            <Button Grid.Column="3"
                    Content="{loc:Translate BtnSave}"
                    IsDefault="True"
                    Click="OnSaveClick"
                    AutomationProperties.Name="{loc:Translate BtnSave}"
                    Style="{DynamicResource PrimaryButtonStyle}"
                    MinWidth="90"/>
        </Grid>
    </Grid>
</Window>
