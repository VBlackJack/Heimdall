<Window x:Class="Heimdall.App.Views.Dialogs.SshKeyRotationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:Heimdall.App.Behaviors"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:loc="clr-namespace:Heimdall.App.Localization"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Heimdall.App.ViewModels.Dialogs"
        d:DataContext="{d:DesignInstance Type=vm:SshKeyRotationDialogViewModel, IsDesignTimeCreatable=False}"
        mc:Ignorable="d"
        Title="{loc:Translate SshKeyRotateDialogTitle}"
        Width="560"
        SizeToContent="Height"
        MinWidth="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        ResizeMode="NoResize"
        behaviors:DialogChromeBehavior.HideCaptionButtons="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/DialogCommonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="{StaticResource SpacingLg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{loc:Translate SshKeyRotateDialogTitle}"
                       FontSize="{StaticResource FontSizeTitle}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding TargetSummary}"
                       Margin="0,4,0,0"
                       FontSize="{StaticResource FontSizeBody}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource DialogSectionCardStyle}">
            <Grid IsEnabled="{Binding CanEditOptions}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Translate SshKeyRotateCurrentKeyLabel}"
                           Style="{StaticResource DialogLabelStyle}" VerticalAlignment="Center" Margin="0,0,12,8"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                           Text="{Binding CurrentKeyDisplay}"
                           FontFamily="{StaticResource FontFamilyMonospace}"
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Translate SshKeyRotateAlgorithmLabel}"
                           Style="{StaticResource DialogLabelStyle}" VerticalAlignment="Center" Margin="0,0,12,8"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                          ItemsSource="{Binding Algorithms}"
                          SelectedItem="{Binding SelectedAlgorithm}"
                          DisplayMemberPath="DisplayName"
                          Margin="0,0,0,8"
                          AutomationProperties.Name="{loc:Translate SshKeyRotateAlgorithmLabel}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Translate SshKeyRotateOutputPathLabel}"
                           Style="{StaticResource DialogLabelStyle}" VerticalAlignment="Center" Margin="0,0,12,8"/>
                <TextBox Grid.Row="2" Grid.Column="1"
                         Text="{Binding NewPrivateKeyPath, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource DialogFormTextBoxStyle}"
                         Margin="0,0,6,8"
                         AutomationProperties.Name="{loc:Translate SshKeyRotateOutputPathLabel}"/>
                <Button Grid.Row="2" Grid.Column="2"
                        Content="{loc:Translate BtnBrowse}"
                        Click="OnBrowseOutputClick"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Margin="0,0,0,8" Padding="10,4"
                        AutomationProperties.Name="{loc:Translate BtnBrowse}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Translate SshKeyRotatePassphraseLabel}"
                           Style="{StaticResource DialogLabelStyle}" VerticalAlignment="Center" Margin="0,0,12,8"/>
                <PasswordBox x:Name="PassphraseBox"
                             Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                             Margin="0,0,0,8"
                             PasswordChanged="OnPassphraseChanged"
                             AutomationProperties.Name="{loc:Translate SshKeyRotatePassphraseLabel}"/>

                <CheckBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                          IsChecked="{Binding RemoveOldKeyFromServer}"
                          IsEnabled="{Binding CanRemoveOldKey}"
                          Content="{loc:Translate SshKeyRotateRemoveOldLabel}"
                          AutomationProperties.Name="{loc:Translate SshKeyRotateRemoveOldLabel}"/>
            </Grid>
        </Border>

        <!-- Progress checklist -->
        <Border Grid.Row="2"
                Style="{StaticResource DialogSectionCardStyle}"
                Margin="0,12,0,0"
                Visibility="{Binding HasStarted, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,8"
                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <TextBlock Text="{Binding ProgressLog}"
                           FontFamily="{StaticResource FontFamilyMonospace}"
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   FontSize="{StaticResource FontSizeCaption}"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0"
                   Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:Translate BtnClose}"
                    Command="{Binding CancelOrCloseCommand}"
                    IsCancel="True"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    MinWidth="96" Margin="0,0,8,0"
                    AutomationProperties.Name="{loc:Translate BtnClose}"/>
            <Button Content="{loc:Translate SshKeyRotateBtnStart}"
                    Command="{Binding StartRotationCommand}"
                    IsEnabled="{Binding CanStart}"
                    IsDefault="True"
                    Style="{DynamicResource PrimaryButtonStyle}"
                    MinWidth="130"
                    AutomationProperties.Name="{loc:Translate SshKeyRotateBtnStart}"/>
        </StackPanel>
    </Grid>
</Window>
