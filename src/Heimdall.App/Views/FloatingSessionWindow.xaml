<Window x:Class="Heimdall.App.Views.FloatingSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Heimdall.App.Converters"
        Title=""
        Width="1024" Height="768"
        MinWidth="400" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <converters:SessionStatusToDisplayConverter x:Key="SessionStatusToDisplayConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header bar -->
            <RowDefinition Height="36"/>
            <!-- Session content -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header bar with session info and reattach button -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderBrush}">
            <DockPanel Margin="8,0">
                <!-- Right: Reattach button -->
                <Button x:Name="ReattachButton"
                        DockPanel.Dock="Right"
                        Content=""
                        Click="OnReattachClick"
                        VerticalAlignment="Center"
                        Padding="12,4"
                        Style="{DynamicResource SecondaryButtonStyle}"/>

                <!-- Left: Connection type icon + title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            DataContext="{Binding Session, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Path x:Name="TypeIcon"
                          Style="{StaticResource GeoIconSmall}"
                          Fill="{DynamicResource InfoBrush}"
                          VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="SessionTitle" Text="{Binding Title, Mode=OneWay}"
                               FontSize="{StaticResource FontSizeBodyLarge}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text=" - " Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="{StaticResource FontSizeCaption}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="{Binding Status, Mode=OneWay, Converter={StaticResource SessionStatusToDisplayConverter}}"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TunnelRouteText" Text="{Binding TunnelRoute, Mode=OneWay}"
                               FontSize="{StaticResource FontSizeSmallCaption}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Session host control -->
        <ContentPresenter x:Name="SessionHost"
                          Grid.Row="1"
                          ClipToBounds="True"/>
    </Grid>
</Window>
