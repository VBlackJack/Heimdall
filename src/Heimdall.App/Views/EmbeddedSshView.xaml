<UserControl x:Class="Heimdall.App.Views.EmbeddedSshView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:Heimdall.App.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="540"
             d:DesignWidth="900"
             Background="{DynamicResource BackgroundBrush}"
             Focusable="True">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header strip (compact, matches RDP pattern) -->
        <Border Grid.Row="0"
                Padding="{StaticResource SessionHeaderPadding}"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <Button x:Name="DisconnectButton"
                        DockPanel.Dock="Right"
                        Content="{loc:Translate BtnDisconnectSession}"
                        Click="OnDisconnectClick"
                        ToolTip="{loc:Translate TooltipDisconnectSession}"
                        AutomationProperties.Name="{loc:Translate A11yDisconnectSession}"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Padding="8,2"
                        FontSize="{StaticResource FontSizeCaption}"
                        Margin="8,0,0,0"/>

                <Button x:Name="ReconnectButton"
                        DockPanel.Dock="Right"
                        Content="{loc:Translate BtnReconnectSession}"
                        Click="OnReconnectClick"
                        ToolTip="{loc:Translate TooltipReconnectSession}"
                        AutomationProperties.Name="{loc:Translate A11yReconnectSession}"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        Padding="8,2"
                        FontSize="{StaticResource FontSizeCaption}"
                        Margin="8,0,0,0"
                        Visibility="Collapsed"/>

                <Button x:Name="HealthToggleButton"
                        DockPanel.Dock="Right"
                        Content="&#xE9D9;"
                        FontFamily="Segoe MDL2 Assets"
                        Click="OnHealthToggleClick"
                        ToolTip="{loc:Translate TooltipToggleHealthMonitoring}"
                        AutomationProperties.Name="{loc:Translate A11yToggleHealthMonitoring}"
                        Style="{DynamicResource ToolbarGhostButtonStyle}"
                        Padding="6,2" FontSize="{StaticResource FontSizeBody}" Margin="4,0"/>

                <Button x:Name="SplitButton"
                        DockPanel.Dock="Right"
                        Content="&#xE8A9;"
                        FontFamily="Segoe MDL2 Assets"
                        Click="OnSplitClick"
                        ToolTip="{loc:Translate TooltipSplitSession}"
                        AutomationProperties.Name="{loc:Translate A11ySplitSession}"
                        Style="{DynamicResource ToolbarGhostButtonStyle}"
                        Padding="6,2" FontSize="{StaticResource FontSizeBody}" Margin="4,0"/>

                <Button x:Name="ElevateButton"
                        DockPanel.Dock="Right"
                        Content="&#xE7EF;"
                        FontFamily="Segoe MDL2 Assets"
                        Click="OnElevateClick"
                        ToolTip="{loc:Translate TooltipElevateToRoot}"
                        AutomationProperties.Name="{loc:Translate A11yElevateToRoot}"
                        Style="{DynamicResource ToolbarGhostButtonStyle}"
                        Padding="6,2" FontSize="{StaticResource FontSizeBody}" Margin="4,0"
                        Visibility="Collapsed"/>

                <!-- Admin badge (visible when session is elevated) -->
                <Border x:Name="AdminBadge"
                        DockPanel.Dock="Right"
                        Background="{DynamicResource WarningBrush}"
                        CornerRadius="{StaticResource CornerRadiusSm}"
                        Padding="6,1"
                        Margin="4,0"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <TextBlock x:Name="AdminBadgeText" Text="{loc:Translate AdminBadgeLabel}"
                               FontSize="{StaticResource FontSizeSmallCaption}" FontWeight="Bold"
                               Foreground="{DynamicResource BadgeTextBrush}"/>
                </Border>

                <!-- Per-pane broadcast target toggle (visible only in SelectedPanes mode).
                     Docked Left so it is never squeezed out by the right-hand button cluster
                     on narrow split panes. -->
                <CheckBox x:Name="BroadcastTargetToggle"
                          DockPanel.Dock="Left"
                          Visibility="Collapsed"
                          Click="OnBroadcastTargetToggleClick"
                          Content="{loc:Translate BroadcastTargetToggleLabel}"
                          ToolTip="{loc:Translate BroadcastTargetToggleTooltip}"
                          AutomationProperties.Name="{loc:Translate A11yBroadcastTargetToggle}"
                          VerticalAlignment="Center"
                          Margin="8,0,0,0"
                          FontSize="{StaticResource FontSizeSmallCaption}"
                          Foreground="{DynamicResource TextPrimaryBrush}"/>

                <!-- Broadcast mode indicator -->
                <Border x:Name="BroadcastBadge"
                        DockPanel.Dock="Right"
                        Visibility="Collapsed"
                        Background="{DynamicResource BroadcastActiveBrush}"
                        CornerRadius="{StaticResource CornerRadiusSm}"
                        Padding="6,1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="BroadcastBadgeText"
                               Text="{loc:Translate BroadcastBadgeLabel}"
                               FontSize="{StaticResource FontSizeSmallCaption}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource ErrorTextBrush}"/>
                </Border>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="SessionTitleText"
                               FontSize="{StaticResource FontSizeBody}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="300"/>
                    <TextBlock x:Name="EndpointTextBlock"
                               Margin="8,0,0,0"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="250"/>
                    <TextBlock Text=" - " Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="{StaticResource FontSizeCaption}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusTextBlock"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Terminal + Health panel container -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="HealthColumnDef" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- Terminal surface -->
            <Border x:Name="BroadcastBorder"
                    Grid.Column="0"
                    Background="{DynamicResource BackgroundBrush}"
                    BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="0"
                    ClipToBounds="True">
                <Grid>
                    <wv2:WebView2 x:Name="TerminalWebView"
                                  Focusable="True" />

                    <Border x:Name="FallbackPanel"
                            Visibility="Collapsed"
                            Background="{DynamicResource BackgroundBrush}"
                            Padding="28">
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    MaxWidth="420">
                            <TextBlock x:Name="FallbackTitleText"
                                       FontSize="{StaticResource FontSizeDisplay}"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock x:Name="FallbackMessageText"
                                       Margin="0,12,0,0"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Reconnect overlay (shown on unexpected disconnect) -->
                    <Border x:Name="ReconnectOverlay"
                            Style="{StaticResource FadeInPanelStyle}"
                            Visibility="Collapsed"
                            Background="{DynamicResource OverlayBackground}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <!-- Message text group: capped width so long messages wrap nicely. -->
                            <StackPanel MaxWidth="400">
                            <TextBlock x:Name="ReconnectMessageText"
                                       Text="{loc:Translate SshDisconnectedMessage}"
                                       FontSize="{StaticResource FontSizeSubtitle}"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                            <!-- Button row: WrapPanel so localized labels wrap instead of clipping. -->
                            <WrapPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        MaxWidth="720"
                                        Margin="0,16,0,0">
                                <Button x:Name="OverlayReconnectButton"
                                        Content="{loc:Translate BtnReconnectSession}"
                                        Click="OnOverlayReconnectClick"
                                        AutomationProperties.Name="{loc:Translate A11yReconnectSession}"
                                        Style="{DynamicResource PrimaryButtonStyle}"
                                        Padding="16,6"
                                        FontSize="{StaticResource FontSizeBodyLarge}"
                                        Margin="0,0,8,0"/>
                                <Button x:Name="OverlayCloseButton"
                                        Content="{loc:Translate BtnCloseOverlay}"
                                        Click="OnOverlayCloseClick"
                                        AutomationProperties.Name="{loc:Translate A11yCloseOverlay}"
                                        Style="{DynamicResource SecondaryButtonStyle}"
                                        Padding="16,6"
                                        FontSize="{StaticResource FontSizeBodyLarge}"
                                        Margin="8,0,0,0"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Auto-reconnect countdown overlay -->
                    <Border x:Name="AutoReconnectOverlay"
                            Style="{StaticResource FadeInPanelStyle}"
                            Visibility="Collapsed"
                            Background="{DynamicResource OverlayBackground}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    MaxWidth="420">
                            <TextBlock x:Name="AutoReconnectMessageText"
                                       Text="{loc:Translate SessionStatusReconnecting}"
                                       FontSize="{StaticResource FontSizeSubtitle}"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock x:Name="AutoReconnectCountdownText"
                                       Margin="0,8,0,0"
                                       TextAlignment="Center"
                                       FontSize="{StaticResource FontSizeBodyLarge}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ProgressBar IsIndeterminate="True"
                                         Height="2"
                                         Width="220"
                                         Margin="0,16,0,16"
                                         Foreground="{DynamicResource AccentBrush}"
                                         Background="Transparent"
                                         BorderThickness="0"/>
                            <Button x:Name="AutoReconnectCancelButton"
                                    Content="{loc:Translate BtnCancelAutoReconnect}"
                                    Click="OnAutoReconnectCancelClick"
                                    AutomationProperties.Name="{loc:Translate A11yCancelAutoReconnect}"
                                    Style="{DynamicResource SecondaryButtonStyle}"
                                    Padding="16,6"
                                    FontSize="{StaticResource FontSizeBodyLarge}"
                                    HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Initial connect overlay (visible until xterm.js signals ready) -->
                    <Border x:Name="ConnectingOverlay"
                            Style="{StaticResource FadeInPanelStyle}"
                            Background="{DynamicResource OverlayBackground}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    MaxWidth="400">
                            <TextBlock x:Name="ConnectingTitleText"
                                       Text="{loc:Translate SshConnectingTitle}"
                                       FontSize="{StaticResource FontSizeSubtitle}"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock x:Name="ConnectingEndpointText"
                                       Margin="0,8,0,0"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ProgressBar IsIndeterminate="True"
                                         Height="2"
                                         Width="220"
                                         Margin="0,16,0,0"
                                         Foreground="{DynamicResource AccentBrush}"
                                         Background="Transparent"
                                         BorderThickness="0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Server Health panel (collapsible right side) -->
            <Border x:Name="HealthPanel"
                    Grid.Column="1"
                    Visibility="Collapsed"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,0,0,0"
                    Padding="10,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- CPU -->
                        <TextBlock x:Name="HealthCpuLabel"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,4"/>
                        <ProgressBar x:Name="CpuProgressBar"
                                     Height="14"
                                     Minimum="0" Maximum="100" Value="0"
                                     Foreground="{DynamicResource AccentBrush}"
                                     Background="{DynamicResource BackgroundBrush}"/>
                        <TextBlock x:Name="CpuPercentText"
                                   Text="0%"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Right"
                                   Margin="0,2,0,12"/>

                        <!-- RAM -->
                        <TextBlock x:Name="HealthRamLabel"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,4"/>
                        <ProgressBar x:Name="RamProgressBar"
                                     Height="14"
                                     Minimum="0" Maximum="100" Value="0"
                                     Foreground="{DynamicResource AccentBrush}"
                                     Background="{DynamicResource BackgroundBrush}"/>
                        <TextBlock x:Name="RamDetailText"
                                   Text="0 / 0 MB"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Right"
                                   Margin="0,2,0,12"/>

                        <!-- Disk -->
                        <TextBlock x:Name="HealthDiskLabel"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,4"/>
                        <ProgressBar x:Name="DiskProgressBar"
                                     Height="14"
                                     Minimum="0" Maximum="100" Value="0"
                                     Foreground="{DynamicResource AccentBrush}"
                                     Background="{DynamicResource BackgroundBrush}"/>
                        <TextBlock x:Name="DiskDetailText"
                                   Text="0 / 0"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Right"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
