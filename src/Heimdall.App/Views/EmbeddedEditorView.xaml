<UserControl x:Class="Heimdall.App.Views.EmbeddedEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Heimdall.App.Localization"
             xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
             Background="{DynamicResource BackgroundBrush}"
             PreviewKeyDown="OnEditorPreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="8,4"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <Button x:Name="BtnSave" DockPanel.Dock="Right"
                        Click="OnSaveClick"
                        Content="{loc:Translate EditorBtnSave}"
                        AutomationProperties.Name="{loc:Translate EditorBtnSave}"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        Padding="12,3" FontSize="{StaticResource FontSizeCaption}" Margin="4,0,0,0"/>
                <Button x:Name="BtnClose" DockPanel.Dock="Right"
                        Click="OnCloseClick"
                        Content="{loc:Translate EditorBtnClose}"
                        AutomationProperties.Name="{loc:Translate EditorBtnClose}"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Padding="8,3" FontSize="{StaticResource FontSizeCaption}" Margin="4,0,0,0"/>
                <TextBlock Text="{Binding DisplayTitle}"
                           FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- AvalonEdit Editor -->
        <avalon:TextEditor x:Name="Editor"
                           Grid.Row="1"
                           AutomationProperties.Name="{loc:Translate A11yEditorText}"
                           FontFamily="{StaticResource FontFamilyMonospace}"
                           FontSize="{StaticResource FontSizeBodyLarge}"
                           ShowLineNumbers="True"
                           WordWrap="False"
                           HorizontalScrollBarVisibility="Auto"
                           VerticalScrollBarVisibility="Auto"/>

        <!-- Status bar -->
        <Border Grid.Row="2" Padding="{StaticResource SessionHeaderPadding}"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock Text="{Binding CursorPositionText}"
                           DockPanel.Dock="Right"
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Text="{Binding SyntaxName}"
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                <!-- Where an act taken from this overlay reports itself. The pane's own
                     status bar is inside the browser surface, which is collapsed while
                     the editor is up. -->
                <TextBlock x:Name="EditorNoticeText" Text="{Binding NoticeText}"
                           Margin="16,0,0,0" TextWrapping="Wrap"
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource WarningBrush}"
                           AutomationProperties.Name="{Binding NoticeText}"
                           Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
