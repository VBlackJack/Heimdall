<UserControl x:Class="Heimdall.App.Views.EmbeddedSftpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:conv="clr-namespace:Heimdall.App.Converters"
             xmlns:loc="clr-namespace:Heimdall.App.Localization"
             xmlns:local="clr-namespace:Heimdall.App.Views"
             mc:Ignorable="d"
             d:DesignHeight="540"
             d:DesignWidth="900"
             Background="{DynamicResource BackgroundBrush}"
             AllowDrop="True"
             Drop="OnDrop"
             DragOver="OnDragOver"
             DragLeave="OnDragLeave"
             KeyDown="OnViewKeyDown">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/Heimdall;component/Themes/FileBrowserStyles.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <conv:FileSizeConverter x:Key="FileSizeConverter"/>
        <conv:FileDateTimeConverter x:Key="FileDateTimeConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <conv:RemoteEntryKindToDisplayNameConverter x:Key="RemoteEntryKindToDisplayNameConverter"/>

        <!-- Layout tokens. Named once here so no size is a bare number in the markup below. -->
        <sys:Double x:Key="SftpFilterBoxWidth">160</sys:Double>
        <sys:Double x:Key="SftpFilterClearSize">24</sys:Double>
        <sys:Double x:Key="SftpHeaderTitleMaxWidth">300</sys:Double>
        <sys:Double x:Key="SftpHeaderEndpointMaxWidth">250</sys:Double>
        <sys:Double x:Key="SftpSecurityBadgeMaxWidth">240</sys:Double>
        <!-- WCAG 2.5.8 sets the floor of a pointer target at 24 px; 28 keeps the toolbar compact. -->
        <sys:Double x:Key="SftpToolbarButtonMinHeight">28</sys:Double>
        <sys:Double x:Key="SftpColumnWidthName">320</sys:Double>
        <sys:Double x:Key="SftpColumnWidthSize">80</sys:Double>
        <sys:Double x:Key="SftpColumnWidthModified">140</sys:Double>
        <sys:Double x:Key="SftpColumnWidthPermissions">80</sys:Double>
        <sys:Double x:Key="SftpColumnWidthOwner">90</sys:Double>
        <sys:Double x:Key="SftpHealthDotSize">8</sys:Double>
        <sys:Double x:Key="SftpLoadingBarHeight">2</sys:Double>
        <sys:Double x:Key="SftpTransferBarHeight">6</sys:Double>
        <sys:Double x:Key="SftpEmptyStateMaxWidth">420</sys:Double>
        <sys:Double x:Key="SftpJobListMaxHeight">120</sys:Double>
        <sys:Double x:Key="SftpOverlayScrimOpacity">0.85</sys:Double>
        <Thickness x:Key="SftpButtonPadding">8,2</Thickness>
        <Thickness x:Key="SftpIconButtonPadding">6,2</Thickness>
        <Thickness x:Key="SftpPanelPadding">8,4</Thickness>
        <Thickness x:Key="SftpDropBadgePadding">16,8</Thickness>

        <!-- A row of the remote list: the shared row look, plus what is specific to a remote entry. -->
        <Style x:Key="SftpRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource FileBrowserRowStyle}">
            <Setter Property="AutomationProperties.Name">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource AccessibleRowNameConverter}">
                        <Binding Source="{x:Static loc:LocalizationSource.Instance}" Path="[A11ySftpFileRow]"/>
                        <Binding Path="Name"/>
                        <Binding Path="Kind" Converter="{StaticResource RemoteEntryKindToDisplayNameConverter}"/>
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Setter Property="ToolTip">
                <Setter.Value>
                    <ToolTip>
                        <StackPanel>
                            <TextBlock Text="{Binding FullPath}" FontWeight="SemiBold"/>
                            <TextBlock>
                                <Run Text="{loc:Translate SftpPropertiesType}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding Kind, Converter={StaticResource RemoteEntryKindToDisplayNameConverter}}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding Size, Converter={StaticResource FileSizeConverter}}"/>
                            <TextBlock Text="{Binding LastModified, Converter={StaticResource FileDateTimeConverter}, ConverterParameter=long}"/>
                            <TextBlock Text="{Binding Permissions}"/>
                        </StackPanel>
                    </ToolTip>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid x:Name="BrowserSurface"
              Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Header strip -->
        <Border Grid.Row="0"
                Padding="{StaticResource SessionHeaderPadding}"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <Button x:Name="DisconnectButton"
                        DockPanel.Dock="Right"
                        Content="{loc:Translate SftpBtnDisconnect}"
                        ToolTip="{loc:Translate TooltipDisconnectSession}"
                        Click="OnDisconnectClick"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Padding="{StaticResource SftpButtonPadding}"
                        MinHeight="{StaticResource SftpToolbarButtonMinHeight}"
                        FontSize="{StaticResource FontSizeCaption}"
                        Margin="8,0,0,0"
                        Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}}"
                        AutomationProperties.Name="{loc:Translate A11yDisconnectSession}"/>
                <Button x:Name="CloseTabButton"
                        DockPanel.Dock="Right"
                        Content="{loc:Translate SftpBtnClose}"
                        ToolTip="{loc:Translate TooltipCloseSessionTab}"
                        Click="OnCloseTabClick"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Padding="{StaticResource SftpButtonPadding}"
                        MinHeight="{StaticResource SftpToolbarButtonMinHeight}"
                        FontSize="{StaticResource FontSizeCaption}"
                        Margin="8,0,0,0"
                        Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVisibilityConverter}}"
                        AutomationProperties.Name="{loc:Translate A11yCloseSessionTab}"/>
                <Button x:Name="ReconnectButton"
                        DockPanel.Dock="Right"
                        Content="{loc:Translate SftpBtnReconnect}"
                        ToolTip="{loc:Translate TooltipReconnectSession}"
                        Click="OnReconnectClick"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        Padding="{StaticResource SftpButtonPadding}"
                        MinHeight="{StaticResource SftpToolbarButtonMinHeight}"
                        FontSize="{StaticResource FontSizeCaption}"
                        Margin="8,0,0,0"
                        Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVisibilityConverter}}"
                        AutomationProperties.Name="{loc:Translate A11yReconnectSession}"/>
                <Button x:Name="EditProfileButton"
                        DockPanel.Dock="Right"
                        Content="{loc:Translate BtnEditProfileOverlay}"
                        Click="OnEditProfileClick"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Padding="{StaticResource SftpButtonPadding}"
                        MinHeight="{StaticResource SftpToolbarButtonMinHeight}"
                        Margin="8,0,0,0"
                        Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVisibilityConverter}}"
                        AutomationProperties.Name="{loc:Translate A11yEditProfileOverlay}"/>
                <Button x:Name="SplitButton"
                        DockPanel.Dock="Right"
                        Content="&#xE8A9;"
                        ToolTip="{loc:Translate TooltipSplitSession}"
                        FontFamily="Segoe MDL2 Assets"
                        Command="{Binding RequestSplitCommand}"
                        Style="{DynamicResource GhostButtonStyle}"
                        Padding="{StaticResource SftpIconButtonPadding}" FontSize="{StaticResource FontSizeBody}" Margin="4,0"
                        AutomationProperties.Name="{loc:Translate A11ySplitSession}"/>

                <Border x:Name="SecurityNoticeBadge"
                        DockPanel.Dock="Right"
                        BorderBrush="{DynamicResource WarningBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerRadiusSm}"
                        Padding="6,1"
                        Margin="4,0"
                        VerticalAlignment="Center"
                        ToolTip="{Binding SecurityNoticeText}"
                        Visibility="{Binding IsSecurityNoticeVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                        AutomationProperties.Name="{Binding SecurityNoticeText}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="{StaticResource FontSizeSmallCaption}"
                                   Foreground="{DynamicResource WarningTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding SecurityNoticeText}"
                                   FontSize="{StaticResource FontSizeSmallCaption}"
                                   Foreground="{DynamicResource WarningTextBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="{StaticResource SftpSecurityBadgeMaxWidth}"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="SessionTitleText"
                               FontSize="{StaticResource FontSizeBodyLarge}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="{StaticResource SftpHeaderTitleMaxWidth}"/>
                    <TextBlock x:Name="EndpointTextBlock"
                               Margin="8,0,0,0"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="{StaticResource SftpHeaderEndpointMaxWidth}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Row 1: Toolbar -->
        <Border x:Name="ToolbarBar"
                Grid.Row="1"
                Padding="{StaticResource SftpPanelPadding}"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                SizeChanged="OnToolbarSizeChanged">
            <DockPanel LastChildFill="True">
                <!-- Right side: filter + hidden toggle -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Grid Width="{StaticResource SftpFilterBoxWidth}" Margin="8,0,0,0">
                        <TextBox x:Name="FilterTextBox"
                                 Style="{DynamicResource SearchTextBoxStyle}"
                                 Tag="{loc:Translate SftpFilterPlaceholder}"
                                 FontSize="{StaticResource FontSizeCaption}"
                                 VerticalContentAlignment="Center"
                                 Padding="6,2,28,2"
                                 KeyDown="OnFilterKeyDown"
                                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay={x:Static local:SftpViewMetrics.FilterInputDelayMilliseconds}}"
                                 AutomationProperties.Name="{loc:Translate A11yTxtSearchFiles}"/>
                        <Button x:Name="FilterClearButton"
                                Content="&#xE711;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="{StaticResource FontSizeSmallCaption}"
                                Style="{DynamicResource GhostButtonStyle}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                MinWidth="{StaticResource SftpFilterClearSize}"
                                MinHeight="{StaticResource SftpFilterClearSize}"
                                Padding="0"
                                Command="{Binding ClearFilterCommand}"
                                ToolTip="{loc:Translate SftpEmptyClearFilter}"
                                AutomationProperties.Name="{loc:Translate SftpEmptyClearFilter}"
                                Visibility="{Binding Text, ElementName=FilterTextBox, Converter={StaticResource NullToVisibilityConverter}}"/>
                    </Grid>
                    <CheckBox x:Name="ToggleHiddenCheckBox"
                              Content="{loc:Translate SftpToggleHiddenLabel}"
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              FontSize="{StaticResource FontSizeCaption}"
                              Margin="8,0,0,0"
                              IsChecked="{Binding ShowHidden}"
                              ToolTip="{loc:Translate SftpToggleHidden}"
                              AutomationProperties.Name="{loc:Translate SftpToggleHidden}"
                              />
                </StackPanel>

                <!-- Left side: navigation + actions (Segoe MDL2 Assets icons) -->
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnBack"
                            Content="&#xE72B;"
                            ToolTip="{loc:Translate TooltipNavigateBack}"
                            FontFamily="Segoe MDL2 Assets"
                            Command="{Binding NavigateBackCommand}"
                            Style="{DynamicResource GhostButtonStyle}"
                            Padding="{StaticResource SftpButtonPadding}" FontSize="{StaticResource FontSizeBody}"
                            IsEnabled="{Binding CanNavigateBack}"
                            AutomationProperties.Name="{loc:Translate A11yNavigateBack}"/>
                    <Button x:Name="BtnUp"
                            Content="&#xE74A;"
                            ToolTip="{loc:Translate TooltipNavigateUp}"
                            FontFamily="Segoe MDL2 Assets"
                            Command="{Binding NavigateUpCommand}"
                            Style="{DynamicResource GhostButtonStyle}"
                            Padding="{StaticResource SftpButtonPadding}" FontSize="{StaticResource FontSizeBody}" Margin="4,0,0,0"
                            IsEnabled="{Binding IsToolbarEnabled}"
                            AutomationProperties.Name="{loc:Translate A11yNavigateUp}"/>
                    <Button x:Name="BtnHome"
                            Content="&#xE80F;"
                            ToolTip="{loc:Translate TooltipNavigateHome}"
                            FontFamily="Segoe MDL2 Assets"
                            Command="{Binding NavigateHomeCommand}"
                            Style="{DynamicResource GhostButtonStyle}"
                            Padding="{StaticResource SftpButtonPadding}" FontSize="{StaticResource FontSizeBody}" Margin="4,0,0,0"
                            IsEnabled="{Binding IsToolbarEnabled}"
                            AutomationProperties.Name="{loc:Translate A11yNavigateHome}"/>
                    <Button x:Name="BtnRefresh"
                            Content="&#xE72C;"
                            ToolTip="{loc:Translate TooltipRefreshDirectory}"
                            FontFamily="Segoe MDL2 Assets"
                            Command="{Binding RefreshCommand}"
                            Style="{DynamicResource GhostButtonStyle}"
                            Padding="{StaticResource SftpButtonPadding}" FontSize="{StaticResource FontSizeBody}" Margin="4,0,0,0"
                            IsEnabled="{Binding IsToolbarEnabled}"
                            AutomationProperties.Name="{loc:Translate A11yRefreshDirectory}"/>

                    <Border Style="{StaticResource ToolbarVerticalSeparatorStyle}"
                            AutomationProperties.AutomationId="Toolbar.Sftp.NavigationActionsSeparator"/>

                    <Button x:Name="BtnUpload"
                            Click="OnUploadClick"
                            ToolTip="{loc:Translate TooltipUploadFiles}"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Padding="{StaticResource SftpButtonPadding}"
                            MinHeight="{StaticResource SftpToolbarButtonMinHeight}"
                            FontSize="{StaticResource FontSizeCaption}" Margin="0,0,4,0"
                            IsEnabled="{Binding IsToolbarEnabled}"
                            AutomationProperties.Name="{loc:Translate A11yUploadFiles}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource FontSizeBody}"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock x:Name="BtnUploadText" Text="{loc:Translate SftpBtnUpload}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnDownload"
                            Click="OnDownloadClick"
                            ToolTip="{loc:Translate TooltipDownloadFiles}"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Padding="{StaticResource SftpButtonPadding}"
                            MinHeight="{StaticResource SftpToolbarButtonMinHeight}"
                            FontSize="{StaticResource FontSizeCaption}" Margin="0,0,4,0"
                            IsEnabled="{Binding CanDownloadSelected}"
                            AutomationProperties.Name="{loc:Translate A11yDownloadFiles}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource FontSizeBody}"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock x:Name="BtnDownloadText" Text="{loc:Translate SftpBtnDownload}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnNewFolder"
                            Command="{Binding CreateFolderCommand}"
                            ToolTip="{loc:Translate TooltipCreateFolder}"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Padding="{StaticResource SftpButtonPadding}"
                            MinHeight="{StaticResource SftpToolbarButtonMinHeight}"
                            FontSize="{StaticResource FontSizeCaption}"
                            IsEnabled="{Binding IsToolbarEnabled}"
                            AutomationProperties.Name="{loc:Translate A11yCreateFolder}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8F4;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource FontSizeBody}"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock x:Name="BtnNewFolderText" Text="{loc:Translate SftpBtnNewFolder}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Button>

                    <Border x:Name="ActionsPrivilegeSeparator"
                            Style="{StaticResource ToolbarVerticalSeparatorStyle}"
                            AutomationProperties.AutomationId="Toolbar.Sftp.ActionsPrivilegeSeparator"/>

                    <ToggleButton x:Name="BtnSudoMode"
                                  Command="{Binding ToggleSudoModeCommand}"
                                  IsChecked="{Binding SudoMode, Mode=OneWay}"
                                  ToolTip="{loc:Translate SftpSudoModeTooltip}"
                                  Style="{DynamicResource ToolbarToggleButtonStyle}"
                                  MinHeight="{StaticResource SftpToolbarButtonMinHeight}"
                                  FontSize="{StaticResource FontSizeCaption}"
                                  AutomationProperties.Name="{loc:Translate SftpSudoModeTooltip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7EF;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource FontSizeBody}"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock x:Name="BtnSudoModeText" Text="{loc:Translate SftpSudoModeLabel}" VerticalAlignment="Center"
                                       FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SudoMode}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton x:Name="BtnFollowSshDirectory"
                                  Checked="OnFollowSshDirectoryToggled"
                                  Unchecked="OnFollowSshDirectoryToggled"
                                  ToolTip="{loc:Translate SftpFollowSshDirectoryTooltip}"
                                  Style="{DynamicResource ToolbarToggleButtonStyle}"
                                  MinHeight="{StaticResource SftpToolbarButtonMinHeight}"
                                  FontSize="{StaticResource FontSizeCaption}"
                                  IsEnabled="{Binding IsToolbarEnabled}"
                                  AutomationProperties.Name="{loc:Translate SftpFollowSshDirectoryTooltip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource FontSizeBody}"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock x:Name="BtnFollowSshDirectoryText" Text="{loc:Translate SftpFollowSshDirectoryLabel}" VerticalAlignment="Center"
                                       FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ToggleButton>

                    <Border x:Name="PrivilegeBookmarksSeparator"
                            Style="{StaticResource ToolbarVerticalSeparatorStyle}"
                            AutomationProperties.AutomationId="Toolbar.Sftp.PrivilegeBookmarksSeparator"/>

                    <!-- Bookmarks overflow menu -->
                    <Button x:Name="BtnBookmarkMenu"
                            Content="&#xE734;"
                            ToolTip="{loc:Translate SftpBtnBookmark}"
                            FontFamily="Segoe MDL2 Assets"
                            Style="{DynamicResource GhostButtonStyle}"
                            Padding="{StaticResource SftpButtonPadding}" FontSize="{StaticResource FontSizeBody}"
                            Click="OnToolbarMenuButtonClick"
                            IsEnabled="{Binding IsToolbarEnabled}"
                            AutomationProperties.Name="{loc:Translate SftpBtnBookmark}">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="BookmarkContextMenu"
                                         DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem x:Name="MnuBookmarkAdd"
                                          Header="{loc:Translate SftpBtnBookmark}"
                                          Command="{Binding AddBookmarkCommand}"
                                          AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource Self}}">
                                </MenuItem>
                                <MenuItem x:Name="MnuBookmarkManage" Header="{loc:Translate SftpBtnBookmarks}" Click="OnBookmarksClick"
                                          AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource Self}}">
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- Overflow menu: hosts the labelled actions when the toolbar is too
                         narrow to show them inline (compact mode, e.g. split panes). -->
                    <Button x:Name="BtnOverflowMenu"
                            Content="&#xE712;"
                            ToolTip="{loc:Translate SftpBtnMoreActions}"
                            FontFamily="Segoe MDL2 Assets"
                            Style="{DynamicResource GhostButtonStyle}"
                            Padding="{StaticResource SftpButtonPadding}" FontSize="{StaticResource FontSizeBody}" Margin="4,0,0,0"
                            Visibility="Collapsed"
                            Click="OnToolbarMenuButtonClick"
                            IsEnabled="{Binding IsToolbarEnabled}"
                            AutomationProperties.Name="{loc:Translate SftpBtnMoreActions}">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="OverflowContextMenu"
                                         DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="{loc:Translate SftpBtnUpload}"
                                          Click="OnUploadClick"
                                          AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource Self}}">
                                </MenuItem>
                                <MenuItem Header="{loc:Translate SftpBtnDownload}"
                                          Click="OnDownloadClick"
                                          IsEnabled="{Binding CanDownloadSelected}"
                                          AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource Self}}">
                                </MenuItem>
                                <MenuItem Header="{loc:Translate SftpBtnNewFolder}"
                                          Command="{Binding CreateFolderCommand}"
                                          AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource Self}}">
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="{loc:Translate SftpBtnBookmark}"
                                          Command="{Binding AddBookmarkCommand}"
                                          AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource Self}}">
                                </MenuItem>
                                <MenuItem Header="{loc:Translate SftpBtnBookmarks}"
                                          Click="OnBookmarksClick"
                                          AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource Self}}">
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Row 2: Path bar -->
        <Border Grid.Row="2"
                Padding="{StaticResource SftpPanelPadding}"
                Background="{DynamicResource BackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <Button x:Name="BtnGoPath"
                        DockPanel.Dock="Right"
                        Content="&#xE76C;"
                        ToolTip="{loc:Translate SftpBtnGoPath}"
                        FontFamily="Segoe MDL2 Assets"
                        Command="{Binding GoToPathCommand}"
                        Style="{DynamicResource GhostButtonStyle}"
                        Padding="{StaticResource SftpButtonPadding}" FontSize="{StaticResource FontSizeBody}"
                        Margin="4,0,0,0"
                        IsEnabled="{Binding IsToolbarEnabled}"
                        AutomationProperties.Name="{loc:Translate SftpBtnGoPath}"/>
                <!-- Enabled with the connection, not with the listing: a control that turns disabled
                     loses the keyboard focus for good, and every Enter used to do exactly that. -->
                <Grid>
                    <TextBox x:Name="PathTextBox"
                             Style="{DynamicResource ThemedTextBoxStyle}"
                             FontSize="{StaticResource FontSizeBody}"
                             FontFamily="{StaticResource FontFamilyMonospace}"
                             VerticalContentAlignment="Center"
                             Text="{Binding PathBarText, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsToolbarEnabled}"
                             KeyDown="OnPathKeyDown"
                             AutomationProperties.Name="{loc:Translate A11yTxtPath}"/>
                    <!-- The breadcrumb covers the path box until the box takes the keyboard (F4, Alt+D, or a
                         click on the empty part of the bar): each folder is a button that goes there. -->
                    <Border x:Name="PathBreadcrumb"
                            Background="{Binding Background, ElementName=PathTextBox}"
                            BorderBrush="{Binding BorderBrush, ElementName=PathTextBox}"
                            BorderThickness="{Binding BorderThickness, ElementName=PathTextBox}"
                            CornerRadius="{StaticResource CornerRadiusMd}"
                            MouseLeftButtonDown="OnPathBreadcrumbMouseDown">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=PathTextBox}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <ScrollViewer x:Name="PathBreadcrumbScroll"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      SizeChanged="OnPathBreadcrumbSizeChanged">
                            <ItemsControl ItemsSource="{Binding PathSegments}"
                                          AutomationProperties.Name="{loc:Translate A11yBreadcrumb}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="Chevron"
                                                       Text="&#xE76C;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="{StaticResource FontSizeSmallCaption}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <Button Content="{Binding Name}"
                                                    Click="OnPathSegmentClick"
                                                    Style="{DynamicResource GhostButtonStyle}"
                                                    FontFamily="{StaticResource FontFamilyMonospace}"
                                                    FontSize="{StaticResource FontSizeBody}"
                                                    MinWidth="0"
                                                    MinHeight="{StaticResource SftpFilterClearSize}"
                                                    Padding="{StaticResource SftpIconButtonPadding}"
                                                    ToolTip="{Binding FullPath}"
                                                    AutomationProperties.Name="{Binding FullPath}"/>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding FullPath}" Value="/">
                                                <Setter TargetName="Chevron" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Row 3: File list -->
        <ListView x:Name="FileListView"
                  Grid.Row="3"
                  Margin="0"
                  Background="{DynamicResource BackgroundBrush}"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  BorderThickness="0"
                  ItemsSource="{Binding Files}"
                  ItemContainerStyle="{StaticResource SftpRowStyle}"
                  SelectionMode="Extended"
                  AlternationCount="2"
                  TextSearch.TextPath="Name"
                  IsTextSearchEnabled="True"
                  MouseDoubleClick="OnFileDoubleClick"
                  PreviewMouseRightButtonDown="OnFileListPreviewMouseRightButtonDown"
                  PreviewMouseLeftButtonDown="OnFileListPreviewMouseLeftButtonDown"
                  PreviewMouseLeftButtonUp="OnFileListPreviewMouseLeftButtonUp"
                  PreviewMouseMove="OnFileListPreviewMouseMove"
                  ContextMenuOpening="OnFileContextMenuOpening"
                  SelectionChanged="OnSelectionChanged"
                  GridViewColumnHeader.Click="OnColumnHeaderClick"
                  SizeChanged="OnFileListSizeChanged"
                  AutomationProperties.Name="{loc:Translate A11yLstFiles}"
                  AutomationProperties.ItemStatus="{Binding SortDescription}"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.View>
                <GridView AllowsColumnReorder="False">
                    <GridViewColumn x:Name="ColName" local:SftpColumn.Key="Name" Width="{StaticResource SftpColumnWidthName}" Header="{loc:Translate SftpColName}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="FileIcon"
                                               Text="&#xE7C3;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="{StaticResource FontSizeBodyLarge}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,0,6,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Directory">
                                        <Setter TargetName="FileIcon" Property="Text" Value="&#xE8B7;"/>
                                        <Setter TargetName="FileIcon" Property="Foreground" Value="{DynamicResource InfoBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="SymbolicLink">
                                        <Setter TargetName="FileIcon" Property="Text" Value="&#xE71B;"/>
                                        <Setter TargetName="FileIcon" Property="Foreground" Value="{DynamicResource InfoBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Fifo">
                                        <Setter TargetName="FileIcon" Property="Text" Value="&#xE946;"/>
                                        <Setter TargetName="FileIcon" Property="Foreground" Value="{DynamicResource InfoBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Socket">
                                        <Setter TargetName="FileIcon" Property="Text" Value="&#xE946;"/>
                                        <Setter TargetName="FileIcon" Property="Foreground" Value="{DynamicResource InfoBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Unknown">
                                        <Setter TargetName="FileIcon" Property="Text" Value="&#xE7BA;"/>
                                        <Setter TargetName="FileIcon" Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Device">
                                        <Setter TargetName="FileIcon" Property="Text" Value="&#xE946;"/>
                                        <Setter TargetName="FileIcon" Property="Foreground" Value="{DynamicResource InfoBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="ColSize" local:SftpColumn.Key="Size" Width="{StaticResource SftpColumnWidthSize}" Header="{loc:Translate SftpColSize}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Size, Converter={StaticResource FileSizeConverter}, ConverterParameter=dir}"
                                           TextAlignment="Right" HorizontalAlignment="Right"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="ColDate" local:SftpColumn.Key="Modified" Width="{StaticResource SftpColumnWidthModified}" Header="{loc:Translate SftpColModified}"
                                    DisplayMemberBinding="{Binding LastModified, Converter={StaticResource FileDateTimeConverter}}"/>
                    <GridViewColumn x:Name="ColPermissions" local:SftpColumn.Key="Permissions" Width="{StaticResource SftpColumnWidthPermissions}" Header="{loc:Translate SftpColPermissions}"
                                    DisplayMemberBinding="{Binding Permissions}"/>
                    <GridViewColumn x:Name="ColOwner" local:SftpColumn.Key="Owner" Width="{StaticResource SftpColumnWidthOwner}" Header="{loc:Translate SftpColOwner}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Owner}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Owner}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>

            <ListView.ContextMenu>
                <ContextMenu x:Name="FileContextMenu"
                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                             Opened="OnContextMenuOpened">
                    <MenuItem x:Name="CtxOpen" Header="{loc:Translate SftpCtxOpen}" Click="OnCtxOpenClick" InputGestureText="Enter"
                              AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource Self}}">
                    </MenuItem>
                    <MenuItem x:Name="CtxEdit" Header="{loc:Translate SftpCtxEdit}" Click="OnCtxEditClick"
                              AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource Self}}">
                    </MenuItem>
                    <MenuItem x:Name="CtxEditExternal" Header="{loc:Translate SftpCtxEditExternal}" Click="OnCtxEditExternalClick"
                              AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource Self}}">
                    </MenuItem>
                    <MenuItem x:Name="CtxDownload" Header="{loc:Translate SftpBtnDownload}" Click="OnCtxDownloadClick" InputGestureText="Ctrl+Shift+D"
                              AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource Self}}">
                    </MenuItem>
                    <Separator/>
                    <MenuItem x:Name="CtxRename" Header="{loc:Translate SftpBtnRename}" Command="{Binding RenameSelectedCommand}" InputGestureText="F2"
                              AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource Self}}">
                    </MenuItem>
                    <MenuItem x:Name="CtxDelete" Header="{loc:Translate SftpBtnDelete}" Command="{Binding DeleteSelectedCommand}" InputGestureText="Del"
                              AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource Self}}">
                    </MenuItem>
                    <MenuItem x:Name="CtxChmod" Header="{loc:Translate SftpCtxChmod}" Command="{Binding ChmodSelectedCommand}"
                              AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource Self}}">
                    </MenuItem>
                    <Separator/>
                    <MenuItem x:Name="CtxCut" Header="{loc:Translate SftpCtxCut}" Command="{Binding CutSelectedCommand}" InputGestureText="Ctrl+X"
                              AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource Self}}">
                    </MenuItem>
                    <MenuItem x:Name="CtxCopy" Header="{loc:Translate SftpCtxCopy}" Command="{Binding CopySelectedCommand}" InputGestureText="Ctrl+C"
                              AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource Self}}">
                    </MenuItem>
                    <MenuItem x:Name="CtxPaste" Header="{loc:Translate SftpCtxPaste}" Command="{Binding PasteCommand}" InputGestureText="Ctrl+V"
                              AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource Self}}">
                    </MenuItem>
                    <MenuItem x:Name="CtxPasteFromExplorer" Header="{loc:Translate SftpCtxPasteFromExplorer}" Click="OnCtxPasteFromExplorerClick"
                              AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource Self}}">
                    </MenuItem>
                    <MenuItem x:Name="CtxDuplicate" Header="{loc:Translate SftpCtxDuplicate}" Command="{Binding DuplicateSelectedCommand}"
                              AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource Self}}">
                    </MenuItem>
                    <Separator/>
                    <MenuItem x:Name="CtxCopyPath" Header="{loc:Translate SftpCopyPath}" Click="OnCtxCopyPathClick" InputGestureText="Ctrl+Shift+C"
                              AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource Self}}">
                    </MenuItem>
                    <MenuItem x:Name="CtxProperties" Header="{loc:Translate SftpCtxProperties}" Command="{Binding ShowSelectedPropertiesCommand}"
                              AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource Self}}">
                    </MenuItem>
                    <Separator/>
                    <MenuItem x:Name="CtxNewFolder" Header="{loc:Translate SftpBtnNewFolder}" Command="{Binding CreateFolderCommand}" InputGestureText="F7"
                              AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource Self}}">
                    </MenuItem>
                    <MenuItem x:Name="CtxUploadHere" Header="{loc:Translate SftpCtxUploadHere}" Click="OnUploadClick" InputGestureText="Ctrl+Shift+U"
                              AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource Self}}">
                    </MenuItem>
                    <MenuItem x:Name="CtxOpenInTerminal" Header="{loc:Translate SftpCtxOpenInTerminal}" Command="{Binding OpenSelectedInTerminalCommand}"
                              AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource Self}}">
                    </MenuItem>
                </ContextMenu>
            </ListView.ContextMenu>
        </ListView>

        <!-- Row 3 overlay: Loading indicator -->
        <ProgressBar x:Name="LoadingBar"
                     Grid.Row="3"
                     VerticalAlignment="Top"
                     Height="{StaticResource SftpLoadingBarHeight}"
                     IsIndeterminate="True"
                     Foreground="{DynamicResource AccentBrush}"
                     Background="Transparent"
                     BorderThickness="0"
                     IsHitTestVisible="False"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- Row 3 overlay: why the list is empty (nothing here, a filter hides all, only hidden entries) -->
        <StackPanel x:Name="EmptyStatePanel"
                    Grid.Row="3"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    MaxWidth="{StaticResource SftpEmptyStateMaxWidth}"
                    Visibility="{Binding ShowEmptyDirectory, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock x:Name="EmptyDirectoryText"
                       Text="{Binding EmptyStateText}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       FontSize="{StaticResource FontSizeBodyLarge}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       AutomationProperties.LiveSetting="Polite"/>
            <Button x:Name="EmptyStateActionButton"
                    Content="{Binding EmptyStateActionText}"
                    Command="{Binding RunEmptyStateActionCommand}"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    MinHeight="{StaticResource SftpToolbarButtonMinHeight}"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,0"
                    Visibility="{Binding HasEmptyStateAction, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>

        <!-- Row 3 overlay: the session is gone; the list below is the last one received -->
        <Grid x:Name="DisconnectedOverlay"
              Grid.Row="3"
              Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVisibilityConverter}}">
            <Rectangle Fill="{DynamicResource BackgroundBrush}" Opacity="{StaticResource SftpOverlayScrimOpacity}"/>
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        MaxWidth="{StaticResource SftpEmptyStateMaxWidth}">
                <TextBlock Text="{loc:Translate SftpStatusDisconnected}"
                           HorizontalAlignment="Center"
                           FontSize="{StaticResource FontSizeBodyLarge}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ErrorBrush}"/>
                <TextBlock Text="{loc:Translate SftpDisconnectedOverlayMessage}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <Button x:Name="OverlayReconnectButton"
                        Content="{loc:Translate SftpBtnReconnect}"
                        Click="OnReconnectClick"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        MinHeight="{StaticResource SftpToolbarButtonMinHeight}"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0"
                        AutomationProperties.Name="{loc:Translate A11yReconnectSession}"/>
            </StackPanel>
        </Grid>

        <!-- Row 3 overlay: Drag-drop feedback -->
        <Border x:Name="DragOverlay"
                Grid.Row="3"
                Background="{DynamicResource DragDropOverlayBackground}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="2"
                CornerRadius="{StaticResource CornerRadiusSm}"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="{StaticResource SftpDropBadgePadding}"
                    Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="{StaticResource CornerRadiusSm}">
                <TextBlock x:Name="DragDropOverlayText"
                           Text="{loc:Translate SftpDragDropOverlay}"
                           FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Border>
        </Border>

        <!-- Row 4: Transfer progress and queue -->
        <Border x:Name="TransferPanel"
                Grid.Row="4"
                Padding="{StaticResource SftpPanelPadding}"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Visibility="{Binding ShowTransferPanel, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <DockPanel Visibility="{Binding IsTransferInProgress, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button x:Name="BtnCancelTransfer"
                            DockPanel.Dock="Right"
                            Content="&#xE711;"
                            ToolTip="{loc:Translate TooltipCancelTransfer}"
                            FontFamily="Segoe MDL2 Assets"
                            Command="{Binding CancelTransferCommand}"
                            Style="{DynamicResource GhostButtonStyle}"
                            Padding="{StaticResource SftpIconButtonPadding}" FontSize="{StaticResource FontSizeBody}"
                            Margin="8,0,0,0"
                            AutomationProperties.Name="{loc:Translate A11yCancelTransfer}"/>
                    <StackPanel>
                        <TextBlock x:Name="TransferText"
                                   Text="{Binding TransferStatusText}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <ProgressBar x:Name="TransferProgressBar"
                                     Value="{Binding TransferProgressValue}"
                                     IsIndeterminate="{Binding IsTransferIndeterminate}"
                                     Height="{StaticResource SftpTransferBarHeight}" Margin="0,4,0,0"
                                     Minimum="0" Maximum="100"
                                     Foreground="{DynamicResource AccentBrush}"
                                     Background="{DynamicResource HighlightBrush}"
                                     AutomationProperties.Name="{loc:Translate A11yPrgTransfer}"/>
                    </StackPanel>
                </DockPanel>
                <!-- The queue: batches waiting, running, failed or cancelled. A finished batch leaves
                     by itself; one that did not complete stays until it is retried or cleared. -->
                <ScrollViewer x:Name="TransferJobScroll"
                              MaxHeight="{StaticResource SftpJobListMaxHeight}"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasTransferJobs, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl x:Name="TransferJobList"
                                  ItemsSource="{Binding TransferJobs}"
                                  AutomationProperties.Name="{loc:Translate SftpTransferQueueLabel}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,4,0,0"
                                           AutomationProperties.Name="{Binding Title}">
                                    <Button DockPanel.Dock="Right"
                                            Content="&#xE711;"
                                            FontFamily="Segoe MDL2 Assets"
                                            Style="{DynamicResource GhostButtonStyle}"
                                            MinWidth="{StaticResource SftpFilterClearSize}"
                                            MinHeight="{StaticResource SftpFilterClearSize}"
                                            Padding="{StaticResource SftpIconButtonPadding}"
                                            ToolTip="{loc:Translate SftpTransferCancelJob}"
                                            AutomationProperties.Name="{loc:Translate SftpTransferCancelJob}"
                                            Command="{Binding DataContext.CancelJobCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <Button DockPanel.Dock="Right"
                                            Content="&#xE72C;"
                                            FontFamily="Segoe MDL2 Assets"
                                            Style="{DynamicResource GhostButtonStyle}"
                                            MinWidth="{StaticResource SftpFilterClearSize}"
                                            MinHeight="{StaticResource SftpFilterClearSize}"
                                            Padding="{StaticResource SftpIconButtonPadding}"
                                            ToolTip="{loc:Translate SftpTransferRetry}"
                                            AutomationProperties.Name="{loc:Translate SftpTransferRetry}"
                                            Command="{Binding DataContext.RetryJobCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <TextBlock x:Name="JobGlyph"
                                               Text="&#xE823;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="{StaticResource FontSizeCaption}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="JobDetail"
                                                   Text="{Binding Detail}"
                                                   FontSize="{StaticResource FontSizeSmallCaption}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Running">
                                        <Setter TargetName="JobGlyph" Property="Text" Value="&#xE895;"/>
                                        <Setter TargetName="JobGlyph" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                                        <Setter TargetName="JobGlyph" Property="Text" Value="&#xE783;"/>
                                        <Setter TargetName="JobGlyph" Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                        <Setter TargetName="JobDetail" Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                        <Setter TargetName="JobGlyph" Property="Text" Value="&#xE711;"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Completed">
                                        <Setter TargetName="JobGlyph" Property="Text" Value="&#xE73E;"/>
                                        <Setter TargetName="JobGlyph" Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Button x:Name="BtnClearFinishedJobs"
                        Content="{loc:Translate SftpTransferClearFinished}"
                        Command="{Binding ClearFinishedJobsCommand}"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        MinHeight="{StaticResource SftpToolbarButtonMinHeight}"
                        Padding="{StaticResource SftpButtonPadding}"
                        FontSize="{StaticResource FontSizeCaption}"
                        HorizontalAlignment="Left"
                        Margin="0,4,0,0"
                        Visibility="{Binding HasFinishedTransferJobs, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StackPanel>
        </Border>

        <!-- Row 5: Status bar. The one place the status is shown: an error gets an icon and its colour
             here, and stays until the next status replaces it. -->
        <Border Grid.Row="5"
                Padding="{StaticResource SessionHeaderPadding}"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock x:Name="ItemCountText"
                           DockPanel.Dock="Right"
                           Text="{Binding ItemCountText}"
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock x:Name="SelectionInfoText"
                           DockPanel.Dock="Right"
                           Text="{Binding SelectionInfoText}"
                           FontSize="{StaticResource FontSizeCaption}"
                           Margin="0,0,12,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <!-- Connection health dot -->
                <Ellipse x:Name="HealthDot"
                         Width="{StaticResource SftpHealthDotSize}" Height="{StaticResource SftpHealthDotSize}"
                         Margin="0,0,6,0"
                         VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                    <Setter Property="Fill" Value="{DynamicResource ErrorBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock x:Name="StatusErrorIcon"
                           Text="&#xE783;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource ErrorBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0"
                           Visibility="{Binding IsErrorStatus, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <TextBlock x:Name="StatusBarText"
                           Text="{Binding StatusText}"
                           ToolTip="{Binding StatusText}"
                           FontSize="{StaticResource FontSizeCaption}"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsErrorStatus}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                    <Setter Property="AutomationProperties.LiveSetting" Value="Assertive"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>
        </Grid>

        <ContentControl x:Name="InlineEditorHost"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Visibility="Collapsed"/>
    </Grid>
</UserControl>
