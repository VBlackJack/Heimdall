<!-- The read-only properties of one session. The DataContext is a ServerItemViewModel. Both the
     detail pane of the session area and the properties panel under the tree show this control, so
     the two can never list different fields. Authentication comes first: it is the line people
     browse the tree for. -->
<UserControl x:Class="Heimdall.App.Controls.SessionPropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Heimdall.App.Localization"
             IsTabStop="False"
             Focusable="False">
    <UserControl.Resources>
        <!-- A value that copies itself: a button, so the keyboard reaches it and a screen reader
             names it, drawn as the plain text it was, underlined while pointed at or focused. -->
        <Style x:Key="SpvCopyValueStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="{StaticResource TargetMinSize}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <!-- The value in full, then how to copy it: a long value ends in an ellipsis at the
                 sidebar's narrowest, and the hint alone left no way to read it. -->
            <Setter Property="ToolTip">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource LocalizedFormatConverter}">
                        <Binding Source="{x:Static loc:LocalizationSource.Instance}" Path="[PropertiesCopyValueToolTip]"/>
                        <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Setter Property="AutomationProperties.HelpText" Value="{loc:Translate PropertiesCopyValueHint}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,1">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusIndicatorBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <Border CornerRadius="{StaticResource CornerRadiusSm}" Padding="6,2" Margin="0,0,8,0">
                <Border.Background>
                    <MultiBinding Converter="{StaticResource ConnectionTypeToBrushConverter}">
                        <Binding Path="ConnectionType"/>
                        <Binding Path="DataContext.ThemeRevision" RelativeSource="{RelativeSource AncestorType={x:Type Window}}"/>
                    </MultiBinding>
                </Border.Background>
                <TextBlock x:Name="Spv_Protocol"
                           Text="{Binding ProtocolDisplayName}"
                           FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold"
                           Foreground="{DynamicResource BadgeTextBrush}"
                           TextTrimming="CharacterEllipsis"/>
            </Border>
            <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                     VerticalAlignment="Center">
                <Ellipse.Fill>
                    <MultiBinding Converter="{StaticResource ConnectionStateToBrushConverter}">
                        <Binding Path="ConnectionState"/>
                        <Binding Path="DataContext.ThemeRevision" RelativeSource="{RelativeSource AncestorType={x:Type Window}}"/>
                    </MultiBinding>
                </Ellipse.Fill>
            </Ellipse>
            <TextBlock x:Name="Spv_State"
                       Text="{Binding ConnectionStateDisplayName}"
                       ToolTip="{Binding ConnectionStateTooltip}"
                       FontSize="{StaticResource FontSizeCaption}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <!-- Endpoint carries the protocol's own port; RemotePort is the RDP one whatever the type. -->
        <Button x:Name="Spv_EndpointCopy"
                Style="{StaticResource SpvCopyValueStyle}"
                Tag="{Binding Endpoint}"
                Click="OnCopyValueClick"
                Margin="0,8,0,0"
                Visibility="{Binding Endpoint, Converter={StaticResource NullToVisibilityConverter}}">
            <AutomationProperties.Name>
                <MultiBinding Converter="{StaticResource LocalizedFormatConverter}">
                    <Binding Source="{x:Static loc:LocalizationSource.Instance}" Path="[PropertiesCopyValueName]"/>
                    <Binding Source="{x:Static loc:LocalizationSource.Instance}" Path="[DetailLabelEndpoint]"/>
                    <Binding Path="Endpoint"/>
                </MultiBinding>
            </AutomationProperties.Name>
            <TextBlock x:Name="Spv_Endpoint"
                       Text="{Binding Endpoint}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="{StaticResource FontSizeBodyLarge}"
                       TextTrimming="CharacterEllipsis"/>
        </Button>

        <Border Margin="0,10,0,0" Padding="12,8"
                Background="{DynamicResource CardBrush}"
                CornerRadius="{StaticResource CornerRadiusSm}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Authentication -->
                <TextBlock x:Name="Spv_AuthLabel" Grid.Row="0" Grid.Column="0"
                           Text="{loc:Translate DetailLabelAuth}" FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,2,12,2" VerticalAlignment="Top"
                           Visibility="{Binding AuthSummary, Converter={StaticResource NullToVisibilityConverter}}"/>
                <TextBlock x:Name="Spv_Auth" Grid.Row="0" Grid.Column="1"
                           Text="{Binding AuthSummary}"
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,2,0,2" TextWrapping="Wrap"
                           Visibility="{Binding AuthSummary, Converter={StaticResource NullToVisibilityConverter}}"/>

                <!-- Username -->
                <TextBlock x:Name="Spv_UsernameLabel" Grid.Row="1" Grid.Column="0"
                           Text="{loc:Translate DetailLabelUsername}" FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,2,12,2" VerticalAlignment="Top"
                           Visibility="{Binding Username, Converter={StaticResource NullToVisibilityConverter}}"/>
                <Button x:Name="Spv_UsernameCopy" Grid.Row="1" Grid.Column="1"
                        Style="{StaticResource SpvCopyValueStyle}"
                        Tag="{Binding Username}"
                        Click="OnCopyValueClick"
                        Margin="0,2,0,2"
                        Visibility="{Binding Username, Converter={StaticResource NullToVisibilityConverter}}">
                    <AutomationProperties.Name>
                        <MultiBinding Converter="{StaticResource LocalizedFormatConverter}">
                            <Binding Source="{x:Static loc:LocalizationSource.Instance}" Path="[PropertiesCopyValueName]"/>
                            <Binding Source="{x:Static loc:LocalizationSource.Instance}" Path="[DetailLabelUsername]"/>
                            <Binding Path="Username"/>
                        </MultiBinding>
                    </AutomationProperties.Name>
                    <TextBlock Text="{Binding Username}"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </Button>

                <!-- SSH key: SSH and SFTP only -->
                <TextBlock x:Name="Spv_SshKeyLabel" Grid.Row="2" Grid.Column="0"
                           Text="{loc:Translate DetailLabelSshKey}" FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,2,12,2" VerticalAlignment="Top"
                           Visibility="{Binding SshKeyText, Converter={StaticResource NullToVisibilityConverter}}"/>
                <Button x:Name="Spv_SshKeyCopy" Grid.Row="2" Grid.Column="1"
                        Style="{StaticResource SpvCopyValueStyle}"
                        Tag="{Binding SshKeyText}"
                        Click="OnCopyValueClick"
                        Margin="0,2,0,2"
                        Visibility="{Binding SshKeyText, Converter={StaticResource NullToVisibilityConverter}}">
                    <AutomationProperties.Name>
                        <MultiBinding Converter="{StaticResource LocalizedFormatConverter}">
                            <Binding Source="{x:Static loc:LocalizationSource.Instance}" Path="[PropertiesCopyValueName]"/>
                            <Binding Source="{x:Static loc:LocalizationSource.Instance}" Path="[DetailLabelSshKey]"/>
                            <Binding Path="SshKeyText"/>
                        </MultiBinding>
                    </AutomationProperties.Name>
                    <TextBlock Text="{Binding SshKeyText}"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap"/>
                </Button>

                <!-- Gateway -->
                <TextBlock x:Name="Spv_GatewayLabel" Grid.Row="3" Grid.Column="0"
                           Text="{loc:Translate DetailLabelGateway}" FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,2,12,2" VerticalAlignment="Top"
                           Visibility="{Binding IsGatewayBadgeVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <Button x:Name="Spv_GatewayCopy" Grid.Row="3" Grid.Column="1"
                        Style="{StaticResource SpvCopyValueStyle}"
                        Tag="{Binding GatewayDetailText}"
                        Click="OnCopyValueClick"
                        Margin="0,2,0,2"
                        Visibility="{Binding IsGatewayBadgeVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <AutomationProperties.Name>
                        <MultiBinding Converter="{StaticResource LocalizedFormatConverter}">
                            <Binding Source="{x:Static loc:LocalizationSource.Instance}" Path="[PropertiesCopyValueName]"/>
                            <Binding Source="{x:Static loc:LocalizationSource.Instance}" Path="[DetailLabelGateway]"/>
                            <Binding Path="GatewayDetailText"/>
                        </MultiBinding>
                    </AutomationProperties.Name>
                <TextBlock FontSize="{StaticResource FontSizeCaption}"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGatewayMissing}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <Run Text="{Binding GatewayDetailText, Mode=OneWay}"/>
                </TextBlock>
                </Button>

                <!-- Folder -->
                <TextBlock x:Name="Spv_GroupLabel" Grid.Row="4" Grid.Column="0"
                           Text="{loc:Translate DetailLabelGroup}" FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,2,12,2" VerticalAlignment="Top"
                           Visibility="{Binding Group, Converter={StaticResource NullToVisibilityConverter}}"/>
                <Button x:Name="Spv_GroupCopy" Grid.Row="4" Grid.Column="1"
                        Style="{StaticResource SpvCopyValueStyle}"
                        Tag="{Binding Group}"
                        Click="OnCopyValueClick"
                        Margin="0,2,0,2"
                        Visibility="{Binding Group, Converter={StaticResource NullToVisibilityConverter}}">
                    <AutomationProperties.Name>
                        <MultiBinding Converter="{StaticResource LocalizedFormatConverter}">
                            <Binding Source="{x:Static loc:LocalizationSource.Instance}" Path="[PropertiesCopyValueName]"/>
                            <Binding Source="{x:Static loc:LocalizationSource.Instance}" Path="[DetailLabelGroup]"/>
                            <Binding Path="Group"/>
                        </MultiBinding>
                    </AutomationProperties.Name>
                    <TextBlock Text="{Binding Group}"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap"/>
                </Button>

                <!-- Project: the import or team grouping, which a tree of hundreds is often sorted by. -->
                <TextBlock x:Name="Spv_ProjectLabel" Grid.Row="5" Grid.Column="0"
                           Text="{loc:Translate DetailLabelProject}" FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,2,12,2" VerticalAlignment="Top"
                           Visibility="{Binding ProjectName, Converter={StaticResource NullToVisibilityConverter}}"/>
                <Button x:Name="Spv_ProjectCopy" Grid.Row="5" Grid.Column="1"
                        Style="{StaticResource SpvCopyValueStyle}"
                        Tag="{Binding ProjectName}"
                        Click="OnCopyValueClick"
                        Margin="0,2,0,2"
                        Visibility="{Binding ProjectName, Converter={StaticResource NullToVisibilityConverter}}">
                    <AutomationProperties.Name>
                        <MultiBinding Converter="{StaticResource LocalizedFormatConverter}">
                            <Binding Source="{x:Static loc:LocalizationSource.Instance}" Path="[PropertiesCopyValueName]"/>
                            <Binding Source="{x:Static loc:LocalizationSource.Instance}" Path="[DetailLabelProject]"/>
                            <Binding Path="ProjectName"/>
                        </MultiBinding>
                    </AutomationProperties.Name>
                    <TextBlock Text="{Binding ProjectName}"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap"/>
                </Button>

                <!-- Origin: where an imported session came from. A session made by hand has none to show. -->
                <TextBlock x:Name="Spv_OriginLabel" Grid.Row="6" Grid.Column="0"
                           Text="{loc:Translate DetailLabelOrigin}" FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,2,12,2" VerticalAlignment="Top"
                           Visibility="{Binding IsOriginBadgeVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <TextBlock x:Name="Spv_Origin" Grid.Row="6" Grid.Column="1"
                           Text="{Binding OriginDisplayName}"
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,2,0,2" TextWrapping="Wrap"
                           Visibility="{Binding IsOriginBadgeVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- Environment -->
                <TextBlock x:Name="Spv_EnvLabel" Grid.Row="7" Grid.Column="0"
                           Text="{loc:Translate DetailLabelEnvironment}" FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,2,12,2" VerticalAlignment="Top"
                           Visibility="{Binding Environment, Converter={StaticResource NullToVisibilityConverter}}"/>
                <Button x:Name="Spv_EnvCopy" Grid.Row="7" Grid.Column="1"
                        Style="{StaticResource SpvCopyValueStyle}"
                        Tag="{Binding Environment}"
                        Click="OnCopyValueClick"
                        Margin="0,2,0,2"
                        Visibility="{Binding Environment, Converter={StaticResource NullToVisibilityConverter}}">
                    <AutomationProperties.Name>
                        <MultiBinding Converter="{StaticResource LocalizedFormatConverter}">
                            <Binding Source="{x:Static loc:LocalizationSource.Instance}" Path="[PropertiesCopyValueName]"/>
                            <Binding Source="{x:Static loc:LocalizationSource.Instance}" Path="[DetailLabelEnvironment]"/>
                            <Binding Path="Environment"/>
                        </MultiBinding>
                    </AutomationProperties.Name>
                    <TextBlock Text="{Binding Environment}"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </Button>

                <!-- Tags -->
                <TextBlock x:Name="Spv_TagsLabel" Grid.Row="8" Grid.Column="0"
                           Text="{loc:Translate DetailLabelTags}" FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,2,12,2" VerticalAlignment="Top"
                           Visibility="{Binding Tags, Converter={StaticResource NullToVisibilityConverter}}"/>
                <Button x:Name="Spv_TagsCopy" Grid.Row="8" Grid.Column="1"
                        Style="{StaticResource SpvCopyValueStyle}"
                        Tag="{Binding Tags}"
                        Click="OnCopyValueClick"
                        Margin="0,2,0,2"
                        Visibility="{Binding Tags, Converter={StaticResource NullToVisibilityConverter}}">
                    <AutomationProperties.Name>
                        <MultiBinding Converter="{StaticResource LocalizedFormatConverter}">
                            <Binding Source="{x:Static loc:LocalizationSource.Instance}" Path="[PropertiesCopyValueName]"/>
                            <Binding Source="{x:Static loc:LocalizationSource.Instance}" Path="[DetailLabelTags]"/>
                            <Binding Path="Tags"/>
                        </MultiBinding>
                    </AutomationProperties.Name>
                    <TextBlock Text="{Binding Tags}"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap"/>
                </Button>

                <!-- Favorite -->
                <TextBlock x:Name="Spv_FavoriteLabel" Grid.Row="9" Grid.Column="0"
                           Text="{loc:Translate DetailLabelFavorite}" FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,2,12,2" VerticalAlignment="Center"
                           Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <TextBlock Grid.Row="9" Grid.Column="1"
                           Text="&#xE735;" FontFamily="{StaticResource FontFamilyIcons}"
                           FontSize="{StaticResource FontSizeBody}"
                           Foreground="{DynamicResource WarningTextBrush}"
                           Margin="0,2,0,2"
                           Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibilityConverter}}"
                           AutomationProperties.Name="{loc:Translate A11yFavoriteIndicator}"/>

                <!-- Latency of the last successful probe -->
                <TextBlock x:Name="Spv_LatencyLabel" Grid.Row="10" Grid.Column="0"
                           Text="{loc:Translate DetailLabelLatency}" FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,2,12,2" VerticalAlignment="Top"
                           Visibility="{Binding LatencyText, Converter={StaticResource NullToVisibilityConverter}}"/>
                <Button x:Name="Spv_LatencyCopy" Grid.Row="10" Grid.Column="1"
                        Style="{StaticResource SpvCopyValueStyle}"
                        Tag="{Binding LatencyText}"
                        Click="OnCopyValueClick"
                        Margin="0,2,0,2"
                        Visibility="{Binding LatencyText, Converter={StaticResource NullToVisibilityConverter}}">
                    <AutomationProperties.Name>
                        <MultiBinding Converter="{StaticResource LocalizedFormatConverter}">
                            <Binding Source="{x:Static loc:LocalizationSource.Instance}" Path="[PropertiesCopyValueName]"/>
                            <Binding Source="{x:Static loc:LocalizationSource.Instance}" Path="[DetailLabelLatency]"/>
                            <Binding Path="LatencyText"/>
                        </MultiBinding>
                    </AutomationProperties.Name>
                    <TextBlock Text="{Binding LatencyText}"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </Button>

                <!-- Last opened, from the connection history -->
                <TextBlock x:Name="Spv_LastOpenedLabel" Grid.Row="11" Grid.Column="0"
                           Text="{loc:Translate DetailLabelLastOpened}" FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,2,12,2" VerticalAlignment="Top"
                           Visibility="{Binding LastOpenedText, Converter={StaticResource NullToVisibilityConverter}}"/>
                <Button x:Name="Spv_LastOpenedCopy" Grid.Row="11" Grid.Column="1"
                        Style="{StaticResource SpvCopyValueStyle}"
                        Tag="{Binding LastOpenedText}"
                        Click="OnCopyValueClick"
                        Margin="0,2,0,2"
                        Visibility="{Binding LastOpenedText, Converter={StaticResource NullToVisibilityConverter}}">
                    <AutomationProperties.Name>
                        <MultiBinding Converter="{StaticResource LocalizedFormatConverter}">
                            <Binding Source="{x:Static loc:LocalizationSource.Instance}" Path="[PropertiesCopyValueName]"/>
                            <Binding Source="{x:Static loc:LocalizationSource.Instance}" Path="[DetailLabelLastOpened]"/>
                            <Binding Path="LastOpenedText"/>
                        </MultiBinding>
                    </AutomationProperties.Name>
                    <TextBlock Text="{Binding LastOpenedText}"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </Button>
            </Grid>
        </Border>

        <!-- Says what a click copied, for a moment; announced to a screen reader. -->
        <TextBlock x:Name="Spv_CopyNotice"
                   FontSize="{StaticResource FontSizeCaption}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,6,0,0"
                   TextTrimming="CharacterEllipsis"
                   Visibility="Collapsed"
                   AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
</UserControl>
