<!-- The "modified from default" marker of one setting, placed after its field. The DataContext is
     the setting's SettingDefaultState. Collapsed while the value is the default, so it is neither
     drawn nor in the tab order nor found by the settings search; shown, it says "Modified" in text
     beside a dot, names the default for a screen reader, and offers the way back to it. -->
<UserControl x:Class="Heimdall.App.Controls.SettingDefaultMarker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Heimdall.App.Localization"
             IsTabStop="False"
             Focusable="False"
             HorizontalAlignment="Left"
             Margin="0,4,0,0">
    <UserControl.Visibility>
        <Binding Path="IsModified" FallbackValue="Collapsed">
            <Binding.Converter>
                <BooleanToVisibilityConverter/>
            </Binding.Converter>
        </Binding>
    </UserControl.Visibility>
    <StackPanel Orientation="Horizontal">
        <Border x:Name="Sdm_Badge"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource CornerRadiusSm}"
                Padding="6,0"
                VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <!-- The dot is decoration; the word beside it is the signal. -->
                <Ellipse Width="6"
                         Height="6"
                         Fill="{DynamicResource AccentBrush}"
                         VerticalAlignment="Center"
                         Margin="0,0,4,0"/>
                <TextBlock x:Name="Sdm_BadgeText"
                           Text="{loc:Translate SettingsModifiedBadge}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="{DynamicResource FontSizeSmallCaption}"
                           VerticalAlignment="Center"
                           AutomationProperties.Name="{Binding BadgeAccessibleName}"/>
            </StackPanel>
        </Border>
        <Button x:Name="Sdm_Reset"
                Command="{Binding ResetCommand}"
                Style="{DynamicResource GhostButtonStyle}"
                MinHeight="{DynamicResource TargetMinSize}"
                Padding="6,1"
                Margin="6,0,0,0"
                VerticalAlignment="Center"
                ToolTip="{Binding ResetAccessibleName}"
                AutomationProperties.Name="{Binding ResetAccessibleName}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE777;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="{DynamicResource FontSizeSmallCaption}"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0"/>
                <TextBlock Text="{loc:Translate SettingsResetToDefault}"
                           FontSize="{DynamicResource FontSizeSmallCaption}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
