<!-- One line of the security posture card. The DataContext is a SecurityPostureLine. The line is
     named as a whole for a screen reader (label, state, warning, unsaved), and colour is never the
     only signal: a risky line has a warning icon and a warning sentence, a safe one a check mark. -->
<UserControl x:Class="Heimdall.App.Controls.SecurityPostureLineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Heimdall.App.Localization"
             IsTabStop="False"
             Focusable="False"
             Margin="0,6,0,0"
             AutomationProperties.Name="{Binding AccessibleName}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="SplVisibleWhen"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="Spl_Icon"
                   Grid.Column="0"
                   FontFamily="Segoe MDL2 Assets"
                   FontSize="{DynamicResource FontSizeCaption}"
                   VerticalAlignment="Top"
                   Margin="0,2,8,0">
            <TextBlock.Style>
                <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="Text" Value="&#xE73E;"/>
                    <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRisky}" Value="True">
                            <Setter Property="Text" Value="&#xE7BA;"/>
                            <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="Spl_Text"
                       Text="{Binding Text}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="Spl_Warning"
                       Text="{Binding WarningText}"
                       Foreground="{DynamicResource WarningTextBrush}"
                       FontSize="{DynamicResource FontSizeCaption}"
                       TextWrapping="Wrap"
                       Margin="0,2,0,0"
                       Visibility="{Binding IsRisky, Converter={StaticResource SplVisibleWhen}}"/>
        </StackPanel>
        <Border x:Name="Spl_Unsaved"
                Grid.Column="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource CornerRadiusSm}"
                Padding="6,0"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Visibility="{Binding IsUnsaved, Converter={StaticResource SplVisibleWhen}}">
            <TextBlock Text="{loc:Translate SecurityPostureUnsaved}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="{DynamicResource FontSizeSmallCaption}"/>
        </Border>
        <Button x:Name="Spl_GoTo"
                Grid.Column="3"
                Content="{loc:Translate SecurityPostureGoTo}"
                Command="{Binding GoToCommand}"
                Style="{DynamicResource GhostButtonStyle}"
                MinHeight="0"
                Padding="6,1"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                AutomationProperties.Name="{Binding GoToAccessibleName}"
                Visibility="{Binding IsRisky, Converter={StaticResource SplVisibleWhen}}"/>
    </Grid>
</UserControl>
