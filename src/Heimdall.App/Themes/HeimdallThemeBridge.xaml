<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Generic themed brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{DynamicResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{DynamicResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{DynamicResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{DynamicResource AccentPressedColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColor}" />
    <!-- Secondary and tertiary text. SecondaryTextColor is not in any theme: HeimdallThemeService
         derives it from TextSecondaryColor on every theme change, so it reads at 4.5 to 1 on the
         window, a card, a hovered row and a selected row (Theming/ThemeTextColours.cs). The disabled
         text, the input border and the scroll thumb keep the theme's own colour. -->
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{DynamicResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{DynamicResource TextSecondaryColor}" Opacity="0.55" />
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
    <!-- A line that carries a boundary: the sidebar divider, grid header separators, tool header
         and footer rules, section cards. BorderStrongColor is not in any theme: HeimdallThemeService
         derives it from BorderColor on every theme change, so it reaches 3 to 1 on the background
         and on a card (WCAG 1.4.11, Theming/ThemeTextColours.cs). BorderBrush stays decorative. -->
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{DynamicResource BorderStrongColor}" />
    <!-- The outline that identifies an input or a secondary button. InputBorderColor is not in any
         theme: HeimdallThemeService derives it from TextSecondaryColor on every theme change, so it
         reaches 3 to 1 on the window and on a card (WCAG 1.4.11). On the raw colour the Dracula
         outline was 1.94 to 1 on a card. -->
    <SolidColorBrush x:Key="InputBorderBrush" Color="{DynamicResource InputBorderColor}" />
    <SolidColorBrush x:Key="HighlightBrush" Color="{DynamicResource SelectionColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{DynamicResource ErrorColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{DynamicResource InfoColor}" />
    <!-- Semantic and accent text. The *TextColor keys are not in any theme: HeimdallThemeService
         derives them from the theme colour of the same meaning on every theme change, so each
         reads at 4.5 to 1 on the background and on a card (Theming/ThemeTextColours.cs). -->
    <SolidColorBrush x:Key="SuccessTextBrush" Color="{DynamicResource SuccessTextColor}" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="{DynamicResource WarningTextColor}" />
    <SolidColorBrush x:Key="ErrorTextBrush" Color="{DynamicResource ErrorTextColor}" />
    <SolidColorBrush x:Key="InfoTextBrush" Color="{DynamicResource InfoTextColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{DynamicResource AccentTextColor}" />
    <!-- The accent the application paints and its outline. ActiveAccentColor and AccentBorderColor
         are not in any theme: HeimdallThemeService writes them on every theme and accent change from
         AccentBrush as resolved, so they follow an accent tint, which ThemeForge applies to the
         accent brushes only. The outline reaches 3 to 1 on the window and on a card (WCAG 1.4.11):
         focus rings, focused inputs, selected items (Theming/ThemeTextColours.cs). -->
    <SolidColorBrush x:Key="AccentBorderBrush" Color="{DynamicResource AccentBorderColor}" />
    <!-- Status indicators (the session tree's dot, the session properties dot). The *IndicatorColor
         keys are not in any theme: HeimdallThemeService derives them on every theme change, so each
         dot reaches 3 to 1 on the window, a card, a hovered row and a selected row (WCAG 1.4.11,
         Theming/ThemeTextColours.cs). -->
    <SolidColorBrush x:Key="SuccessIndicatorBrush" Color="{DynamicResource SuccessIndicatorColor}" />
    <SolidColorBrush x:Key="WarningIndicatorBrush" Color="{DynamicResource WarningIndicatorColor}" />
    <SolidColorBrush x:Key="ErrorIndicatorBrush" Color="{DynamicResource ErrorIndicatorColor}" />
    <SolidColorBrush x:Key="InfoIndicatorBrush" Color="{DynamicResource InfoIndicatorColor}" />
    <SolidColorBrush x:Key="NeutralIndicatorBrush" Color="{DynamicResource NeutralIndicatorColor}" />
    <SolidColorBrush x:Key="BadgeTextBrush" Color="{DynamicResource BackgroundColor}" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{DynamicResource BackgroundColor}" />
    <!-- The primary button's hover fill. AccentHoverFillColor is not in any theme: HeimdallThemeService
         picks it on every theme and accent change, the hover shade where TextOnAccentBrush reads on it
         at 4.5 to 1, the pressed shade where it does not (Theming/ThemeTextColours.cs). -->
    <SolidColorBrush x:Key="AccentHoverFillBrush" Color="{DynamicResource AccentHoverFillColor}" />
    <SolidColorBrush x:Key="FocusIndicatorBrush" Color="{DynamicResource CyanColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{DynamicResource TextSecondaryColor}" Opacity="0.70" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{DynamicResource BackgroundColor}" />
    <SolidColorBrush x:Key="TreeViewIndentGuideBrush" Color="{DynamicResource BorderColor}" Opacity="0.50" />
    <!-- Session tree row states. Hover keeps HighlightBrush; a selected row and a drop target each
         get their own tint, so the three never read as one state. -->
    <SolidColorBrush x:Key="TreeRowSelectedBrush" Color="{DynamicResource ActiveAccentColor}" Opacity="0.18" />
    <SolidColorBrush x:Key="TreeRowDropTargetBrush" Color="{DynamicResource InfoColor}" Opacity="0.30" />
    <SolidColorBrush x:Key="DragDropOverlayBackground" Color="{DynamicResource BackgroundColor}" Opacity="0.40" />
    <!-- Modal scrim: the window background at 70% (alpha B3), so a light theme dims to a light veil. -->
    <SolidColorBrush x:Key="OverlayBackground" Color="{DynamicResource BackgroundColor}" Opacity="0.70" />

    <!-- Protocol accent brushes -->
    <SolidColorBrush x:Key="ProtocolRdpBrush" Color="{DynamicResource BlueColor}" />
    <SolidColorBrush x:Key="ProtocolSshBrush" Color="{DynamicResource GreenColor}" />
    <SolidColorBrush x:Key="ProtocolWinRmBrush" Color="{DynamicResource PurpleColor}" />
    <SolidColorBrush x:Key="ProtocolSftpBrush" Color="{DynamicResource OrangeColor}" />
    <SolidColorBrush x:Key="ProtocolVncBrush" Color="{DynamicResource CyanColor}" />
    <SolidColorBrush x:Key="ProtocolWebBrush" Color="{DynamicResource PinkColor}" />
    <SolidColorBrush x:Key="ProtocolTelnetBrush" Color="{DynamicResource CommentColor}" />
    <SolidColorBrush x:Key="ProtocolFtpBrush" Color="{DynamicResource BlueColor}" />
    <SolidColorBrush x:Key="ProtocolCitrixBrush" Color="{DynamicResource PurpleColor}" />
    <SolidColorBrush x:Key="ProtocolLocalBrush" Color="{DynamicResource ActiveAccentColor}" />

    <!-- Connection badge brushes -->
    <SolidColorBrush x:Key="RdpBadgeBrush" Color="{DynamicResource BlueColor}" />
    <SolidColorBrush x:Key="SshBadgeBrush" Color="{DynamicResource GreenColor}" />
    <SolidColorBrush x:Key="WinRmBadgeBrush" Color="{DynamicResource PurpleColor}" />
    <SolidColorBrush x:Key="SftpBadgeBrush" Color="{DynamicResource OrangeColor}" />
    <SolidColorBrush x:Key="VncBadgeBrush" Color="{DynamicResource CyanColor}" />
    <SolidColorBrush x:Key="WebBadgeBrush" Color="{DynamicResource PinkColor}" />
    <SolidColorBrush x:Key="FtpBadgeBrush" Color="{DynamicResource BlueColor}" />
    <SolidColorBrush x:Key="CitrixBadgeBrush" Color="{DynamicResource PurpleColor}" />
    <SolidColorBrush x:Key="TelnetBadgeBrush" Color="{DynamicResource CommentColor}" />
    <SolidColorBrush x:Key="LocalBadgeBrush" Color="{DynamicResource ActiveAccentColor}" />

    <!-- Tool category brushes -->
    <SolidColorBrush x:Key="ToolBadgeBrush" Color="{DynamicResource CyanColor}" />
    <SolidColorBrush x:Key="ToolNetworkBrush" Color="{DynamicResource BlueColor}" />
    <SolidColorBrush x:Key="ToolSecurityBrush" Color="{DynamicResource OrangeColor}" />
    <SolidColorBrush x:Key="ToolEncodingBrush" Color="{DynamicResource PurpleColor}" />
    <SolidColorBrush x:Key="ToolSystemBrush" Color="{DynamicResource CyanColor}" />
    <SolidColorBrush x:Key="ToolExternalBrush" Color="{DynamicResource PinkColor}" />

    <!-- JWT viewer brushes -->
    <SolidColorBrush x:Key="JwtHeaderBrush" Color="{DynamicResource BlueColor}" />
    <SolidColorBrush x:Key="JwtPayloadBrush" Color="{DynamicResource GreenColor}" />
    <SolidColorBrush x:Key="JwtSignatureBrush" Color="{DynamicResource OrangeColor}" />

    <!-- File type icon brushes -->
    <SolidColorBrush x:Key="FileScriptBrush" Color="{DynamicResource GreenColor}" />
    <SolidColorBrush x:Key="FileConfigBrush" Color="{DynamicResource CyanColor}" />
    <SolidColorBrush x:Key="FileDocumentBrush" Color="{DynamicResource CommentColor}" />
    <SolidColorBrush x:Key="FileArchiveBrush" Color="{DynamicResource OrangeColor}" />
    <SolidColorBrush x:Key="FileExecutableBrush" Color="{DynamicResource PinkColor}" />
    <SolidColorBrush x:Key="FileImageBrush" Color="{DynamicResource YellowColor}" />

    <!-- Broadcast feedback brush -->
    <SolidColorBrush x:Key="BroadcastActiveBrush" Color="{DynamicResource RedColor}" Opacity="0.27" />

</ResourceDictionary>
