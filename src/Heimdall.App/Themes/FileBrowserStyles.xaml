<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:local="clr-namespace:Heimdall.App.Views">

    <!-- The row of the remote and of the local file browser, so the two read the same. -->
    <sys:Double x:Key="FileBrowserRowMinHeight">26</sys:Double>
    <sys:Double x:Key="FileBrowserRowAccentBarWidth">3</sys:Double>
    <Thickness x:Key="FileBrowserRowPadding">4,4</Thickness>

    <!-- Selection is a tint plus an accent bar, hover is the quieter highlight, the keyboard focus
         ring is its own cyan border, and a drop target is the info tint: four states that no longer
         read as one. The ring is a border of its own so a focused row keeps its accent bar, which a
         single border property could not. -->
    <Style x:Key="FileBrowserRowStyle" TargetType="ListViewItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Padding" Value="{StaticResource FileBrowserRowPadding}"/>
        <Setter Property="MinHeight" Value="{StaticResource FileBrowserRowMinHeight}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="local:SftpDropTarget.IsDropTarget" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="AccentBar"
                                    Width="{StaticResource FileBrowserRowAccentBarWidth}"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentBrush}"
                                    Visibility="Collapsed"/>
                            <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                  Columns="{TemplateBinding GridView.ColumnCollection}"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HighlightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TreeRowSelectedBrush}"/>
                            <Setter TargetName="AccentBar" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FocusIndicatorBrush}"/>
                        </Trigger>
                        <Trigger Property="local:SftpDropTarget.IsDropTarget" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TreeRowDropTargetBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
