                            </TabItem>
                            <TabItem x:Name="Mw_SettingsSshSubTabHostKeys"
                                     Header="{loc:Translate SettingsSshSubTabHostKeys}"
                                     Style="{StaticResource SegmentedTabItemStyle}">
