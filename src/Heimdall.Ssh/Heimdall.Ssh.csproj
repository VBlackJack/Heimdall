<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Heimdall.Core\Heimdall.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Heimdall.Ssh.Tests" />
    <InternalsVisibleTo Include="Heimdall.App.Tests" />
    <!-- The SFTP browser and its editors connect through ConnectWithCancellationAsync,
         which observes the token through the handshake. Narrower than making the member
         public: the assembly that owns the helper decides who may call it. -->
    <InternalsVisibleTo Include="Heimdall.Sftp" />
  </ItemGroup>

</Project>
