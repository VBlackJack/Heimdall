<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Heimdall.Core.Tests" />
    <!-- The App-side runtime protector guard arms CredentialProtector.CryptoCallObserver.
         Heimdall.Sftp and Heimdall.Ssh already expose their internals to this assembly. -->
    <InternalsVisibleTo Include="Heimdall.App.Tests" />
    <!-- OutputReplayGate and ExitLatch are shared by the terminal-like sessions, which sit in
         sibling assemblies that reference only Core; their tests exercise the gate directly. -->
    <InternalsVisibleTo Include="Heimdall.Ssh" />
    <InternalsVisibleTo Include="Heimdall.Ssh.Tests" />
    <InternalsVisibleTo Include="Heimdall.Terminal" />
    <InternalsVisibleTo Include="Heimdall.Terminal.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.15" />
  </ItemGroup>

</Project>
