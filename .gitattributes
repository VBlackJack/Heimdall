# Line-ending policy. Text files are stored with LF in the repository (clean
# diffs), but source and project files check out as CRLF on every platform so
# the .editorconfig "end_of_line = crlf" rule and the CI "dotnet format" gate
# are satisfied deterministically, regardless of the tool that wrote the file.
* text=auto

# Git hook shims must stay LF on every OS (POSIX sh shebang).
.githooks/** text eol=lf

# Scripts whose line endings are semantically significant.
*.sh   text eol=lf
*.bash text eol=lf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Windows-only source and project files: deterministic CRLF checkout to match
# .editorconfig (end_of_line = crlf). Blobs remain LF.
*.cs      text eol=crlf
*.csproj  text eol=crlf
*.props   text eol=crlf
*.targets text eol=crlf
*.slnx    text eol=crlf
*.xaml    text eol=crlf
*.json    text eol=crlf

# Binary assets: never treat as text, never normalize, never diff as text.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.snk   binary
*.pfx   binary
*.dll   binary
*.exe   binary
*.pdb   binary
*.nupkg binary
*.zip   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
