{
  "id": "zypper-install",
  "title": "Install a package with Zypper",
  "description": "Install a package with Zypper (openSUSE/SLES)",
  "category": "package-management",
  "platform": 1,
  "level": 1,
  "tags": [
    "zypper",
    "install",
    "suse",
    "opensuse",
    "package"
  ],
  "linuxCommandTemplateId": "zypper-install-cmd",
  "linuxCommandTemplate": {
    "id": "zypper-install-cmd",
    "platform": 1,
    "name": "zypper",
    "commandPattern": "sudo zypper install -y {package}",
    "parameters": [
      {
        "name": "package",
        "label": "Package name",
        "type": "string",
        "defaultValue": "nginx",
        "required": true,
        "description": "Name of the package to install"
      }
    ]
  },
  "examples": [
    {
      "command": "sudo zypper in vim",
      "description": "Short form of install",
      "platform": 1
    },
    {
      "command": "sudo zypper update",
      "description": "Update the packages",
      "platform": 1
    },
    {
      "command": "zypper repos",
      "description": "List the repositories",
      "platform": 1
    }
  ],
  "notes": "Requires sudo. 'in' is an alias of 'install'. The SUSE package manager.",
  "links": [
    {
      "title": "Zypper documentation",
      "url": "https://en.opensuse.org/SDB:Zypper_usage"
    }
  ],
  "translations": {
