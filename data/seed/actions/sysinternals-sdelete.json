    "platform": 0,
    "name": "sdelete",
    "commandPattern": "sdelete.exe -p {passes} -s -AcceptEula {path}",
    "parameters": [
      {
        "name": "passes",
        "label": "Nombre de passes",
        "type": "number",
        "defaultValue": "3",
        "required": true,
        "description": "Nombre de réécritures"
      },
      {
        "name": "path",
        "label": "Chemin",
        "type": "string",
        "defaultValue": "",
        "required": true,
        "description": "Fichier ou dossier à détruire"
      }
    ]
  },
  "examples": [
    {
      "command": "sdelete.exe -p 3 -s -AcceptEula C:\\Confidential\\*",
