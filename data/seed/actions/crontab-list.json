{
  "id": "crontab-list",
  "title": "List the cron jobs",
  "description": "Show the user's scheduled cron jobs",
  "category": "services-automation",
  "platform": 1,
  "level": 0,
  "tags": [
    "cron",
    "crontab",
    "scheduler",
    "automation",
    "tasks"
  ],
  "linuxCommandTemplateId": "crontab-list-cmd",
  "linuxCommandTemplate": {
    "id": "crontab-list-cmd",
    "platform": 1,
    "name": "crontab",
    "commandPattern": "crontab -l",
    "parameters": []
  },
  "examples": [
    {
      "command": "crontab -l",
      "description": "List your cron jobs",
      "platform": 1
    },
    {
      "command": "crontab -e",
      "description": "Edit your cron jobs",
      "platform": 1
    },
    {
      "command": "sudo crontab -l -u username",
      "description": "List the jobs of another user",
      "platform": 1
    },
    {
      "command": "crontab -r",
      "description": "Delete every cron job",
      "platform": 1
    },
    {
      "command": "crontab -l -u www-data",
      "description": "List the jobs of another user",
      "platform": 1
    },
    {
      "command": "cat /etc/crontab",
      "description": "Show the system crontab",
      "platform": 1
    },
    {
      "command": "ls -la /etc/cron.d/",
      "description": "cron.d files",
      "platform": 1
    }
  ],
  "notes": "Format: min hour day month weekday command. -e to edit. Logs in /var/log/syslog.",
  "links": [
    {
      "title": "Crontab documentation",
      "url": "https://man7.org/linux/man-pages/man5/crontab.5.html"
    }
  ],
  "translations": {
