    "name": "grep",
    "commandPattern": "grep -rnw {path} -e {pattern}",
    "parameters": [
      {
        "name": "path",
        "label": "Path",
        "type": "string",
        "defaultValue": ".",
        "required": true,
        "description": "Where to search"
      },
      {
        "name": "pattern",
        "label": "Text",
        "type": "string",
        "defaultValue": "error",
        "required": true,
        "description": "Text to find"
      }
    ]
  },
  "examples": [
    {
      "command": "grep -rnw '/var/log' -e 'Exception'",
      "description": "Search /var/log for 'Exception' recursively (-r), with line numbers (-n) and whole words (-w).",
      "platform": 1
    }
