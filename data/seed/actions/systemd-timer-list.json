{
  "id": "systemd-timer-list",
  "title": "List systemd timers",
  "description": "Show every systemd timer (modern alternative to cron)",
  "category": "services-automation",
  "platform": 1,
  "level": 0,
  "tags": [
    "systemd",
    "timer",
    "scheduler",
    "automation",
    "cron"
  ],
  "linuxCommandTemplateId": "systemctl-timer-cmd",
  "linuxCommandTemplate": {
    "id": "systemctl-timer-cmd",
    "platform": 1,
    "name": "systemctl",
    "commandPattern": "systemctl list-timers {options}",
    "parameters": [
      {
        "name": "options",
        "label": "Options",
        "type": "string",
        "defaultValue": "--all",
        "required": false,
        "description": "Options (--all, --state=active, etc.)"
      }
    ]
  },
  "examples": [
    {
      "command": "systemctl list-timers",
      "description": "List the active timers",
      "platform": 1
    },
    {
      "command": "systemctl list-timers --all",
      "description": "List every timer",
      "platform": 1
    },
    {
      "command": "systemctl status my-backup.timer",
      "description": "Status of a specific timer",
      "platform": 1
    },
    {
      "command": "systemctl status nginx",
      "description": "Check the status of the nginx service",
      "platform": 1
    },
    {
      "command": "systemctl start apache2",
      "description": "Start the Apache service",
      "platform": 1
    },
    {
      "command": "systemctl stop mysql",
      "description": "Stop the MySQL service",
      "platform": 1
    },
    {
      "command": "systemctl restart sshd",
      "description": "Restart the SSH service",
      "platform": 1
    },
    {
      "command": "systemctl enable docker",
      "description": "Enable Docker at boot",
      "platform": 1
    }
  ],
  "notes": "systemd timers are more flexible than cron. See /etc/systemd/system/ for the definitions.",
  "links": [
    {
      "title": "systemd timers",
      "url": "https://www.freedesktop.org/software/systemd/man/systemd.timer.html"
    }
  ],
  "translations": {
    "fr": {
      "title": "Lister les timers systemd",
      "description": "Affiche tous les timers systemd (alternative moderne à cron)",
      "notes": "Les timers systemd sont plus flexibles que cron. Voir /etc/systemd/system/ pour les définitions.",
      "parameters": {
        "linux": {
          "options": {
            "label": "Options",
            "description": "Options (--all, --state=active, etc.)"
          }
        }
      },
      "examples": {
        "systemctl list-timers": "Liste les timers actifs",
        "systemctl list-timers --all": "Liste tous les timers",
        "systemctl status my-backup.timer": "État d'un timer spécifique",
        "systemctl status nginx": "Vérifier l'état du service nginx",
        "systemctl start apache2": "Démarrer le service Apache",
        "systemctl stop mysql": "Arrêter le service MySQL",
        "systemctl restart sshd": "Redémarrer le service SSH",
        "systemctl enable docker": "Activer Docker au démarrage"
      }
    }
  }
}