{
  "id": "vmstat-system-stats",
  "title": "Global system statistics",
  "description": "Show virtual memory, CPU, I/O and process statistics",
  "category": "monitoring-logs",
  "platform": 1,
  "level": 0,
  "tags": [
    "vmstat",
    "memory",
    "cpu",
    "performance",
    "statistics"
  ],
  "linuxCommandTemplateId": "vmstat-cmd",
  "linuxCommandTemplate": {
    "id": "vmstat-cmd",
    "platform": 1,
    "name": "vmstat",
    "commandPattern": "vmstat {interval} {count}",
    "parameters": [
      {
        "name": "interval",
        "label": "Interval (seconds)",
        "type": "number",
        "defaultValue": "5",
        "required": true,
        "description": "Interval between samples"
      },
      {
        "name": "count",
        "label": "Number of samples",
        "type": "number",
        "defaultValue": "5",
        "required": true,
        "description": "Number of samples to take"
      }
    ]
  },
  "examples": [
    {
      "command": "vmstat 5 5",
      "description": "Statistics every 5 seconds, 5 times",
      "platform": 1
    },
    {
      "command": "vmstat -s",
      "description": "Detailed memory statistics",
      "platform": 1
    },
    {
      "command": "vmstat -d",
      "description": "Disk statistics",
      "platform": 1
    },
    {
      "command": "vmstat 1 10",
      "description": "System stats every second, 10 times",
      "platform": 1
    },
    {
      "command": "vmstat -w",
      "description": "Wide format",
      "platform": 1
    },
    {
      "command": "vmstat -a",
      "description": "Active/inactive memory",
      "platform": 1
    },
    {
      "command": "vmstat 1 5",
      "description": "Stats every second, 5 times",
      "platform": 1
    }
  ],
  "notes": "Does not require sudo. Columns: r=runnable, b=blocked, swpd=swap, free=free RAM, etc.",
  "links": [
    {
      "title": "vmstat command",
      "url": "https://man7.org/linux/man-pages/man8/vmstat.8.html"
    }
  ],
  "translations": {
    "fr": {
      "title": "Statistiques système globales",
      "description": "Affiche les statistiques de mémoire virtuelle, CPU, I/O et processus",
      "notes": "Ne nécessite pas sudo. Colonnes: r=runnable, b=blocked, swpd=swap, free=RAM libre, etc.",
      "parameters": {
        "linux": {
          "interval": {
            "label": "Intervalle (secondes)",
            "description": "Intervalle entre les mesures"
          },
          "count": {
            "label": "Nombre de mesures",
            "description": "Nombre de mesures à effectuer"
          }
        }
      },
      "examples": {
        "vmstat 5 5": "Statistiques toutes les 5 secondes, 5 fois",
        "vmstat -s": "Statistiques mémoire détaillées",
        "vmstat -d": "Statistiques disques",
        "vmstat 1 10": "Stats système toutes les secondes, 10 fois",
        "vmstat -w": "Format large",
        "vmstat -a": "Mémoire active/inactive",
        "vmstat 1 5": "Stats toutes les secondes, 5 fois"
      }
    }
  }
}