{
  "id": "getfacl-show-acl",
  "title": "Show the ACLs of a file",
  "description": "Show the extended access control lists (ACLs) of a file.",
  "category": "security",
  "platform": 1,
  "level": 0,
  "tags": [
    "getfacl",
    "acl",
    "permissions",
    "access"
  ],
  "linuxCommandTemplateId": "getfacl-cmd",
  "linuxCommandTemplate": {
    "id": "getfacl-cmd",
    "platform": 1,
    "name": "getfacl",
    "commandPattern": "getfacl {path}",
    "parameters": [
      {
        "name": "path",
        "label": "Path",
        "type": "string",
        "defaultValue": "/path/to/file",
        "required": true,
        "description": "File or directory to examine"
      }
    ]
  },
  "examples": [
    {
      "command": "getfacl /var/www/html",
      "description": "Show the ACLs of the directory",
      "platform": 1
    },
    {
      "command": "getfacl -R /home/shared",
      "description": "Show the ACLs recursively",
      "platform": 1
    },
    {
      "command": "getfacl -R /home/user",
      "description": "Recursive ACLs",
      "platform": 1
    },
    {
      "command": "getfacl --omit-header file.txt",
      "description": "Without header",
      "platform": 1
    },
    {
      "command": "getfacl -a /etc/passwd",
      "description": "Access ACLs only",
      "platform": 1
    },
    {
      "command": "getfacl -d /shared",
      "description": "Default ACLs",
      "platform": 1
    }
  ],
  "notes": "Reading does not require sudo. ACLs allow finer permissions than chmod.",
  "links": [
    {
      "title": "ACL guide",
      "url": "https://man7.org/linux/man-pages/man1/getfacl.1.html"
    }
  ],
  "translations": {
    "fr": {
      "title": "Afficher les ACL d'un fichier",
      "description": "Affiche les listes de contrôle d'accès (ACL) étendues d'un fichier",
      "notes": "Ne nécessite pas sudo pour lecture. Les ACL permettent des permissions plus fines que chmod.",
      "parameters": {
        "linux": {
          "path": {
            "label": "Chemin",
            "description": "Fichier ou répertoire à examiner"
          }
        }
      },
      "examples": {
        "getfacl /var/www/html": "Affiche les ACL du répertoire",
        "getfacl -R /home/shared": "Affiche les ACL récursivement",
        "getfacl -R /home/user": "ACL récursives",
        "getfacl --omit-header file.txt": "Sans en-tête",
        "getfacl -a /etc/passwd": "Uniquement les ACL d'accès",
        "getfacl -d /shared": "ACL par défaut"
      }
    }
  }
}