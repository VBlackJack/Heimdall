{
  "id": "iotop-disk-io",
  "title": "Monitor disk I/O activity",
  "description": "Show in real time which processes use the most disk I/O.",
  "category": "monitoring-logs",
  "platform": 1,
  "level": 0,
  "tags": [
    "iotop",
    "io",
    "disk",
    "monitoring",
    "performance"
  ],
  "linuxCommandTemplateId": "iotop-cmd",
  "linuxCommandTemplate": {
    "id": "iotop-cmd",
    "platform": 1,
    "name": "iotop",
    "commandPattern": "sudo iotop -o -n {iterations}",
    "parameters": [
      {
        "name": "iterations",
        "label": "Iterations",
        "type": "number",
        "defaultValue": "5",
        "required": true,
        "description": "Number of refreshes"
      }
    ]
  },
  "examples": [
    {
      "command": "sudo iotop",
      "description": "Monitor I/O in real time",
      "platform": 1
    },
    {
      "command": "sudo iotop -o",
      "description": "Show only the active processes",
      "platform": 1
    },
    {
      "command": "sudo iotop -b -n 5",
      "description": "Batch mode, 5 iterations",
      "platform": 1
    },
    {
      "command": "sudo iotop -a",
      "description": "Show the accumulated I/O",
      "platform": 1
    },
    {
      "command": "sudo iotop -P",
      "description": "Show by process (not threads)",
      "platform": 1
    }
  ],
  "notes": "Requires sudo and the iotop package. -o shows only the active processes.",
  "links": [
    {
      "title": "iotop documentation",
      "url": "http://guichaz.free.fr/iotop/"
    }
  ],
  "translations": {
    "fr": {
      "title": "Monitorer l'activité I/O disque",
      "description": "Affiche en temps réel quels processus utilisent le plus l'I/O disque",
      "notes": "Nécessite sudo et le package iotop. -o affiche seulement les processus actifs.",
      "parameters": {
        "linux": {
          "iterations": {
            "label": "Itérations",
            "description": "Nombre de rafraîchissements"
          }
        }
      },
      "examples": {
        "sudo iotop": "Monitorer I/O en temps réel",
        "sudo iotop -o": "Afficher seulement les processus actifs",
        "sudo iotop -b -n 5": "Batch mode, 5 itérations",
        "sudo iotop -a": "Afficher les I/O accumulés",
        "sudo iotop -P": "Afficher par processus (pas threads)"
      }
    }
  }
}