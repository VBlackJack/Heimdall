{
  "id": "blkid-show-uuid",
  "title": "Show the partition UUIDs",
  "description": "Show the UUIDs and information of the block devices",
  "category": "files-storage",
  "platform": 1,
  "level": 0,
  "tags": [
    "blkid",
    "uuid",
    "filesystem",
    "partition"
  ],
  "linuxCommandTemplateId": "blkid-cmd",
  "linuxCommandTemplate": {
    "id": "blkid-cmd",
    "platform": 1,
    "name": "blkid",
    "commandPattern": "blkid {device}",
    "parameters": [
      {
        "name": "device",
        "label": "Device",
        "type": "string",
        "defaultValue": "",
        "required": false,
        "description": "Specific device (empty = all)"
      }
    ]
  },
  "examples": [
    {
      "command": "sudo blkid",
      "description": "List the UUIDs of every partition",
      "platform": 1
    },
    {
      "command": "blkid /dev/sda1",
      "description": "UUID of a specific partition",
      "platform": 1
    },
    {
      "command": "blkid",
      "description": "Show the UUIDs of every partition",
      "platform": 1
    },
    {
      "command": "blkid -o list",
      "description": "List format",
      "platform": 1
    },
    {
      "command": "blkid -t TYPE=ext4",
      "description": "ext4 partitions only",
      "platform": 1
    }
  ],
  "notes": "Requires sudo. UUIDs are used in /etc/fstab for permanent mounts.",
  "links": [
    {
      "title": "blkid documentation",
      "url": "https://man7.org/linux/man-pages/man8/blkid.8.html"
    }
  ],
  "translations": {
    "fr": {
      "title": "Afficher les UUID des partitions",
      "description": "Affiche les UUID et informations des périphériques de bloc",
      "notes": "Nécessite sudo. UUID utilisés dans /etc/fstab pour montage permanent.",
      "parameters": {
        "linux": {
          "device": {
            "label": "Périphérique",
            "description": "Périphérique spécifique (vide = tous)"
          }
        }
      },
      "examples": {
        "sudo blkid": "Liste tous les UUID des partitions",
        "blkid /dev/sda1": "UUID d'une partition spécifique",
        "blkid": "Afficher les UUID de toutes les partitions",
        "blkid -o list": "Format liste",
        "blkid -t TYPE=ext4": "Partitions ext4 uniquement"
      }
    },
    "es": {
      "title": "Mostrar los UUID de las particiones",
      "description": "Muestra los UUID y la información de los dispositivos de bloques"
    }
  }
}