{
  "id": "linux-chown",
  "title": "Change owner (chown)",
  "description": "Change the owner and group of a file or folder.",
  "category": "security",
  "platform": 1,
  "level": 1,
  "tags": [
    "linux",
    "chown",
    "owner",
    "user",
    "group"
  ],
  "linuxCommandTemplate": {
    "id": "eb337443-e9db-4c46-843d-8addd385df09",
    "platform": 1,
    "name": "chown",
    "commandPattern": "chown {owner}:{group} {file}",
    "parameters": [
      {
        "name": "owner",
        "label": "User",
        "type": "string",
        "defaultValue": "www-data",
        "required": true,
        "description": "New user"
      },
      {
        "name": "group",
        "label": "Group",
        "type": "string",
        "defaultValue": "www-data",
        "required": true,
        "description": "New group"
      },
      {
        "name": "file",
        "label": "File",
        "type": "string",
        "defaultValue": "/var/www",
        "required": true,
        "description": "Target"
      }
    ]
  },
  "examples": [
    {
      "command": "chown -R www-data:www-data /var/www/html",
      "description": "Give ownership to the web server (www-data) recursively. Often fixes '403 Forbidden' errors.",
      "platform": 1
    },
    {
      "command": "chown root:root /etc/cron.d/mycron",
      "description": "Give a system file back to root.",
      "platform": 1
    }
  ],
  "linuxCommandTemplateId": "eb337443-e9db-4c46-843d-8addd385df09",
  "translations": {
    "fr": {
      "title": "Changer propriétaire (chown)",
      "description": "Change le propriétaire et le groupe d'un fichier ou dossier.",
      "parameters": {
        "linux": {
          "owner": {
            "label": "Utilisateur",
            "description": "Nouvel utilisateur"
          },
          "group": {
            "label": "Groupe",
            "description": "Nouveau groupe"
          },
          "file": {
            "label": "Fichier",
            "description": "Cible"
          }
        }
      },
      "examples": {
        "chown -R www-data:www-data /var/www/html": "Donne la propriété au serveur web (www-data) récursivement. Résout souvent les erreurs '403 Forbidden'.",
        "chown root:root /etc/cron.d/mycron": "Remet les droits root sur un fichier système."
      }
    }
  }
}