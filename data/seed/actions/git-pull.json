{
  "id": "git-pull",
  "title": "Fetch and merge from the remote repository",
  "description": "Fetch the changes of the remote repository and merge them into the local branch.",
  "category": "development",
  "platform": 2,
  "level": 1,
  "tags": [
    "git",
    "pull",
    "fetch",
    "merge"
  ],
  "windowsCommandTemplateId": "git-pull-win",
  "windowsCommandTemplate": {
    "id": "git-pull-win",
    "platform": 0,
    "name": "git",
    "commandPattern": "git pull {remote} {branch}",
    "parameters": [
      {
        "name": "remote",
        "label": "Remote",
        "type": "string",
        "defaultValue": "origin",
        "required": false,
        "description": "Name of the remote repository"
      },
      {
        "name": "branch",
        "label": "Branch",
        "type": "string",
        "defaultValue": "",
        "required": false,
        "description": "Branch name"
      }
    ]
  },
  "linuxCommandTemplateId": "git-pull-linux",
  "linuxCommandTemplate": {
    "id": "git-pull-linux",
    "platform": 1,
    "name": "git",
    "commandPattern": "git pull {remote} {branch}",
    "parameters": [
      {
        "name": "remote",
        "label": "Remote",
        "type": "string",
        "defaultValue": "origin",
        "required": false,
        "description": "Name of the remote repository"
      },
      {
        "name": "branch",
        "label": "Branch",
        "type": "string",
        "defaultValue": "",
        "required": false,
        "description": "Branch name"
      }
    ]
  },
  "examples": [
    {
      "command": "git pull origin main",
      "description": "Fetch and merge the changes of main",
      "platform": 2
    },
    {
      "command": "git pull --rebase",
      "description": "Fetch and rebase instead of merging",
      "platform": 2
    }
  ],
  "notes": "Use --rebase for a linear history without merge commits.",
  "links": [
    {
      "title": "Git Pull Documentation",
      "url": "https://git-scm.com/docs/git-pull"
    }
  ],
  "translations": {
    "fr": {
      "title": "Récupérer et fusionner depuis le dépôt distant",
      "description": "Récupère les modifications du dépôt distant et les fusionne avec la branche locale",
      "notes": "Utilisez --rebase pour un historique linéaire sans commits de merge.",
      "parameters": {
        "windows": {
          "remote": {
            "label": "Dépôt distant",
            "description": "Nom du dépôt distant"
          },
          "branch": {
            "label": "Branche",
            "description": "Nom de la branche"
          }
        },
        "linux": {
          "remote": {
            "label": "Dépôt distant",
            "description": "Nom du dépôt distant"
          },
          "branch": {
            "label": "Branche",
            "description": "Nom de la branche"
          }
        }
      },
      "examples": {
        "git pull origin main": "Récupère et fusionne les changements de main",
        "git pull --rebase": "Récupère et rebase au lieu de merge"
      }
    }
  }
}