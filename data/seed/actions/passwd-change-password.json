{
  "id": "passwd-change-password",
  "title": "Change a user's password",
  "description": "Change the password of a user account.",
  "category": "security",
  "platform": 1,
  "level": 1,
  "tags": [
    "passwd",
    "password",
    "security",
    "user"
  ],
  "linuxCommandTemplateId": "passwd-cmd",
  "linuxCommandTemplate": {
    "id": "passwd-cmd",
    "platform": 1,
    "name": "passwd",
    "commandPattern": "sudo passwd {username}",
    "parameters": [
      {
        "name": "username",
        "label": "User name",
        "type": "string",
        "defaultValue": "",
        "required": true,
        "description": "Account whose password is changed"
      }
    ]
  },
  "examples": [
    {
      "command": "passwd",
      "description": "Change your own password",
      "platform": 1
    },
    {
      "command": "sudo passwd john",
      "description": "Change the password of john (admin)",
      "platform": 1
    },
    {
      "command": "sudo passwd -l john",
      "description": "Lock the account of john",
      "platform": 1
    },
    {
      "command": "sudo passwd -l baduser",
      "description": "Lock the password",
      "platform": 1
    },
    {
      "command": "sudo passwd -u baduser",
      "description": "Unlock the password",
      "platform": 1
    },
    {
      "command": "sudo passwd -e jdupont",
      "description": "Force a password change at the next logon",
      "platform": 1
    },
    {
      "command": "sudo chage -l jdupont",
      "description": "Show the password expiration information",
      "platform": 1
    },
    {
      "command": "sudo passwd -l jdupont",
      "description": "Lock the account",
      "platform": 1
    }
  ],
  "notes": "Requires sudo to change another user's password. -l locks, -u unlocks.",
  "links": [
    {
      "title": "passwd command",
      "url": "https://man7.org/linux/man-pages/man1/passwd.1.html"
    }
  ],
  "translations": {
    "fr": {
      "title": "Changer le mot de passe d'un utilisateur",
      "description": "Modifie le mot de passe d'un compte utilisateur",
      "notes": "Nécessite sudo pour changer le MDP d'un autre user. -l verrouille, -u déverrouille.",
      "parameters": {
        "linux": {
          "username": {
            "label": "Nom d'utilisateur",
            "description": "Compte dont le mot de passe est modifié"
          }
        }
      },
      "examples": {
        "passwd": "Change son propre mot de passe",
        "sudo passwd john": "Change le mot de passe de john (admin)",
        "sudo passwd -l john": "Verrouille le compte de john",
        "sudo passwd -l baduser": "Verrouiller le mot de passe",
        "sudo passwd -u baduser": "Déverrouiller le mot de passe",
        "sudo passwd -e jdupont": "Forcer le changement de mot de passe à la prochaine connexion",
        "sudo chage -l jdupont": "Afficher les informations d'expiration du mot de passe",
        "sudo passwd -l jdupont": "Verrouiller le compte"
      }
    },
    "es": {
      "title": "Cambiar la contraseña de un usuario",
      "description": "Cambia la contraseña de una cuenta de usuario."
    }
  }
}