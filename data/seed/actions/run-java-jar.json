  ],
  "windowsCommandTemplateId": "run-java-win-cmd",
  "windowsCommandTemplate": {
    "id": "run-java-win-cmd",
    "platform": 0,
    "name": "java",
    "commandPattern": "java -jar {jarPath}",
    "parameters": [
      {
        "name": "jarPath",
        "label": "Fichier JAR",
        "type": "string",
        "defaultValue": "",
