      "parameters": {
        "windows": {
          "jarPath": {
            "label": "Fichier JAR",
            "description": "Chemin du fichier .jar"
          }
        },
        "linux": {
          "jarPath": {
            "label": "Fichier JAR",
            "description": "Chemin du fichier .jar"
          }
        }
      },
