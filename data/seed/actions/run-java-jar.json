{
  "id": "run-java-jar",
  "title": "Run a Java JAR file",
  "description": "Start a Java application packaged as a JAR.",
  "category": "development",
  "platform": 2,
  "level": 0,
  "tags": [
    "java",
    "jar",
    "run",
    "execute"
  ],
  "windowsCommandTemplateId": "run-java-win-cmd",
  "windowsCommandTemplate": {
    "id": "run-java-win-cmd",
    "platform": 0,
    "name": "java",
    "commandPattern": "java -jar {jarPath}",
    "parameters": [
      {
        "name": "jarPath",
        "label": "JAR file",
        "type": "string",
        "defaultValue": "",
        "required": true,
        "description": "Path of the .jar file"
      }
    ]
  },
  "linuxCommandTemplateId": "run-java-linux-cmd",
  "linuxCommandTemplate": {
    "id": "run-java-linux-cmd",
    "platform": 1,
    "name": "java",
    "commandPattern": "java -jar {jarPath}",
    "parameters": [
      {
        "name": "jarPath",
        "label": "JAR file",
        "type": "string",
        "defaultValue": "",
        "required": true,
        "description": "Path of the .jar file"
      }
    ]
  },
  "examples": [
    {
      "command": "java -jar application.jar",
      "description": "Run a JAR file",
      "platform": 2
    },
    {
      "command": "java -Xmx2G -jar application.jar",
      "description": "Run with 2 GB of maximum memory",
      "platform": 2
    },
    {
      "command": "java -jar app.jar --spring.profiles.active=prod",
      "description": "Run with Spring arguments",
      "platform": 2
    },
    {
      "command": "java -jar \"C:\\Apps\\myapp.jar\"",
      "description": "Example using the 'jarPath' parameter: Path of the .jar file. Replace C:\\Apps\\myapp.jar with the value that fits your environment.",
      "platform": 2
    }
  ],
  "notes": "-Xmx sets the maximum memory, -Xms the initial memory. Arguments after the JAR are passed to the application.",
  "links": [],
  "linuxExamples": [
    {
      "command": "java -Xmx2g -jar app.jar",
      "description": "Run with a 2 GB heap",
      "platform": 1
    },
    {
      "command": "java -version",
      "description": "Show the Java version",
      "platform": 1
    },
    {
      "command": "java -cp \"lib/*:.\" MainClass",
      "description": "Run with a custom classpath",
      "platform": 1
    },
    {
      "command": "java -Dspring.profiles.active=prod -jar app.jar",
      "description": "Set a Spring profile",
      "platform": 1
    },
    {
      "command": "java -jar app.jar --server.port=8081",
      "description": "With a custom port",
      "platform": 1
    }
  ],
  "translations": {
