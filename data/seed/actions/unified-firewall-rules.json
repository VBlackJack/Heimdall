{
  "id": "unified-firewall-rules",
  "title": "List the active firewall rules",
  "description": "Show every active firewall rule on the system",
  "category": "security",
  "platform": 2,
  "level": 0,
  "tags": [
    "firewall",
    "security",
    "rules",
    "network",
    "iptables",
    "netfirewall"
  ],
  "windowsCommandTemplateId": "unified-firewall-rules-win-cmd",
  "windowsCommandTemplate": {
    "id": "unified-firewall-rules-win-cmd",
    "platform": 0,
    "commandPattern": "Get-NetFirewallRule | Where-Object {$_.Enabled -eq 'True'} | Select-Object DisplayName,Direction,Action,Profile | Sort-Object Direction,DisplayName | Format-Table -AutoSize",
    "parameters": []
  },
  "linuxCommandTemplateId": "unified-firewall-rules-linux-cmd",
  "linuxCommandTemplate": {
    "id": "unified-firewall-rules-linux-cmd",
    "platform": 1,
    "commandPattern": "iptables -L -n -v --line-numbers",
    "parameters": []
  },
  "examples": [],
  "windowsExamples": [
    {
      "command": "Get-NetFirewallRule | Where-Object {$_.Enabled -eq 'True'} | Format-Table",
      "description": "List the active firewall rules on Windows",
      "platform": 0
    }
  ],
  "linuxExamples": [
    {
      "command": "iptables -L -n -v --line-numbers",
      "description": "List the iptables rules on Linux",
      "platform": 1
    },
    {
      "command": "iptables -L -n -v",
      "description": "List the rules with statistics",
      "platform": 1
    },
    {
      "command": "iptables -A INPUT -p tcp --dport 22 -j ACCEPT",
      "description": "Allow SSH",
      "platform": 1
    },
    {
      "command": "iptables -A INPUT -s 192.168.1.0/24 -j ACCEPT",
      "description": "Allow a subnet",
      "platform": 1
    },
    {
      "command": "iptables -D INPUT 3",
      "description": "Delete rule number 3",
      "platform": 1
    }
  ],
  "translations": {
    "fr": {
      "title": "Lister les règles de pare-feu actives",
      "description": "Affiche toutes les règles de pare-feu actives sur le système",
      "examples": {
        "Get-NetFirewallRule | Where-Object {$_.Enabled -eq 'True'} | Format-Table": "Liste les règles de pare-feu actives sur Windows",
        "iptables -L -n -v --line-numbers": "Liste les règles iptables sur Linux",
        "iptables -L -n -v": "Lister les règles avec statistiques",
        "iptables -A INPUT -p tcp --dport 22 -j ACCEPT": "Autoriser SSH",
        "iptables -A INPUT -s 192.168.1.0/24 -j ACCEPT": "Autoriser un sous-réseau",
        "iptables -D INPUT 3": "Supprimer la règle n°3"
      }
    }
  }
}