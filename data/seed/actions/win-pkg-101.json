{
  "id": "win-pkg-101",
  "title": "Installer un package Chocolatey",
  "description": "Installe un package Windows à l'aide du gestionnaire Chocolatey.",
  "category": "📦 Package Management",
  "platform": 0,
  "level": 1,
  "tags": [
    "chocolatey",
    "package",
    "installation",
    "software",
    "windows"
  ],
  "windowsCommandTemplateId": "choco-install-cmd",
  "windowsCommandTemplate": {
    "id": "choco-install-cmd",
    "platform": 0,
    "name": "choco",
    "commandPattern": "choco install {packageName} -y",
    "parameters": [
      {
        "name": "packageName",
        "label": "Nom du package",
        "type": "string",
        "defaultValue": "",
        "required": true,
        "description": "Nom du package à installer (ex: googlechrome, vscode)"
      }
    ]
  },
  "examples": [
    {
      "command": "choco install googlechrome -y",
      "description": "Installe Google Chrome",
      "platform": 0
    },
    {
      "command": "choco install vscode -y",
      "description": "Installe Visual Studio Code",
      "platform": 0
    }
  ],
  "notes": "Nécessite Chocolatey installé. L'option -y accepte automatiquement les prompts.",
  "links": [
    {
      "title": "Documentation officielle Chocolatey",
      "url": "https://docs.chocolatey.org/en-us/choco/commands/install"
    }
  ]
}