{
  "id": "unified-create-local-user",
  "title": "Créer un utilisateur local",
  "description": "Crée un nouveau compte utilisateur local sur le système.",
  "category": "🔒 Security & Encryption",
  "platform": 2,
  "level": 1,
  "tags": [
    "user",
    "account",
    "create",
    "useradd",
    "new-localuser",
    "windows",
    "linux"
  ],
  "linuxCommandTemplateId": "useradd-cmd",
  "linuxCommandTemplate": {
    "id": "useradd-cmd",
    "platform": 1,
    "name": "useradd",
    "commandPattern": "useradd -m -s {shell} {username}",
    "parameters": [
      {
        "name": "shell",
        "label": "Shell",
        "type": "string",
        "defaultValue": "/bin/bash",
        "required": true,
        "description": "Shell par défaut"
      },
      {
        "name": "username",
        "label": "Nom d'utilisateur",
        "type": "string",
        "defaultValue": "newuser",
        "required": true,
        "description": "Nom du nouvel utilisateur"
      }
    ]
  },
  "notes": "Windows: New-LocalUser crée un utilisateur local (pas AD). -NoPassword pour compte sans mot de passe.\nLinux: useradd nécessite sudo. -m crée le répertoire home. Utiliser passwd ensuite pour définir le mot de passe.",
  "links": [
    {
      "title": "useradd documentation",
      "url": "https://man7.org/linux/man-pages/man8/useradd.8.html"
    },
    {
      "title": "New-LocalUser documentation",
      "url": "https://learn.microsoft.com/en-us/powershell/module/microsoft.powershell.localaccounts/new-localuser"
    }
  ],
  "linuxExamples": [
    {
      "command": "sudo useradd -m -s /bin/bash john",
      "description": "Crée l'utilisateur john avec répertoire home",
      "platform": 1
    },
    {
      "command": "sudo useradd -m -G sudo,docker john",
      "description": "Crée john et l'ajoute aux groupes sudo et docker",
      "platform": 1
    },
    {
      "command": "sudo passwd john",
      "description": "Définit le mot de passe après création",
      "platform": 1
    },
    {
      "command": "useradd -m -s /bin/bash {username}",
      "description": "Exemple utilisant le paramètre 'shell': Shell par défaut. Remplacez <shell> par la valeur appropriée selon votre environnement.",
      "platform": 1
    },
    {
      "command": "useradd -m -s {shell} newuser",
      "description": "Exemple utilisant le paramètre 'username': Nom du nouvel utilisateur. Remplacez <username> par la valeur appropriée selon votre environnement.",
      "platform": 1
    },
    {
      "command": "useradd -m -s /bin/bash jdupont",
      "description": "Créer un utilisateur avec home et bash",
      "platform": 1
    },
    {
      "command": "useradd -m -d /opt/app -s /bin/bash appuser",
      "description": "Utilisateur avec home personnalisé",
      "platform": 1
    }
  ],
  "windowsCommandTemplateId": "create-localuser-win-cmd",
  "windowsCommandTemplate": {
    "id": "create-localuser-win-cmd",
    "platform": 0,
    "name": "New-LocalUser",
    "commandPattern": "New-LocalUser -Name {username} -NoPassword",
    "parameters": [
      {
        "name": "username",
        "label": "Nom d'utilisateur",
        "type": "string",
        "defaultValue": "newuser",
        "required": true,
        "description": "Nom du nouvel utilisateur"
      }
    ]
  },
  "windowsExamples": [
    {
      "command": "New-LocalUser -Name \"john\" -NoPassword",
      "description": "Crée l'utilisateur john sans mot de passe",
      "platform": 0
    },
    {
      "command": "New-LocalUser -Name \"john\" -Password (Read-Host -AsSecureString)",
      "description": "Crée john avec mot de passe interactif",
      "platform": 0
    },
    {
      "command": "New-LocalUser -Name \"john\" -FullName \"John Doe\" -Description \"Developer\"",
      "description": "Crée john avec nom complet et description",
      "platform": 0
    }
  ],
  "examples": []
}