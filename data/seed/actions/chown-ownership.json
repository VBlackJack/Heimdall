{
  "id": "chown-ownership",
  "title": "Modifier le propriétaire d'un fichier",
  "description": "Change le propriétaire (user et/ou group) d'un fichier ou répertoire",
  "category": "security",
  "platform": 1,
  "level": 1,
  "tags": [
    "chown",
    "owner",
    "permissions",
    "user",
    "group"
  ],
  "linuxCommandTemplateId": "chown-cmd",
  "linuxCommandTemplate": {
    "id": "chown-cmd",
    "platform": 1,
    "name": "chown",
    "commandPattern": "chown {owner}:{group} {path}",
    "parameters": [
      {
        "name": "owner",
        "label": "Propriétaire",
        "type": "string",
        "defaultValue": "www-data",
        "required": true,
        "description": "Nouveau propriétaire"
      },
      {
        "name": "group",
        "label": "Groupe",
        "type": "string",
        "defaultValue": "www-data",
        "required": false,
        "description": "Nouveau groupe (optionnel)"
      },
      {
        "name": "path",
        "label": "Chemin",
        "type": "string",
        "defaultValue": "/var/www/html",
        "required": true,
        "description": "Fichier ou répertoire à modifier"
      }
    ]
  },
  "examples": [
    {
      "command": "sudo chown www-data:www-data /var/www/html",
      "description": "Change owner et group",
      "platform": 1
    },
    {
      "command": "sudo chown -R john /home/john",
      "description": "Change récursivement le propriétaire",
      "platform": 1
    },
    {
      "command": "sudo chown :developers file.txt",
      "description": "Change uniquement le groupe",
      "platform": 1
    },
    {
      "command": "chown admin:IT-Admins /var/log/app.log -v",
      "description": "Exécute la commande en mode verbeux. Le flag -v (verbose) affiche chaque action effectuée en temps réel. Essentiel pour suivre la progression des opérations longues et vérifier que tout se déroule correctement.",
      "platform": 1
    },
    {
      "command": "chown www-data:IT-Admins /var/log/app.log",
      "description": "Exemple utilisant le paramètre 'owner': Nouveau propriétaire. Remplacez admin par la valeur appropriée selon votre environnement.",
      "platform": 1
    },
    {
      "command": "chown www-data:www-data /var/www/html -R",
      "description": "Changer le propriétaire du dossier web Apache",
      "platform": 1
    },
    {
      "command": "chown root:admin /etc/config.conf",
      "description": "Définir root comme propriétaire avec groupe admin",
      "platform": 1
    },
    {
      "command": "chown -R jdupont:users /home/jdupont/documents",
      "description": "Changer récursivement le propriétaire d'un dossier",
      "platform": 1
    },
    {
      "command": "chown --reference=/etc/passwd /etc/shadow",
      "description": "Copier le propriétaire d'un fichier de référence",
      "platform": 1
    },
    {
      "command": "chown -h jdupont:users /tmp/mylink",
      "description": "Changer le propriétaire d'un lien symbolique",
      "platform": 1
    }
  ],
  "notes": "Nécessite sudo. -R pour récursif. user:group ou user seul ou :group seul.",
  "links": [
    {
      "title": "chown documentation",
      "url": "https://man7.org/linux/man-pages/man1/chown.1.html"
    }
  ]
}