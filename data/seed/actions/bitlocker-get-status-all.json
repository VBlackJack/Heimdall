{
  "id": "bitlocker-get-status-all",
  "title": "Obtenir le statut BitLocker de tous les disques",
  "description": "Affiche l'état de chiffrement BitLocker pour tous les volumes du système.",
  "category": "security",
  "platform": 0,
  "level": 0,
  "tags": [
    "bitlocker",
    "encryption",
    "status",
    "security"
  ],
  "windowsCommandTemplateId": "bitlocker-get-status-all-cmd",
  "windowsCommandTemplate": {
    "id": "bitlocker-get-status-all-cmd",
    "platform": 0,
    "name": "Get-BitLockerVolume",
    "commandPattern": "Get-BitLockerVolume | Select-Object MountPoint,EncryptionMethod,VolumeStatus,ProtectionStatus,EncryptionPercentage | Format-Table -AutoSize",
    "parameters": []
  },
  "examples": [
    {
      "command": "Get-BitLockerVolume",
      "description": "Affiche le statut BitLocker de tous les volumes avec tous les détails",
      "platform": 0
    },
    {
      "command": "Get-BitLockerVolume | Select-Object MountPoint,VolumeStatus,ProtectionStatus",
      "description": "Affiche uniquement le point de montage et les statuts de chiffrement",
      "platform": 0
    },
    {
      "command": "Get-BitLockerVolume | Where-Object {$_.ProtectionStatus -eq 'On'}",
      "description": "Liste uniquement les volumes avec BitLocker activé",
      "platform": 0
    },
    {
      "command": "Get-BitLockerVolume | Where-Object {$_.VolumeStatus -eq 'FullyDecrypted'}",
      "description": "Liste les volumes non chiffrés (vulnérables)",
      "platform": 0
    },
    {
      "command": "Get-BitLockerVolume C: | Select-Object *",
      "description": "Affiche toutes les propriétés détaillées du volume C:",
      "platform": 0
    }
  ],
  "notes": "ProtectionStatus: On (protégé), Off (non protégé). VolumeStatus: FullyEncrypted, FullyDecrypted, EncryptionInProgress, DecryptionInProgress. EncryptionMethod: None, Aes128, Aes256, XtsAes128, XtsAes256.",
  "links": [
    {
      "title": "Get-BitLockerVolume Documentation",
