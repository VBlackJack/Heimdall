{
  "id": "docker-logs",
  "title": "Consulter les logs d'un conteneur",
  "description": "Affiche les logs stdout/stderr d'un conteneur Docker",
  "category": "containers-vms",
  "platform": 2,
  "level": 0,
  "tags": [
    "docker",
    "logs",
    "container",
    "debug",
    "windows"
  ],
  "linuxCommandTemplateId": "docker-logs-cmd",
  "linuxCommandTemplate": {
    "id": "docker-logs-cmd",
    "platform": 1,
    "name": "docker",
    "commandPattern": "docker logs -f {container}",
    "parameters": [
      {
        "name": "container",
        "label": "Conteneur",
        "type": "string",
        "defaultValue": "container_name",
        "required": true,
        "description": "Nom ou ID du conteneur"
      }
    ]
  },
  "notes": "Windows & Linux: Ctrl+C pour arrêter le suivi. --tail limite le nombre de lignes.",
  "links": [
    {
      "title": "Docker logs",
      "url": "https://docs.docker.com/engine/reference/commandline/logs/"
    }
  ],
  "windowsCommandTemplate": {
    "id": "docker-logs-win-cmd",
    "platform": 0,
    "name": "docker",
    "commandPattern": "docker logs -f {container}",
    "parameters": [
      {
        "name": "container",
        "label": "Conteneur",
        "type": "string",
        "defaultValue": "container_name",
        "required": true,
        "description": "Nom ou ID du conteneur"
      }
    ]
  },
  "windowsCommandTemplateId": "docker-logs-win-cmd",
  "windowsExamples": [
    {
      "command": "docker logs -f mycontainer",
      "description": "Suit les logs en temps réel",
      "platform": 0
    },
    {
      "command": "docker logs --tail 100 mycontainer",
      "description": "Affiche les 100 dernières lignes",
      "platform": 0
    },
    {
      "command": "docker logs --since 1h mycontainer",
      "description": "Logs de la dernière heure",
      "platform": 0
    },
    {
      "command": "docker logs -f {container}",
      "description": "Exemple utilisant le paramètre 'options': Options (-f=follow, --tail=n, --since, -t=timestamps). Remplacez <options> par la valeur appropriée selon votre environnement.",
      "platform": 0
    }
  ],
