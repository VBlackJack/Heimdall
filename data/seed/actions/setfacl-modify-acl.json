{
  "id": "setfacl-modify-acl",
  "title": "Modify the ACLs of a file",
  "description": "Set or modify extended access control lists (ACLs)",
  "category": "security",
  "platform": 1,
  "level": 1,
  "tags": [
    "setfacl",
    "acl",
    "permissions",
    "access"
  ],
  "linuxCommandTemplateId": "setfacl-cmd",
  "linuxCommandTemplate": {
    "id": "setfacl-cmd",
    "platform": 1,
    "name": "setfacl",
    "commandPattern": "setfacl -m {acl} {path}",
    "parameters": [
      {
        "name": "acl",
        "label": "ACL",
        "type": "string",
        "defaultValue": "u:username:rwx",
        "required": true,
        "description": "ACL to apply (u:user:perms or g:group:perms)"
      },
      {
        "name": "path",
        "label": "Path",
        "type": "string",
        "defaultValue": "/path/to/file",
        "required": true,
        "description": "File or directory to modify"
      }
    ]
  },
  "examples": [
    {
      "command": "setfacl -m u:john:rwx /shared/folder",
      "description": "Give rwx to the user john",
      "platform": 1
    },
    {
      "command": "setfacl -m g:developers:rw- /project",
      "description": "Give rw to the developers group",
      "platform": 1
    },
    {
      "command": "setfacl -x u:john /shared/folder",
      "description": "Remove john's ACL",
      "platform": 1
    },
    {
      "command": "setfacl -m u:username:rwx C:\\Logs\\app.log",
      "description": "Example using the 'acl' parameter: ACL to apply (u:user:perms or g:group:perms). Replace user:jdupont:rwx with the value that fits your environment.",
      "platform": 1
    },
    {
      "command": "setfacl -m user:jdupont:rwx /path/to/file",
      "description": "Example using the 'path' parameter: File or directory to modify. Replace C:\\Logs\\app.log with the value that fits your environment.",
      "platform": 1
    },
    {
      "command": "setfacl -m u:jdupont:rwx /shared",
      "description": "Give rwx to jdupont",
      "platform": 1
    },
    {
      "command": "setfacl -m g:devs:rx /app",
      "description": "Give rx to the devs group",
      "platform": 1
    },
    {
      "command": "setfacl -x u:olduser /shared",
      "description": "Remove a user's ACLs",
      "platform": 1
    },
    {
      "command": "setfacl -b /shared",
      "description": "Remove every ACL",
      "platform": 1
    },
    {
      "command": "setfacl -R -m u:www-data:rx /var/www",
      "description": "Recursive ACLs",
      "platform": 1
    }
  ],
  "notes": "Requires sudo. -m to modify, -x to remove, -R for recursive.",
  "links": [
    {
      "title": "setfacl documentation",
      "url": "https://man7.org/linux/man-pages/man1/setfacl.1.html"
    }
  ],
  "translations": {
    "fr": {
      "title": "Modifier les ACL d'un fichier",
      "description": "Définit ou modifie les listes de contrôle d'accès (ACL) étendues",
      "notes": "Nécessite sudo. -m pour modifier, -x pour supprimer, -R pour récursif.",
      "parameters": {
        "linux": {
          "acl": {
            "label": "ACL",
            "description": "ACL à appliquer (u:user:perms ou g:group:perms)"
          },
          "path": {
            "label": "Chemin",
            "description": "Fichier ou répertoire à modifier"
          }
        }
      },
      "examples": {
        "setfacl -m u:john:rwx /shared/folder": "Donne rwx à l'utilisateur john",
        "setfacl -m g:developers:rw- /project": "Donne rw au groupe developers",
        "setfacl -x u:john /shared/folder": "Supprime l'ACL de john",
        "setfacl -m u:username:rwx C:\\Logs\\app.log": "Exemple utilisant le paramètre 'acl': ACL à appliquer (u:user:perms ou g:group:perms). Remplacez user:jdupont:rwx par la valeur appropriée selon votre environnement.",
        "setfacl -m user:jdupont:rwx /path/to/file": "Exemple utilisant le paramètre 'path': Fichier ou répertoire à modifier. Remplacez C:\\Logs\\app.log par la valeur appropriée selon votre environnement.",
        "setfacl -m u:jdupont:rwx /shared": "Donner rwx à jdupont",
        "setfacl -m g:devs:rx /app": "Donner rx au groupe devs",
        "setfacl -x u:olduser /shared": "Supprimer les ACL d'un utilisateur",
        "setfacl -b /shared": "Supprimer toutes les ACL",
        "setfacl -R -m u:www-data:rx /var/www": "ACL récursives"
      }
    }
  }
}