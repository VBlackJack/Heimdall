{
  "id": "sar-system-activity",
  "title": "System activity report (SAR)",
  "description": "Collect and show the history of system activity (CPU, memory, I/O, network)",
  "category": "monitoring-logs",
  "platform": 1,
  "level": 0,
  "tags": [
    "sar",
    "performance",
    "statistics",
    "history",
    "sysstat"
  ],
  "linuxCommandTemplateId": "sar-cmd",
  "linuxCommandTemplate": {
    "id": "sar-cmd",
    "platform": 1,
    "name": "sar",
    "commandPattern": "sar {options} {interval} {count}",
    "parameters": [
      {
        "name": "options",
        "label": "Options",
        "type": "string",
        "defaultValue": "-u",
        "required": true,
        "description": "Statistics type (-u=CPU, -r=RAM, -b=IO, -n DEV=network)"
      },
      {
        "name": "interval",
        "label": "Interval",
        "type": "number",
        "defaultValue": "5",
        "required": true,
        "description": "Interval in seconds"
      },
      {
        "name": "count",
        "label": "Count",
        "type": "number",
        "defaultValue": "3",
        "required": true,
        "description": "Number of samples"
      }
    ]
  },
  "examples": [
    {
      "command": "sar -u 5 3",
      "description": "CPU every 5 s, 3 times",
      "platform": 1
    },
    {
      "command": "sar -r",
      "description": "Today's memory usage history",
      "platform": 1
    },
    {
      "command": "sar -n DEV 1 5",
      "description": "Network statistics",
      "platform": 1
    },
    {
      "command": "sar -u 3600 10",
      "description": "Example using the 'options' parameter: Statistics type (-u=CPU, -r=RAM, -b=IO, -n DEV=network). Replace -v -f with the value that fits your environment.",
      "platform": 1
    },
    {
      "command": "sar -v -f 5 10",
      "description": "Example using the 'interval' parameter: Interval in seconds. Replace 3600 with the value that fits your environment.",
      "platform": 1
    },
    {
      "command": "sar -u 1 5",
      "description": "CPU every second, 5 times",
      "platform": 1
    },
    {
      "command": "sar -r 1 5",
      "description": "Memory every second",
      "platform": 1
    },
    {
      "command": "sar -b 1 5",
      "description": "I/O activity",
      "platform": 1
    },
    {
      "command": "sar -q",
      "description": "System load (load average)",
      "platform": 1
    }
  ],
  "notes": "Part of the sysstat package. Historical data lives in /var/log/sysstat/.",
  "links": [
    {
      "title": "sar command",
      "url": "https://man7.org/linux/man-pages/man1/sar.1.html"
    }
  ],
  "translations": {
    "fr": {
      "title": "Rapport d'activité système (SAR)",
      "description": "Collecte et affiche l'historique de l'activité système (CPU, mémoire, I/O, réseau)",
      "notes": "Fait partie du package sysstat. Données historiques dans /var/log/sysstat/.",
      "parameters": {
        "linux": {
          "options": {
            "label": "Options",
            "description": "Type de stats (-u=CPU, -r=RAM, -b=IO, -n DEV=réseau)"
          },
          "interval": {
            "label": "Intervalle",
            "description": "Intervalle en secondes"
          },
          "count": {
            "label": "Nombre",
            "description": "Nombre de mesures"
          }
        }
      },
      "examples": {
        "sar -u 5 3": "CPU toutes les 5s, 3 fois",
        "sar -r": "Historique d'utilisation mémoire du jour",
        "sar -n DEV 1 5": "Statistiques réseau",
        "sar -u 3600 10": "Exemple utilisant le paramètre 'options': Type de stats (-u=CPU, -r=RAM, -b=IO, -n DEV=réseau). Remplacez -v -f par la valeur appropriée selon votre environnement.",
        "sar -v -f 5 10": "Exemple utilisant le paramètre 'interval': Intervalle en secondes. Remplacez 3600 par la valeur appropriée selon votre environnement.",
        "sar -u 1 5": "CPU toutes les secondes, 5 fois",
        "sar -r 1 5": "Mémoire toutes les secondes",
        "sar -b 1 5": "Activité I/O",
        "sar -q": "Charge système (load average)"
      }
    }
  }
}