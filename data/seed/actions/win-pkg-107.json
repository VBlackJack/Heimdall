{
  "id": "win-pkg-107",
  "title": "Add a Chocolatey source",
  "description": "Add a new custom Chocolatey package source.",
  "category": "package-management",
  "platform": 0,
  "level": 1,
  "tags": [
    "chocolatey",
    "package",
    "source",
    "repository",
    "windows"
  ],
  "windowsCommandTemplateId": "choco-source-add-cmd",
  "windowsCommandTemplate": {
    "id": "choco-source-add-cmd",
    "platform": 0,
    "name": "choco",
    "commandPattern": "choco source add --name={name} --source={url}",
    "parameters": [
      {
        "name": "name",
        "label": "Source name",
        "type": "string",
        "defaultValue": "",
        "required": true,
        "description": "Name to give the source"
      },
      {
        "name": "url",
        "label": "Source URL",
        "type": "string",
        "defaultValue": "",
        "required": true,
        "description": "URL of the package repository"
      }
    ]
  },
  "examples": [
    {
      "command": "choco source add --name=MyRepo --source=https://packages.example.com/chocolatey",
      "description": "Add a custom source",
      "platform": 0
    }
  ],
  "notes": "Requires administrator rights. Check that the source is trustworthy before adding it.",
  "links": [
    {
      "title": "Chocolatey source documentation",
      "url": "https://docs.chocolatey.org/en-us/choco/commands/source"
    }
  ],
  "translations": {
    "fr": {
      "title": "Ajouter une source Chocolatey",
      "description": "Ajoute une nouvelle source de packages Chocolatey personnalisée.",
      "notes": "Nécessite des droits administrateur. Vérifier la fiabilité de la source avant de l'ajouter.",
      "parameters": {
        "windows": {
          "name": {
            "label": "Nom de la source",
            "description": "Nom à donner à la source"
          },
          "url": {
            "label": "URL de la source",
            "description": "URL du dépôt de packages"
          }
        }
      },
      "examples": {
        "choco source add --name=MyRepo --source=https://packages.example.com/chocolatey": "Ajoute une source personnalisée"
      }
    }
  }
}