{
  "id": "fdisk-partition",
  "title": "Manage partitions with fdisk",
  "description": "Disk partitioning tool (MBR/GPT).",
  "category": "files-storage",
  "platform": 1,
  "level": 2,
  "tags": [
    "fdisk",
    "partition",
    "disk",
    "mbr",
    "gpt"
  ],
  "linuxCommandTemplateId": "fdisk-cmd",
  "linuxCommandTemplate": {
    "id": "fdisk-cmd",
    "platform": 1,
    "name": "fdisk",
    "commandPattern": "sudo fdisk -l {device}",
    "parameters": [
      {
        "name": "device",
        "label": "Device",
        "type": "string",
        "defaultValue": "",
        "required": false,
        "description": "Disk to examine (empty = all)"
      }
    ]
  },
  "examples": [
    {
      "command": "sudo fdisk -l",
      "description": "List all partitions",
      "platform": 1
    },
    {
      "command": "sudo fdisk /dev/sdb",
      "description": "Interactive mode to partition /dev/sdb",
      "platform": 1
    },
    {
      "command": "sudo fdisk -l /dev/sda1",
      "description": "Example using the 'device' parameter: disk to examine (empty = all). Replace /dev/sda1 with the value that fits your environment.",
      "platform": 1
    },
    {
      "command": "sudo fdisk -l /dev/sda",
      "description": "Details of disk sda",
      "platform": 1
    },
    {
      "command": "sudo parted -l",
      "description": "Alternative: list with parted",
      "platform": 1
    },
    {
      "command": "sudo gdisk /dev/sdc",
      "description": "Manage GPT partitions",
      "platform": 1
    }
  ],
  "notes": "Requires sudo. DANGER: can destroy data. Interactive mode: m=help, p=print, w=write.",
  "links": [
    {
      "title": "fdisk guide",
      "url": "https://man7.org/linux/man-pages/man8/fdisk.8.html"
    }
  ],
  "translations": {
    "fr": {
      "title": "Gérer les partitions avec fdisk",
      "description": "Outil de partitionnement de disques (MBR/GPT)",
      "notes": "Nécessite sudo. DANGER: peut détruire des données. Mode interactif: m=aide, p=afficher, w=écrire.",
      "parameters": {
        "linux": {
          "device": {
            "label": "Périphérique",
            "description": "Disque à examiner (vide = tous)"
          }
        }
      },
      "examples": {
        "sudo fdisk -l": "Liste toutes les partitions",
        "sudo fdisk /dev/sdb": "Mode interactif pour partitionner /dev/sdb",
        "sudo fdisk -l /dev/sda1": "Exemple utilisant le paramètre 'device': Disque à examiner (vide = tous). Remplacez /dev/sda1 par la valeur appropriée selon votre environnement.",
        "sudo fdisk -l /dev/sda": "Détails du disque sda",
        "sudo parted -l": "Alternative: lister avec parted",
        "sudo gdisk /dev/sdc": "Gérer les partitions GPT"
      }
    }
  }
}