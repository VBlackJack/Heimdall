{
  "id": "git-log",
  "title": "Show the commit history",
  "description": "Show the commit history of the repository.",
  "category": "development",
  "platform": 2,
  "level": 0,
  "tags": [
    "git",
    "log",
    "history"
  ],
  "windowsCommandTemplateId": "git-log-win",
  "windowsCommandTemplate": {
    "id": "git-log-win",
    "platform": 0,
    "name": "git",
    "commandPattern": "git log --oneline --graph --decorate -n {count}",
    "parameters": [
      {
        "name": "count",
        "label": "Count",
        "type": "number",
        "defaultValue": "20",
        "required": false,
        "description": "Number of commits to show"
      }
    ]
  },
  "linuxCommandTemplateId": "git-log-linux",
  "linuxCommandTemplate": {
    "id": "git-log-linux",
    "platform": 1,
    "name": "git",
    "commandPattern": "git log --oneline --graph --decorate -n {count}",
    "parameters": [
      {
        "name": "count",
        "label": "Count",
        "type": "number",
        "defaultValue": "20",
        "required": false,
        "description": "Number of commits"
      }
    ]
  },
  "examples": [
    {
      "command": "git log --oneline",
      "description": "Show the history in a compact format",
      "platform": 2
    },
    {
      "command": "git log --graph --all",
      "description": "Show every branch with a graph",
      "platform": 2
    },
    {
      "command": "git log --author=\"John\"",
      "description": "Filter by author",
      "platform": 2
    }
  ],
  "notes": "Use --graph to see the branches, --stat to see change statistics.",
  "links": [
    {
      "title": "Git Log Documentation",
      "url": "https://git-scm.com/docs/git-log"
    }
  ],
  "translations": {
    "fr": {
      "title": "Afficher l'historique des commits",
      "description": "Affiche l'historique des commits du dépôt",
      "notes": "Utilisez --graph pour visualiser les branches, --stat pour voir les statistiques de modifications.",
      "parameters": {
        "windows": {
          "count": {
            "label": "Nombre",
            "description": "Nombre de commits à afficher"
          }
        },
        "linux": {
          "count": {
            "label": "Nombre",
            "description": "Nombre de commits"
          }
        }
      },
      "examples": {
        "git log --oneline": "Affiche l'historique en format compact",
        "git log --graph --all": "Affiche toutes les branches avec un graphe",
        "git log --author=\"John\"": "Filtre par auteur"
      }
    }
  }
}