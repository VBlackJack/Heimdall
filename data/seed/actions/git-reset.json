{
  "id": "git-reset",
  "title": "Reset the repository state",
  "description": "Reset HEAD to a given state.",
  "category": "development",
  "platform": 2,
  "level": 2,
  "tags": [
    "git",
    "reset",
    "undo"
  ],
  "windowsCommandTemplateId": "git-reset-win",
  "windowsCommandTemplate": {
    "id": "git-reset-win",
    "platform": 0,
    "name": "git",
    "commandPattern": "git reset {mode} {target}",
    "parameters": [
      {
        "name": "mode",
        "label": "Mode",
        "type": "choice",
        "allowedValues": [
          "--soft",
          "--mixed",
          "--hard"
        ],
        "defaultValue": "--mixed",
        "required": false,
        "description": "Reset mode (--soft, --mixed, --hard)"
      },
      {
        "name": "target",
        "label": "Target",
        "type": "string",
        "defaultValue": "HEAD~1",
        "required": false,
        "description": "Target commit"
      }
    ]
  },
  "linuxCommandTemplateId": "git-reset-linux",
  "linuxCommandTemplate": {
    "id": "git-reset-linux",
    "platform": 1,
    "name": "git",
    "commandPattern": "git reset {mode} {target}",
    "parameters": [
      {
        "name": "mode",
        "label": "Mode",
        "type": "choice",
        "allowedValues": [
          "--soft",
          "--mixed",
          "--hard"
        ],
        "defaultValue": "--mixed",
        "required": false,
        "description": "Reset mode"
      },
      {
        "name": "target",
        "label": "Target",
        "type": "string",
        "defaultValue": "HEAD~1",
        "required": false,
        "description": "Target commit"
      }
    ]
  },
  "examples": [
    {
      "command": "git reset --hard origin/main",
      "description": "Reset completely to the state of origin/main",
      "platform": 2
    }
  ],
  "notes": "WARNING: --hard discards the changes. --soft keeps everything staged, --mixed unstages.",
  "links": [
    {
      "title": "Git Reset Documentation",
      "url": "https://git-scm.com/docs/git-reset"
    }
  ],
  "windowsExamples": [],
  "linuxExamples": [
    {
      "command": "git reset HEAD~1",
      "description": "Undo the last commit and keep the changes",
      "platform": 1
    }
  ],
  "translations": {
    "fr": {
      "title": "Réinitialiser l'état du dépôt",
      "description": "Réinitialise HEAD à un état spécifique",
      "notes": "ATTENTION : --hard supprime les modifications. --soft garde tout staged, --mixed unstage.",
      "parameters": {
        "windows": {
          "mode": {
            "label": "Mode",
            "description": "Mode de reset (--soft, --mixed, --hard)"
          },
          "target": {
            "label": "Cible",
            "description": "Commit cible"
          }
        },
        "linux": {
          "mode": {
            "label": "Mode",
            "description": "Mode de reset"
          },
          "target": {
            "label": "Cible",
            "description": "Commit cible"
          }
        }
      },
      "examples": {
        "git reset HEAD~1": "Annule le dernier commit en gardant les modifications",
        "git reset --hard origin/main": "Réinitialise complètement au state de origin/main"
      }
    }
  }
}