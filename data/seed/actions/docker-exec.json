{
  "id": "docker-exec",
  "title": "Exécuter une commande dans un conteneur",
  "description": "Exécute une commande dans un conteneur Docker en cours d'exécution",
  "category": "containers-vms",
  "platform": 2,
  "level": 1,
  "tags": [
    "docker",
    "exec",
    "container",
    "bash",
    "shell",
    "windows"
  ],
  "linuxCommandTemplateId": "docker-exec-cmd",
  "linuxCommandTemplate": {
    "id": "docker-exec-cmd",
    "platform": 1,
    "name": "docker",
    "commandPattern": "docker exec {options} {container} {command}",
    "parameters": [
      {
        "name": "options",
        "label": "Options",
        "type": "string",
        "defaultValue": "-it",
        "required": false,
        "description": "Options (-it=interactive+tty, -u=user, -w=workdir)"
      },
      {
        "name": "container",
        "label": "Conteneur",
        "type": "string",
        "defaultValue": "mycontainer",
        "required": true,
        "description": "Nom ou ID du conteneur"
      },
      {
        "name": "command",
        "label": "Commande",
        "type": "string",
        "defaultValue": "/bin/bash",
        "required": true,
        "description": "Commande à exécuter"
      }
    ]
  },
  "notes": "Windows & Linux: -it nécessaire pour shell interactif. Le conteneur doit être en cours d'exécution.",
  "links": [
    {
      "title": "Docker exec",
      "url": "https://docs.docker.com/engine/reference/commandline/exec/"
    }
  ],
