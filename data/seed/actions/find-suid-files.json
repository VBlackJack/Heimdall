{
  "id": "find-suid-files",
  "title": "Find SUID/SGID files",
  "description": "List every file with the SUID or SGID bit set (potentially dangerous).",
  "category": "security",
  "platform": 1,
  "level": 0,
  "tags": [
    "find",
    "suid",
    "sgid",
    "security",
    "permissions"
  ],
  "linuxCommandTemplateId": "find-suid-cmd",
  "linuxCommandTemplate": {
    "id": "find-suid-cmd",
    "platform": 1,
    "name": "find",
    "commandPattern": "find {path} -perm /{perm} -type f",
    "parameters": [
      {
        "name": "path",
        "label": "Path",
        "type": "string",
        "defaultValue": "/",
        "required": true,
        "description": "Search directory"
      },
      {
        "name": "perm",
        "label": "Permissions",
        "type": "string",
        "defaultValue": "4000",
        "required": true,
        "description": "4000=SUID, 2000=SGID, 6000=both"
      }
    ]
  },
  "examples": [
    {
      "command": "sudo find / -perm /4000 -type f 2>/dev/null",
      "description": "List all SUID files",
      "platform": 1
    },
    {
      "command": "find /usr -perm /6000 -ls",
      "description": "SUID or SGID files in /usr with details",
      "platform": 1
    },
    {
      "command": "find /var/log -name \"*.log\" -mtime -7",
      "description": ".log files modified in the last 7 days",
      "platform": 1
    },
    {
      "command": "find /home -size +100M",
      "description": "Files larger than 100 MB",
      "platform": 1
    },
    {
      "command": "find /tmp -type f -name \"*.tmp\" -delete",
      "description": "Delete the .tmp files",
      "platform": 1
    },
    {
      "command": "find . -type d -empty",
      "description": "Find empty folders",
      "platform": 1
    },
    {
      "command": "find /etc -name \"*.conf\" -exec grep -l \"password\" {} \\;",
      "description": "Conf files that contain \"password\"",
      "platform": 1
    }
  ],
  "notes": "Requires sudo for the whole system. SUID/SGID files can be security risks.",
  "links": [
    {
      "title": "SUID security",
      "url": "https://man7.org/linux/man-pages/man1/find.1.html"
    }
  ],
  "translations": {
    "fr": {
      "title": "Rechercher les fichiers SUID/SGID",
      "description": "Liste tous les fichiers avec bits SUID ou SGID (potentiellement dangereux)",
      "notes": "Nécessite sudo pour tout le système. SUID/SGID peuvent être des risques de sécurité.",
      "parameters": {
        "linux": {
          "path": {
            "label": "Chemin",
            "description": "Répertoire de recherche"
          },
          "perm": {
            "label": "Permissions",
            "description": "4000=SUID, 2000=SGID, 6000=les deux"
          }
        }
      },
      "examples": {
        "sudo find / -perm /4000 -type f 2>/dev/null": "Liste tous les fichiers SUID",
        "find /usr -perm /6000 -ls": "Fichiers SUID ou SGID dans /usr avec détails",
        "find /var/log -name \"*.log\" -mtime -7": "Fichiers .log modifiés dans les 7 derniers jours",
        "find /home -size +100M": "Fichiers de plus de 100 Mo",
        "find /tmp -type f -name \"*.tmp\" -delete": "Supprimer les fichiers .tmp",
        "find . -type d -empty": "Trouver les dossiers vides",
        "find /etc -name \"*.conf\" -exec grep -l \"password\" {} \\;": "Fichiers conf contenant \"password\""
      }
    }
  }
}