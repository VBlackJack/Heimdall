{
  "id": "run-dotnet",
  "title": "Run a .NET project",
  "description": "Start a .NET project in development mode.",
  "category": "development",
  "platform": 2,
  "level": 0,
  "tags": [
    "run",
    "dotnet",
    "execute",
    "development"
  ],
  "windowsCommandTemplateId": "run-dotnet-win-cmd",
  "windowsCommandTemplate": {
    "id": "run-dotnet-win-cmd",
    "platform": 0,
    "name": "dotnet run",
    "commandPattern": "dotnet run --project {projectPath}",
    "parameters": [
      {
        "name": "projectPath",
        "label": "Project",
        "type": "string",
        "defaultValue": ".",
        "required": false,
        "description": "Path of the .csproj project"
      }
    ]
  },
  "linuxCommandTemplateId": "run-dotnet-linux-cmd",
  "linuxCommandTemplate": {
    "id": "run-dotnet-linux-cmd",
    "platform": 1,
    "name": "dotnet run",
    "commandPattern": "dotnet run --project {projectPath}",
    "parameters": [
      {
        "name": "projectPath",
        "label": "Project",
        "type": "string",
        "defaultValue": ".",
        "required": false,
        "description": "Path of the .csproj project"
      }
    ]
  },
  "examples": [],
  "notes": "Arguments after -- are passed to the application. --no-build skips the rebuild.",
  "links": [
    {
      "title": "Documentation dotnet run",
      "url": "https://learn.microsoft.com/en-us/dotnet/core/tools/dotnet-run"
    }
  ],
  "windowsExamples": [
    {
      "command": "dotnet run",
      "description": "Run the project in the current folder",
      "platform": 0
    },
    {
      "command": "dotnet run --configuration Release",
      "description": "Run in Release mode",
      "platform": 0
    },
    {
      "command": "dotnet run -- arg1 arg2",
      "description": "Run with arguments",
      "platform": 0
    }
  ],
  "linuxExamples": [
    {
      "command": "dotnet run --project \"./MyApp\"",
      "description": "Run a .NET project from a relative path",
      "platform": 1
    },
    {
      "command": "dotnet restore",
      "description": "Restore the NuGet dependencies",
      "platform": 1
    }
  ],
  "translations": {
    "fr": {
      "title": "Exécuter un projet .NET",
      "description": "Lance un projet .NET en mode développement.",
      "notes": "Les arguments après -- sont passés à l'application. --no-build évite la recompilation.",
      "parameters": {
        "windows": {
          "projectPath": {
            "label": "Projet",
            "description": "Chemin du projet .csproj"
          }
        },
        "linux": {
          "projectPath": {
            "label": "Projet",
            "description": "Chemin du projet .csproj"
          }
        }
      },
      "examples": {
        "dotnet run": "Lance le projet du dossier courant",
        "dotnet run --configuration Release": "Lance en mode Release",
        "dotnet run -- arg1 arg2": "Lance avec des arguments",
        "dotnet run --project \"./MyApp\"": "Lance un projet .NET depuis un chemin relatif",
        "dotnet restore": "Restaurer les dépendances NuGet"
      }
    }
  }
}