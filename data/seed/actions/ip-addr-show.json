{
  "id": "ip-addr-show",
  "title": "Show IP addresses",
  "description": "Show every network interface and its IP addresses.",
  "category": "network-dns",
  "platform": 1,
  "level": 0,
  "tags": [
    "ip",
    "network",
    "interface",
    "address",
    "ipv4",
    "ipv6"
  ],
  "linuxCommandTemplateId": "ip-addr-cmd",
  "linuxCommandTemplate": {
    "id": "ip-addr-cmd",
    "platform": 1,
    "name": "ip",
    "commandPattern": "ip addr show {interface}",
    "parameters": [
      {
        "name": "interface",
        "label": "Interface",
        "type": "string",
        "defaultValue": "",
        "required": false,
        "description": "Interface name (empty = all)"
      }
    ]
  },
  "examples": [
    {
      "command": "ip addr show",
      "description": "Show every interface and IP",
      "platform": 1
    },
    {
      "command": "ip addr show eth0",
      "description": "Show only eth0",
      "platform": 1
    },
    {
      "command": "ip -br addr",
      "description": "Short format (brief)",
      "platform": 1
    },
    {
      "command": "ip route show",
      "description": "Show the routing table",
      "platform": 1
    },
    {
      "command": "sudo ip link set eth0 up",
      "description": "Bring the eth0 interface up",
      "platform": 1
    },
    {
      "command": "sudo ip addr add 192.168.1.100/24 dev eth0",
      "description": "Add an IP address",
      "platform": 1
    },
    {
      "command": "ip neigh show",
      "description": "Show the ARP table",
      "platform": 1
    },
    {
      "command": "ip -4 addr",
      "description": "IPv4 only",
      "platform": 1
    }
  ],
  "notes": "Reading does not require sudo. Replaces ifconfig. -br for a condensed format. Changing a link or an address requires root (sudo).",
  "links": [
    {
      "title": "ip command",
      "url": "https://man7.org/linux/man-pages/man8/ip.8.html"
    }
  ],
  "translations": {
    "fr": {
      "title": "Afficher les adresses IP",
      "description": "Affiche toutes les interfaces réseau et leurs adresses IP",
      "notes": "Ne nécessite pas sudo pour la lecture. Remplace ifconfig. -br pour format condensé. Modifier une interface ou une adresse nécessite les droits root (sudo).",
      "parameters": {
        "linux": {
          "interface": {
            "label": "Interface",
            "description": "Nom de l'interface (vide = toutes)"
          }
        }
      },
      "examples": {
        "ip addr show": "Affiche toutes les interfaces et IP",
        "ip addr show eth0": "Affiche uniquement eth0",
        "ip -br addr": "Format court (brief)",
        "ip route show": "Afficher la table de routage",
        "sudo ip link set eth0 up": "Activer l'interface eth0",
        "sudo ip addr add 192.168.1.100/24 dev eth0": "Ajouter une adresse IP",
        "ip neigh show": "Afficher la table ARP",
        "ip -4 addr": "IPv4 uniquement"
      }
    },
    "es": {
      "title": "Mostrar las direcciones IP",
      "description": "Muestra todas las interfaces de red y sus direcciones IP."
    }
  }
}