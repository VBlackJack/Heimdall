  ],
  "linuxCommandTemplateId": "docker-compose-up-cmd",
  "linuxCommandTemplate": {
    "id": "docker-compose-up-cmd",
    "platform": 1,
    "name": "docker-compose",
    "commandPattern": "docker-compose up {options}",
    "parameters": [
      {
        "name": "options",
        "label": "Options",
        "type": "string",
        "defaultValue": "-d",
        "required": false,
        "description": "Options (-d=detached, --build, --scale, etc.)"
      }
    ]
  },
  "notes": "Windows & Linux: Doit être exécuté dans le répertoire contenant docker-compose.yml. -d pour detached mode.",
  "links": [
    {
      "title": "Docker Compose documentation",
      "url": "https://docs.docker.com/compose/reference/up/"
    }
  ],
  "supportedPlatforms": [
    0,
    1
  ],
  "windowsCommandTemplate": {
    "id": "docker-compose-up-win-cmd",
    "platform": 0,
    "name": "docker-compose",
    "commandPattern": "docker-compose up {options}",
    "parameters": [
      {
        "name": "options",
        "label": "Options",
        "type": "string",
        "defaultValue": "-d",
        "required": false,
        "description": "Options (-d=detached, --build, --scale, etc.)"
      }
    ]
  },
  "windowsCommandTemplateId": "docker-compose-up-win-cmd",
  "windowsExamples": [
    {
      "command": "docker-compose up -d",
      "description": "Démarre en arrière-plan",
      "platform": 0
