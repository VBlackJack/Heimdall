{
  "id": "file-directory-size-linux",
  "title": "Directory size",
  "description": "Compute the total size of a directory and its content.",
  "category": "files-storage",
  "platform": 1,
  "level": 0,
  "tags": [
    "size",
    "folder",
    "du",
    "linux"
  ],
  "linuxCommandTemplateId": "file-directory-size-linux-cmd",
  "linuxCommandTemplate": {
    "id": "file-directory-size-linux-cmd",
    "platform": 1,
    "name": "du",
    "commandPattern": "du -sh {path}",
    "parameters": [
      {
        "name": "path",
        "label": "Path",
        "type": "string",
        "defaultValue": ".",
        "required": false,
        "description": "Path of the folder to analyze"
      }
    ]
  },
  "examples": [
    {
      "command": "du -h --max-depth=1 /home | sort -h",
      "description": "List folders by size",
      "platform": 1
    },
    {
      "command": "du -sh /home/*",
      "description": "Size of each home directory",
      "platform": 1
    }
  ],
  "notes": "-s for a sum, -h for a human-readable format. --max-depth limits the depth.",
  "links": [],
  "translations": {
    "fr": {
      "title": "Taille d'un répertoire",
      "description": "Calcule la taille totale d'un répertoire et de son contenu.",
      "notes": "-s pour somme, -h pour format lisible. --max-depth limite la profondeur.",
      "parameters": {
        "linux": {
          "path": {
            "label": "Chemin",
            "description": "Chemin du dossier à analyser"
          }
        }
      },
      "examples": {
        "du -h --max-depth=1 /home | sort -h": "Liste les dossiers par taille",
        "du -sh /home/*": "Taille de chaque home"
      }
    }
  }
}