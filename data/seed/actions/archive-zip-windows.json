{
  "id": "archive-zip-windows",
  "title": "Create a ZIP archive",
  "description": "Compress files or folders into a ZIP archive.",
  "category": "files-storage",
  "platform": 0,
  "level": 0,
  "tags": [
    "compression",
    "zip",
    "archive",
    "windows"
  ],
  "windowsCommandTemplateId": "archive-zip-windows-cmd",
  "windowsCommandTemplate": {
    "id": "archive-zip-windows-cmd",
    "platform": 0,
    "name": "Compress-Archive",
    "commandPattern": "Compress-Archive -Path {sourcePath} -DestinationPath {zipPath} -CompressionLevel Optimal -Force",
    "parameters": [
      {
        "name": "sourcePath",
        "label": "Source",
        "type": "string",
        "defaultValue": "",
        "required": true,
        "description": "Files or folders to compress"
      },
      {
        "name": "zipPath",
        "label": "ZIP file",
        "type": "string",
        "defaultValue": "",
        "required": true,
        "description": "Path of the ZIP file to create"
      }
    ]
  },
  "examples": [
    {
      "command": "Compress-Archive -Path \"C:\\Data\\*\" -DestinationPath \"C:\\Backup\\data.zip\"",
      "description": "Compress a whole folder",
      "platform": 0
    },
    {
      "command": "Compress-Archive -Path \"*.txt\",\"*.log\" -DestinationPath \"logs.zip\"",
      "description": "Compress several file types",
      "platform": 0
    }
  ],
  "notes": "-CompressionLevel: Optimal, Fastest, NoCompression. -Force overwrites the existing ZIP.",
  "links": [
    {
      "title": "Documentation Compress-Archive",
      "url": "https://learn.microsoft.com/en-us/powershell/module/microsoft.powershell.archive/compress-archive"
    }
  ],
  "translations": {
    "fr": {
      "title": "Créer une archive ZIP",
      "description": "Compresse des fichiers ou dossiers dans une archive ZIP.",
      "notes": "-CompressionLevel: Optimal, Fastest, NoCompression. -Force écrase le ZIP existant.",
      "parameters": {
        "windows": {
          "sourcePath": {
            "label": "Source",
            "description": "Fichiers ou dossiers à compresser"
          },
          "zipPath": {
            "label": "Fichier ZIP",
            "description": "Chemin du fichier ZIP à créer"
          }
        }
      },
      "examples": {
        "Compress-Archive -Path \"C:\\Data\\*\" -DestinationPath \"C:\\Backup\\data.zip\"": "Compresse un dossier entier",
        "Compress-Archive -Path \"*.txt\",\"*.log\" -DestinationPath \"logs.zip\"": "Compresse plusieurs types de fichiers"
      }
    }
  }
