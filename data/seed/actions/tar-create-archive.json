{
  "id": "tar-create-archive",
  "title": "Create a tar archive",
  "description": "Create a compressed archive of files and directories",
  "category": "files-storage",
  "platform": 1,
  "level": 0,
  "tags": [
    "tar",
    "archive",
    "compress",
    "backup",
    "gzip"
  ],
  "linuxCommandTemplateId": "tar-create-cmd",
  "linuxCommandTemplate": {
    "id": "tar-create-cmd",
    "platform": 1,
    "name": "tar",
    "commandPattern": "tar -{options} {archive} {files}",
    "parameters": [
      {
        "name": "options",
        "label": "Options",
        "type": "choice",
        "allowedValues": [
          "czf",
          "cJf",
          "cf",
          "czvf"
        ],
        "defaultValue": "czf",
        "required": true,
        "description": "czf = gzip, cJf = xz, cf = no compression, czvf = gzip listing each file"
      },
      {
        "name": "archive",
        "label": "Archive",
        "type": "string",
        "defaultValue": "backup.tar.gz",
        "required": true,
        "description": "Archive file name"
      },
      {
        "name": "files",
        "label": "Files",
        "type": "string",
        "defaultValue": "/path/to/files",
        "required": true,
        "description": "Files/directories to archive"
      }
    ]
  },
  "examples": [
    {
      "command": "tar -czf backup.tar.gz /home/user/data",
      "description": "Create a gzip archive",
      "platform": 1
    },
    {
      "command": "tar -xzf backup.tar.gz",
      "description": "Extract a gzip archive",
      "platform": 1
    },
    {
      "command": "tar -tjf backup.tar.bz2",
      "description": "List the content without extracting",
      "platform": 1
    }
  ],
  "notes": "c=create, x=extract, t=list, z=gzip, j=bzip2, f=file. .tar.gz or .tgz for gzip.",
  "links": [
    {
      "title": "tar command",
      "url": "https://man7.org/linux/man-pages/man1/tar.1.html"
    }
  ],
  "translations": {
    "fr": {
      "title": "Créer une archive tar",
      "description": "Crée une archive compressée de fichiers et répertoires",
      "notes": "c=create, x=extract, t=list, z=gzip, j=bzip2, f=file. .tar.gz ou .tgz pour gzip.",
      "parameters": {
        "linux": {
          "options": {
            "label": "Options",
            "description": "czf = gzip, cJf = xz, cf = sans compression, czvf = gzip en listant chaque fichier"
          },
          "archive": {
            "label": "Archive",
            "description": "Nom du fichier d'archive"
          },
          "files": {
            "label": "Fichiers",
            "description": "Fichiers/répertoires à archiver"
          }
        }
      },
      "examples": {
        "tar -czf backup.tar.gz /home/user/data": "Crée une archive gzip",
        "tar -xzf backup.tar.gz": "Extrait une archive gzip",
        "tar -tjf backup.tar.bz2": "Liste le contenu sans extraire"
      }
    }
  }
}