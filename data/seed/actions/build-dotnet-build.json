        "linux": {
          "projectPath": {
            "label": "Projet/Solution",
            "description": "Chemin du .csproj, .sln ou dossier"
          },
          "configuration": {
            "label": "Configuration",
            "description": "Debug ou Release"
          }
        }
      },
      "examples": {
        "dotnet build MyApp.csproj --configuration Release": "Compile en mode Release",
