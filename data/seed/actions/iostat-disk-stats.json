{
  "id": "iostat-disk-stats",
  "title": "Disk I/O statistics",
  "description": "Show the input/output statistics of disks and partitions.",
  "category": "monitoring-logs",
  "platform": 1,
  "level": 0,
  "tags": [
    "iostat",
    "io",
    "disk",
    "performance",
    "statistics"
  ],
  "linuxCommandTemplateId": "iostat-cmd",
  "linuxCommandTemplate": {
    "id": "iostat-cmd",
    "platform": 1,
    "name": "iostat",
    "commandPattern": "iostat -x {interval} {count}",
    "parameters": [
      {
        "name": "interval",
        "label": "Interval (seconds)",
        "type": "number",
        "defaultValue": "5",
        "required": true,
        "description": "Interval between samples"
      },
      {
        "name": "count",
        "label": "Number of samples",
        "type": "number",
        "defaultValue": "3",
        "required": true,
        "description": "Number of samples to take"
      }
    ]
  },
  "examples": [
    {
      "command": "iostat",
      "description": "CPU and disk statistics",
      "platform": 1
    }
  ],
  "notes": "Part of the sysstat package. -x for extended statistics. Useful to find bottlenecks.",
  "links": [
    {
      "title": "iostat command",
      "url": "https://man7.org/linux/man-pages/man1/iostat.1.html"
    }
  ],
  "translations": {
    "fr": {
      "title": "Statistiques d'I/O disque",
      "description": "Affiche les statistiques d'entrées/sorties des disques et partitions",
      "notes": "Fait partie du package sysstat. -x pour statistiques étendues. Utile pour détecter les goulots d'étranglement.",
      "parameters": {
        "linux": {
          "interval": {
            "label": "Intervalle (secondes)",
            "description": "Intervalle entre les mesures"
          },
          "count": {
            "label": "Nombre de mesures",
            "description": "Nombre de mesures à effectuer"
          }
        }
      },
      "examples": {
        "iostat": "Statistiques CPU et disque"
      }
    }
  }
}