{
  "id": "lsof-open-files",
  "title": "List open files",
  "description": "List every file opened by the processes (files, sockets, etc.).",
  "category": "monitoring-logs",
  "platform": 1,
  "level": 0,
  "tags": [
    "lsof",
    "files",
    "processes",
    "sockets",
    "monitoring"
  ],
  "linuxCommandTemplateId": "lsof-cmd",
  "linuxCommandTemplate": {
    "id": "lsof-cmd",
    "platform": 1,
    "name": "lsof",
    "commandPattern": "lsof -i",
    "parameters": []
  },
  "examples": [
    {
      "command": "sudo lsof -i",
      "description": "List every open network file",
      "platform": 1
    },
    {
      "command": "lsof -i :80",
      "description": "Processes listening on port 80",
      "platform": 1
    },
    {
      "command": "lsof -u username",
      "description": "Files opened by a user",
      "platform": 1
    },
    {
      "command": "lsof -i",
      "description": "List the open network files",
      "platform": 1
    },
    {
      "command": "lsof -u www-data",
      "description": "Files opened by www-data",
      "platform": 1
    },
    {
      "command": "lsof /var/log/syslog",
      "description": "Processes using this file",
      "platform": 1
    },
    {
      "command": "lsof -i -P -n",
      "description": "All network connections",
      "platform": 1
    },
    {
      "command": "lsof +D /tmp",
      "description": "Open files in /tmp",
      "platform": 1
    }
  ],
  "notes": "Requires sudo to see every process. Very powerful to diagnose problems.",
  "links": [
    {
      "title": "lsof examples",
