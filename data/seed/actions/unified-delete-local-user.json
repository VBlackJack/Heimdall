{
  "id": "unified-delete-local-user",
  "title": "Delete a local user",
  "description": "Delete a local user account from the system.",
  "category": "security",
  "platform": 2,
  "level": 2,
  "tags": [
    "user",
    "account",
    "delete",
    "remove",
    "userdel",
    "remove-localuser",
    "windows",
    "linux"
  ],
  "linuxCommandTemplateId": "userdel-cmd",
  "linuxCommandTemplate": {
    "id": "userdel-cmd",
    "platform": 1,
    "name": "userdel",
    "commandPattern": "sudo userdel {options} {username}",
    "parameters": [
      {
        "name": "options",
        "label": "Options",
        "type": "choice",
        "allowedValues": [
          "-r",
          "-f"
        ],
        "defaultValue": "-r",
        "required": false,
        "description": "-r also deletes the home directory and the mail spool, -f forces the deletion even when the user is logged in"
      },
      {
        "name": "username",
        "label": "User name",
        "type": "string",
        "defaultValue": "john",
        "required": true,
        "description": "User to delete"
      }
    ]
  },
  "notes": "Windows: Remove-LocalUser deletes the local user (not AD). The user profile is not deleted automatically.\nLinux: userdel requires sudo. DANGER: -r deletes the home directory for good. Check the running processes first.",
  "links": [
    {
      "title": "userdel documentation",
      "url": "https://man7.org/linux/man-pages/man8/userdel.8.html"
    },
    {
      "title": "Remove-LocalUser documentation",
      "url": "https://learn.microsoft.com/en-us/powershell/module/microsoft.powershell.localaccounts/remove-localuser"
    }
  ],
  "linuxExamples": [
    {
      "command": "sudo userdel john",
      "description": "Delete the user john (keeps the home directory)",
      "platform": 1
    },
    {
      "command": "sudo userdel -r john",
      "description": "Delete john and his home directory",
      "platform": 1
    },
    {
      "command": "sudo userdel jdupont",
      "description": "Delete the user jdupont",
      "platform": 1
    },
    {
      "command": "sudo userdel -r olduser",
      "description": "Delete the user and the home directory",
      "platform": 1
    },
    {
      "command": "sudo userdel -f lockeduser",
      "description": "Force the deletion even when the user is logged on",
      "platform": 1
    },
    {
      "command": "sudo userdel -r jdupont",
      "description": "With deletion of the home directory",
      "platform": 1
    }
  ],
  "windowsCommandTemplateId": "delete-localuser-win-cmd",
  "windowsCommandTemplate": {
    "id": "delete-localuser-win-cmd",
    "platform": 0,
    "name": "Remove-LocalUser",
    "commandPattern": "Remove-LocalUser -Name {username}",
    "parameters": [
      {
        "name": "username",
        "label": "User name",
        "type": "string",
        "defaultValue": "john",
        "required": true,
        "description": "User to delete"
      }
    ]
  },
  "windowsExamples": [
    {
      "command": "Remove-LocalUser -Name \"john\"",
      "description": "Delete the user john",
      "platform": 0
    },
    {
      "command": "Remove-LocalUser -Name \"john\" -Confirm:$false",
      "description": "Delete without confirmation",
      "platform": 0
    },
    {
      "command": "Get-LocalUser | Where-Object {$_.Enabled -eq $false} | Remove-LocalUser",
      "description": "Delete every disabled user",
      "platform": 0
    }
  ],
  "examples": [],
  "translations": {
    "fr": {
      "title": "Supprimer un utilisateur local",
      "description": "Supprime un compte utilisateur local du système.",
      "notes": "Windows: Remove-LocalUser supprime l'utilisateur local (pas AD). Le profil utilisateur n'est pas supprimé automatiquement.\nLinux: userdel nécessite sudo. DANGER: -r supprime définitivement le home. Vérifier les processus actifs d'abord.",
      "parameters": {
        "windows": {
          "username": {
            "label": "Nom d'utilisateur",
            "description": "Utilisateur à supprimer"
          }
        },
        "linux": {
          "options": {
            "label": "Options",
            "description": "-r supprime aussi le répertoire personnel et la boîte mail, -f force la suppression même si l'utilisateur est connecté"
          },
          "username": {
            "label": "Nom d'utilisateur",
            "description": "Utilisateur à supprimer"
          }
        }
      },
      "examples": {
        "Remove-LocalUser -Name \"john\"": "Supprime l'utilisateur john",
        "Remove-LocalUser -Name \"john\" -Confirm:$false": "Supprime sans confirmation",
        "Get-LocalUser | Where-Object {$_.Enabled -eq $false} | Remove-LocalUser": "Supprime tous les utilisateurs désactivés",
        "sudo userdel john": "Supprime l'utilisateur john (garde le home)",
        "sudo userdel -r john": "Supprime john et son répertoire home",
        "sudo userdel jdupont": "Supprimer l'utilisateur jdupont",
        "sudo userdel -r olduser": "Supprimer l'utilisateur et son home",
        "sudo userdel -f lockeduser": "Forcer la suppression même si connecté",
        "sudo userdel -r jdupont": "Avec suppression du home"
      }
    },
    "es": {
      "title": "Eliminar un usuario local",
      "description": "Elimina una cuenta de usuario local del sistema."
    }
  }
}