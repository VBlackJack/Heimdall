  "windowsCommandTemplateId": "delete-localuser-win-cmd",
  "windowsCommandTemplate": {
    "id": "delete-localuser-win-cmd",
    "platform": 0,
    "name": "Remove-LocalUser",
    "commandPattern": "Remove-LocalUser -Name {username}",
    "parameters": [
      {
        "name": "username",
        "label": "Nom d'utilisateur",
        "type": "string",
        "defaultValue": "john",
        "required": true,
        "description": "Utilisateur à supprimer"
      }
    ]
  },
  "windowsExamples": [
    {
      "command": "Remove-LocalUser -Name \"john\"",
      "description": "Supprime l'utilisateur john",
      "platform": 0
    },
    {
      "command": "Remove-LocalUser -Name \"john\" -Confirm:$false",
      "description": "Supprime sans confirmation",
      "platform": 0
    },
    {
      "command": "Get-LocalUser | Where-Object {$_.Enabled -eq $false} | Remove-LocalUser",
      "description": "Supprime tous les utilisateurs désactivés",
      "platform": 0
    },
    {
      "command": "Get-Help Remove-LocalUser -Full",
      "description": "Affiche l'aide complète de Remove-LocalUser",
      "platform": 0
    },
    {
      "command": "Remove-LocalUser -Name \"jdupont\"",
      "description": "Exemple Windows pour Supprimer un utilisateur local",
      "platform": 0
    }
  ],
