  "linuxCommandTemplateId": "userdel-cmd",
  "linuxCommandTemplate": {
    "id": "userdel-cmd",
    "platform": 1,
    "name": "userdel",
    "commandPattern": "userdel {options} {username}",
    "parameters": [
      {
        "name": "options",
        "label": "Options",
        "type": "string",
        "defaultValue": "-r",
        "required": false,
        "description": "Options (-r supprime aussi le home)"
      },
      {
        "name": "username",
        "label": "Nom d'utilisateur",
        "type": "string",
        "defaultValue": "john",
        "required": true,
        "description": "Utilisateur à supprimer"
      }
    ]
  },
  "notes": "Windows: Remove-LocalUser supprime l'utilisateur local (pas AD). Le profil utilisateur n'est pas supprimé automatiquement.\nLinux: userdel nécessite sudo. DANGER: -r supprime définitivement le home. Vérifier les processus actifs d'abord.",
  "links": [
    {
      "title": "userdel documentation",
      "url": "https://man7.org/linux/man-pages/man8/userdel.8.html"
    },
    {
      "title": "Remove-LocalUser documentation",
      "url": "https://learn.microsoft.com/en-us/powershell/module/microsoft.powershell.localaccounts/remove-localuser"
    }
  ],
  "supportedPlatforms": [
    0,
    1
  ],
  "linuxExamples": [
    {
      "command": "sudo userdel john",
      "description": "Supprime l'utilisateur john (garde le home)",
      "platform": 1
    },
    {
