      "platform": 1
    },
    {
      "command": "userdel -r {username}",
      "description": "Exemple utilisant le paramètre 'options': Options (-r supprime aussi le home). Remplacez <options> par la valeur appropriée selon votre environnement.",
      "platform": 1
    },
    {
      "command": "userdel {options} john",
