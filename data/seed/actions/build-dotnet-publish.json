            "label": "Dossier de sortie",
            "description": "Dossier où publier"
          }
        },
        "linux": {
          "projectPath": {
            "label": "Projet",
            "description": "Chemin du projet"
          },
          "outputPath": {
            "label": "Dossier de sortie",
            "description": "Dossier où publier"
          }
        }
      },
      "examples": {
        "dotnet publish -c Release -o ./publish": "Publie en mode Release",
