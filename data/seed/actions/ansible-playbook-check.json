{
  "id": "ansible-playbook-check",
  "title": "Run a playbook in dry-run mode (--check)",
  "description": "Run an Ansible playbook in test mode without applying the changes",
  "category": "services-automation",
  "platform": 2,
  "level": 1,
  "tags": [
    "ansible",
    "playbook",
    "dry-run",
    "check",
    "test"
  ],
  "windowsCommandTemplateId": "ansible-playbook-check-win",
  "windowsCommandTemplate": {
    "id": "ansible-playbook-check-win",
    "platform": 0,
    "name": "ansible-playbook",
    "commandPattern": "ansible-playbook {playbookPath} -i {inventory} --check --diff",
    "parameters": [
      {
        "name": "playbookPath",
        "label": "Playbook path",
        "type": "string",
        "defaultValue": "site.yml",
        "required": true,
        "description": "Path to the YAML playbook file"
      },
      {
        "name": "inventory",
        "label": "Inventory",
        "type": "string",
        "defaultValue": "inventory.ini",
        "required": true,
        "description": "Host inventory file"
      }
    ]
  },
  "linuxCommandTemplateId": "ansible-playbook-check-linux",
  "linuxCommandTemplate": {
    "id": "ansible-playbook-check-linux",
    "platform": 1,
    "name": "ansible-playbook",
    "commandPattern": "ansible-playbook {playbookPath} -i {inventory} --check --diff",
    "parameters": [
      {
        "name": "playbookPath",
        "label": "Playbook path",
        "type": "string",
        "defaultValue": "site.yml",
        "required": true,
        "description": "Path to the YAML playbook file"
      },
      {
        "name": "inventory",
        "label": "Inventory",
        "type": "string",
        "defaultValue": "inventory.ini",
        "required": true,
        "description": "Host inventory file"
      }
    ]
  },
  "examples": [],
  "notes": "The --check mode simulates the run without applying the changes. --diff shows the before/after differences.",
  "links": [
    {
      "title": "Ansible Check Mode",
      "url": "https://docs.ansible.com/ansible/latest/user_guide/playbooks_checkmode.html"
    }
  ],
  "windowsExamples": [
    {
      "command": "ansible-playbook site.yml -i inventory.ini --check --diff",
      "description": "Simulate the run and show the planned changes.",
      "platform": 0
    },
    {
      "command": "ansible-playbook deploy.yml --check -v",
      "description": "Dry-run mode with verbose output.",
      "platform": 0
    }
  ],
  "linuxExamples": [
    {
      "command": "ansible-playbook deploy.yml -i production --check --diff",
      "description": "Simulate the deployment and show the changes",
      "platform": 1
    },
    {
      "command": "ansible-playbook update.yml --check -v",
      "description": "Test with verbose output",
      "platform": 1
    },
    {
      "command": "ansible-playbook --check deploy.yml",
      "description": "Check mode",
      "platform": 1
    }
  ],
  "translations": {
    "fr": {
      "title": "Exécuter un playbook en mode dry-run (--check)",
      "description": "Exécute un playbook Ansible en mode test sans appliquer les changements",
      "notes": "Le mode --check simule l'exécution sans appliquer les changements. --diff affiche les différences avant/après.",
      "parameters": {
        "windows": {
          "playbookPath": {
            "label": "Chemin du playbook",
            "description": "Chemin vers le fichier playbook YAML"
          },
          "inventory": {
            "label": "Inventaire",
            "description": "Fichier d'inventaire des hôtes"
          }
        },
        "linux": {
          "playbookPath": {
            "label": "Chemin du playbook",
            "description": "Chemin vers le fichier playbook YAML"
          },
          "inventory": {
            "label": "Inventaire",
            "description": "Fichier d'inventaire des hôtes"
          }
        }
      },
      "examples": {
        "ansible-playbook site.yml -i inventory.ini --check --diff": "Simule l'exécution et affiche les modifications prévues.",
        "ansible-playbook deploy.yml --check -v": "Mode dry-run avec sortie verbose.",
        "ansible-playbook deploy.yml -i production --check --diff": "Simule le déploiement et affiche les modifications",
        "ansible-playbook update.yml --check -v": "Test avec sortie verbeux",
        "ansible-playbook --check deploy.yml": "Mode check"
      }
    }
  }
}