{
  "id": "perf-profiling",
  "title": "Profile CPU performance",
  "description": "Analyze CPU performance and find the hotspots.",
  "category": "performance",
  "platform": 1,
  "level": 1,
  "tags": [
    "perf",
    "profiling",
    "cpu",
    "performance",
    "analysis"
  ],
  "linuxCommandTemplateId": "perf-cmd",
  "linuxCommandTemplate": {
    "id": "perf-cmd",
    "platform": 1,
    "name": "perf",
    "commandPattern": "perf {subcommand}",
    "parameters": [
      {
        "name": "subcommand",
        "label": "Subcommand",
        "type": "choice",
        "allowedValues": [
          "top",
          "record",
          "report",
          "stat"
        ],
        "defaultValue": "top",
        "required": true,
        "description": "Subcommand (top, record, report, stat)"
      }
    ]
  },
  "examples": [
    {
      "command": "sudo perf top",
      "description": "Real-time view of the CPU profiling",
      "platform": 1
    },
    {
      "command": "sudo perf record -a -g sleep 10",
      "description": "Record 10 seconds of profiling",
      "platform": 1
    },
    {
      "command": "perf report",
      "description": "Show the report of the last record",
      "platform": 1
    },
    {
      "command": "perf top",
      "description": "Profile in real time",
      "platform": 1
    },
    {
      "command": "perf record -g command",
      "description": "Record with a call graph",
      "platform": 1
    },
    {
      "command": "perf list",
      "description": "List the available events",
      "platform": 1
    }
  ],
  "notes": "Requires sudo and the linux-tools package. Very powerful for performance analysis.",
  "links": [
    {
      "title": "perf documentation",
      "url": "https://perf.wiki.kernel.org/index.php/Tutorial"
    }
  ],
  "translations": {
    "fr": {
      "title": "Profiler les performances CPU",
      "description": "Analyse les performances CPU et identifie les hotspots",
      "notes": "Nécessite sudo et package linux-tools. Très puissant pour l'analyse de performance.",
      "parameters": {
        "linux": {
          "subcommand": {
            "label": "Sous-commande",
            "description": "Sous-commande (top, record, report, stat)"
          }
        }
      },
      "examples": {
        "sudo perf top": "Vue en temps réel du profiling CPU",
        "sudo perf record -a -g sleep 10": "Enregistre 10 secondes de profiling",
        "perf report": "Affiche le rapport du dernier record",
        "perf top": "Profiler en temps réel",
        "perf record -g command": "Enregistrer avec call graph",
        "perf list": "Lister les événements disponibles"
      }
    },
    "es": {
      "title": "Perfilar el rendimiento de la CPU",
      "description": "Analiza el rendimiento de la CPU y encuentra los puntos críticos."
    }
  }
}