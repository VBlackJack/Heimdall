{
  "id": "git-add",
  "title": "Add files to the Git index",
  "description": "Add file changes to the index (staging area).",
  "category": "development",
  "platform": 2,
  "level": 0,
  "tags": [
    "git",
    "add",
    "staging"
  ],
  "windowsCommandTemplateId": "git-add-win",
  "windowsCommandTemplate": {
    "id": "git-add-win",
    "platform": 0,
    "name": "git",
    "commandPattern": "git add {files}",
    "parameters": [
      {
        "name": "files",
        "label": "Files",
        "type": "string",
        "defaultValue": ".",
        "required": true,
        "description": "Files to add (. for all)"
      }
    ]
  },
  "linuxCommandTemplateId": "git-add-linux",
  "linuxCommandTemplate": {
    "id": "git-add-linux",
    "platform": 1,
    "name": "git",
    "commandPattern": "git add {files}",
    "parameters": [
      {
        "name": "files",
        "label": "Files",
        "type": "string",
        "defaultValue": ".",
        "required": true,
        "description": "Files to add"
      }
    ]
  },
  "examples": [
    {
      "command": "git add .",
      "description": "Add every modified file",
      "platform": 2
    },
    {
      "command": "git add src/*.js",
      "description": "Add every JS file of the src folder",
      "platform": 2
    }
  ],
  "notes": "Use . to add every file, -A to include deletions and renames.",
  "links": [
    {
      "title": "Git Add Documentation",
      "url": "https://git-scm.com/docs/git-add"
    }
  ],
  "translations": {
    "fr": {
      "title": "Ajouter des fichiers à l'index Git",
      "description": "Ajoute les modifications de fichiers à l'index (staging area)",
      "notes": "Utilisez . pour ajouter tous les fichiers, -A pour inclure suppressions et renames.",
      "parameters": {
        "windows": {
          "files": {
            "label": "Fichiers",
            "description": "Fichiers à ajouter (. pour tous)"
          }
        },
        "linux": {
          "files": {
            "label": "Fichiers",
            "description": "Fichiers à ajouter"
          }
        }
      },
      "examples": {
        "git add .": "Ajoute tous les fichiers modifiés",
        "git add src/*.js": "Ajoute tous les fichiers JS du dossier src"
      }
    },
    "es": {
      "title": "Añadir archivos al índice de Git",
      "description": "Añade los cambios de los archivos al índice (área de preparación o staging)."
    }
  }
}