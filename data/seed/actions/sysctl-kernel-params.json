{
  "id": "sysctl-kernel-params",
  "title": "Show or change kernel parameters",
  "description": "Show or change Linux kernel parameters at runtime",
  "category": "performance",
  "platform": 1,
  "level": 1,
  "tags": [
    "sysctl",
    "kernel",
    "tuning",
    "performance",
    "parameters"
  ],
  "linuxCommandTemplateId": "sysctl-cmd",
  "linuxCommandTemplate": {
    "id": "sysctl-cmd",
    "platform": 1,
    "name": "sysctl",
    "commandPattern": "sysctl {parameter}",
    "parameters": [
      {
        "name": "parameter",
        "label": "Parameter",
        "type": "string",
        "defaultValue": "-a",
        "required": true,
        "description": "Kernel parameter (-a=all, param.name, param=value)"
      }
    ]
  },
  "examples": [
    {
      "command": "sysctl -a",
      "description": "List every kernel parameter",
      "platform": 1
    },
    {
      "command": "sysctl net.ipv4.ip_forward",
      "description": "Show a specific parameter",
      "platform": 1
    },
    {
      "command": "sudo sysctl -w net.ipv4.ip_forward=1",
      "description": "Change a parameter (temporary)",
      "platform": 1
    },
    {
      "command": "sysctl vm.swappiness",
      "description": "Swappiness value",
      "platform": 1
    },
    {
      "command": "sudo sysctl -w vm.swappiness=10",
      "description": "Change swappiness",
      "platform": 1
    },
    {
      "command": "sudo sysctl -p",
      "description": "Reload /etc/sysctl.conf",
      "platform": 1
    },
    {
      "command": "sysctl -a | head -50",
      "description": "Every parameter",
      "platform": 1
    }
  ],
  "notes": "Changes are temporary. Edit /etc/sysctl.conf to make them permanent. sysctl -p reloads the file. Writing a value (-w, -p) requires root (sudo).",
  "links": [
    {
      "title": "sysctl documentation",
      "url": "https://man7.org/linux/man-pages/man8/sysctl.8.html"
    }
  ],
  "translations": {
    "fr": {
      "title": "Afficher/modifier les paramètres kernel",
      "description": "Affiche ou modifie les paramètres du noyau Linux en temps réel",
      "notes": "Modifications temporaires. Éditer /etc/sysctl.conf pour permanence. sysctl -p recharge le fichier. Écrire une valeur (-w, -p) nécessite les droits root (sudo).",
      "parameters": {
        "linux": {
          "parameter": {
            "label": "Paramètre",
            "description": "Paramètre kernel (-a=all, param.name, param=value)"
          }
        }
      },
      "examples": {
        "sysctl -a": "Liste tous les paramètres kernel",
        "sysctl net.ipv4.ip_forward": "Affiche un paramètre spécifique",
        "sudo sysctl -w net.ipv4.ip_forward=1": "Modifie un paramètre (temporaire)",
        "sysctl vm.swappiness": "Valeur de swappiness",
        "sudo sysctl -w vm.swappiness=10": "Modifier swappiness",
        "sudo sysctl -p": "Recharger /etc/sysctl.conf",
        "sysctl -a | head -50": "Tous les paramètres"
      }
    }
  }
}