{
  "id": "db-sqlcmd-query",
  "title": "Query SQL Server (sqlcmd)",
  "description": "Run a T-SQL query on a Microsoft SQL Server from the command line.",
  "category": "database",
  "platform": 0,
  "level": 1,
  "tags": [
    "sql",
    "mssql",
    "database",
    "query",
    "sqlcmd"
  ],
  "windowsCommandTemplate": {
    "id": "302fc47e-9c7b-4333-8fd5-4f67aec742c2",
    "platform": 0,
    "name": "sqlcmd",
    "commandPattern": "sqlcmd -S {server} -d {database} -Q {query}",
    "parameters": [
      {
        "name": "server",
        "label": "Server",
        "type": "string",
        "defaultValue": "localhost",
        "required": true,
        "description": "SQL instance (e.g. .\\SQLEXPRESS)"
      },
      {
        "name": "database",
        "label": "Database",
        "type": "string",
        "defaultValue": "master",
        "required": true,
        "description": "Name of the database"
      },
      {
        "name": "query",
        "label": "Query",
        "type": "string",
        "defaultValue": "SELECT name, state_desc FROM sys.databases",
        "required": true,
        "description": "T-SQL query"
      }
    ]
  },
  "examples": [
    {
      "command": "sqlcmd -S PROD-SQL-01 -U sa -P Password123 -Q \"SELECT name, state_desc FROM sys.databases\"",
      "description": "List the state of every database (Online, Recovery, Suspect).",
      "platform": 0
    }
  ],
  "windowsCommandTemplateId": "302fc47e-9c7b-4333-8fd5-4f67aec742c2",
  "translations": {
