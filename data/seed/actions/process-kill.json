          "processId": {
            "label": "ID du processus",
            "description": "PID du processus à terminer"
          }
        }
      },
      "examples": {
        "kill -9 1234": "Termine le processus 1234 (Linux)",
        "kill -15 1234": "Terminer proprement le processus 1234",
