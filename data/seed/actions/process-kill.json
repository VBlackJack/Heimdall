{
  "id": "process-kill",
  "title": "Terminate a process",
  "description": "Force a given process to stop by its ID or its name.",
  "category": "performance",
  "platform": 2,
  "level": 2,
  "tags": [
    "process",
    "kill",
    "terminate",
    "windows"
  ],
  "windowsCommandTemplateId": "process-kill-windows-cmd",
  "windowsCommandTemplate": {
    "id": "process-kill-windows-cmd",
    "platform": 0,
    "name": "Stop-Process",
    "commandPattern": "Stop-Process -Id {processId} -Force",
    "parameters": [
      {
        "name": "processId",
        "label": "Process ID",
        "type": "int",
        "defaultValue": "",
        "required": true,
        "description": "Numeric ID of the process to terminate"
      }
    ]
  },
  "linuxCommandTemplateId": "process-kill-linux-cmd",
  "linuxCommandTemplate": {
    "id": "process-kill-linux-cmd",
    "platform": 1,
    "name": "kill",
    "commandPattern": "kill -9 {processId}",
    "parameters": [
      {
        "name": "processId",
        "label": "Process ID",
        "type": "int",
        "defaultValue": "",
        "required": true,
        "description": "PID of the process to terminate"
      }
    ]
  },
  "examples": [],
  "notes": "⚠️ WARNING: can lose unsaved data. -9 (SIGKILL) is a forced stop.",
  "links": [
    {
      "title": "Stop-Process documentation",
      "url": "https://learn.microsoft.com/en-us/powershell/module/microsoft.powershell.management/stop-process"
    }
  ],
  "linuxExamples": [
    {
      "command": "kill -9 1234",
      "description": "Terminate process 1234 (Linux)",
      "platform": 1
    },
    {
      "command": "kill -15 1234",
      "description": "Terminate process 1234 cleanly",
      "platform": 1
    },
    {
      "command": "kill -9 5678",
      "description": "Force process 5678 to stop",
      "platform": 1
    },
    {
      "command": "pkill -f \"python script.py\"",
      "description": "Kill the processes that match the pattern",
      "platform": 1
    },
    {
      "command": "kill 1234",
      "description": "Terminate process 1234 gracefully",
      "platform": 1
    },
    {
      "command": "xkill",
      "description": "Kill by clicking a window",
      "platform": 1
    }
  ],
  "translations": {
    "fr": {
      "title": "Terminer un processus",
