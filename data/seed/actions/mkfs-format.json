{
  "id": "mkfs-format",
  "title": "Format a partition",
  "description": "Create a filesystem on a partition.",
  "category": "files-storage",
  "platform": 1,
  "level": 2,
  "tags": [
    "mkfs",
    "format",
    "filesystem",
    "ext4",
    "xfs"
  ],
  "linuxCommandTemplateId": "mkfs-cmd",
  "linuxCommandTemplate": {
    "id": "mkfs-cmd",
    "platform": 1,
    "name": "mkfs",
    "commandPattern": "sudo mkfs.{fstype} {device}",
    "parameters": [
      {
        "name": "fstype",
        "label": "Filesystem type",
        "type": "string",
        "defaultValue": "ext4",
        "required": true,
        "description": "Type (ext4, xfs, ext3, btrfs, etc.)"
      },
      {
        "name": "device",
        "label": "Device",
        "type": "string",
        "defaultValue": "/dev/sdb1",
        "required": true,
        "description": "Partition to format"
      }
    ]
  },
  "examples": [
    {
      "command": "sudo mkfs.ext4 /dev/sdb1",
      "description": "Format as ext4",
      "platform": 1
    },
    {
      "command": "sudo mkfs.xfs /dev/sdc1",
      "description": "Format as XFS",
      "platform": 1
    },
    {
      "command": "sudo mkfs.ext4 /dev/sda1",
      "description": "Example using the 'fstype' parameter: type (ext4, xfs, ext3, btrfs, etc.). Replace ext4 with the value that fits your environment.",
      "platform": 1
    },
    {
      "command": "sudo mkfs.btrfs /dev/sde1",
      "description": "Format with Btrfs",
      "platform": 1
    },
    {
      "command": "sudo mkswap /dev/sdf1",
      "description": "Create a swap partition",
      "platform": 1
    }
  ],
  "notes": "Requires sudo. DANGER: destroys all the data of the partition.",
  "links": [
    {
      "title": "mkfs documentation",
      "url": "https://man7.org/linux/man-pages/man8/mkfs.8.html"
    }
  ],
  "translations": {
    "fr": {
      "title": "Formater une partition",
      "description": "Crée un système de fichiers sur une partition",
      "notes": "Nécessite sudo. DANGER: détruit toutes les données de la partition.",
      "parameters": {
        "linux": {
          "fstype": {
            "label": "Type de filesystem",
            "description": "Type (ext4, xfs, ext3, btrfs, etc.)"
          },
          "device": {
            "label": "Périphérique",
            "description": "Partition à formater"
          }
        }
      },
      "examples": {
        "sudo mkfs.ext4 /dev/sdb1": "Formate en ext4",
        "sudo mkfs.xfs /dev/sdc1": "Formate en XFS",
        "sudo mkfs.ext4 /dev/sda1": "Exemple utilisant le paramètre 'fstype': Type (ext4, xfs, ext3, btrfs, etc.). Remplacez ext4 par la valeur appropriée selon votre environnement.",
        "sudo mkfs.btrfs /dev/sde1": "Formater en Btrfs",
        "sudo mkswap /dev/sdf1": "Créer une partition swap"
      }
    },
    "es": {
      "title": "Formatear una partición",
      "description": "Crea un sistema de archivos en una partición."
    }
  }
}