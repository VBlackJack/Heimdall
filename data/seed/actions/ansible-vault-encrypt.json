{
  "id": "ansible-vault-encrypt",
  "title": "Encrypt a file with Ansible Vault",
  "description": "Encrypt a file that holds sensitive data with Ansible Vault",
  "category": "security",
  "platform": 2,
  "level": 1,
  "tags": [
    "ansible",
    "vault",
    "encryption",
    "security"
  ],
  "windowsCommandTemplateId": "ansible-vault-encrypt-win",
  "windowsCommandTemplate": {
    "id": "ansible-vault-encrypt-win",
    "platform": 0,
    "name": "ansible-vault",
    "commandPattern": "ansible-vault encrypt {filePath}",
    "parameters": [
      {
        "name": "filePath",
        "label": "File to encrypt",
        "type": "string",
        "defaultValue": "secrets.yml",
        "required": true,
        "description": "Path of the file to encrypt"
      }
    ]
  },
  "linuxCommandTemplateId": "ansible-vault-encrypt-linux",
  "linuxCommandTemplate": {
    "id": "ansible-vault-encrypt-linux",
    "platform": 1,
    "name": "ansible-vault",
    "commandPattern": "ansible-vault encrypt {filePath}",
    "parameters": [
      {
        "name": "filePath",
        "label": "File to encrypt",
        "type": "string",
        "defaultValue": "secrets.yml",
        "required": true,
        "description": "Path of the file to encrypt"
      }
    ]
  },
  "examples": [],
  "notes": "Use a strong password and store it securely. To run a playbook with encrypted files, use --ask-vault-pass.",
  "links": [
    {
      "title": "Ansible Vault",
      "url": "https://docs.ansible.com/ansible/latest/user_guide/vault.html"
    }
  ],
  "windowsExamples": [
    {
      "command": "ansible-vault encrypt C:\\Data\\report.xlsx",
      "description": "Windows example using ansible-vault. Replace the parameters between <> with your values.",
      "platform": 0
    }
  ],
  "linuxExamples": [
    {
      "command": "ansible-vault encrypt vars/secrets.yml",
      "description": "Encrypt the secrets file",
      "platform": 1
    },
    {
      "command": "ansible-vault decrypt vars/secrets.yml",
      "description": "Decrypt the secrets file",
      "platform": 1
    },
    {
      "command": "ansible-vault encrypt --vault-id prod@prompt secrets.yml",
      "description": "With a vault ID",
      "platform": 1
    },
    {
      "command": "ansible-vault encrypt_string 'secret' --name 'password'",
      "description": "Encrypt a string",
      "platform": 1
    }
  ],
  "translations": {
