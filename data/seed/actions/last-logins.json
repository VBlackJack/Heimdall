{
  "id": "last-logins",
  "title": "Show the logon history",
  "description": "List the latest user logons to the system.",
  "category": "monitoring-logs",
  "platform": 1,
  "level": 0,
  "tags": [
    "last",
    "login",
    "users",
    "audit"
  ],
  "linuxCommandTemplateId": "last-cmd",
  "linuxCommandTemplate": {
    "id": "last-cmd",
    "platform": 1,
    "name": "last",
    "commandPattern": "last -n {count} {username}",
    "parameters": [
      {
        "name": "count",
        "label": "Number of entries",
        "type": "number",
        "defaultValue": "20",
        "required": true,
        "description": "Number of logons to show"
      },
      {
        "name": "username",
        "label": "User name",
        "type": "string",
        "defaultValue": "",
        "required": false,
        "description": "Filter by user (empty = all)"
      }
    ]
  },
  "examples": [
    {
      "command": "last -n 20",
      "description": "Show the last 20 logons",
      "platform": 1
    },
    {
      "command": "last root",
      "description": "Show every logon of the root user",
      "platform": 1
    },
    {
      "command": "lastb",
      "description": "Show the failed logon attempts",
      "platform": 1
    },
    {
      "command": "last -n 10 jdupont",
      "description": "Example using the 'username' parameter: filter by user (empty = all). Replace jdupont with the value that fits your environment.",
      "platform": 1
    },
    {
      "command": "last",
      "description": "Logon history",
      "platform": 1
    },
    {
      "command": "last -x",
      "description": "Include shutdown and runlevel entries",
      "platform": 1
    },
    {
      "command": "lastlog",
      "description": "Last logon of each user",
      "platform": 1
    },
    {
      "command": "last reboot",
      "description": "Reboot history",
      "platform": 1
    },
    {
      "command": "last -F",
      "description": "With full dates",
      "platform": 1
    }
  ],
  "notes": "lastb shows the bad logins. The data comes from /var/log/wtmp and /var/log/btmp.",
  "links": [
    {
      "title": "last command",
      "url": "https://man7.org/linux/man-pages/man1/last.1.html"
    }
  ],
  "translations": {
    "fr": {
      "title": "Afficher l'historique des connexions",
      "description": "Liste les dernières connexions utilisateurs au système",
      "notes": "lastb affiche les bad logins. Les données proviennent de /var/log/wtmp et /var/log/btmp.",
      "parameters": {
        "linux": {
          "count": {
            "label": "Nombre d'entrées",
            "description": "Nombre de connexions à afficher"
          },
          "username": {
            "label": "Nom d'utilisateur",
            "description": "Filtrer par utilisateur (vide = tous)"
          }
        }
      },
      "examples": {
        "last -n 20": "Affiche les 20 dernières connexions",
        "last root": "Affiche toutes les connexions de l'utilisateur root",
        "lastb": "Affiche les tentatives de connexion échouées",
        "last -n 10 jdupont": "Exemple utilisant le paramètre 'username': Filtrer par utilisateur (vide = tous). Remplacez jdupont par la valeur appropriée selon votre environnement.",
        "last": "Historique des connexions",
        "last -x": "Inclure shutdown et runlevel",
        "lastlog": "Dernière connexion de chaque utilisateur",
        "last reboot": "Historique des redémarrages",
        "last -F": "Avec dates complètes"
      }
    },
    "es": {
      "title": "Mostrar el historial de inicios de sesión",
      "description": "Lista los últimos inicios de sesión de usuarios en el sistema."
    }
  }
}