{
  "id": "ad-get-user-groups",
  "title": "List the groups of a user",
  "description": "Show every Active Directory group a user is a member of.",
  "category": "active-directory",
  "platform": 2,
  "level": 0,
  "tags": [
    "ad",
    "user",
    "groups",
    "membership"
  ],
  "windowsCommandTemplateId": "ad-get-user-groups-cmd",
  "windowsCommandTemplate": {
    "id": "ad-get-user-groups-cmd",
    "platform": 0,
    "name": "Get-ADPrincipalGroupMembership",
    "commandPattern": "Get-ADPrincipalGroupMembership -Identity {username} | Select-Object Name,GroupCategory,GroupScope | Sort-Object Name",
    "parameters": [
      {
        "name": "username",
        "label": "Username",
        "type": "string",
        "defaultValue": "",
        "required": true,
        "description": "SamAccountName of the user"
      }
    ]
  },
  "examples": [],
  "notes": "Shows direct and indirect (nested) groups. Useful to audit permissions.",
  "links": [
    {
      "title": "Documentation Get-ADPrincipalGroupMembership",
      "url": "https://learn.microsoft.com/en-us/powershell/module/activedirectory/get-adprincipalgroupmembership"
    }
  ],
  "linuxCommandTemplate": {
    "id": "groups-cmd",
    "platform": 1,
    "name": "groups",
    "commandPattern": "groups {username}",
    "parameters": [
      {
        "name": "username",
        "label": "Username",
        "type": "string",
        "defaultValue": "",
        "required": false,
        "description": "User (empty = current user)"
      }
    ]
  },
  "windowsExamples": [
    {
      "command": "Get-ADGroup -Filter {GroupCategory -eq 'Security' -and GroupScope -eq 'Global'}",
      "description": "List global security groups only. GroupCategory is 'Security' or 'Distribution'. GroupScope is 'DomainLocal', 'Global' or 'Universal'. Global security groups are the most common for resource permissions.",
      "platform": 0
    }
  ],
  "linuxExamples": [
    {
      "command": "groups",
      "description": "Show your groups",
      "platform": 1
    },
    {
      "command": "groups john",
      "description": "Show the groups of john",
      "platform": 1
    },
    {
      "command": "id john",
      "description": "Show the UID, GID and groups",
      "platform": 1
    },
    {
      "command": "id jdupont",
      "description": "UID, GID and groups",
      "platform": 1
    },
    {
      "command": "getent group sudo",
      "description": "Members of the sudo group",
      "platform": 1
    }
  ],
  "linuxCommandTemplateId": "groups-cmd",
  "translations": {
    "fr": {
      "title": "Lister les groupes d'un utilisateur",
      "description": "Affiche tous les groupes Active Directory dont un utilisateur est membre.",
      "notes": "Affiche les groupes directs et indirects (imbriqués). Utile pour l'audit des permissions.",
      "parameters": {
        "windows": {
          "username": {
            "label": "Nom d'utilisateur",
            "description": "SamAccountName de l'utilisateur"
          }
        },
        "linux": {
          "username": {
            "label": "Nom d'utilisateur",
            "description": "Utilisateur (vide = utilisateur actuel)"
          }
        }
      },
      "examples": {
        "Get-ADGroup -Filter {GroupCategory -eq 'Security' -and GroupScope -eq 'Global'}": "Liste uniquement les groupes de sécurité globaux. GroupCategory peut être 'Security' ou 'Distribution'. GroupScope peut être 'DomainLocal', 'Global' ou 'Universal'. Les groupes de sécurité globaux sont les plus courants pour les permissions sur ressources.",
        "groups": "Affiche vos groupes",
        "groups john": "Affiche les groupes de john",
        "id john": "Affiche UID, GID et groupes",
        "id jdupont": "UID, GID et groupes",
        "getent group sudo": "Membres du groupe sudo"
      }
    },
    "es": {
      "title": "Listar los grupos de un usuario",
      "description": "Muestra todos los grupos de Active Directory de los que es miembro un usuario."
    }
  }
}