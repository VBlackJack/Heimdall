<!--
  Heimdall WiX MSI Installer
  WiX v4+ format. Produces an .msi for enterprise GPO/SCCM deployment.
  Build: wix build -d AppVersion=<MSI product version> -d SourceDir=<publish directory>
  AppVersion is <yy>.<M>.<DD*100+xx> from the YYYY.MMDDxx build number (2026.102702 ->
  26.10.2702, see ConvertTo-MsiProductVersion in scripts/BuildVersioning.ps1): Windows
  Installer compares only three fields, so the assembly version 1.0.MMDD.xx lost the year.
         -o Heimdall.msi Product.wxs -ext WixToolset.UI.wixext
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="Heimdall"
           Manufacturer="Julien Bombled"
           Version="$(AppVersion)"
           UpgradeCode="B7A4D3E1-8F2C-4A91-9D5E-6C3B8A1F0E72"
           Scope="perMachine"
           InstallerVersion="500">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Heimdall is already installed." />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="..\LICENSE.rtf" />

    <Feature Id="ProductFeature" Title="Heimdall" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Heimdall">
        <Component Id="DesktopShortcut" Guid="A1B2C3D4-E5F6-7890-AB12-CD34EF560A78">
          <Shortcut Id="DesktopShortcutFile"
                    Name="Heimdall"
                    Target="[INSTALLFOLDER]Heimdall.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Directory="DesktopFolder" />
          <RegistryValue Root="HKCU" Key="Software\Heimdall" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
        </Component>
        <Component Id="StartMenuShortcut" Guid="B2C3D4E5-F6A7-8901-BC23-DE45FA670B89">
          <Shortcut Id="StartMenuShortcutFile"
                    Name="Heimdall"
                    Target="[INSTALLFOLDER]Heimdall.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Directory="ProgramMenuFolder" />
          <RegistryValue Root="HKCU" Key="Software\Heimdall" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />
    <StandardDirectory Id="ProgramMenuFolder" />

  </Package>

  <!-- Product files harvested via WiX Files element -->
  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Files Include="$(SourceDir)\**">
        <Exclude Files="**\*.pdb" />
      </Files>
    </ComponentGroup>
  </Fragment>

</Wix>
